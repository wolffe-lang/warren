//! member: false
//! The pure modules alone, as one program with a `main`: the form the
//! reference interpreter runs. The server, client, command and configuration
//! modules are not imported here, and never will be.
use vt
use proto
use layout

fn main() -> int {
    assert(vt.pure())
    assert(proto.pure())
    assert(layout.pure())
    assert(vt.milestone() == "W1")
    var parser = vt.new_parser()
    for b in "\u{1b}[31m中".bytes() { vt.advance_in_place(mut parser, b) }
    assert(parser.state == 0 && parser.utf_left == 0)
    assert(parser.output_count == 1 && parser.first_kind == 1 && parser.first_value == 20013)
    assert(parser.param_count == 1 && parser.params[0] == 31)
    for b in "\u{1b}]2;title\u{1b}\\".bytes() { vt.advance_in_place(mut parser, b) }
    assert(parser.output_count == 1 && parser.first_kind == 5 && parser.payload_len == 7)
    0
}
