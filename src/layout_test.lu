//! member: false
//! The layout module in the ordinary `wolf test` gate: every golden, the
//! arena-free form's rows, one layout file round trip at the smallest and
//! the largest size, and four property sequences with the constructed grids
//! at each size, one test a size so that each fits the checked machine's
//! step budget.

use layout_rows

fn test_layout_goldens() {
    assert(layout_rows.goldens() == 0)
}

fn test_layout_shape_add_tree() {
    assert(layout_rows.shape_rows() == 0)
}

fn test_layout_file_round_trip_20x6() {
    assert(layout_rows.file_round_trips(0, 0, 1) == 0)
}

fn test_layout_file_round_trip_512x512() {
    assert(layout_rows.file_round_trips(4, 0, 1) == 0)
}

fn test_layout_properties_20x6() {
    assert(layout_rows.properties_at(0, 0, 4, true) == 0)
}

fn test_layout_properties_80x24() {
    assert(layout_rows.properties_at(1, 0, 4, true) == 0)
}

fn test_layout_properties_81x25() {
    assert(layout_rows.properties_at(2, 0, 4, true) == 0)
}

fn test_layout_properties_320x90() {
    assert(layout_rows.properties_at(3, 0, 4, true) == 0)
}

fn test_layout_properties_512x512() {
    assert(layout_rows.properties_at(4, 0, 4, true) == 0)
}
