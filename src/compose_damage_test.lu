//! member: false
//! Compose's damage rows: a session compose computes each frame cell once,
//! and in a pane it reads only the rows and spans the emulator changed
//! since this client's last image; and over seeded streams in random
//! chunks, two clients composing at different times each hold exactly the
//! frame a full rescan computes. Native and the checked machine. The
//! program's argument is the streams per size (one by default); the gate
//! runs twelve.
use std.env
use server
use vt

struct Rig {
    panes: List[server.Pane],
    ses: server.Session,
    sh: server.Shadow,
    seq: int,
}

fn pane(cols: int, rows: int) -> server.Pane {
    server.Pane { live: true, id: 1, session: 0, session_gen: 0, gen: 1, master: 0 - 1, key: 0 - 1, child: 0 - 1,
        pid: 0 - 1, child_live: false, status: 0 - 1, ended: false, screen: vt.new(cols, rows, 0),
        input: List[byte](), in_off: 0, in_len: 0, write_on: false, last_output: 0, sync_since: 0, read_turn: 0 - 1,
        streaming: false, read_peak: 0, damage: 0, shown: true, at_col: 1, at_row: 1, argv: List[byte](),
        start_dir: List[byte]() }
}

// One pane filling a session's tab area, the bar's two rows below it.
fn rig(cols: int, rows: int) -> Rig {
    var ses = server.idle_session()
    ses.live = true
    ses.cols = cols
    ses.rows = rows + 2
    var i = 0
    while i < cols * rows {
        (mut ses.owner).push(0)
        i += 1
    }
    var panes = List[server.Pane]()
    (mut panes).push(pane(cols, rows))
    Rig { panes: panes, ses: ses, sh: server.no_shadow(), seq: 0 }
}

fn feed(mut r: Rig, data: List[byte]) {
    vt.feed(mut r.panes[0].screen, data)
    r.panes[0].damage += 1
}

fn push_text(mut out: List[byte], text: str) {
    for b in text.bytes() { (mut out).push(b) }
}

// Compose the client's next image with the pane's rect to scan, as the
// server does when the pane's damage moved; the frame cells it read.
fn compose(mut r: Rig, full: bool) -> int {
    let cols = r.ses.cols
    let rows = r.ses.rows - 2
    let scans: List[int] = [1, 1, cols, rows]
    let cursor: List[int] = [1, 1, 0, 1]
    let payload = server.compose_frame(mut r.sh, r.panes, r.ses, List[vt.Cell](), vt.new_view(), 0 - 1, r.seq + 1, full, false, scans,
        cursor)
    if payload.len > 0 { r.seq += 1 }
    r.sh.reads
}

// Row n's text: letters with a space every ninth column.
fn push_line(mut out: List[byte], cols: int, n: int) {
    let letters = "abcdefghijklmnopqrstuvwxyz".bytes()
    var c = 0
    while c < cols {
        if c % 9 == 8 { (mut out).push(32 as byte) } else { (mut out).push(letters[(n * 7 + c) % 26]) }
        c += 1
    }
}

// A screen of text, as an editor draws it: every row written.
fn fill(mut r: Rig) {
    let cols = r.ses.cols
    let rows = r.ses.rows - 2
    var data = List[byte]()
    var n = 1
    while n <= rows {
        push_text(mut data, "\u{1b}[{n};1H")
        push_line(mut data, cols, n)
        n += 1
    }
    feed(mut r, data)
}

// A full image reads each of the frame's cells once.
fn test_a_whole_image_reads_each_cell_once() {
    var r = rig(40, 10)
    fill(mut r)
    let reads = compose(mut r, true)
    assert(reads == 40 * 12, "whole-reads-each-cell-once")
}

// One cell written: the next image reads that cell and nothing else.
fn test_one_cell_reads_one() {
    var r = rig(160, 50)
    fill(mut r)
    let _whole = compose(mut r, true)
    feed(mut r, "\u{1b}[25;100H#".bytes())
    let reads = compose(mut r, false)
    assert(r.sh.cells[24 * 160 + 99].base == 35, "one-cell-shadow")
    assert(reads == 1, "one-cell-reads-one")
}

// Rows 26 to 50 redrawn, as an editor does below an inserted line: the
// image reads those rows' cells once each, and none of the rows above.
fn test_a_redraw_reads_its_rows() {
    var r = rig(160, 50)
    fill(mut r)
    let _whole = compose(mut r, true)
    var data = List[byte]()
    push_text(mut data, "\u{1b}[26;1H\u{1b}[J")
    var n = 26
    while n <= 50 {
        push_text(mut data, "\u{1b}[{n};1H")
        push_line(mut data, 160, n + 3)
        n += 1
    }
    feed(mut r, data)
    let reads = compose(mut r, false)
    assert(reads == 25 * 160, "redraw-reads-its-rows")
}

// The pane's rect asked for again with nothing new written: nothing read.
fn test_no_new_damage_reads_nothing() {
    var r = rig(160, 50)
    fill(mut r)
    let _whole = compose(mut r, true)
    r.panes[0].damage += 1
    let reads = compose(mut r, false)
    assert(reads == 0, "no-new-damage-reads-nothing")
}

// Another session's pane, shown at the same place in its own frame: its
// damage says nothing about this frame's cells, which only this frame's
// own pane (the owner map's) limits.
fn test_another_sessions_pane_limits_nothing() {
    var r = rig(40, 10)
    var other = pane(40, 10)
    other.id = 2
    other.session = 1
    (mut r.panes).push(other)
    fill(mut r)
    let _whole = compose(mut r, true)
    vt.feed(mut r.panes[1].screen, "\u{1b}[2;1Hz".bytes())
    r.panes[1].damage += 1
    let _quiet = compose(mut r, false)
    feed(mut r, "\u{1b}[7;5Hhello".bytes())
    vt.feed(mut r.panes[1].screen, "\u{1b}[3;1Hy".bytes())
    r.panes[1].damage += 1
    let _image = compose(mut r, false)
    assert(differs(r.panes, r.ses, r.sh) == 0 - 1, "other-session-pane-limits-nothing")
}

// ---- the damage-limited image equals a full rescan ----

struct Rng { state: int }

fn next(mut r: Rng, bound: int) -> int {
    r.state = (r.state * 1103515245 + 12345) % 2147483648
    (r.state / 65536) % bound
}

// One stream: text among everything else that writes or moves cells
// (wraps, scrolls in and out of a region, inserted and deleted lines and
// characters, erases of every kind, wide glyphs, marks, REP, insert mode,
// the alternate screen, alignment, resets).
fn stream(mut g: Rng, rows: int, cols: int) -> List[byte] {
    var out = List[byte]()
    let alphabet = "abcdefghijklmnopqrstuvwxyz ABCXYZ0123456789.,;:!?-_=+*/()[]<>|~`'#$%&@^".bytes()
    var pieces = 0
    while pieces < 40 {
        let kind = next(mut g, 30)
        if kind < 9 {
            var n = 1 + next(mut g, cols * 2)
            while n > 0 {
                let pick = next(mut g, alphabet.len)
                (mut out).push(alphabet[pick])
                n -= 1
            }
        } else if kind == 9 { push_text(mut out, "\r\n") }
        else if kind == 10 {
            let row = 1 + next(mut g, rows)
            let col = 1 + next(mut g, cols)
            push_text(mut out, "\u{1b}[{row};{col}H")
        } else if kind == 11 {
            let bold = next(mut g, 2)
            let colour = next(mut g, 8)
            push_text(mut out, "\u{1b}[{bold};4{colour}m")
        } else if kind == 12 {
            let part = next(mut g, 3)
            push_text(mut out, "\u{1b}[{part}K")
        } else if kind == 13 {
            let part = next(mut g, 3)
            push_text(mut out, "\u{1b}[{part}J")
        }
        else if kind == 14 { push_text(mut out, "中") }
        else if kind == 15 { push_text(mut out, "e\u{301}") }
        else if kind == 16 {
            let times = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{times}b")
        } else if kind == 17 {
            let n = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{n}L")
        } else if kind == 18 {
            let n = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{n}M")
        } else if kind == 19 {
            let n = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{n}@")
        } else if kind == 20 {
            let n = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{n}P")
        } else if kind == 21 {
            let n = 1 + next(mut g, 3)
            push_text(mut out, "\u{1b}[{n}X")
        }
        else if kind == 22 { push_text(mut out, if next(mut g, 2) == 0 then "\u{1b}[4h" else "\u{1b}[4l") }
        else if kind == 23 { push_text(mut out, if next(mut g, 2) == 0 then "\u{1b}[?1049h" else "\u{1b}[?1049l") }
        else if kind == 24 { push_text(mut out, if next(mut g, 2) == 0 then "\u{1b}D" else "\u{1b}M") }
        else if kind == 25 {
            let top = 1 + next(mut g, rows)
            push_text(mut out, "\u{1b}[{top};{rows}r")
        }
        else if kind == 26 { push_text(mut out, "\n\n\n") }
        else if kind == 27 { push_text(mut out, "\u{1b}#8") }
        else if kind == 28 { push_text(mut out, if next(mut g, 2) == 0 then "\u{1b}(0q" else "\u{1b}(B") }
        else { push_text(mut out, if next(mut g, 6) == 0 then "\u{1b}c" else "\u{8}\t") }
        pieces += 1
    }
    out
}

fn same_cell(a: server.Shadow, i: int, b: server.Shadow) -> bool {
    a.cells[i].base == b.cells[i].base && a.cells[i].mark1 == b.cells[i].mark1 && a.cells[i].mark2 == b.cells[i].mark2 &&
        a.cells[i].width == b.cells[i].width && a.cells[i].flags == b.cells[i].flags &&
        a.cells[i].foreground == b.cells[i].foreground && a.cells[i].background == b.cells[i].background
}

// The first frame cell where a client's shadow and a full rescan differ,
// or -1.
fn differs(panes: List[server.Pane], ses: server.Session, sh: server.Shadow) -> int {
    var fresh = server.no_shadow()
    let cursor: List[int] = [1, 1, 0, 1]
    let _image = server.compose_frame(mut fresh, panes, ses, List[vt.Cell](), vt.new_view(), 0 - 1, 1, true, false, List[int](), cursor)
    var i = 0
    while i < ses.cols * ses.rows {
        if !same_cell(sh, i, fresh) { return i }
        i += 1
    }
    0 - 1
}

// Two panes of one session side by side (a border column between), and a
// third of another session shown at the first one's place in its own
// frame. Each client scans every pane's rect, as after output in both.
fn split_rig(cols: int, rows: int) -> Rig {
    var ses = server.idle_session()
    ses.live = true
    ses.cols = cols * 2 + 1
    ses.rows = rows + 2
    var i = 0
    while i < ses.cols * rows {
        let c = i % ses.cols
        (mut ses.owner).push(if c < cols then 0 else if c == cols then 0 - 1 else 1)
        i += 1
    }
    var panes = List[server.Pane]()
    (mut panes).push(pane(cols, rows))
    var right = pane(cols, rows)
    right.id = 2
    right.at_col = cols + 2
    (mut panes).push(right)
    var other = pane(cols, rows)
    other.id = 3
    other.session = 1
    (mut panes).push(other)
    Rig { panes: panes, ses: ses, sh: server.no_shadow(), seq: 0 }
}

fn compose_split(mut sh: server.Shadow, seq: int, r: Rig, full: bool) -> int {
    let cols = r.panes[0].screen.cols
    let rows = r.ses.rows - 2
    let scans: List[int] = [1, 1, cols, rows, cols + 2, 1, cols, rows]
    let cursor: List[int] = [1, 1, 0, 1]
    let image = server.compose_frame(mut sh, r.panes, r.ses, List[vt.Cell](), vt.new_view(), 0 - 1, seq + 1, full, false, scans, cursor)
    if image.len > 0 { return seq + 1 }
    seq
}

// Seeded streams at sizes that meet the edges often (the first `count`
// of them), one a pane, fed in random chunks to a pane chosen at random.
// One client composes after every chunk, another after every third; after
// each image, its shadow must equal the full rescan. A difference is
// printed as `FAIL damage-equals-rescan` and ends the comparison.
fn damage_agrees(rounds: int, count: int) -> bool {
    var g = Rng { state: 20261117 }
    let sizes = [1, 1, 2, 3, 7, 4, 13, 5, 20, 6, 40, 12]
    var streams = 0
    var images = 0
    var k = 0
    while k < sizes.len && k < count * 2 {
        let cols = sizes[k]
        let rows = sizes[k + 1]
        var round = 0
        while round < rounds {
            var data = List[List[byte]]()
            var at = List[int]()
            var q = 0
            while q < 3 {
                (mut data).push(stream(mut g, rows, cols))
                (mut at).push(0)
                q += 1
            }
            var r = split_rig(cols, rows)
            var one = server.no_shadow()
            var one_seq = compose_split(mut one, 0, r, true)
            var two = server.no_shadow()
            var two_seq = compose_split(mut two, 0, r, true)
            var chunk = 0
            var left = data[0].len + data[1].len + data[2].len
            while left > 0 {
                var p = next(mut g, 3)
                while at[p] >= data[p].len { p = (p + 1) % 3 }
                var end = at[p] + 1 + next(mut g, 24)
                if end > data[p].len { end = data[p].len }
                vt.feed(mut r.panes[p].screen, data[p][at[p]..end])
                r.panes[p].damage += 1
                left -= end - at[p]
                at[p] = end
                one_seq = compose_split(mut one, one_seq, r, false)
                let a = differs(r.panes, r.ses, one)
                if a >= 0 {
                    print("FAIL damage-equals-rescan size {cols}x{rows} round {round} client 1 pane {p} chunk {chunk} cell {a}")
                    return false
                }
                chunk += 1
                images += 1
                if chunk % 3 == 0 || left == 0 {
                    two_seq = compose_split(mut two, two_seq, r, false)
                    let b = differs(r.panes, r.ses, two)
                    if b >= 0 {
                        print("FAIL damage-equals-rescan size {cols}x{rows} round {round} client 2 pane {p} chunk {chunk} cell {b}")
                        return false
                    }
                    images += 1
                }
            }
            streams += 3
            round += 1
        }
        k += 2
    }
    print("MEASURE compose-damage streams={streams} images={images}")
    true
}

// The checked machine's step budget holds the two smallest sizes.
fn test_damage_equals_a_full_rescan() {
    assert(damage_agrees(1, 2), "damage-equals-rescan")
}

fn main() -> int {
    test_a_whole_image_reads_each_cell_once()
    test_one_cell_reads_one()
    test_a_redraw_reads_its_rows()
    test_no_new_damage_reads_nothing()
    test_another_sessions_pane_limits_nothing()
    let args = env.args()
    var rounds = 1
    if args.len > 0 { rounds = args[0].to_int() else 1 }
    if !damage_agrees(rounds, 6) { return 1 }
    print("PASS compose-damage")
    0
}
