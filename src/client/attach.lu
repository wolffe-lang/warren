//! member: true
//! The terminal client: attach to a session (starting the server when
//! there is none and creation is asked for), draw its images, send what is
//! typed, and give the terminal back on every way out.
use std.env
use std.io
use std.fs
use std.net
use std.poll
use std.process
use std.signal
use std.term
use std.time
use proto
use server

/// How long a client waits for a server it started to answer.
pub const START_MS: int = 5000

// A line to the file WARREN_CLIENT_TRACE names, if any: what a client did
// on its way out, for rows on hosts where its terminal is gone.
fn ctrace(text: str) {
    let path = env.get("WARREN_CLIENT_TRACE") else ""
    if path.len == 0 { return }
    let old = fs.read_text(path) else ""
    fs.write_text(path, old + "{now_ms()} {text}\n") else |_| {}
}

fn now_ms() -> int {
    time.monotonic_ns() / 1000000
}

fn ms_since(start: int) -> int {
    now_ms() - start
}

/// This program's own path, for starting the server: argv[0] when it
/// names a file, else the first match on PATH.
pub fn self_path() -> str {
    let a0 = env.arg0()
    if a0.starts_with("/") { return a0 }
    if a0.contains("/") {
        let here = env.cwd() else "."
        return here + "/" + a0
    }
    let path = env.get("PATH") else ""
    for dir in path.split(":") {
        if dir.len == 0 { continue }
        let candidate = dir + "/" + a0
        let info = fs.stat(candidate) else { continue }
        if info.kind == 0 { return candidate }
    }
    a0
}

// Start `warren server` detached: a session of its own, reparented, its
// standard streams on /dev/null, the client's terminal not inherited.
fn start_server() -> str {
    let a = process.fork() else |e| { return "fork: {e}" }
    if process.is_child(a) {
        process.lead_session() else |_| { process.exit(40) }
        let b = process.fork() else |_| {
            process.exit(41)
            return ""
        }
        if process.is_child(b) {
            let null = fs.open_mode("/dev/null", 2) else |_| {
                process.exit(42)
                return ""
            }
            var c = process.command(self_path())
            process.push_arg(mut c, "server")
            process.set_stdin(mut c, null)
            process.set_stdout(mut c, null)
            process.set_stderr(mut c, null)
            process.exec(c, env.vars()) else |_| {}
            process.exit(127)
        }
        process.exit(0)
    }
    var ch = process.Child { slot: a.child.slot }
    let st = process.wait_status(take ch) else 0 - 1
    if st != 0 { return "the server's starter ended {st}" }
    ""
}

/// Dial the server; when there is none and `create`, start it and dial
/// until it answers (START_MS).
pub fn dial_or_start(create: bool) -> Peer ! DialErrors {
    let sock = server.socket_path(server.runtime_dir())
    if server.socket_path_problem(sock).len > 0 { return io }
    var why = ""
    var first = dial(sock) else |e| {
        why = "{e}"
        no_peer(0 - 1)
    }
    if why.len == 0 { return first }
    if why == "denied" { return denied }
    if why == "unsupported" { return unsupported }
    if why == "io" { return io }
    if !create {
        if why == "not_found" { return not_found }
        return refused
    }
    if start_server().len > 0 { return io }
    let t0 = now_ms()
    while ms_since(t0) < START_MS {
        var p = dial(sock) else |_| {
            time.sleep(time.millis(20))
            continue
        }
        return p
    }
    refused
}

fn env_lists(mut names: List[str], mut values: List[str]) {
    for kv in env.vars() {
        let at = kv.find("=") else 0 - 1
        if at < 0 { continue }
        if at == 0 { continue }
        (mut names).push(kv[0..at])
        (mut values).push(kv[at + 1..kv.len])
    }
}

fn number(n: int, width: int) -> List[byte] {
    var b = List[byte]()
    proto.put(mut b, n, width)
    b
}

fn send_event(p: Peer, e: Event) -> bool {
    var b = List[byte]()
    if e.kind == 2 {
        proto.put(mut b, e.mods, 1)
        proto.put(mut b, e.key, 1)
        proto.put(mut b, e.code, 4)
    } else if e.kind == 3 {
        proto.put(mut b, e.key, 1)
        proto.put(mut b, e.code, 1)
        proto.put(mut b, e.mods, 1)
        proto.put(mut b, e.col, 2)
        proto.put(mut b, e.row, 2)
    } else if e.kind == 5 {
        proto.put(mut b, e.code, 1)
    } else {
        proto.put(mut b, e.data.len, 4)
        for x in e.data { (mut b).push(x) }
    }
    send(p, e.kind, b)
}

fn sanitize(t: str) -> str {
    var out = List[byte]()
    for b in t.bytes() {
        let v = b as int
        if v >= 32 && v != 127 { (mut out).push(b) }
    }
    str_from_utf8(out) else ""
}

/// How a client ended: its exit code and the line it prints.
pub struct End {
    code: int,
    line: str,
    gone: bool,
}

fn bye_end(code: int, text: str, session: str) -> End {
    if code == 1 { return End { code: 0, line: "[detached from {session}]", gone: false } }
    if code == 2 { return End { code: 0, line: "[{session} ended]", gone: false } }
    if code == 3 { return End { code: 0, line: "[the server stopped]", gone: false } }
    if code == 7 { return End { code: 1, line: "warren: the terminal is too small ({text})", gone: false } }
    End { code: 1, line: "warren: {text} (BYE {code})", gone: false }
}

const LISTENED: int = 2 + 1 + 4 + 16 + 16384 + 32 + 8192

/// The columns a 0x0 window is given when COLUMNS does not say.
pub const DEFAULT_COLS: int = 80
/// The rows a 0x0 window is given when LINES does not say.
pub const DEFAULT_ROWS: int = 24

// A positive number from the environment, or `fallback`.
fn env_size(name: str, fallback: int) -> int {
    let text = env.get(name) else ""
    let n = text.trim().to_int() else 0
    if n > 0 && n <= 65535 { return n }
    fallback
}

/// The window a session is made and attached at. A dimension the terminal
/// reports as 0 (a serial line, or a console never told its size) is taken
/// from COLUMNS or LINES when that is a positive number, else 80 columns
/// and 24 rows; a dimension it reports is kept.
pub fn window_size(read: term.Size) -> term.Size {
    let cols = if read.columns > 0 then read.columns else env_size("COLUMNS", DEFAULT_COLS)
    let rows = if read.rows > 0 then read.rows else env_size("LINES", DEFAULT_ROWS)
    term.Size { rows: rows, columns: cols }
}

/// Why a window cannot be carried by the protocol (more than 65,535 in a
/// dimension, or more than GRID_MAX cells), or "".
pub fn window_problem(s: term.Size) -> str {
    if s.columns > 65535 || s.rows > 65535 || s.columns * s.rows > proto.GRID_MAX {
        return "the terminal's window {s.columns}x{s.rows} is larger than warren takes ({proto.GRID_MAX} cells)"
    }
    ""
}

/// Attach this terminal to `target` (empty: the default session),
/// creating it (and the server) when `create`. Returns the exit code.
pub fn attach(target: str, create: bool) -> int {
    var out = fs.stdout()
    let file = fs.stdin()
    let read = term.size(file) else |_| {
        eprint("warren: not a terminal: attach needs one on standard input")
        return 1
    }
    let size = window_size(read)
    let large = window_problem(size)
    if large.len > 0 {
        eprint("warren: {large}")
        return 1
    }
    let console = (env.get("WARREN_RENDER") else "") == "console"
    let termname = env.get("TERM") else ""
    let pol = policy_for(termname, env.get("COLORTERM") else "", console)
    // Bit 3: the outer terminal takes OSC 52 clipboard writes; never the console.
    let features = if console then 0 else 15
    let long = server.socket_path_problem(server.socket_path(server.runtime_dir()))
    if long.len > 0 {
        eprint("warren: the {long}")
        return 1
    }
    var p = dial_or_start(create) else |e| {
        if "{e}" == "not_found" || "{e}" == "refused" {
            eprint("warren: no server is running")
        } else {
            eprint("warren: cannot reach the server: {e}")
        }
        return 1
    }
    p.auto_ack = false
    var names = List[str]()
    var values = List[str]()
    env_lists(mut names, mut values)
    let cwd = env.cwd() else "/"
    var t = take_terminal(file, features) else |e| {
        hang_up(mut p)
        eprint("warren: cannot set up the terminal: {e}")
        return 1
    }
    ctrace("attached")
    let end = run(mut p, mut t, mut out, size.columns, size.rows, pol, features,
        hello_with(1, size.columns, size.rows, pol.depth, features, termname, target,
            if create then 1 else 0, cwd, names, values))
    ctrace("ended: {end.line}")
    // A terminal that went away is not written or set again: on some hosts
    // a gone terminal holds a drain forever.
    if !end.gone { give_back(mut t) }
    ctrace("gave back")
    hang_up(mut p)
    if end.line.len > 0 && !end.gone { eprint(end.line) }
    ctrace("exit {end.code}")
    end.code
}

fn run(mut p: Peer, mut t: Tty, mut out: fs.File, cols: int, rows: int, pol: Policy, features: int,
    hello: List[byte]) -> End {
    // A HELLO the codec refuses is the client's own refusal, never the
    // server's close: it is named, with the window it carried.
    let first = proto.encode(1, 0, hello)
    if first.code != 0 {
        ctrace("hello not sent: the codec refused it (code {first.code}) at {cols}x{rows}")
        return End { code: 1, line: "warren: the hello could not be sent: the codec refused a {cols}x{rows} window (code {first.code})",
            gone: false }
    }
    if !send_raw(p, first.bytes) {
        ctrace("hello not sent: the write failed")
        return End { code: 1, line: "warren: the server closed the connection before the hello", gone: false }
    }
    ctrace("hello sent at {cols}x{rows}")
    // A suspend is the client's to handle (it gives the terminal back
    // first): an inherited ignore of it would hide it from the wait.
    signal.reset(signal.suspend() | signal.reload()) else |_| {}
    signal.listen(LISTENED) else |e| { return End { code: 1, line: "warren: signals: {e}", gone: false } }
    var w = poll.open() else |e| { return End { code: 1, line: "warren: readiness set: {e}", gone: false } }
    let tty_key = poll.add_file(mut w, t.file, poll.READ) else |e| {
        return End { code: 1, line: "warren: readiness set: {e}", gone: false }
    }
    let sock_key = poll.add_socket(mut w, net.Socket { fd: p.fd }, poll.READ) else |e| {
        return End { code: 1, line: "warren: readiness set: {e}", gone: false }
    }
    var drawn = proto.image()
    var par = parser()
    var l = Loop { cols: cols, rows: rows, tty_key: tty_key, sock_key: sock_key, features: features, note: List[byte]() }
    // One turn at a time, each in a region of its own: what a turn builds
    // (the wait's answer, the messages read, the bytes drawn and sent, the
    // events typed) is freed when the turn ends. The peer, the terminal,
    // the image drawn, the parser and the loop's state outlive every turn
    // and are changed in place; the turn hands back only a number.
    var why = GOES_ON
    while why == GOES_ON {
        region turn {
            why = one_turn(mut p, mut t, mut out, mut w, mut drawn, mut par, mut l, pol)
        }
    }
    ended(why, p, l)
}

// How a turn ended the attach (GOES_ON: it did not). Each names an End
// that `ended` makes once the loop is over, outside every turn's region.
const GOES_ON: int = 0
const BY_SIGNAL: int = 1
const HANGUP_GONE: int = 2
const WAIT_FAILED: int = 3
const TERMINAL_CLOSED: int = 4
const SERVER_CLOSED: int = 5
const IMAGE_REFUSED: int = 6
const NOT_WRITTEN: int = 7
const SAID_BYE: int = 8
const SAID_REFUSE: int = 9
const CONNECTION_FAILED: int = 10

// What the attach loop keeps between turns besides the peer, the
// terminal, the image and the parser: the window last sent, the
// readiness keys, the features the client advertised, and why a wait
// failed (bytes, emptied and refilled).
struct Loop {
    cols: int,
    rows: int,
    tty_key: int,
    sock_key: int,
    features: int,
    note: List[byte],
}

fn keep_note(mut note: List[byte], t: str) {
    (mut note).reset()
    for b in t.bytes() { (mut note).push(b) }
}

// One turn: a wait, then what it reported. Called inside the turn's
// region; every long-lived value it is handed is changed in place.
fn one_turn(mut p: Peer, mut t: Tty, mut out: fs.File, mut w: poll.Waiter, mut drawn: proto.Image,
    mut par: Parser, mut l: Loop, pol: Policy) -> int {
    var wait = 0 - 1
    let d = deadline(par)
    if d >= 0 {
        wait = d - now_ms()
        if wait < 0 { wait = 0 }
    }
    let ev = poll.wait(mut w, LISTENED, wait) else |e| {
        keep_note(mut l.note, "{e}")
        return WAIT_FAILED
    }
    let m = ev.meaning
    if m & signal.reload() != 0 {
        // A hangup: the terminal may be gone; it is given back only if
        // it still answers.
        let alive = term.mode(t.file) else |_| term.Mode { canonical: false, echo: false, signals: false,
            flow: false, extended: false, raw_cr: false, raw_output: false, strip8: false, min: 0 - 1, time: 0 }
        return if alive.min < 0 then HANGUP_GONE else BY_SIGNAL
    }
    if m & (signal.terminate() | signal.quit() | signal.interrupt()) != 0 { return BY_SIGNAL }
    if m & signal.suspend() != 0 {
        give_back(mut t)
        // Stop as the suspend asked: its default action, raised again.
        signal.reset_one(signal.suspend()) else |_| {}
        signal.raise(signal.suspend()) else |_| {}
        signal.listen(LISTENED) else |_| {}
        take_again(mut t)
        // The screen is unknown again: the next image is drawn whole.
        drawn.valid = false
        let _r = send(p, 9, List[byte]())
    }
    if m & signal.continued() != 0 {
        take_again(mut t)
        drawn.valid = false
        let _r = send(p, 9, List[byte]())
    }
    if m & signal.resize() != 0 {
        // A dimension the window now reports as 0 keeps its last size; a
        // window the protocol cannot carry is not sent.
        let now = term.size(t.file) else |_| term.Size { rows: l.rows, columns: l.cols }
        let s = term.Size { rows: if now.rows > 0 then now.rows else l.rows,
            columns: if now.columns > 0 then now.columns else l.cols }
        if window_problem(s).len == 0 && (s.columns != l.cols || s.rows != l.rows) {
            l.cols = s.columns
            l.rows = s.rows
            var b = number(s.columns, 2)
            proto.put(mut b, s.rows, 2)
            let _r = send(p, 6, b)
        }
    }
    var in_file = copy t.file
    for r in ev.ready {
        if r.key == l.tty_key {
            let got = fs.read_chunk(mut in_file, 4096) else |_| { return TERMINAL_CLOSED }
            if got.len == 0 { return TERMINAL_CLOSED }
            for e in feed(mut par, got, now_ms()) {
                if !send_event(p, e) { return SERVER_CLOSED }
            }
        } else if r.key == l.sock_key {
            let pulled = pull(mut p)
            while true {
                let k = step(mut p, 0)
                if k == 0 { break }
                if k == 0 - 2 { return IMAGE_REFUSED }
                if k == 0 - 1 { return SERVER_CLOSED }
                if k == 131 {
                    let bytes = render(mut drawn, p.image, pol)
                    fs.write_chunk(mut out, bytes) else |_| { return NOT_WRITTEN }
                    let _a = send(p, 8, number(p.image.seq, 4))
                } else if k == 132 {
                    fs.write_chunk(mut out, "\u{7}".bytes()) else |_| {}
                } else if k == 133 && l.features & 8 != 0 {
                    fs.write_chunk(mut out, osc52(p.clipboard)) else |_| {}
                } else if k == 134 && !pol.explicit_wide {
                    fs.write_chunk(mut out, "\u{1b}]2;{sanitize(kept_text(p.title))}\u{7}".bytes()) else |_| {}
                } else if k == 135 {
                    return SAID_BYE
                } else if k == 130 {
                    return SAID_REFUSE
                }
            }
            if pulled == 1 { return SERVER_CLOSED }
            if pulled == 2 { return CONNECTION_FAILED }
        }
    }
    for e in expire(mut par, now_ms()) {
        if !send_event(p, e) { return SERVER_CLOSED }
    }
    GOES_ON
}

// The End a turn's code names, made after the loop.
fn ended(why: int, p: Peer, l: Loop) -> End {
    let named = kept_text(p.welcome_session)
    let session = if named.len > 0 then named else "the session"
    if why == SAID_BYE { return bye_end(p.end_code, kept_text(p.end_text), session) }
    if why == SAID_REFUSE { return End { code: 1, line: "warren: refused: {kept_text(p.end_text)}", gone: false } }
    if why == WAIT_FAILED { return End { code: 1, line: "warren: wait failed: {kept_text(l.note)}", gone: false } }
    if why == HANGUP_GONE { return End { code: 1, line: "warren: ended by a signal", gone: true } }
    if why == BY_SIGNAL { return End { code: 1, line: "warren: ended by a signal", gone: false } }
    if why == TERMINAL_CLOSED { return End { code: 1, line: "warren: the terminal closed", gone: true } }
    if why == IMAGE_REFUSED {
        return End { code: 1, line: "warren: the server sent an image that does not apply", gone: false }
    }
    if why == NOT_WRITTEN { return End { code: 1, line: "warren: the terminal cannot be written", gone: false } }
    if why == CONNECTION_FAILED { return End { code: 1, line: "warren: the connection failed", gone: false } }
    End { code: 1, line: "warren: the server closed the connection", gone: false }
}

/// A command's reply: its status (0 done, 1 refused, 2 usage, 3 no
/// server) and what it printed to each stream.
pub struct Reply {
    status: int,
    out: List[byte],
    err: List[byte],
}

fn no_reply(status: int, why: str) -> Reply {
    Reply { status: status, out: List[byte](), err: "warren: {why}\n".bytes() }
}

/// Run one command on the server and return its reply. `cols` and `rows`
/// are the size a session it creates starts at (both zero otherwise).
pub fn command_sized(argv: List[str], cols: int, rows: int, with_env: bool) -> Reply {
    let long = server.socket_path_problem(server.socket_path(server.runtime_dir()))
    if long.len > 0 { return no_reply(1, "the {long}") }
    var p = dial(server.socket_path(server.runtime_dir())) else |_| { return no_reply(3, "no server is running") }
    command_on(mut p, argv, cols, rows, with_env)
}

// One command on a connection already dialed; the connection is hung up.
fn command_on(mut p: Peer, argv: List[str], cols: int, rows: int, with_env: bool) -> Reply {
    var names = List[str]()
    var values = List[str]()
    if with_env { env_lists(mut names, mut values) }
    let cwd = env.cwd() else "/"
    let _h = send(p, 1, hello_with(2, cols, rows, 0, 0, env.get("TERM") else "", "", 0, cwd, names, values))
    var b = number(1, 4)
    proto.put(mut b, argv.len, 2)
    for a in argv { proto.put_text(mut b, a) }
    proto.put_text(mut b, cwd)
    // The pane this command runs in, when it runs in one: a verb with no
    // target acts there.
    proto.put_text(mut b, env.get("WARREN_PANE") else "")
    let _c = send(p, 11, b)
    let t0 = now_ms()
    while ms_since(t0) < 10000 {
        let m = next(mut p, 1000)
        if m.kind == 136 {
            let status = m.body[4] as int
            let out_len = le(m.body, 5, 4)
            let out = m.body[9..9 + out_len]
            let err_len = le(m.body, 9 + out_len, 4)
            let err = m.body[13 + out_len..13 + out_len + err_len]
            hang_up(mut p)
            return Reply { status: status, out: out, err: err }
        }
        if m.kind == 130 || m.kind == 135 || (m.kind == 0 && m.code != 0) {
            hang_up(mut p)
            return no_reply(1, "the server did not answer the command")
        }
    }
    hang_up(mut p)
    no_reply(1, "the server did not answer the command in 10 s")
}

/// `warren new [-d] [-s NAME]`: make a session (starting the server when
/// there is none) at this terminal's size (`window_size`: COLUMNS and LINES,
/// else 80x24, for a 0x0 window or none), in this
/// directory and environment; print its name, then attach to it unless
/// `detached`. A name already in use is refused.
pub fn new_session(name: str, detached: bool) -> int {
    let long = server.socket_path_problem(server.socket_path(server.runtime_dir()))
    if long.len > 0 {
        eprint("warren: the {long}")
        return 1
    }
    let read = term.size(fs.stdin()) else |_| {
        if !detached {
            eprint("warren: not a terminal: new needs one on standard input (or -d)")
            return 1
        }
        term.Size { rows: 0, columns: 0 }
    }
    // The session is made at the window the attach will send.
    let size = window_size(read)
    let large = window_problem(size)
    if large.len > 0 {
        eprint("warren: {large}")
        return 1
    }
    var p = dial_or_start(true) else |e| {
        eprint("warren: cannot reach or start the server: {e}")
        return 1
    }
    var argv = List[str]()
    (mut argv).push("new-session")
    if name.len > 0 { (mut argv).push(name) }
    let r = command_on(mut p, argv, size.columns, size.rows, true)
    var se = fs.stderr()
    fs.write_chunk(mut se, r.err) else |_| {}
    if r.status != 0 { return if r.status == 3 then 1 else r.status }
    let made = (str_from_utf8(r.out) else "").trim()
    if detached {
        io.write_line(made)
        return 0
    }
    attach(made, false)
}

/// Run one command on the server and return its reply, sending no size.
pub fn command_reply(argv: List[str]) -> Reply {
    command_sized(argv, 0, 0, false)
}

/// Run one command on the server (`warren <verb>`) and print its reply;
/// the exit code is the reply's status: 0 done, 1 refused, 2 usage, 3 no
/// server.
pub fn command(argv: List[str]) -> int {
    let r = command_reply(argv)
    var so = fs.stdout()
    var se = fs.stderr()
    fs.write_chunk(mut so, r.out) else |_| {}
    fs.write_chunk(mut se, r.err) else |_| {}
    r.status
}
