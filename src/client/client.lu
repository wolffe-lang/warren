//! member: true
//! The client: one attached terminal, its input parser and renderer. The
//! parser (`input.lu`) and the renderer (`render.lu`) are pure; the wire
//! (`wire.lu`), the terminal (`tty.lu`) and the attach loop (`attach.lu`)
//! are the host half.

/// The milestone that fills this module in.
pub fn milestone() -> str {
    "W2"
}

/// Whether the module is pure: no I/O, so it runs on every host and under
/// the reference interpreter. The client is not (its pure parts are rows
/// natively and on the checked machine, never alone under lupin).
pub fn pure() -> bool {
    false
}
