//! member: true
//! The client's side of the wire: dial, HELLO, read whole logical messages
//! (FRAME fragments reassembled), apply images and ACK them. Used by the
//! scripted rows now and by the terminal client.
use std.net
use std.net.unix
use std.poll
use std.time
use proto

/// A connection to the server, as a client holds it.
pub struct Peer {
    fd: int,
    rx: List[byte],
    rx_off: int,
    rx_len: int,
    image: proto.Image,
    frames: int,
    full_frames: int,
    last_base: int,
    title: str,
    bells: int,
    ended: bool,
    end_kind: int,
    end_code: int,
    end_text: str,
    welcome_session: str,
    auto_ack: bool,
    pongs: int,
}

/// One whole logical message: kind 0 means none arrived before the
/// deadline (code 0) or the connection ended (code 1) or a frame header
/// or payload was invalid (code 2).
pub struct Message {
    kind: int,
    body: List[byte],
    code: int,
}

/// What a dial can answer: the Unix family's rows, unchanged.
pub error DialErrors = {unsupported, refused, not_found, denied, io}

/// Dial a server's socket; io-like failures are named rows.
pub fn dial(path: str) -> Peer ! DialErrors {
    let s = unix.connect(path)?
    Peer { fd: s.fd, rx: List[byte](), rx_off: 0, rx_len: 0, image: proto.image(), frames: 0,
        full_frames: 0, last_base: 0, title: "", bells: 0, ended: false, end_kind: 0, end_code: 0,
        end_text: "", welcome_session: "", auto_ack: true, pongs: 0 }
}

/// Close the connection.
pub fn hang_up(mut p: Peer) {
    if p.fd >= 0 {
        var s = net.Socket { fd: p.fd }
        net.close(take s) else |_| {}
        p.fd = 0 - 1
    }
}

/// A HELLO payload. role 1 attach, 2 command.
pub fn hello_payload(role: int, cols: int, rows: int, target: str, options: int, cwd: str,
    names: List[str], values: List[str]) -> List[byte] {
    var b = List[byte]()
    proto.put(mut b, 87, 1)
    proto.put(mut b, 82, 1)
    proto.put(mut b, 78, 1)
    proto.put(mut b, 0, 1)
    proto.put(mut b, 1, 2)
    proto.put(mut b, 1, 2)
    proto.put(mut b, role, 1)
    proto.put(mut b, cols, 2)
    proto.put(mut b, rows, 2)
    proto.put(mut b, 3, 1)
    proto.put(mut b, 0, 4)
    proto.put_text(mut b, "xterm-256color")
    proto.put_text(mut b, target)
    proto.put(mut b, options, 1)
    proto.put_text(mut b, cwd)
    proto.put(mut b, names.len, 2)
    var i = 0
    while i < names.len {
        proto.put_text(mut b, names[i])
        proto.put_text(mut b, values[i])
        i = i + 1
    }
    b
}

/// Write bytes whole (the scripted client may block; the server may not).
pub fn send_raw(p: Peer, data: List[byte]) -> bool {
    var s = net.Socket { fd: p.fd }
    net.write_bytes(mut s, data) else { return false }
    true
}

/// Encode and write one unfragmented message.
pub fn send(p: Peer, kind: int, payload: List[byte]) -> bool {
    let r = proto.encode(kind, 0, payload)
    if r.code != 0 { return false }
    send_raw(p, r.bytes)
}

fn le(b: List[byte], at: int, width: int) -> int {
    var n: int = 0
    var f: int = 1
    var i = 0
    while i < width {
        n = n + (b[at + i] as int) * f
        f = f * 256
        i = i + 1
    }
    n
}

fn fill(mut p: Peer, wait_ms: int) -> int {
    var w = poll.open() else { return 2 }
    let k = poll.add_socket(mut w, net.Socket { fd: p.fd }, poll.READ) else { return 2 }
    let ev = poll.wait(mut w, 0, wait_ms) else { return 2 }
    poll.remove(mut w, k) else |_| {}
    poll.close(take w) else |_| {}
    if ev.ready.len == 0 { return 0 }
    var s = net.Socket { fd: p.fd }
    var ended = false
    let got = net.read_bytes(mut s, 65536) else |_| {
        ended = true
        List[byte]()
    }
    if ended { return 1 }
    if p.rx_off == p.rx_len {
        p.rx_off = 0
        p.rx_len = 0
        (mut p.rx).reset()
    }
    for b in got {
        (mut p.rx).push(b)
        p.rx_len = p.rx_len + 1
    }
    3
}

/// The next whole logical message, waiting at most deadline_ms in all.
pub fn next(mut p: Peer, deadline_ms: int) -> Message {
    let until = time.monotonic_ns() + deadline_ms * 1000000
    var chain = List[byte]()
    var chain_kind = 0
    while true {
        while p.rx_len - p.rx_off >= 6 {
            let n = le(p.rx, p.rx_off, 4)
            let kind = p.rx[p.rx_off + 4] as int
            let flags = p.rx[p.rx_off + 5] as int
            if n > proto.PHYSICAL_MAX || flags > 1 || !proto.known(kind) {
                return Message { kind: 0, body: List[byte](), code: 2 }
            }
            if p.rx_len - p.rx_off < 6 + n { break }
            let body = p.rx[p.rx_off + 6..p.rx_off + 6 + n]
            p.rx_off = p.rx_off + 6 + n
            if chain_kind != 0 && kind != chain_kind { return Message { kind: 0, body: List[byte](), code: 2 } }
            for x in body { (mut chain).push(x) }
            if flags == 1 {
                chain_kind = kind
                continue
            }
            if proto.validate(kind, chain) != 0 { return Message { kind: 0, body: List[byte](), code: 2 } }
            return Message { kind: kind, body: chain, code: 0 }
        }
        let left = (until - time.monotonic_ns()) / 1000000
        if left <= 0 { return Message { kind: 0, body: List[byte](), code: 0 } }
        let r = fill(mut p, left)
        if r == 1 { return Message { kind: 0, body: List[byte](), code: 1 } }
        if r == 2 { return Message { kind: 0, body: List[byte](), code: 2 } }
    }
    Message { kind: 0, body: List[byte](), code: 0 }
}

fn text_at(b: List[byte], at: int) -> str {
    let n = le(b, at, 2)
    str_from_utf8(b[at + 2..at + 2 + n]) else ""
}

/// Take one message and apply what a client applies: a FRAME to the image
/// (ACKed when auto_ack), a TITLE, a BELL, a BYE or REFUSE as the end.
/// Returns the message's kind, 0 when none, -1 when the connection ended,
/// -2 for an image that did not apply (the client must close).
pub fn step(mut p: Peer, deadline_ms: int) -> int {
    let m = next(mut p, deadline_ms)
    if m.kind == 0 {
        if m.code == 0 { return 0 }
        p.ended = true
        return 0 - 1
    }
    if m.kind == 131 {
        let base = le(m.body, 4, 4)
        if proto.apply(mut p.image, m.body) != 0 { return 0 - 2 }
        p.frames = p.frames + 1
        p.last_base = base
        if base == 0 { p.full_frames = p.full_frames + 1 }
        if p.auto_ack {
            var a = List[byte]()
            proto.put(mut a, p.image.seq, 4)
            let _ok = send(p, 8, a)
        }
    } else if m.kind == 134 {
        p.title = text_at(m.body, 0)
    } else if m.kind == 132 {
        p.bells = p.bells + 1
    } else if m.kind == 137 {
        p.pongs = p.pongs + 1
    } else if m.kind == 129 {
        p.welcome_session = text_at(m.body, 10)
    } else if m.kind == 130 || m.kind == 135 {
        p.end_kind = m.kind
        p.end_code = le(m.body, 0, 2)
        p.end_text = text_at(m.body, 2)
    }
    m.kind
}

/// Step until a row of the image contains text, or the deadline passes.
pub fn until_text(mut p: Peer, text: str, deadline_ms: int) -> bool {
    let until = time.monotonic_ns() + deadline_ms * 1000000
    while time.monotonic_ns() < until {
        var row = 1
        while row <= p.image.rows {
            if proto.row_text(p.image, row).contains(text) { return true }
            row = row + 1
        }
        let left = (until - time.monotonic_ns()) / 1000000
        if left <= 0 { return false }
        let k = step(mut p, left)
        if k < 0 { return false }
    }
    false
}

/// Step until a message of this kind arrives (applying the rest).
pub fn until_kind(mut p: Peer, kind: int, deadline_ms: int) -> bool {
    let until = time.monotonic_ns() + deadline_ms * 1000000
    while time.monotonic_ns() < until {
        let left = (until - time.monotonic_ns()) / 1000000
        if left <= 0 { return false }
        let k = step(mut p, left)
        if k == kind { return true }
        if k < 0 { return false }
    }
    false
}

/// INPUT bytes.
pub fn input(p: Peer, text: str) -> bool {
    var b = List[byte]()
    proto.put_bytes(mut b, text.bytes())
    send(p, 7, b)
}

/// A KEY event.
pub fn key(p: Peer, mods: int, kind: int, code: int) -> bool {
    var b = List[byte]()
    proto.put(mut b, mods, 1)
    proto.put(mut b, kind, 1)
    proto.put(mut b, code, 4)
    send(p, 2, b)
}

/// A RESIZE.
pub fn resize(p: Peer, cols: int, rows: int) -> bool {
    var b = List[byte]()
    proto.put(mut b, cols, 2)
    proto.put(mut b, rows, 2)
    send(p, 6, b)
}

/// The image's whole text, rows joined by newlines (for diagnostics).
pub fn screen_text(p: Peer) -> str {
    var out = ""
    var row = 1
    while row <= p.image.rows {
        out = out + proto.row_text(p.image, row) + "\n"
        row = row + 1
    }
    out
}
