//! member: false
//! Pane rows: a scripted client drives a real server's panes and tabs over
//! its socket, through key events (the prefix, Ctrl-Space, then a key; the
//! modes behind it; the prompts and the key list).
//! Each row starts its own server in its own runtime directory with a
//! lifetime bound and ends it with kill-server; a row's pane programs are
//! /bin/sh (or /bin/cat) and this program's own helper modes.
//!
//!   pane_rows WARREN [ROW...]
//!
//! Prints `PASS <row>` or `FAIL <row> <why>` per row (and `MEASURE` lines),
//! then `PANE-ROWS rows=N failed=M`; exits 1 when any row is red.
//!
//! The helper modes, run inside panes:
//!   --print-size TAG    prints `TAG ROWS COLS`, its terminal's size
//!   --winch FILE TAG    appends `TAG start ROWS COLS`, then `TAG winch ROWS COLS`
//!                       at every window change, until its terminal hangs up
//!   --hup FILE          appends `ready PID`, then `hangup PID` when its
//!                       terminal hangs up, and exits
//!   --read-bytes FILE N appends `ready`, reads N bytes from its terminal in
//!                       raw mode, appends `bytes HEX...`, and exits
//!   --mouse-probe FILE ENCODING  logs raw input bytes until its terminal
//!                       hangs up; ENCODING is 0 off, 1 SGR, 2 legacy
//! No row sends a signal: a helper reports what reached it.
use std.env
use std.fs
use std.net
use std.net.unix
use std.process
use std.signal
use std.sort
use std.term
use std.time
use client
use proto
use server

struct Rig {
    warren: str,
    dir: str,
    server: int,
    started: bool,
}

/// The tab area of an 80x24 client: two bar lines below it.
const AREA: int = 22
/// Wire colours as images carry them.
const GREEN: int = 16777218
const INVERSE: int = 64
/// The bar's mode field: inverse and bold, nine columns at the right end.
const FIELD: int = 65
/// Idle hints, and the prefix table revealed after Ctrl-Space.
const NORMAL_HINTS: str = " C-Space prefix"
const PREFIX_HINTS: str = " C-Space prefix  M-\\ M-| |- split  M-t c new tab  M-w x close  ? keys  +15"
const PANE_HINTS: str = " |- split  hjkl focus  x close  z zoom  o next pane  = equalize  Esc back"

fn now_ms() -> int {
    time.monotonic_ns() / 1000000
}

fn rig(warren: str, row: str) -> Rig {
    Rig { warren: warren, dir: "rt-" + row, server: 0 - 1, started: false }
}

fn socket(r: Rig) -> str {
    r.dir + "/default"
}

fn here() -> str {
    env.cwd() else "."
}

fn self_path() -> str {
    let a0 = env.arg0()
    if a0.starts_with("/") { return a0 }
    here() + "/" + a0
}

/// A file beside the row's runtime directory, by its absolute path.
fn out_file(r: Rig, name: str) -> str {
    here() + "/" + r.dir + "-" + name
}

fn start_with(mut r: Rig, pane_command: str, lifetime_ms: int) -> str {
    fs.remove_dir_all(r.dir) else |_| {}
    env.set("WARREN_RUNTIME_DIR", r.dir) else { return "env" }
    env.set("WARREN_LIFETIME_MS", "{lifetime_ms}") else { return "env" }
    env.set("WARREN_PANE_COMMAND", pane_command) else { return "env" }
    var c = process.command(r.warren)
    process.push_arg(mut c, "server")
    let ch = process.start(c) else |e| { return "server-start-{e}" }
    r.server = ch.slot
    r.started = true
    let until = now_ms() + 5000
    while now_ms() < until {
        var s = unix.connect(socket(r)) else |_| {
            time.sleep(time.millis(10))
            continue
        }
        net.close(take s) else |_| {}
        return ""
    }
    "server-never-answered"
}

fn start_server(mut r: Rig, pane_command: str) -> str {
    start_with(mut r, pane_command, 120000)
}

fn stop_server(mut r: Rig) -> int {
    if !r.started { return 0 - 1 }
    var p = client.dial(socket(r)) else |_| {
        var ch = process.Child { slot: r.server }
        r.started = false
        return process.wait_status(take ch) else 0 - 1
    }
    var argv = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", argv, argv))
    let _w = client.until_kind(mut p, 129, 2000)
    var b = List[byte]()
    proto.put(mut b, 1, 4)
    proto.put(mut b, 1, 2)
    proto.put_text(mut b, "kill-server")
    proto.put_text(mut b, "")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    let _r = client.until_kind(mut p, 136, 2000)
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    process.wait_status(take ch) else 0 - 1
}

fn server_pid(r: Rig) -> int {
    process.pid(process.Child { slot: r.server }) else 0 - 1
}

fn env_names() -> List[str] {
    var n = List[str]()
    (mut n).push("PS1")
    (mut n).push("PATH")
    (mut n).push("HOME")
    (mut n).push("SHELL")
    n
}

fn env_values() -> List[str] {
    var v = List[str]()
    (mut v).push("$ ")
    (mut v).push(env.get("PATH") else "/bin:/usr/bin")
    (mut v).push(env.get("HOME") else "/")
    (mut v).push("/bin/sh")
    v
}

fn attach(r: Rig, cols: int, rows: int, target: str, options: int) -> client.Peer ! client.DialErrors {
    var p = client.dial(socket(r))?
    let _h = client.send(p, 1, client.hello_payload(1, cols, rows, target, options, here(), env_names(), env_values()))
    p
}

/// The prefix (Ctrl-Space) then a key: a scalar, or a named key (kind 1).
fn prefix(p: client.Peer, code: int) -> bool {
    client.key(p, 4, 0, 32) && client.key(p, 0, 0, code)
}

fn prefix_named(p: client.Peer, code: int) -> bool {
    client.key(p, 4, 0, 32) && client.key(p, 0, 1, code)
}

fn push_utf8(mut out: List[byte], cp: int) {
    if cp < 128 {
        (mut out).push(cp as byte)
    } else if cp < 2048 {
        (mut out).push((192 + cp / 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else if cp < 65536 {
        (mut out).push((224 + cp / 4096) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else {
        (mut out).push((240 + cp / 262144) as byte)
        (mut out).push((128 + cp / 4096 % 64) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    }
}

/// The text of cells `col .. col+cols-1` of one row, trailing blanks trimmed.
fn cells(img: proto.Image, row: int, col: int, cols: int) -> str {
    if !img.valid || row < 1 || row > img.rows { return "" }
    var out = List[byte]()
    var c = col
    while c < col + cols && c <= img.cols {
        let i = (row - 1) * img.cols + c - 1
        if img.width[i] != 0 { push_utf8(mut out, if img.base[i] == 0 then 32 else img.base[i]) }
        c += 1
    }
    var end = out.len
    while end > 0 && out[end - 1] == 32 as byte { end -= 1 }
    str_from_utf8(out[0..end]) else ""
}

/// Whether a rect of the image holds the text on one of its rows.
fn rect_has(img: proto.Image, text: str, col: int, row: int, cols: int, rows: int) -> bool {
    var r = row
    while r < row + rows {
        if cells(img, r, col, cols).contains(text) { return true }
        r += 1
    }
    false
}

/// Step until the rect holds the text, or the deadline.
fn until_rect(mut p: client.Peer, text: str, col: int, row: int, cols: int, rows: int, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if rect_has(p.image, text, col, row, cols, rows) { return true }
        let k = client.step(mut p, until - now_ms())
        if k < 0 { return false }
    }
    rect_has(p.image, text, col, row, cols, rows)
}

/// Step until some row of the rect reads exactly the text.
fn until_rect_line(mut p: client.Peer, text: str, col: int, row: int, cols: int, rows: int, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        var r = row
        while r < row + rows {
            if cells(p.image, r, col, cols) == text { return true }
            r += 1
        }
        let k = client.step(mut p, until - now_ms())
        if k < 0 { return false }
    }
    false
}

/// Take messages until none comes for `quiet_ms`.
fn drain(mut p: client.Peer, quiet_ms: int) {
    var n = 0
    while n < 1000 {
        let k = client.step(mut p, quiet_ms)
        if k <= 0 { return }
        n += 1
    }
}

fn file_has(path: str, text: str) -> bool {
    let t = fs.read_text(path) else { return false }
    t.contains(text)
}

fn until_file(path: str, text: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if file_has(path, text) { return true }
        time.sleep(time.millis(10))
    }
    file_has(path, text)
}

/// The number after `word ` on a line of the file, -1 if none.
fn number_after(path: str, word: str) -> int {
    let t = fs.read_text(path) else { return 0 - 1 }
    for line in t.lines() {
        let w = line.words()
        if w.len >= 2 && w[0] == word { return w[1].to_int() else 0 - 1 }
    }
    0 - 1
}

/// Whether the lines of a file hold `want` in order (others between).
fn in_order(path: str, want: List[str]) -> bool {
    let t = fs.read_text(path) else { return false }
    var k = 0
    for line in t.lines() {
        if k < want.len && line.trim() == want[k] { k += 1 }
    }
    k == want.len
}

fn until_in_order(path: str, want: List[str], ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if in_order(path, want) { return true }
        time.sleep(time.millis(10))
    }
    in_order(path, want)
}

/// The next FRAME's payload, applied to the image and ACKed; empty when
/// none came before the deadline. Other messages are applied on the way.
fn next_image(mut p: client.Peer, ms: int) -> List[byte] {
    let until = now_ms() + ms
    while now_ms() < until {
        let m = client.next(mut p, until - now_ms())
        if m.kind == 0 { return List[byte]() }
        if m.kind == 131 {
            if proto.apply(mut p.image, m.body) != 0 { return List[byte]() }
            p.frames += 1
            var a = List[byte]()
            proto.put(mut a, p.image.seq, 4)
            let _ok = client.send(p, 8, a)
            return m.body
        }
        if m.kind == 135 || m.kind == 130 {
            p.ended = true
            return List[byte]()
        }
    }
    List[byte]()
}

fn le(b: List[byte], at: int, width: int) -> int {
    var n: int = 0
    var f: int = 1
    var i = 0
    while i < width {
        n = n + (b[at + i] as int) * f
        f = f * 256
        i += 1
    }
    n
}

/// A FRAME payload's runs as (row, col, columns) triples.
fn runs_of(body: List[byte]) -> List[int] {
    var out = List[int]()
    let count = le(body, 18, 4)
    var at = 22
    var k = 0
    while k < count && at + 18 <= body.len {
        (mut out).push(le(body, at, 2))
        (mut out).push(le(body, at + 2, 2))
        (mut out).push(le(body, at + 14, 2))
        let records = le(body, at + 16, 2)
        at += 18
        var j = 0
        while j < records {
            let n = le(body, at + 3, 1)
            at += 4 + 4 * n
            j += 1
        }
        k += 1
    }
    out
}

fn proc_gone(pid: int) -> bool {
    !fs.exists("/proc/{pid}")
}

fn has_proc() -> bool {
    fs.exists("/proc/self/status")
}

fn rss_kb(pid: int) -> int {
    let text = fs.read_text("/proc/{pid}/status") else { return 0 - 1 }
    for line in text.lines() {
        if line.starts_with("VmRSS:") {
            let parts = line.words()
            if parts.len >= 2 { return parts[1].to_int() else 0 - 1 }
        }
    }
    0 - 1
}

/// The server's children, where the host lists them (Linux), else -1.
fn children_of(pid: int) -> int {
    let t = fs.read_text("/proc/{pid}/task/{pid}/children") else { return 0 - 1 }
    t.words().len
}

/// Open a session at cols x rows with a prompt drawn.
fn session(r: Rig, cols: int, rows: int, target: str) -> client.Peer ! client.DialErrors {
    var p = attach(r, cols, rows, target, 1)?
    let _w = client.until_text(mut p, "$", 5000)
    p
}

// ---------------- rows ----------------

// 80x24: a left-right split gives 39 and 40 columns of 22 rows (LAYOUT.md;
// tmux gives 40 and 39); the right pane split top-bottom gives 10 and 11.
fn row_split_sizes(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let me = self_path()
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new right pane:\n" + client.screen_text(p) }
    let _a = client.input(p, "{me} --print-size R\r")
    if !until_rect(mut p, "R 22 40", 41, 1, 40, AREA, 5000) { return "right pane:\n" + client.screen_text(p) }
    let _h = prefix(p, 104)
    let _b = client.input(p, "{me} --print-size L\r")
    if !until_rect(mut p, "L 22 39", 1, 1, 39, AREA, 5000) { return "left pane:\n" + client.screen_text(p) }
    let _l = prefix(p, 108)
    let _d = prefix(p, 45)
    if !until_rect_line(mut p, "$", 41, 12, 40, 11, 5000) { return "no prompt in the new bottom pane:\n" + client.screen_text(p) }
    let _c = client.input(p, "{me} --print-size B\r")
    if !until_rect(mut p, "B 11 40", 41, 12, 40, 11, 5000) { return "bottom right pane:\n" + client.screen_text(p) }
    let _k = prefix(p, 107)
    let _e = client.input(p, "clear; {me} --print-size T\r")
    if !until_rect(mut p, "T 10 40", 41, 1, 40, 10, 5000) { return "top right pane:\n" + client.screen_text(p) }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_keys_reach_focused(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane:\n" + client.screen_text(p) }
    let _a = client.input(p, "echo A-$((40+2))\r")
    if !until_rect(mut p, "A-42", 41, 1, 40, AREA, 5000) { return "typed into the new pane, not shown there:\n" + client.screen_text(p) }
    if rect_has(p.image, "A-", 1, 1, 39, AREA) { return "the new pane's keys reached the left pane:\n" + client.screen_text(p) }
    let _h = prefix(p, 104)
    let _b = client.input(p, "echo B-$((40+3))\r")
    if !until_rect(mut p, "B-43", 1, 1, 39, AREA, 5000) { return "typed after focus left, not shown there:\n" + client.screen_text(p) }
    if rect_has(p.image, "B-", 41, 1, 40, AREA) { return "the left pane's keys reached the right pane:\n" + client.screen_text(p) }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// The helper is the pane's program (exec): it reports every window change
// it hears, with the size it then reads.
fn row_sigwinch(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "winch.txt")
    fs.remove(f) else |_| {}
    let _x = client.input(p, "exec {self_path()} --winch {f} w\r")
    if !until_file(f, "w start 22 80", 5000) { return "the helper did not start at 22 80:\n" + client.screen_text(p) }
    var want = List[str]()
    (mut want).push("w start 22 80")
    // A split: the helper's pane keeps the left 39 columns.
    let _s = prefix(p, 124)
    (mut want).push("w winch 22 39")
    if !until_in_order(f, want, 5000) { return "after the split: " + (fs.read_text(f) else "") }
    // Back to it, then its right border moves two columns right.
    let _h = prefix(p, 104)
    let _l = prefix(p, 76)
    (mut want).push("w winch 22 41")
    if !until_in_order(f, want, 5000) { return "after the border moved: " + (fs.read_text(f) else "") }
    let _z = prefix(p, 122)
    (mut want).push("w winch 22 80")
    if !until_in_order(f, want, 5000) { return "after zoom: " + (fs.read_text(f) else "") }
    let _u = prefix(p, 122)
    (mut want).push("w winch 22 41")
    if !until_in_order(f, want, 5000) { return "after unzoom: " + (fs.read_text(f) else "") }
    // The client's terminal grows: share 5190 of 99 columns is 51.
    let _r = client.resize(p, 100, 30)
    (mut want).push("w winch 28 51")
    if !until_in_order(f, want, 5000) { return "after the client resized: " + (fs.read_text(f) else "") }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// Closing a pane closes its terminal: its program hears the hangup, ends,
// and is reaped; the sibling takes the whole area.
fn row_close_hangs_up(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "hup.txt")
    fs.remove(f) else |_| {}
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane:\n" + client.screen_text(p) }
    let _x = client.input(p, "exec {self_path()} --hup {f}\r")
    if !until_file(f, "ready", 5000) { return "the helper did not start:\n" + client.screen_text(p) }
    let pid = number_after(f, "ready")
    if !until_rect(mut p, "hup-waiting", 41, 1, 40, AREA, 5000) { return "the helper is not drawn:\n" + client.screen_text(p) }
    let t0 = now_ms()
    let _c = prefix(p, 120)
    let _y = client.key(p, 0, 0, 121)
    if !until_file(f, "hangup {pid}", 5000) { return "the closed pane's program heard no hangup in 5 s: " + (fs.read_text(f) else "") }
    print("MEASURE close-hangup-ms={now_ms() - t0}")
    if has_proc() {
        let until = now_ms() + 3000
        while now_ms() < until && !proc_gone(pid) { time.sleep(time.millis(20)) }
        if !proc_gone(pid) { return "the closed pane's program {pid} was not reaped" }
    }
    let _a = client.input(p, "{self_path()} --print-size C\r")
    if !until_text(mut p, "C 22 80", 5000) { return "the survivor did not take the area:\n" + client.screen_text(p) }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn until_text(mut p: client.Peer, text: str, ms: int) -> bool {
    client.until_text(mut p, text, ms)
}

fn row_exit_closes_pane(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane:\n" + client.screen_text(p) }
    let _x = client.input(p, "exit\r")
    let until = now_ms() + 5000
    while border_cells(p.image) != 0 && now_ms() < until { let _k = client.step(mut p, 100) }
    if border_cells(p.image) != 0 { return "the exited pane's border is still drawn:\n" + client.screen_text(p) }
    let _a = client.input(p, "{self_path()} --print-size E\r")
    if !until_text(mut p, "E 22 80", 5000) { return "the remaining pane did not take the area:\n" + client.screen_text(p) }
    let _e = client.input(p, "exit\r")
    if !client.until_kind(mut p, 135, 5000) || p.end_code != 2 { return "the last pane's exit: BYE {p.end_code}, expected session-ended" }
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    let st = process.wait_status(take ch) else 0 - 1
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_tabs(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "t") else |e| { return "dial-{e}" }
    let _a = client.input(p, "echo T1-$((0+1))\r")
    if !until_text(mut p, "T1-1", 5000) { return "no echo in tab 1" }
    let _c = prefix(p, 99)
    if !until_rect(mut p, "1  2", 1, 23, 80, 1, 5000) { return "the bar does not list two tabs: '" + cells(p.image, 23, 1, 80) + "'" }
    if !until_rect_line(mut p, "$", 1, 1, 80, 1, 5000) { return "no prompt on tab 2's first row:\n" + client.screen_text(p) }
    if rect_has(p.image, "T1-1", 1, 1, 80, AREA) { return "tab 1's pane is still drawn in tab 2" }
    let _b = client.input(p, "sleep 1; echo LATE-$((5+5))\r")
    time.sleep(time.millis(200))
    let _p = prefix(p, 112)
    if !until_text(mut p, "T1-1", 5000) { return "tab 1 not shown after p" }
    time.sleep(time.millis(1500))
    if rect_has(p.image, "LATE-10", 1, 1, 80, AREA) { return "tab 2's output was drawn over tab 1" }
    let _two = prefix(p, 50)
    if !until_text(mut p, "LATE-10", 5000) { return "tab 2's output while hidden is not there:\n" + client.screen_text(p) }
    let _n = prefix(p, 110)
    if !until_text(mut p, "T1-1", 5000) { return "n did not wrap to tab 1" }
    let _d = client.input(p, "echo T1-$((1+1))\r")
    if !until_text(mut p, "T1-2", 5000) { return "keys did not reach tab 1's pane" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// A client resize reaches the pane of a tab that is not shown.
fn row_resize_all_tabs(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "winch.txt")
    fs.remove(f) else |_| {}
    let _c = prefix(p, 99)
    if !client.until_line(mut p, "$", 5000) { return "no prompt in tab 2" }
    let _x = client.input(p, "exec {self_path()} --winch {f} t2\r")
    if !until_file(f, "t2 start 22 80", 5000) { return "the helper did not start" }
    let _p = prefix(p, 112)
    time.sleep(time.millis(200))
    let _r = client.resize(p, 100, 30)
    if !until_file(f, "t2 winch 28 100", 5000) { return "the hidden tab's pane was not resized: " + (fs.read_text(f) else "") }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

/// Border glyphs (the box-drawing block) in the image's tab area.
fn border_cells(img: proto.Image) -> int {
    var n = 0
    var row = 1
    while row <= img.rows - 2 {
        var c = 1
        while c <= img.cols {
            let b = img.base[(row - 1) * img.cols + c - 1]
            if b >= 9472 && b <= 9599 { n += 1 }
            c += 1
        }
        row += 1
    }
    n
}

fn row_zoom(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let me = self_path()
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane" }
    let _z = prefix(p, 122)
    let _a = client.input(p, "clear; {me} --print-size Z\r")
    if !until_text(mut p, "Z 22 80", 5000) { return "zoomed:\n" + client.screen_text(p) }
    if border_cells(p.image) != 0 { return "borders drawn while zoomed:\n" + client.screen_text(p) }
    let _u = prefix(p, 122)
    let _b = client.input(p, "clear; {me} --print-size U\r")
    if !until_rect(mut p, "U 22 40", 41, 1, 40, AREA, 5000) { return "unzoomed:\n" + client.screen_text(p) }
    if border_cells(p.image) != AREA { return "{border_cells(p.image)} border cells after unzoom, expected {AREA}" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// At 20x6 (a tab area of 20x4) a split that would leave a pane under its
// minimum is refused by name, and nothing is started.
fn row_too_small(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 20, 6, "") else |e| { return "dial-{e}" }
    let pid = server_pid(r)
    let _d = prefix(p, 45)
    if !until_rect(mut p, "$", 1, 3, 20, 2, 5000) { return "no prompt in the bottom pane:\n" + client.screen_text(p) }
    let before = children_of(pid)
    let _e = prefix(p, 45)
    if !until_rect(mut p, "too small", 1, 6, 20, 1, 3000) { return "no refusal on the hint line: '" + cells(p.image, 6, 1, 20) + "'" }
    let after = children_of(pid)
    if before >= 0 && after != before { return "a program was started for a refused split ({before} -> {after})" }
    if border_cells(p.image) != 20 { return "the layout changed: {border_cells(p.image)} border cells" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// The memory budget, lowered below a second pane: the split is refused by
// name, nothing starts, and the pane goes on.
fn row_pane_memory(mut r: Rig) -> str {
    let one = server.pane_bytes(80, 22) + server.attached_bytes(80, 24) + server.connection_bytes()
    env.set("WARREN_MEMORY_BUDGET", "{one}") else { return "env" }
    let why = start_server(mut r, "/bin/sh")
    env.set("WARREN_MEMORY_BUDGET", "0") else { return "env" }
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_rect(mut p, "refused", 1, 24, 80, 1, 3000) { return "no refusal on the hint line: '" + cells(p.image, 24, 1, 80) + "'" }
    if border_cells(p.image) != 0 { return "a split was drawn past the budget" }
    let _a = client.input(p, "echo still-$((40+2))\r")
    if !until_text(mut p, "still-42", 5000) { return "the pane stopped answering" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// 32 panes a session (tabs here): the 33rd is refused by name.
fn row_pane_limit(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    var n = 1
    while n < 32 {
        let _c = prefix(p, 99)
        n += 1
        let label = " {n} "
        if !until_rect(mut p, "{n}", 1, 23, 80, 1, 5000) { return "tab {n} not listed: '" + cells(p.image, 23, 1, 80) + "' ({label})" }
    }
    let _c = prefix(p, 99)
    if !until_rect(mut p, "32 panes", 1, 24, 80, 1, 3000) { return "the 33rd pane was not refused by name: '" + cells(p.image, 24, 1, 80) + "'" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

/// "" when the image's cell holds the scalar, flags and foreground.
fn cell_is(img: proto.Image, col: int, row: int, base: int, flags: int, fg: int) -> str {
    let i = (row - 1) * img.cols + col - 1
    if img.base[i] != base || img.flags[i] != flags || img.fg[i] != fg || img.bg[i] != 0 || img.width[i] != 1 {
        return "cell {col},{row}: U+{img.base[i]} flags {img.flags[i]} fg {img.fg[i]} bg {img.bg[i]} width {img.width[i]}; expected U+{base} flags {flags} fg {fg}"
    }
    ""
}

// Three panes at 80x24 (left; right top and bottom), cat in each: the
// border column 40 with its junction at row 11, the right column's border
// along row 11, the focus ring in colour 2, the bar's two lines, blanks in
// every pane. `focus` is 1 for the left pane, 3 for the bottom right.
fn golden_three(img: proto.Image, focus: int, name: str) -> str {
    if !img.valid || img.cols != 80 || img.rows != 24 { return "image {img.cols}x{img.rows}" }
    var row = 1
    while row <= AREA {
        let glyph = if row == 11 then 9500 else 9474
        let lit = focus == 1 || row >= 11
        let w = cell_is(img, 40, row, glyph, 0, if lit then GREEN else 0)
        if w.len > 0 { return w }
        row += 1
    }
    var c = 41
    while c <= 80 {
        let w = cell_is(img, c, 11, 9472, 0, if focus == 3 then GREEN else 0)
        if w.len > 0 { return w }
        c += 1
    }
    row = 1
    while row <= AREA {
        c = 1
        while c <= 80 {
            if c != 40 && !(row == 11 && c > 40) {
                let w = cell_is(img, c, row, 32, 0, 0)
                if w.len > 0 { return "pane " + w }
            }
            c += 1
        }
        row += 1
    }
    // Line one: " NAME " and " 1 ", both inverse (the one tab is active),
    // blanks, the mode field " NORMAL  " at columns 65-73, the clock.
    let bar = " {name}  1 "
    var k = 0
    for b in bar.bytes() {
        let w = cell_is(img, k + 1, 23, b as int, INVERSE, 0)
        if w.len > 0 { return "bar " + w }
        k += 1
    }
    c = k + 1
    while c <= 64 {
        let w = cell_is(img, c, 23, 32, 0, 0)
        if w.len > 0 { return "bar " + w }
        c += 1
    }
    k = 65
    for b in " NORMAL  ".bytes() {
        let w = cell_is(img, k, 23, b as int, FIELD, 0)
        if w.len > 0 { return "mode field " + w }
        k += 1
    }
    let cw = clock_cells_are(img)
    if cw.len > 0 { return "clock " + cw }
    let hw = hint_cells_are(img, 24, NORMAL_HINTS, [2, 8])
    if hw.len > 0 { return "hint line " + hw }
    let at_col = if focus == 1 then 1 else 41
    let at_row = if focus == 1 then 1 else 12
    if img.cursor_col != at_col || img.cursor_row != at_row { return "cursor {img.cursor_col},{img.cursor_row}, expected {at_col},{at_row}" }
    ""
}

/// "" when a row reads the text from column 1, blanks after it, with the
/// cells of the (first, last) column pairs in `keys` inverse and the rest
/// plain.
fn hint_cells_are(img: proto.Image, row: int, text: str, keys: List[int]) -> str {
    var col = 1
    let bytes = text.bytes()
    while col <= img.cols {
        let base = if col <= bytes.len then bytes[col - 1] as int else 32
        var flags = 0
        var q = 0
        while q + 1 < keys.len {
            if col >= keys[q] && col <= keys[q + 1] { flags = INVERSE }
            q += 2
        }
        let w = cell_is(img, col, row, base, flags, 0)
        if w.len > 0 { return w }
        col += 1
    }
    ""
}

// Two panes side by side: one border; the half of it beside the focused
// pane is marked (rows 1-11 for the left, 12-22 for the right).
fn golden_two(img: proto.Image, left: bool) -> str {
    if !img.valid || img.cols != 80 { return "image {img.cols}x{img.rows}" }
    var row = 1
    while row <= AREA {
        let lit = if left then row <= 11 else row >= 12
        let w = cell_is(img, 40, row, 9474, 0, if lit then GREEN else 0)
        if w.len > 0 { return w }
        row += 1
    }
    ""
}

fn until_golden_three(mut p: client.Peer, focus: int, name: str, ms: int) -> str {
    let until = now_ms() + ms
    var w = golden_three(p.image, focus, name)
    while w.len > 0 && now_ms() < until {
        let k = client.step(mut p, 100)
        if k < 0 { return "connection ended: " + w }
        w = golden_three(p.image, focus, name)
    }
    w
}

fn until_golden_two(mut p: client.Peer, left: bool, ms: int) -> str {
    let until = now_ms() + ms
    var w = golden_two(p.image, left)
    while w.len > 0 && now_ms() < until {
        let k = client.step(mut p, 100)
        if k < 0 { return "connection ended: " + w }
        w = golden_two(p.image, left)
    }
    w
}

fn row_frame_golden(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "g", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    let _s = prefix(p, 124)
    var w = until_golden_two(mut p, false, 3000)
    if w.len > 0 { return "two panes, the right focused: " + w }
    let _h = prefix(p, 104)
    w = until_golden_two(mut p, true, 3000)
    if w.len > 0 { return "two panes, the left focused: " + w }
    let _l = prefix(p, 108)
    let _d = prefix(p, 45)
    let _b = prefix(p, 104)
    w = until_golden_three(mut p, 1, "g", 3000)
    if w.len > 0 { return "three panes, the left focused: " + w }
    let _r = prefix(p, 108)
    w = until_golden_three(mut p, 3, "g", 3000)
    if w.len > 0 { return "three panes, the bottom right focused: " + w }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// A keystroke's image holds only the focused pane's cells.
fn row_damage_in_rect(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane" }
    drain(mut p, 300)
    p.auto_ack = false
    var n = 0
    while n < 5 {
        let _k = client.key(p, 0, 0, 113)
        let body = next_image(mut p, 3000)
        if body.len == 0 { return "no image for keystroke {n}" }
        let rs = runs_of(body)
        var k = 0
        while k < rs.len {
            let row = rs[k]
            let col = rs[k + 1]
            let width = rs[k + 2]
            if row < 1 || row > AREA || col < 41 || col + width - 1 > 80 {
                return "keystroke {n}: a run at {col},{row} x{width} outside the focused pane (41,1 40x22)"
            }
            k += 3
        }
        if rs.len == 0 { return "keystroke {n}: an image without the echo" }
        n += 1
    }
    p.auto_ack = true
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// Diagnostic capture happens after applying each image, against a saved
// pre-image. Raw frames and per-run byte/unchanged counts are printed only
// after the focus measurements, so output does not pace the server.
fn capture_focus(mut out: List[str], before: proto.Image, after: proto.Image, body: List[byte], label: str) {
    let verbose = (env.get("WARREN_FOCUS_CAPTURE") else "") == "1"
    if verbose {
        let wire = proto.encode(131, 0, body)
        assert(wire.code == 0, "focus capture frame")
        var hex = "WIRE {label} seq={after.seq} "
        let digits = "0123456789abcdef"
        for b in wire.bytes {
            let n = b as int
            hex = hex + digits[n / 16..n / 16 + 1] + digits[n % 16..n % 16 + 1]
        }
        (mut out).push(hex)
        (mut out).push("CURSOR {label} seq={after.seq} {before.cursor_row},{before.cursor_col},{before.shape},{before.visible}->{after.cursor_row},{after.cursor_col},{after.shape},{after.visible} fixed-wire=28")
    }
    var at = 22
    var k = 0
    let count = le(body, 18, 4)
    while k < count {
        let start = at
        let row = le(body, at, 2)
        let col = le(body, at + 2, 2)
        let columns = le(body, at + 14, 2)
        let records = le(body, at + 16, 2)
        at += 18
        var j = 0
        while j < records { at += 4 + 4 * le(body, at + 3, 1); j += 1 }
        var unchanged = 0
        var c = col
        while c < col + columns {
            let i = (row - 1) * after.cols + c - 1
            if before.base[i] == after.base[i] && before.mark1[i] == after.mark1[i] &&
                before.mark2[i] == after.mark2[i] && before.width[i] == after.width[i] &&
                before.flags[i] == after.flags[i] && before.fg[i] == after.fg[i] && before.bg[i] == after.bg[i] { unchanged += 1 }
            c += 1
        }
        // These fixtures are ASCII: no unchanged wide-pair companion is
        // needed. A needless repaint is red even if it fits the byte bound.
        assert(unchanged == 0, "focus delta repaints unchanged cells")
        if verbose {
            let part = if row == after.rows then "hints" else if row == after.rows - 1 then "bar" else "pane-border"
            (mut out).push("RUN {label} seq={after.seq} part={part} row={row} col={col} columns={columns} wire={at - start} unchanged={unchanged}")
        }
        k += 1
    }
    assert(at == body.len, "focus capture consumes payload")
}

fn focus_before(p: client.Peer) -> proto.Image { copy p.image }

// One small socket write carries both complete KEY messages. The separate
// schedule below deliberately waits for the prefix image before its action.
fn coalesced_focus_prefix(p: client.Peer, code: int) -> bool {
    var batch = List[byte]()
    for mods in [4, 0] {
        var key = List[byte]()
        proto.put(mut key, mods, 1)
        proto.put(mut key, 0, 1)
        proto.put(mut key, if mods == 4 then 32 else code, 4)
        let frame = proto.encode(2, 0, key)
        if frame.code != 0 { return false }
        for b in frame.bytes { (mut batch).push(b) }
    }
    client.send_raw(p, batch)
}

fn bytes_until_focus_mode(mut p: client.Peer, want: str, ms: int, mut captured: List[str], label: str) -> int {
    let until = now_ms() + ms
    var total = 0
    while now_ms() < until {
        let before = focus_before(p)
        let body = next_image(mut p, until - now_ms())
        if body.len == 0 { return 0 - 1 }
        capture_focus(mut captured, before, p.image, body, label)
        total += 6 + body.len
        if mode_of(p.image) == want { return total }
    }
    0 - 1
}

// The wire bytes of the images up to the one that holds the golden.
fn bytes_until_golden_two(mut p: client.Peer, left: bool, ms: int, mut captured: List[str]) -> int {
    let until = now_ms() + ms
    var total = 0
    while now_ms() < until {
        let before = focus_before(p)
        let body = next_image(mut p, until - now_ms())
        if body.len == 0 { return 0 - 1 }
        capture_focus(mut captured, before, p.image, body, "two-action")
        total += 6 + body.len
        if golden_two(p.image, left).len == 0 { return total }
    }
    0 - 1
}

fn bytes_until_golden_three(mut p: client.Peer, focus: int, name: str, ms: int, mut captured: List[str]) -> int {
    let until = now_ms() + ms
    var total = 0
    while now_ms() < until {
        let before = focus_before(p)
        let body = next_image(mut p, until - now_ms())
        if body.len == 0 { return 0 - 1 }
        capture_focus(mut captured, before, p.image, body, "three-action")
        total += 6 + body.len
        if golden_three(p.image, focus, name).len == 0 { return total }
    }
    0 - 1
}

// The bytes of the images a focus change makes, two and three panes.
fn row_focus_bytes(mut r: Rig, separate: bool) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    let _s = prefix(p, 124)
    let w2 = until_golden_two(mut p, false, 3000)
    if w2.len > 0 { return "two panes: " + w2 }
    drain(mut p, 300)
    p.auto_ack = false
    var captured = List[str]()
    var two_prefix = 0
    if separate {
        let _p = ctrl_space(p)
        two_prefix = bytes_until_focus_mode(mut p, "PREFIX", 3000, mut captured, "two-prefix")
        if two_prefix < 0 { return "no prefix image before two-pane focus" }
        let _h = client.key(p, 0, 0, 104)
    } else { let _h = coalesced_focus_prefix(p, 104) }
    let two_action = bytes_until_golden_two(mut p, true, 3000, mut captured)
    if two_action < 0 { return "no image completed the focus change" }
    let two_bytes = two_prefix + two_action
    p.auto_ack = true
    let _l = prefix(p, 108)
    let _d = prefix(p, 45)
    let w3 = until_golden_three(mut p, 3, "default", 3000)
    if w3.len > 0 { return "three panes: " + w3 }
    drain(mut p, 300)
    p.auto_ack = false
    var three_prefix = 0
    if separate {
        let _p = ctrl_space(p)
        three_prefix = bytes_until_focus_mode(mut p, "PREFIX", 3000, mut captured, "three-prefix")
        if three_prefix < 0 { return "no prefix image before three-pane focus" }
        let _b = client.key(p, 0, 0, 104)
    } else { let _b = coalesced_focus_prefix(p, 104) }
    let three_action = bytes_until_golden_three(mut p, 1, "default", 3000, mut captured)
    if three_action < 0 { return "no image completed the second focus change" }
    let three_bytes = three_prefix + three_action
    p.auto_ack = true
    for line in captured { print(line) }
    print("MEASURE focus-change 80x24 two-panes-wire-bytes={two_bytes} three-panes-wire-bytes={three_bytes}")
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    // Coalesced minima remain 600/314 (28 fixed + 572/286 border).
    // Separated prefix reveal: 626 = 28 fixed + 66 mode + 532 hints.
    // Action: 926/640 = 28 + 572/286 border + 66 mode + 260 hint erase.
    // Necessary totals: 1552/1266; headroom: 168/134 (about 11%).
    // Hard zero-unchanged-cell checks above apply in both schedules.
    let two_bound = if separate then 1720 else 800
    let three_bound = if separate then 1400 else 500
    if two_bytes > two_bound { return "a focus change between two panes took {two_bytes} bytes (bound {two_bound}, separated={separate})" }
    if three_bytes > three_bound { return "a focus change among three panes took {three_bytes} bytes (bound {three_bound}, separated={separate})" }
    ""
}

fn percentile(sorted: List[int], pct: int) -> int {
    if sorted.len == 0 { return 0 - 1 }
    var i = sorted.len * pct / 100
    if i >= sorted.len { i = sorted.len - 1 }
    sorted[i]
}

// Type count characters at the right pane's prompt, each timed from the
// KEY's send to the image showing it; Ctrl-U every 30.
fn keystrokes(mut q: client.Peer, count: int, gap_ms: int) -> List[int] {
    var times = List[int]()
    var typed = ""
    var n = 0
    while n < count {
        if gap_ms > 0 { time.sleep(time.millis(gap_ms)) }
        let ch = "abcdefghijklmnopqrstuvwxyz"[n % 26..n % 26 + 1]
        let t0 = time.monotonic_ns()
        let _k = client.key(q, 0, 0, 97 + n % 26)
        typed = typed + ch
        if !until_rect_line(mut q, "$ " + typed, 41, 1, 40, AREA, 10000) {
            eprint("keystroke {n} not shown:\n" + client.screen_text(q))
            return List[int]()
        }
        (mut times).push((time.monotonic_ns() - t0) / 1000)
        if typed.len == 30 {
            let _u = client.key(q, 4, 0, 117)
            if !until_rect_line(mut q, "$", 41, 1, 40, AREA, 10000) { return List[int]() }
            typed = ""
        }
        n += 1
    }
    times
}

fn report(label: str, times: List[int]) -> int {
    var sorted = copy times
    sort.sort_ints(mut sorted)
    let worst = percentile(sorted, 100)
    print("MEASURE {label} keys={times.len} p50-us={percentile(sorted, 50)} p90-us={percentile(sorted, 90)} p99-us={percentile(sorted, 99)} max-us={worst}")
    worst
}

fn row_keys_in_split(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane" }
    let quiet = keystrokes(mut p, 120, 25)
    if quiet.len == 0 { return "a keystroke in the split was not shown" }
    let _q = report("keys-quiet-split gap-ms=25", quiet)
    let _h = prefix(p, 104)
    let _f = client.input(p, "while :; do echo 0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopq; done\r")
    let _l = prefix(p, 108)
    let _u = client.key(p, 4, 0, 117)
    time.sleep(time.millis(200))
    let flooded = keystrokes(mut p, 120, 25)
    if flooded.len == 0 { return "a keystroke beside the flooding pane was not shown" }
    let worst = report("keys-beside-split-flood gap-ms=25", flooded)
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    if worst > 2000000 { return "a keystroke beside the flood took {worst} us (bound 2 s)" }
    ""
}

fn row_split_latency(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    drain(mut p, 300)
    let t0 = now_ms()
    let _s = prefix(p, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "no prompt in the new pane" }
    print("MEASURE split-ms={now_ms() - t0} (the prefix and | to the new pane's prompt drawn)")
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// Split and close 200 times: the server's resident size stays within 1 MiB
// after the first cycle (pane slots are reused, layout work dies with its
// turn).
fn row_split_close_cycles(mut r: Rig) -> str {
    let why = start_with(mut r, "/bin/cat", 600000)
    if why.len > 0 { return why }
    let pid = server_pid(r)
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    var before = 0
    var n = 0
    while n < 201 {
        let _s = prefix(p, 124)
        let a = until_golden_two(mut p, false, 3000)
        if a.len > 0 { return "cycle {n}: no split: " + a }
        let _x = prefix(p, 120)
        let _y = client.key(p, 0, 0, 121)
        let until = now_ms() + 3000
        while border_cells(p.image) != 0 && now_ms() < until { let _k = client.step(mut p, 100) }
        if border_cells(p.image) != 0 { return "cycle {n}: the split did not close" }
        if n == 0 {
            time.sleep(time.millis(300))
            before = rss_kb(pid)
        }
        n += 1
    }
    time.sleep(time.millis(300))
    let after = rss_kb(pid)
    print("MEASURE split-close-cycles=200 server-rss-before-kb={before} after-kb={after}")
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if before < 0 || after < 0 { return "no /proc status for the server" }
    if after - before > 1024 { return "server RSS grew {after - before} kB over 200 split/close cycles" }
    if st != 0 { return "server exit {st}" }
    ""
}

// ---------------- modes, hints, prompts, the key list ----------------

fn ctrl_space(p: client.Peer) -> bool {
    client.key(p, 4, 0, 32)
}

fn esc(p: client.Peer) -> bool {
    client.key(p, 0, 1, 14)
}

fn enter(p: client.Peer) -> bool {
    client.key(p, 0, 1, 13)
}

// Each byte of an ASCII text as a KEY.
fn type_keys(p: client.Peer, text: str) -> bool {
    for b in text.bytes() {
        if !client.key(p, 0, 0, b as int) { return false }
    }
    true
}

/// The first column of the bar's mode field: left of the clock from 40
/// columns, at the right end below.
fn field_at(cols: int) -> int {
    if cols >= 40 { return cols - 15 }
    cols - 8
}

/// The bar's mode field, trimmed.
fn mode_of(img: proto.Image) -> str {
    if !img.valid || img.cols < 9 { return "" }
    cells(img, img.rows - 1, field_at(img.cols) + 1, 8)
}

fn until_mode(mut p: client.Peer, name: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if mode_of(p.image) == name { return true }
        let k = client.step(mut p, until - now_ms())
        if k < 0 { return false }
    }
    mode_of(p.image) == name
}

/// The hint line (the last row), trailing blanks trimmed.
fn hint_of(img: proto.Image) -> str {
    cells(img, img.rows, 1, img.cols)
}

fn until_hint(mut p: client.Peer, text: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if hint_of(p.image) == text { return true }
        let k = client.step(mut p, until - now_ms())
        if k < 0 { return false }
    }
    hint_of(p.image) == text
}

fn until_borders(mut p: client.Peer, n: int, ms: int) -> bool {
    let until = now_ms() + ms
    while border_cells(p.image) != n && now_ms() < until {
        let k = client.step(mut p, 100)
        if k < 0 { return false }
    }
    border_cells(p.image) == n
}

/// The text of line one's inverse cells after the session's name: the
/// active tab's label, trimmed.
fn active_label(img: proto.Image, name: str) -> str {
    if !img.valid { return "" }
    let row = img.rows - 1
    var out = List[byte]()
    var c = name.len + 3
    while c < field_at(img.cols) - 1 {
        let i = (row - 1) * img.cols + c - 1
        if img.flags[i] == INVERSE { push_utf8(mut out, img.base[i]) }
        c += 1
    }
    (str_from_utf8(out) else "").trim()
}

fn until_active(mut p: client.Peer, name: str, label: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if active_label(p.image, name) == label { return true }
        let k = client.step(mut p, until - now_ms())
        if k < 0 { return false }
    }
    active_label(p.image, name) == label
}

fn finish(mut r: Rig, mut p: client.Peer) -> str {
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// The mode field at the right end of line one: inverse and bold, its
// place fixed; it follows the prefix, every mode key and every way out.
// Measures the wire bytes of the prefix and pane-mode images: both update
// the mode field and hint line.
fn row_mode_field(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "f", 1) else |e| { return "dial-{e}" }
    if !until_mode(mut p, "NORMAL", 5000) { return "no NORMAL field: '" + cells(p.image, 23, 1, 80) + "'" }
    var k = 65
    for b in " NORMAL  ".bytes() {
        let w = cell_is(p.image, k, 23, b as int, FIELD, 0)
        if w.len > 0 { return "the field: " + w }
        k += 1
    }
    drain(mut p, 300)
    p.auto_ack = false
    let _a = ctrl_space(p)
    let one = next_image(mut p, 3000)
    if one.len == 0 || mode_of(p.image) != "PREFIX" { return "the prefix's image: '" + mode_of(p.image) + "'" }
    let _w = client.key(p, 0, 0, 119)
    let two = next_image(mut p, 3000)
    if two.len == 0 || mode_of(p.image) != "PANE" { return "pane mode's image: '" + mode_of(p.image) + "'" }
    p.auto_ack = true
    print("MEASURE mode-change 80x24 prefix-wire-bytes={6 + one.len} pane-mode-wire-bytes={6 + two.len}")
    if 6 + one.len > 800 { return "the prefix's image took {6 + one.len} bytes (measured 690, bound 800)" }
    if 6 + two.len > 1300 { return "pane mode's image took {6 + two.len} bytes (predicted about 1 KB, bound 1300)" }
    let steps = [
        "esc", "NORMAL", "prefix", "PREFIX", "t", "TAB", "enter", "NORMAL", "prefix", "PREFIX", "r", "RESIZE",
        "prefix", "PREFIX", "s", "SESSION", "esc", "NORMAL", "prefix", "PREFIX", "q", "NORMAL", "prefix", "PREFIX",
        "g", "LOCKED", "esc", "LOCKED", "prefix", "LOCKED", "C-g", "NORMAL"]
    var i = 0
    while i + 1 < steps.len {
        let key = steps[i]
        if key == "esc" { let _e = esc(p) }
        else if key == "enter" { let _n = enter(p) }
        else if key == "prefix" { let _c = ctrl_space(p) }
        else if key == "C-g" { let _g = client.key(p, 4, 0, 103) }
        else { let _t = type_keys(p, key) }
        if !until_mode(mut p, steps[i + 1], 3000) { return "after {key}: '" + mode_of(p.image) + "', expected " + steps[i + 1] }
        if cells(p.image, 23, 65, 1) != "" || p.image.flags[22 * 80 + 64] != FIELD { return "the field moved after {key}" }
        i += 2
    }
    finish(mut r, mut p)
}

// Idle shows only the prefix, which reveals the action table; every way
// back hides it. Narrow prefix tables still count the hints that do not fit.
fn row_hint_line(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !until_hint(mut p, NORMAL_HINTS, 5000) { return "normal: '" + hint_of(p.image) + "'" }
    let w = hint_cells_are(p.image, 24, NORMAL_HINTS, [2, 8])
    if w.len > 0 { return "normal's cells: " + w }
    let _a = ctrl_space(p)
    if !until_mode(mut p, "PREFIX", 3000) { return "no prefix mode" }
    if !until_hint(mut p, PREFIX_HINTS, 3000) { return "prefix: '" + hint_of(p.image) + "'" }
    let pw = hint_cells_are(p.image, 24, PREFIX_HINTS, [2, 8, 18, 27, 36, 40, 51, 55, 64, 64])
    if pw.len > 0 { return "prefix cells: " + pw }
    let _w = client.key(p, 0, 0, 119)
    if !until_hint(mut p, PANE_HINTS, 3000) { return "pane: '" + hint_of(p.image) + "'" }
    let _e = esc(p)
    if !until_hint(mut p, NORMAL_HINTS, 3000) { return "back to normal: '" + hint_of(p.image) + "'" }
    let _again = ctrl_space(p)
    if !until_hint(mut p, PREFIX_HINTS, 3000) { return "prefix again" }
    let _cancel = esc(p)
    if !until_hint(mut p, NORMAL_HINTS, 3000) { return "Escape from prefix did not hide actions" }
    let _pane = prefix(p, 119)
    if !until_hint(mut p, PANE_HINTS, 3000) { return "pane again" }
    let _enter = enter(p)
    if !until_hint(mut p, NORMAL_HINTS, 3000) { return "Enter from pane did not hide actions" }
    let _g = prefix(p, 103)
    if !until_hint(mut p, " C-g unlock", 3000) { return "locked: '" + hint_of(p.image) + "'" }
    let _u = client.key(p, 4, 0, 103)
    if !until_hint(mut p, NORMAL_HINTS, 3000) { return "unlocked: '" + hint_of(p.image) + "'" }
    let _z = client.resize(p, 40, 24)
    if !until_hint(mut p, NORMAL_HINTS, 3000) { return "idle at 40 columns: '" + hint_of(p.image) + "'" }
    let _narrow = ctrl_space(p)
    if !until_hint(mut p, " C-Space prefix  M-\\ M-| |- split  +18", 3000) { return "prefix at 40 columns: '" + hint_of(p.image) + "'" }
    finish(mut r, mut p)
}

// The prefix twice: the pane reads it (NUL), and the mode is normal.
fn row_prefix_twice(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "bytes.txt")
    fs.remove(f) else |_| {}
    let _x = client.input(p, "{self_path()} --read-bytes {f} 1\r")
    if !until_file(f, "ready", 5000) { return "the helper did not start:\n" + client.screen_text(p) }
    let _a = ctrl_space(p)
    let _b = ctrl_space(p)
    if !until_file(f, "bytes 00", 5000) { return "the pane did not read NUL: " + (fs.read_text(f) else "") }
    if !until_mode(mut p, "NORMAL", 3000) { return "not back to normal: " + mode_of(p.image) }
    finish(mut r, mut p)
}

// Locked: every key reaches the pane, the prefix included; only C-g is
// taken, and leaves.
fn row_locked(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "bytes.txt")
    fs.remove(f) else |_| {}
    let _x = client.input(p, "{self_path()} --read-bytes {f} 4\r")
    if !until_file(f, "ready", 5000) { return "the helper did not start:\n" + client.screen_text(p) }
    let _g = prefix(p, 103)
    if !until_mode(mut p, "LOCKED", 3000) { return "not locked: " + mode_of(p.image) }
    let _a = ctrl_space(p)
    let _b = client.key(p, 0, 0, 124)
    let _c = client.key(p, 0, 0, 120)
    let _d = esc(p)
    if !until_file(f, "bytes 00 7c 78 1b", 5000) { return "the pane did not read every key: " + (fs.read_text(f) else "") }
    if border_cells(p.image) != 0 { return "a locked | split the pane" }
    if mode_of(p.image) != "LOCKED" { return "left locked mode: " + mode_of(p.image) }
    let _u = client.key(p, 4, 0, 103)
    if !until_mode(mut p, "NORMAL", 3000) { return "C-g did not unlock: " + mode_of(p.image) }
    let _s = prefix(p, 124)
    if !until_borders(mut p, AREA, 3000) { return "the prefix table after unlocking: {border_cells(p.image)} border cells" }
    finish(mut r, mut p)
}

// Pane mode is sticky: splits, focus, a confirm answered no, zoom; Esc
// leaves, and keys reach the focused pane again.
fn row_pane_mode(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _w = prefix(p, 119)
    if !until_mode(mut p, "PANE", 3000) { return "no pane mode" }
    let _s = client.key(p, 0, 0, 124)
    if !until_rect_line(mut p, "$", 41, 1, 40, AREA, 5000) { return "| in pane mode did not split:\n" + client.screen_text(p) }
    let _d = client.key(p, 0, 0, 45)
    if !until_rect_line(mut p, "$", 41, 12, 40, 11, 5000) { return "- in pane mode did not split:\n" + client.screen_text(p) }
    let _h = client.key(p, 0, 0, 104)
    let until = now_ms() + 3000
    while p.image.cursor_col > 39 && now_ms() < until { let _k = client.step(mut p, 100) }
    if p.image.cursor_col > 39 { return "h in pane mode did not focus left: cursor {p.image.cursor_col},{p.image.cursor_row}" }
    if mode_of(p.image) != "PANE" { return "pane mode was left: " + mode_of(p.image) }
    let borders = border_cells(p.image)
    let _x = client.key(p, 0, 0, 120)
    if !until_mode(mut p, "CONFIRM", 3000) { return "x did not ask: " + mode_of(p.image) }
    if !hint_of(p.image).contains("close this pane?") { return "no question: '" + hint_of(p.image) + "'" }
    let _n = client.key(p, 0, 0, 110)
    if !until_mode(mut p, "PANE", 3000) { return "n did not go back to pane mode: " + mode_of(p.image) }
    if border_cells(p.image) != borders { return "n closed a pane" }
    let _z = client.key(p, 0, 0, 122)
    if !until_borders(mut p, 0, 3000) { return "z in pane mode did not zoom" }
    let _u = client.key(p, 0, 0, 122)
    if !until_borders(mut p, borders, 3000) { return "z again did not unzoom" }
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) { return "Esc did not leave: " + mode_of(p.image) }
    let _t = client.input(p, "echo P-$((1+1))\r")
    if !until_rect(mut p, "P-2", 1, 1, 39, AREA, 5000) { return "keys after pane mode did not reach the left pane:\n" + client.screen_text(p) }
    finish(mut r, mut p)
}

// Tab mode is sticky: new tabs, previous and next, a number, a rename
// typed at its prompt (back to tab mode), a close confirmed with y.
fn row_tab_mode(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "t") else |e| { return "dial-{e}" }
    let _t = prefix(p, 116)
    if !until_mode(mut p, "TAB", 3000) { return "no tab mode" }
    let _c = client.key(p, 0, 0, 99)
    if !until_active(mut p, "t", "2", 5000) { return "c: active '" + active_label(p.image, "t") + "'" }
    let _d = client.key(p, 0, 0, 99)
    if !until_active(mut p, "t", "3", 5000) { return "c again: active '" + active_label(p.image, "t") + "'" }
    let _h = client.key(p, 0, 0, 104)
    if !until_active(mut p, "t", "2", 3000) { return "h: active '" + active_label(p.image, "t") + "'" }
    let _l = client.key(p, 0, 0, 108)
    if !until_active(mut p, "t", "3", 3000) { return "l: active '" + active_label(p.image, "t") + "'" }
    let _one = client.key(p, 0, 0, 49)
    if !until_active(mut p, "t", "1", 3000) { return "1: active '" + active_label(p.image, "t") + "'" }
    let _r = client.key(p, 0, 0, 114)
    if !until_mode(mut p, "RENAME", 3000) { return "r did not prompt: " + mode_of(p.image) }
    let _w = type_keys(p, "work")
    let _n = enter(p)
    if !until_active(mut p, "t", "1:work", 3000) { return "the rename: active '" + active_label(p.image, "t") + "'" }
    if mode_of(p.image) != "TAB" { return "the rename did not go back to tab mode: " + mode_of(p.image) }
    let _x = client.key(p, 0, 0, 120)
    if !until_mode(mut p, "CONFIRM", 3000) { return "x did not ask" }
    if !hint_of(p.image).contains("close this tab and its panes?") { return "no question: '" + hint_of(p.image) + "'" }
    let _y = client.key(p, 0, 0, 121)
    if !until_rect(mut p, "1  2", 1, 23, 70, 1, 3000) || rect_has(p.image, "work", 1, 23, 70, 1) || rect_has(p.image, "3", 4, 23, 67, 1) {
        return "y did not close the tab: '" + cells(p.image, 23, 1, 80) + "'"
    }
    if mode_of(p.image) != "TAB" { return "the close did not go back to tab mode: " + mode_of(p.image) }
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) { return "Esc did not leave" }
    finish(mut r, mut p)
}

// Resize mode: each l moves the border two columns, h back.
fn row_resize_mode(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let f = out_file(r, "winch.txt")
    fs.remove(f) else |_| {}
    let _x = client.input(p, "exec {self_path()} --winch {f} w\r")
    if !until_file(f, "w start 22 80", 5000) { return "the helper did not start:\n" + client.screen_text(p) }
    var want = List[str]()
    (mut want).push("w start 22 80")
    let _s = prefix(p, 124)
    (mut want).push("w winch 22 39")
    if !until_in_order(f, want, 5000) { return "after the split: " + (fs.read_text(f) else "") }
    let _h = prefix(p, 104)
    let _r = prefix(p, 114)
    if !until_mode(mut p, "RESIZE", 3000) { return "no resize mode" }
    for cols in [41, 43, 45] {
        let _l = client.key(p, 0, 0, 108)
        (mut want).push("w winch 22 {cols}")
        if !until_in_order(f, want, 5000) { return "after l: " + (fs.read_text(f) else "") }
    }
    let _b = client.key(p, 0, 0, 104)
    (mut want).push("w winch 22 43")
    if !until_in_order(f, want, 5000) { return "after h: " + (fs.read_text(f) else "") }
    // A pause longer than a short repeat timeout must not end the mode.
    time.sleep(time.millis(700))
    let _arrow = client.key(p, 0, 1, 3)
    (mut want).push("w winch 22 45")
    if !until_in_order(f, want, 5000) { return "the fifth resize (Right after a pause): " + (fs.read_text(f) else "") }
    if !until_mode(mut p, "RESIZE", 3000) { return "resize mode was left: " + mode_of(p.image) }
    if hint_of(p.image) != " hjkl resize  = equalize  Esc back" { return "resize hints vanished" }
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) || hint_of(p.image) != NORMAL_HINTS { return "Esc did not leave to idle hints" }
    let _again = prefix(p, 114)
    if !until_mode(mut p, "RESIZE", 3000) { return "resize before Enter" }
    let _enter = enter(p)
    if !until_mode(mut p, "NORMAL", 3000) || hint_of(p.image) != NORMAL_HINTS { return "Enter did not leave to idle hints" }
    let _last = prefix(p, 114)
    if !until_mode(mut p, "RESIZE", 3000) { return "resize before prefix" }
    let _prefix = ctrl_space(p)
    if !until_mode(mut p, "PREFIX", 3000) || hint_of(p.image) != PREFIX_HINTS { return "the prefix did not leave resize" }
    finish(mut r, mut p)
}

// Session mode: d detaches this client.
fn row_session_mode(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 115)
    if !until_mode(mut p, "SESSION", 3000) { return "no session mode" }
    if !until_hint(mut p, " d detach  Esc back", 3000) { return "session hints: '" + hint_of(p.image) + "'" }
    let _d = client.key(p, 0, 0, 100)
    if !client.until_kind(mut p, 135, 5000) || p.end_code != 1 { return "d: BYE {p.end_code}, expected detached" }
    finish(mut r, mut p)
}

// A close asks first: Esc and any other key keep the pane; y closes it.
fn row_confirm_close(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _s = prefix(p, 124)
    if !until_borders(mut p, AREA, 5000) { return "no split" }
    let _x = prefix(p, 120)
    if !until_hint(mut p, " close this pane? y yes  n no", 3000) { return "the question: '" + hint_of(p.image) + "'" }
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) { return "Esc did not cancel: " + mode_of(p.image) }
    let _y = prefix(p, 120)
    if !until_mode(mut p, "CONFIRM", 3000) { return "x did not ask again" }
    let _q = client.key(p, 0, 0, 113)
    if !until_mode(mut p, "NORMAL", 3000) { return "q did not cancel: " + mode_of(p.image) }
    time.sleep(time.millis(200))
    let _k = client.step(mut p, 100)
    if border_cells(p.image) != AREA { return "a cancelled close closed the pane" }
    let _z = prefix(p, 120)
    let _a = client.key(p, 0, 0, 121)
    if !until_borders(mut p, 0, 3000) { return "y did not close the pane" }
    finish(mut r, mut p)
}

// The rename prompt: typed, erased, cleared, cancelled; it starts with the
// tab's name, and its cursor follows the text.
fn row_rename_tab(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "r") else |e| { return "dial-{e}" }
    let _c = prefix(p, 44)
    if !until_hint(mut p, " rename tab:", 3000) { return "no prompt: '" + hint_of(p.image) + "'" }
    let _t = type_keys(p, "logx")
    let _b = client.key(p, 0, 1, 11)
    let _s = type_keys(p, "s")
    if !until_hint(mut p, " rename tab: logs", 3000) { return "typed: '" + hint_of(p.image) + "'" }
    if p.image.cursor_row != 24 || p.image.cursor_col != 18 { return "the cursor at {p.image.cursor_col},{p.image.cursor_row}, expected 18,24" }
    let _n = enter(p)
    if !until_active(mut p, "r", "1:logs", 3000) { return "renamed: '" + cells(p.image, 23, 1, 80) + "'" }
    if mode_of(p.image) != "NORMAL" { return "not back to normal: " + mode_of(p.image) }
    let _again = prefix(p, 44)
    if !until_hint(mut p, " rename tab: logs", 3000) { return "the prompt did not start with the name: '" + hint_of(p.image) + "'" }
    let _u = client.key(p, 4, 0, 117)
    if !until_hint(mut p, " rename tab:", 3000) { return "C-u: '" + hint_of(p.image) + "'" }
    let _w = type_keys(p, "w")
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) { return "Esc did not cancel" }
    if active_label(p.image, "r") != "1:logs" { return "a cancelled rename renamed: '" + cells(p.image, 23, 1, 80) + "'" }
    finish(mut r, mut p)
}

// The command line takes the key table's action names and arguments; an
// unknown verb is answered on the hint line.
fn row_command_mode(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "c") else |e| { return "dial-{e}" }
    let _a = prefix(p, 58)
    if !until_hint(mut p, " :", 3000) { return "no prompt: '" + hint_of(p.image) + "'" }
    let _t = type_keys(p, "split-down")
    if !until_hint(mut p, " :split-down", 3000) { return "typed: '" + hint_of(p.image) + "'" }
    let _n = enter(p)
    if !until_rect_line(mut p, "$", 1, 12, 80, 11, 5000) { return "split-down did not split:\n" + client.screen_text(p) }
    if p.image.base[10 * 80] != 9472 { return "the border is not on row 11" }
    let _b = prefix(p, 58)
    let _u = type_keys(p, "resize up 3")
    let _m = enter(p)
    let until = now_ms() + 3000
    while p.image.base[7 * 80] != 9472 && now_ms() < until { let _k = client.step(mut p, 100) }
    if p.image.base[7 * 80] != 9472 { return "resize up 3 did not move the border to row 8:\n" + client.screen_text(p) }
    let _c = prefix(p, 58)
    let _v = type_keys(p, "bogus")
    let _o = enter(p)
    if !until_hint(mut p, "unknown command: bogus", 3000) { return "no answer: '" + hint_of(p.image) + "'" }
    let _d = prefix(p, 58)
    let _w = type_keys(p, "rename-tab work notes")
    let _e = enter(p)
    if !until_active(mut p, "c", "1:work notes", 3000) { return "rename-tab: '" + cells(p.image, 23, 1, 80) + "'" }
    let _f = prefix(p, 58)
    let _l = type_keys(p, "lock")
    let _g = enter(p)
    if !until_mode(mut p, "LOCKED", 3000) { return "lock: " + mode_of(p.image) }
    let _h = client.key(p, 4, 0, 103)
    if !until_mode(mut p, "NORMAL", 3000) { return "C-g after lock" }
    finish(mut r, mut p)
}

// Modes are a client's own: one client in pane mode, the other's keys
// still reach the pane and its bar says NORMAL; the layout is shared.
fn row_modes_per_client(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = session(r, 80, 24, "m") else |e| { return "dial-{e}" }
    var b = attach(r, 80, 24, "m", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "$", 5000) { return "the second client has no image" }
    let _w = prefix(a, 119)
    if !until_mode(mut a, "PANE", 3000) { return "no pane mode" }
    drain(mut b, 300)
    if mode_of(b.image) != "NORMAL" { return "the other client's mode: " + mode_of(b.image) }
    if hint_of(a.image) != PANE_HINTS || hint_of(b.image) != NORMAL_HINTS { return "hints leaked between clients" }
    let _bp = ctrl_space(b)
    if !until_hint(mut b, PREFIX_HINTS, 3000) { return "the second client did not reveal its prefix table" }
    drain(mut a, 100)
    if mode_of(a.image) != "PANE" || hint_of(a.image) != PANE_HINTS { return "the second prefix changed the first client" }
    let _be = esc(b)
    if !until_hint(mut b, NORMAL_HINTS, 3000) { return "the second Escape did not hide its table" }
    let _t = client.input(b, "echo B-$((1+1))\r")
    if !until_text(mut b, "B-2", 5000) { return "the other client's keys did not reach the pane" }
    let _s = client.key(a, 0, 0, 124)
    if !until_borders(mut b, AREA, 5000) { return "the split did not reach the other client" }
    if mode_of(a.image) != "PANE" { return "the split left pane mode" }
    let _end = esc(a)
    if !until_hint(mut a, NORMAL_HINTS, 3000) { return "the first client did not return to idle hints" }
    let _resize = prefix(a, 114)
    if !until_mode(mut a, "RESIZE", 3000) { return "the first client did not enter resize" }
    let _left = client.key(a, 0, 1, 4)
    if !until_rect(mut b, "│", 38, 1, 1, AREA, 3000) { return "the resize did not reach the second client" }
    drain(mut a, 100)
    if mode_of(a.image) != "RESIZE" || hint_of(a.image) != " hjkl resize  = equalize  Esc back" { return "resize did not stay on the first client" }
    if mode_of(b.image) != "NORMAL" || hint_of(b.image) != NORMAL_HINTS { return "resize changed the second client's mode or hints" }
    let _leave = enter(a)
    if !until_hint(mut a, NORMAL_HINTS, 3000) { return "the first client's Enter did not hide resize hints" }
    client.hang_up(mut b)
    finish(mut r, mut a)
}

// INPUT and PASTE are dropped outside normal and locked mode.
fn row_input_in_modes(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "") else |e| { return "dial-{e}" }
    let _w = prefix(p, 119)
    if !until_mode(mut p, "PANE", 3000) { return "no pane mode" }
    let _i = client.input(p, "echo IN-$((1+1))\r")
    var paste = List[byte]()
    let text = "echo PA-$((2+2))\r"
    proto.put(mut paste, text.len, 4)
    for c in text.bytes() { (mut paste).push(c) }
    let _p = client.send(p, 4, paste)
    let _e = esc(p)
    if !until_mode(mut p, "NORMAL", 3000) { return "Esc did not leave" }
    let _o = client.input(p, "echo OK-$((3+3))\r")
    if !until_text(mut p, "OK-6", 5000) { return "input after the mode did not arrive" }
    let screen = client.screen_text(p)
    if screen.contains("IN-") || screen.contains("PA-") { return "input in pane mode reached the pane:\n" + screen }
    finish(mut r, mut p)
}

// The key list is drawn for one client only, over the tab area, scrolls
// with j and k, and closes back to the exact frame it covered.
fn row_help_overlay(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "h", 1) else |e| { return "dial-{e}" }
    var b = attach(r, 80, 24, "h", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 5000) || !client.until_kind(mut b, 131, 5000) { return "no images" }
    let _s = prefix(a, 124)
    if !until_borders(mut a, AREA, 3000) { return "no split" }
    drain(mut a, 300)
    drain(mut b, 300)
    let before = copy a.image
    let _q = prefix(a, 63)
    if !until_mode(mut a, "HELP", 3000) { return "no help mode" }
    let first = "  NORMAL   C-Space    prefix mode"
    if !until_rect_line(mut a, first, 1, 1, 80, 1, 3000) { return "row 1: '" + cells(a.image, 1, 1, 80) + "'" }
    if !until_hint(mut a, " jk scroll  Esc close", 3000) { return "help hints: '" + hint_of(a.image) + "'" }
    drain(mut b, 300)
    if rect_has(b.image, "C-Space", 1, 1, 80, AREA) { return "the key list reached the other client" }
    let _j = client.key(a, 0, 0, 106)
    if !until_rect_line(mut a, "  NORMAL   M-\\        split-right", 1, 1, 80, 1, 3000) { return "j: '" + cells(a.image, 1, 1, 80) + "'" }
    let _k = client.key(a, 0, 0, 107)
    if !until_rect_line(mut a, first, 1, 1, 80, 1, 3000) { return "k: '" + cells(a.image, 1, 1, 80) + "'" }
    let _e = esc(a)
    if !until_mode(mut a, "NORMAL", 3000) { return "Esc did not close" }
    drain(mut a, 300)
    let d = proto.differing(before, a.image)
    if d != 0 { return "{d} cells differ from the frame before the key list" }
    client.hang_up(mut b)
    finish(mut r, mut a)
}

// ---------------- line one: marks, the clock ----------------

fn digit_at(img: proto.Image, col: int, row: int) -> bool {
    let i = (row - 1) * img.cols + col - 1
    img.base[i] >= 48 && img.base[i] <= 57 && img.flags[i] == 0
}

/// "" when line one's last seven cells are ` HH:MM ` in the default
/// rendition (at 40 columns and wider).
fn clock_cells_are(img: proto.Image) -> str {
    let row = img.rows - 1
    let c = img.cols - 6
    let i = (row - 1) * img.cols
    if img.base[i + c - 1] != 32 || img.base[i + img.cols - 1] != 32 || img.base[i + c + 2] != 58 ||
        !digit_at(img, c + 1, row) || !digit_at(img, c + 2, row) || !digit_at(img, c + 4, row) ||
        !digit_at(img, c + 5, row) || img.flags[i + c - 1] != 0 || img.flags[i + c + 2] != 0 {
        return "not ' HH:MM ' at {c}-{img.cols}: '" + cells(img, row, c, 7) + "'"
    }
    ""
}

/// The clock's HH:MM.
fn clock_of(img: proto.Image) -> str {
    cells(img, img.rows - 1, img.cols - 5, 5)
}

fn two(n: int) -> str {
    if n < 10 { return "0{n}" }
    "{n}"
}

/// The host's local HH:MM at a UNIX second, as the rows read it (TZ or
/// /etc/localtime; UTC where there is no zone).
fn local_hhmm(unix_s: int) -> str {
    let l = time.local(unix_s) else {
        let d = unix_s % 86400
        return two(d / 3600) + ":" + two(d / 60 % 60)
    }
    two(l.hour) + ":" + two(l.minute)
}

/// "" when line one reads `text` from column 1 up to the mode field, the
/// columns of each (first, last) pair in `inverse` inverse and the rest
/// plain, blanks up to the field.
fn line_one_is(img: proto.Image, text: str, inverse: List[int]) -> str {
    let row = img.rows - 1
    let end = field_at(img.cols) - 1
    var col = 1
    var cps = List[int]()
    for cp in text.code_points() { (mut cps).push(cp) }
    while col <= end {
        let base = if col <= cps.len then cps[col - 1] else 32
        var flags = 0
        var q = 0
        while q + 1 < inverse.len {
            if col >= inverse[q] && col <= inverse[q + 1] { flags = INVERSE }
            q += 2
        }
        let w = cell_is(img, col, row, base, flags, 0)
        if w.len > 0 { return w + " in '" + cells(img, row, 1, end) + "'" }
        col += 1
    }
    let f = field_at(img.cols)
    var k = f
    for b in " NORMAL  ".bytes() {
        let w = cell_is(img, k, row, b as int, FIELD, 0)
        if w.len > 0 { return "mode field " + w }
        k += 1
    }
    if img.cols >= 40 { return clock_cells_are(img) }
    ""
}

fn until_line_one(mut p: client.Peer, text: str, inverse: List[int], ms: int) -> str {
    let until = now_ms() + ms
    var w = line_one_is(p.image, text, inverse)
    while w.len > 0 && now_ms() < until {
        let k = client.step(mut p, 100)
        if k < 0 { return "connection ended: " + w }
        w = line_one_is(p.image, text, inverse)
    }
    w
}

// Line one at 80, 20 and 200 columns, and at 40 with nine tabs: the
// session's name, the tabs (the active one inverse, a name after its
// number), the mode field, the clock from 40 columns; tabs that do not
// fit leave the far side of the active one.
fn row_bar_line_one(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "b", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    let _c = prefix(p, 99)
    let _d = prefix(p, 99)
    let _two = prefix(p, 50)
    let _n = prefix(p, 44)
    let _t = type_keys(p, "logs")
    let _e = enter(p)
    let _one = prefix(p, 49)
    var w = until_line_one(mut p, " b  1  2:logs  3 ", [1, 3, 4, 6], 3000)
    if w.len > 0 { return "80 columns: " + w }
    let _s = client.resize(p, 20, 6)
    w = until_line_one(mut p, " b  1 >", [1, 3, 4, 6], 3000)
    if w.len > 0 { return "20 columns: " + w }
    let _b = client.resize(p, 200, 24)
    w = until_line_one(mut p, " b  1  2:logs  3 ", [1, 3, 4, 6], 3000)
    if w.len > 0 { return "200 columns: " + w }
    var n = 3
    while n < 9 {
        let _x = prefix(p, 99)
        n += 1
    }
    let _r = client.resize(p, 40, 24)
    w = until_line_one(mut p, " b < 4  5  6  7  8  9 ", [1, 3, 20, 22], 3000)
    if w.len > 0 { return "40 columns, nine tabs: " + w }
    finish(mut r, mut p)
}

// A zoomed tab's label carries Z.
fn row_zoom_mark(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "z", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    let _s = prefix(p, 124)
    if !until_borders(mut p, AREA, 3000) { return "no split" }
    let _z = prefix(p, 122)
    if !until_active(mut p, "z", "1Z", 3000) { return "zoomed: '" + cells(p.image, 23, 1, 80) + "'" }
    let _u = prefix(p, 122)
    if !until_active(mut p, "z", "1", 3000) { return "unzoomed: '" + cells(p.image, 23, 1, 80) + "'" }
    finish(mut r, mut p)
}

/// The text of a tab's label on line one (its number first), trimmed.
fn label_of(img: proto.Image, n: int) -> str {
    let line = cells(img, img.rows - 1, 1, field_at(img.cols) - 1)
    for part in line.split(" ") {
        if part.starts_with("{n}") { return part }
    }
    ""
}

fn until_label(mut p: client.Peer, n: int, label: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if label_of(p.image, n) == label { return true }
        let k = client.step(mut p, 100)
        if k < 0 { return false }
    }
    label_of(p.image, n) == label
}

// Output in a tab that is not shown marks it `+`, a bell `!`; showing the
// tab clears both; the shown tab is never marked.
fn row_activity_marks(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "a") else |e| { return "dial-{e}" }
    let _c = prefix(p, 99)
    if !until_active(mut p, "a", "2", 5000) { return "no second tab" }
    if !until_rect_line(mut p, "$", 1, 1, 80, 1, 5000) { return "no prompt in tab 2" }
    // The typed line's echo is the tab's own output: wait for it before
    // the tab is hidden, so that only the command's output can mark it.
    let _x = client.input(p, "sleep 2; echo OUT-$((1+1))\r")
    if !until_text(mut p, "OUT-$((1+1))", 5000) { return "the typed line was not echoed in tab 2" }
    drain(mut p, 200)
    let _p = prefix(p, 112)
    if !until_active(mut p, "a", "1", 3000) { return "tab 1 not shown" }
    if label_of(p.image, 2) != "2" { return "tab 2 marked before its output: '" + label_of(p.image, 2) + "'" }
    let t0 = now_ms()
    if !until_label(mut p, 2, "2+", 5000) { return "no + on tab 2: '" + cells(p.image, 23, 1, 80) + "'" }
    print("MEASURE activity-mark-ms={now_ms() - t0} (from the switch; the output follows the line by 2 s)")
    let _y = client.input(p, "echo SHOWN-$((2+2))\r")
    if !until_text(mut p, "SHOWN-4", 5000) { return "no output in tab 1" }
    if label_of(p.image, 1) != "1" { return "the shown tab was marked: '" + label_of(p.image, 1) + "'" }
    let _two = prefix(p, 50)
    if !until_active(mut p, "a", "2", 3000) { return "showing tab 2 did not clear +: '" + cells(p.image, 23, 1, 80) + "'" }
    let _b = client.input(p, "sleep 1; printf '\\007'\r")
    let _q = prefix(p, 49)
    if !until_label(mut p, 2, "2+!", 5000) { return "no ! on tab 2 after its bell: '" + cells(p.image, 23, 1, 80) + "'" }
    let _back = prefix(p, 50)
    if !until_active(mut p, "a", "2", 3000) { return "showing tab 2 did not clear its marks" }
    let _one = prefix(p, 49)
    if !until_label(mut p, 2, "2", 3000) { return "tab 2's marks came back: '" + label_of(p.image, 2) + "'" }
    finish(mut r, mut p)
}

// The clock is the host's local HH:MM.
fn row_clock(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    drain(mut p, 200)
    let s = time.unix_ms() / 1000
    let shown = clock_of(p.image)
    if shown != local_hhmm(s) && shown != local_hhmm(s - 60) {
        return "the clock reads '{shown}', the host " + local_hhmm(s) + " (line one '" + cells(p.image, 23, 1, 80) + "')"
    }
    finish(mut r, mut p)
}

// At the next minute boundary the clock moves, within a second.
fn row_clock_tick(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    drain(mut p, 200)
    var ms = time.unix_ms()
    // Not within a second of a boundary already.
    if ms % 60000 > 58500 {
        time.sleep(time.millis(2000))
        drain(mut p, 100)
        ms = time.unix_ms()
    }
    let boundary = (ms / 60000 + 1) * 60000
    let want = local_hhmm(boundary / 1000)
    while time.unix_ms() < boundary + 1000 && clock_of(p.image) != want {
        let _k = client.step(mut p, 100)
    }
    let late = time.unix_ms() - boundary
    if clock_of(p.image) != want { return "the clock reads '" + clock_of(p.image) + "' a second after {want}" }
    print("MEASURE clock-tick-ms={late} (the minute's boundary to the image holding it)")
    finish(mut r, mut p)
}

fn status_field(pid: int, field: str) -> int {
    let t = fs.read_text("/proc/{pid}/status") else { return 0 - 1 }
    for line in t.lines() {
        if line.starts_with(field + ":") {
            for w in line.split("\t") {
                let v = w.trim().split(" ")
                if v.len >= 1 {
                    let n = v[0].to_int() else 0 - 1
                    if n >= 0 { return n }
                }
            }
        }
    }
    0 - 1
}

// Threads and resident size a pane, from one pane to four (hosts with
// /proc): the server is one loop, so no thread a pane.
fn row_pane_cost(mut r: Rig) -> str {
    if !has_proc() { return "no /proc here" }
    let why = start_server(mut r, "/bin/cat")
    if why.len > 0 { return why }
    let pid = server_pid(r)
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    drain(mut p, 300)
    let t1 = status_field(pid, "Threads")
    let r1 = status_field(pid, "VmRSS")
    let _a = prefix(p, 124)
    if !until_borders(mut p, AREA, 3000) { return "no second pane" }
    let _b = prefix(p, 45)
    let _c = prefix(p, 104)
    let _d = prefix(p, 45)
    if !until_borders(mut p, AREA + 40 + 39, 3000) { return "not four panes: {border_cells(p.image)} border cells" }
    drain(mut p, 300)
    let t4 = status_field(pid, "Threads")
    let r4 = status_field(pid, "VmRSS")
    if t1 < 1 || r1 < 1 || t4 < 1 || r4 < 1 { return "no Threads or VmRSS for the server ({t1} {r1} {t4} {r4})" }
    let per = (r4 - r1) / 3
    print("MEASURE threads-per-pane={(t4 - t1) / 3} server-threads={t1}->{t4} server-rss-per-pane-kb={per} server-rss-kb={r1}->{r4} (1 -> 4 panes at 80x22)")
    finish(mut r, mut p)
    if t4 != t1 { return "the server's threads went {t1} -> {t4} for three panes (predicted none)" }
    if per > 13 * 1024 { return "{per} kB a pane (predicted at most 13 MB)" }
    ""
}

// Encode independent outer-terminal bytes, parse them, then send mouse events.
fn outer_mouse(p: client.Peer, legacy: bool, kind: int, col: int, row: int) -> bool {
    var raw = List[byte]()
    if legacy {
        raw = "\u{1b}[M".bytes()
        let b = if kind == 1 then 3 else if kind == 2 then 32 else 0
        for n in [32 + b, 32 + col, 32 + row] { (mut raw).push(n as byte) }
    } else {
        let b = if kind == 2 then 32 else 0
        let end = if kind == 1 then "m" else "M"
        raw = "\u{1b}[<{b};{col};{row}{end}".bytes()
    }
    var parser = client.parser()
    let events = client.feed(mut parser, raw, 0)
    if events.len != 1 || events[0].kind != 3 { return false }
    let e = events[0]
    var body = List[byte]()
    proto.put(mut body, e.key, 1)
    proto.put(mut body, e.code, 1)
    proto.put(mut body, e.mods, 1)
    proto.put(mut body, e.col, 2)
    proto.put(mut body, e.row, 2)
    client.send(p, 3, body)
}

fn wire_mouse_button(p: client.Peer, kind: int, button: int, col: int, row: int) -> bool {
    var body = List[byte]()
    for n in [kind, button, 0] { proto.put(mut body, n, 1) }
    proto.put(mut body, col, 2)
    proto.put(mut body, row, 2)
    client.send(p, 3, body)
}

fn mouse_click(p: client.Peer, legacy: bool, col: int, row: int) -> bool {
    outer_mouse(p, legacy, 0, col, row) && outer_mouse(p, legacy, 1, col, row)
}

fn mouse_probe_text(path: str) -> str {
    let log = fs.read_text(path) else ""
    var out = ""
    for line in log.lines() {
        if line.starts_with("b ") { out = out + line + "\n" }
    }
    out
}

fn mouse_expected(encoding: int) -> str {
    var out = ""
    if encoding == 1 {
        for b in "\u{1b}[<0;5;3M\u{1b}[<0;5;3m".bytes() { out = out + "b {b as int}\n" }
    } else if encoding == 2 {
        // ESC [ M, button 32/35, col 37, row 35.
        for b in [27, 91, 77, 32, 37, 35, 27, 91, 77, 35, 37, 35] { out = out + "b {b}\n" }
    }
    out
}

fn until_mouse_bytes(path: str, want: str) -> bool {
    let end = now_ms() + 3000
    while now_ms() < end {
        if mouse_probe_text(path) == want { return true }
        time.sleep(time.millis(10))
    }
    mouse_probe_text(path) == want
}

fn until_mouse_focus(mut p: client.Peer, left: bool) -> bool {
    let end = now_ms() + 3000
    while now_ms() < end {
        if p.image.valid && p.image.cols == 80 && p.image.fg[39] == (if left then GREEN else 0) { return true }
        let k = client.step(mut p, 100)
        if k < 0 { return false }
    }
    false
}

// Each outer encoding crossed with inner SGR, legacy, and no reports.
// The first focus gesture (including motion/release) is not delivered;
// another client's focused click is unaffected by that gesture's state.
fn row_mouse_focus(mut r: Rig, legacy: bool, encoding: int) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = session(r, 80, 24, "m") else |e| { return "dial-{e}" }
    let left = out_file(r, "left.txt")
    let right = out_file(r, "right.txt")
    fs.remove(left) else |_| {}
    fs.remove(right) else |_| {}
    let _lp = client.input(a, "exec {self_path()} --mouse-probe {left} {encoding}\r")
    if !until_file(left, "ready", 5000) { return "left probe did not start" }
    let _split = prefix(a, 124)
    if !until_borders(mut a, AREA, 5000) { return "no split" }
    let _rp = client.input(a, "exec {self_path()} --mouse-probe {right} {encoding}\r")
    if !until_file(right, "ready", 5000) { return "right probe did not start" }
    var b = attach(r, 80, 24, "m", 1) else |e| { return "second-dial-{e}" }
    if !client.until_kind(mut b, 131, 5000) { return "second image" }
    let expected = mouse_expected(encoding)
    if !mouse_click(a, legacy, 45, 3) { return "focused outer mouse was not decoded" }
    if !until_mouse_bytes(right, expected) { return "focused right click was not relative to its pane: " + mouse_probe_text(right) }
    if !outer_mouse(a, legacy, 0, 5, 3) { return "outer mouse press was not decoded" }
    if !until_mouse_focus(mut a, true) || !until_mouse_focus(mut b, true) { return "click did not focus the left pane for both clients" }
    if mouse_probe_text(left) != "" { return "the focus press reached its program" }
    if !mouse_click(b, legacy, 5, 3) { return "second client mouse" }
    if !until_mouse_bytes(left, expected) { return "the first client's focus gesture swallowed the second client's click" }
    let _drag = outer_mouse(a, legacy, 2, 6, 3)
    let _release = outer_mouse(a, legacy, 1, 5, 3)
    drain(mut a, 100)
    if mouse_probe_text(left) != expected { return "the focus gesture leaked a motion or release" }
    if !mouse_click(a, legacy, 5, 3) { return "focused outer click" }
    if !until_mouse_bytes(left, expected + expected) { return "focused click did not reach its program" }
    let _border = outer_mouse(a, legacy, 0, 40, 3)
    let _motion = outer_mouse(a, legacy, 2, 5, 3)
    let _up = outer_mouse(a, legacy, 1, 5, 3)
    let _hint = mouse_click(a, legacy, 5, 24)
    let _outside = mouse_click(a, legacy, 81, 25)
    drain(mut a, 100)
    if mouse_probe_text(left) != expected + expected { return "an inert border/bar gesture reached the program" }
    if !until_mouse_focus(mut a, true) { return "an inert gesture changed focus" }
    for button in [2, 3] {
        let _down_right = wire_mouse_button(a, 0, button, 45, 3)
        let _up_right = wire_mouse_button(a, 1, button, 45, 3)
        if !until_mouse_focus(mut a, false) { return "middle/right click did not focus right" }
        let _down_left = wire_mouse_button(a, 0, button, 5, 3)
        let _up_left = wire_mouse_button(a, 1, button, 5, 3)
        if !until_mouse_focus(mut a, true) { return "middle/right click did not focus left" }
    }
    drain(mut a, 100)
    if mouse_probe_text(left) != expected + expected || mouse_probe_text(right) != expected { return "middle/right focus gestures leaked" }
    client.hang_up(mut b)
    finish(mut r, mut a)
}

fn row_mouse_tabs(mut r: Rig, legacy: bool) -> str {
    // Each pane's shell starts 300 ms late, as on a slow host, so its first
    // prompt can come after the row has made the next tab. Its prompt is not
    // `$ `: a script's non-interactive shell drops PS1 on some hosts (macOS's
    // /bin/sh), and the shell it starts then draws its own default.
    let late = out_file(r, "late-sh")
    fs.write_text(late, "sleep 0.3\nPS1='sh-3.2$ '\nexport PS1\nexec /bin/sh\n") else |e| { return "late shell: {e}" }
    let why = start_server(mut r, "/bin/sh " + late)
    if why.len > 0 { return why }
    var p = session(r, 80, 24, "b") else |e| { return "dial-{e}" }
    let f = out_file(r, "tab.txt")
    fs.remove(f) else |_| {}
    let _probe = client.input(p, "exec {self_path()} --mouse-probe {f} 1\r")
    if !until_file(f, "ready", 5000) { return "tab probe did not start" }
    // Wide label: both display cells of its glyph must hit the same tab.
    let _rename = prefix(p, 44)
    let _wide = client.key(p, 0, 0, 20013)
    let _enter = enter(p)
    let _new = prefix(p, 99)
    if !until_active(mut p, "b", "2", 5000) { return "new tab" }
    if !mouse_click(p, legacy, 8, 23) { return "tab click decode" }
    if !until_active(mut p, "b", "1:中", 3000) { return "wide continuation cell did not select tab one" }
    drain(mut p, 100)
    if mouse_probe_text(f) != "" { return "tab click release reached the new tab's program" }
    let _next = prefix(p, 110)
    if !until_active(mut p, "b", "2", 3000) { return "tab two" }
    let _name = prefix(p, 44)
    let _long = type_keys(p, "a-very-long-label")
    let _done = enter(p)
    // Each new tab is shown until its shell's prompt is drawn: output in a tab
    // that is not shown marks it, and a mark widens its label on the bar.
    var n = 2
    while n < 9 {
        let _c = prefix(p, 99)
        n += 1
        if !until_active(mut p, "b", "{n}", 10000) { return "tab {n}" }
        // The prompt's arrival, not its text, which differs between hosts:
        // any text in the tab's pane.
        let until = now_ms() + 10000
        var drawn = false
        while !drawn {
            var row = 1
            while row <= p.image.rows - 2 {
                if proto.row_text(p.image, row).len > 0 { drawn = true }
                row += 1
            }
            if !drawn {
                if now_ms() >= until { return "no prompt in tab {n}" }
                if client.step(mut p, 100) < 0 { return "the connection ended in tab {n}" }
            }
        }
    }
    // Every late shell has written its prompt before line one is read.
    drain(mut p, 1000)
    let _size = client.resize(p, 40, 24)
    let w = until_line_one(mut p, " b < 4  5  6  7  8  9 ", [1, 3, 20, 22], 3000)
    if w.len > 0 { return "narrow before click: " + w }
    if !mouse_click(p, legacy, 6, 23) { return "narrow click decode" }
    if !until_active(mut p, "b", "4", 3000) { return "visible tab four was confused with its screen position" }
    // Neither the session name, mode/clock, nor hint line is a tab.
    let _session = mouse_click(p, legacy, 2, 23)
    let _field = mouse_click(p, legacy, 30, 23)
    let _hints = mouse_click(p, legacy, 6, 24)
    drain(mut p, 100)
    if active_label(p.image, "b") != "4" { return "a non-tab bar cell switched tabs" }
    finish(mut r, mut p)
}

fn mouse_probe_helper(path: str, encoding: int) -> int {
    let was = term.mode(fs.stdin()) else { return 1 }
    term.set_mode(fs.stdin(), term.raw_bytes(was)) else { return 1 }
    if encoding != 0 { print("\u{1b}[?1003h") }
    if encoding == 1 { print("\u{1b}[?1006h") }
    fs.write_text(path, "ready\n") else { return 1 }
    var tty = fs.stdin()
    while true {
        let got = fs.read_chunk(mut tty, 256) else { break }
        if got.len == 0 { break }
        for b in got { fs.append_text(path, "b {b as int}\n") else |_| {} }
    }
    term.set_mode(fs.stdin(), was) else |_| {}
    0
}

// Freeze one client's painted spans while a second client changes the live
// labels. The press names the tab still drawn, not the new label under it.
fn row_mouse_tab_snapshot(mut r: Rig, legacy: bool) -> str {
    let why = start_server(mut r, "cat")
    if why.len > 0 { return why }
    var a = attach(r, 40, 24, "b", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 3000) { return "first frame" }
    let _rename1 = prefix(a, 44)
    let _a = type_keys(a, "a")
    let _done1 = enter(a)
    let _new = prefix(a, 99)
    if !until_active(mut a, "b", "2", 3000) { return "second tab: active='" + active_label(a.image, "b") + "' screen='" + client.screen_text(a) + "'" }
    let _rename2 = prefix(a, 44)
    let _b = type_keys(a, "b")
    let _done2 = enter(a)
    let _first = prefix(a, 49)
    let painted = until_line_one(mut a, " b  1:a  2:b ", [1, 3, 4, 8], 3000)
    if painted.len > 0 { return "initial painted spans: " + painted }
    a.auto_ack = false
    var b = attach(r, 40, 24, "b", 0) else |e| { return "second-client-{e}" }
    if !client.until_kind(mut b, 131, 3000) { return "second client frame" }
    let _rename = prefix(b, 44)
    let _clear = client.key(b, 4, 0, 117)
    let _shift = type_keys(b, "name-shift")
    let _commit = enter(b)
    if !until_active(mut b, "b", "1:name-shift", 3000) { return "controlled label shift" }
    // Do not read a new image on a: column 10 still visibly belongs to tab 2.
    if cells(a.image, 23, 10, 3) != "2:b" { return "the frozen fixture did not paint tab two at column ten" }
    if !mouse_click(a, legacy, 10, 23) { return "snapshot click encoding" }
    a.auto_ack = true
    if !until_active(mut a, "b", "2:b", 3000) {
        client.hang_up(mut b)
        return "click used live labels instead of painted tab two: active='" + active_label(a.image, "b") + "'"
    }
    if !until_active(mut b, "b", "2:b", 3000) { return "tab switch did not reach the second client" }
    client.hang_up(mut b)
    finish(mut r, mut a)
}

// Removing a tab must not retarget its old painted label to the successor.
fn row_mouse_tab_removed(mut r: Rig, legacy: bool) -> str {
    let why = start_server(mut r, "cat")
    if why.len > 0 { return why }
    var a = attach(r, 40, 24, "b", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 3000) { return "first frame" }
    let _two = prefix(a, 99)
    if !until_active(mut a, "b", "2", 3000) { return "second tab" }
    let _three = prefix(a, 99)
    let painted = until_line_one(mut a, " b  1  2  3 ", [1, 3, 10, 12], 3000)
    if painted.len > 0 { return "three painted tabs: " + painted }
    a.auto_ack = false
    var b = attach(r, 40, 24, "b", 0) else |e| { return "second-client-{e}" }
    if !client.until_kind(mut b, 131, 3000) { return "second client frame" }
    let _target = prefix(b, 50)
    if !until_active(mut b, "b", "2", 3000) { return "target tab two" }
    let _close = prefix(b, 120)
    let _yes = client.key(b, 0, 0, 121)
    let _first = prefix(b, 49)
    let now = until_line_one(mut b, " b  1  2 ", [1, 3, 4, 6], 3000)
    if now.len > 0 { return "tab two was not removed: " + now }
    if cells(a.image, 23, 8, 1) != "2" { return "frozen removed-tab fixture" }
    if !mouse_click(a, legacy, 8, 23) { return "removed-tab click encoding" }
    a.auto_ack = true
    if !until_active(mut a, "b", "1", 3000) {
        client.hang_up(mut b)
        return "removed tab's old span retargeted its successor: active='" + active_label(a.image, "b") + "'"
    }
    if !until_active(mut b, "b", "1", 3000) { return "removed-tab gesture changed session focus" }
    client.hang_up(mut b)
    finish(mut r, mut a)
}

// Replacing a tab can leave every pixel and the cursor identical. Its new
// identity still needs an ACKable (zero-cell) FRAME, not a stale map until
// unrelated output or the next clock tick happens to repaint something.
fn row_mouse_tab_identity_frame(mut r: Rig) -> str {
    let phase = time.unix_ms() % 60000
    if phase > 55000 { time.sleep(time.millis(60100 - phase)) }
    let why = start_server(mut r, "cat")
    if why.len > 0 { return why }
    var a = attach(r, 40, 24, "b", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 3000) { return "first frame" }
    let _two = prefix(a, 99)
    let ready = until_line_one(mut a, " b  1  2 ", [1, 3, 7, 9], 3000)
    if ready.len > 0 { return "two tabs: " + ready }
    var b = attach(r, 40, 24, "b", 0) else |e| { return "second-client-{e}" }
    if !client.until_kind(mut b, 131, 3000) { return "second client frame" }
    drain(mut a, 50)
    let previous = a.image.seq
    var batch = List[byte]()
    for code in [0, 120, 121, 0, 99] {
        var key = List[byte]()
        proto.put(mut key, if code == 0 then 4 else 0, 1)
        proto.put(mut key, 0, 1)
        proto.put(mut key, if code == 0 then 32 else code, 4)
        let frame = proto.encode(2, 0, key)
        if frame.code != 0 { return "identity fixture key encoding" }
        for x in frame.bytes { (mut batch).push(x) }
    }
    if !client.send_raw(b, batch) { return "replacement batch" }
    let frame = next_image(mut a, 3000)
    if frame.len == 0 { client.hang_up(mut b); return "changed tab identities never published an ACKable image" }
    if le(frame, 0, 4) != previous + 1 || le(frame, 4, 4) != previous || le(frame, 18, 4) != 0 {
        client.hang_up(mut b)
        return "identity-only publication must be a consecutive zero-cell delta"
    }
    let unchanged = line_one_is(a.image, " b  1  2 ", [1, 3, 7, 9])
    if unchanged.len > 0 { return "replacement changed visible labels: " + unchanged }
    let _first = prefix(b, 49)
    if !until_active(mut b, "b", "1", 3000) { return "first tab after replacement" }
    if !mouse_click(a, false, 8, 23) { return "replacement click encoding" }
    if !until_active(mut b, "b", "2", 3000) { return "acknowledged identity map did not target the replacement tab" }
    drain(mut a, 100)
    client.hang_up(mut b)
    finish(mut r, mut a)
}

// Border gestures belong to the split hit, not to the focused program.
fn row_mouse_border(mut r: Rig, legacy: bool) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no image" }
    let _split = prefix(p, 124)
    if !until_rect(mut p, "│", 40, 1, 1, AREA, 5000) { return "no vertical split" }
    let _click = mouse_click(p, legacy, 40, 3)
    drain(mut p, 100)
    if !rect_has(p.image, "│", 40, 1, 1, AREA) { return "plain border click resized" }
    let _down = outer_mouse(p, legacy, 0, 40, 3)
    let _move = outer_mouse(p, legacy, 2, 46, 3)
    if !until_rect(mut p, "│", 46, 1, 1, AREA, 3000) { return "border did not follow drag" }
    let _up = outer_mouse(p, legacy, 1, 46, 3)
    let _stray = outer_mouse(p, legacy, 2, 50, 3)
    drain(mut p, 100)
    if !rect_has(p.image, "│", 46, 1, 1, AREA) { return "released border kept moving" }
    let _again = outer_mouse(p, legacy, 0, 46, 3)
    let _minimum = outer_mouse(p, legacy, 2, 1, 3)
    if !until_rect(mut p, "│", 3, 1, 1, AREA, 3000) { return "left minimum was not clamped" }
    let _right = outer_mouse(p, legacy, 2, 80, 3)
    if !until_rect(mut p, "│", 78, 1, 1, AREA, 3000) { return "right minimum was not clamped" }
    let _end = outer_mouse(p, legacy, 1, 80, 24)
    let _equal = prefix(p, 61)
    if !until_rect(mut p, "│", 40, 1, 1, AREA, 3000) { return "equalize failed" }
    let _horizontal = prefix(p, 45)
    if !until_rect(mut p, "─", 41, 11, 40, 1, 3000) { return "no nested horizontal split" }
    let _hdown = outer_mouse(p, legacy, 0, 45, 11)
    let _hmove = outer_mouse(p, legacy, 2, 1, 15)
    if !until_rect(mut p, "─", 41, 15, 40, 1, 3000) { return "origin horizontal split lost on cross-pane motion" }
    let _hup = outer_mouse(p, legacy, 1, 1, 15)
    finish(mut r, mut p)
}

fn run_row(warren: str, name: str) -> str {
    var r = rig(warren, name)
    var why = "no such row"
    if name == "split-sizes" { why = row_split_sizes(mut r) }
    else if name == "mouse-tab-snapshot-sgr" { why = row_mouse_tab_snapshot(mut r, false) }
    else if name == "mouse-tab-snapshot-x10" { why = row_mouse_tab_snapshot(mut r, true) }
    else if name == "mouse-tab-removed-sgr" { why = row_mouse_tab_removed(mut r, false) }
    else if name == "mouse-tab-removed-x10" { why = row_mouse_tab_removed(mut r, true) }
    else if name == "mouse-tab-identity-frame" { why = row_mouse_tab_identity_frame(mut r) }
    else if name == "mouse-border-sgr" { why = row_mouse_border(mut r, false) }
    else if name == "mouse-border-legacy" { why = row_mouse_border(mut r, true) }
    else if name == "mouse-sgr-off" { why = row_mouse_focus(mut r, false, 0) }
    else if name == "mouse-sgr-sgr" { why = row_mouse_focus(mut r, false, 1) }
    else if name == "mouse-sgr-legacy" { why = row_mouse_focus(mut r, false, 2) }
    else if name == "mouse-tabs-sgr" { why = row_mouse_tabs(mut r, false) }
    else if name == "mouse-legacy-off" { why = row_mouse_focus(mut r, true, 0) }
    else if name == "mouse-legacy-sgr" { why = row_mouse_focus(mut r, true, 1) }
    else if name == "mouse-legacy-legacy" { why = row_mouse_focus(mut r, true, 2) }
    else if name == "mouse-tabs-legacy" { why = row_mouse_tabs(mut r, true) }
    else if name == "keys-reach-focused" { why = row_keys_reach_focused(mut r) }
    else if name == "sigwinch-on-change" { why = row_sigwinch(mut r) }
    else if name == "close-hangs-up" { why = row_close_hangs_up(mut r) }
    else if name == "exit-closes-pane" { why = row_exit_closes_pane(mut r) }
    else if name == "tabs" { why = row_tabs(mut r) }
    else if name == "resize-all-tabs" { why = row_resize_all_tabs(mut r) }
    else if name == "zoom" { why = row_zoom(mut r) }
    else if name == "too-small" { why = row_too_small(mut r) }
    else if name == "pane-memory" { why = row_pane_memory(mut r) }
    else if name == "pane-limit" { why = row_pane_limit(mut r) }
    else if name == "frame-golden" { why = row_frame_golden(mut r) }
    else if name == "damage-in-rect" { why = row_damage_in_rect(mut r) }
    else if name == "focus-bytes" { why = row_focus_bytes(mut r, false) }
    else if name == "focus-prefix-bytes" { why = row_focus_bytes(mut r, true) }
    else if name == "keys-in-split" { why = row_keys_in_split(mut r) }
    else if name == "split-latency" { why = row_split_latency(mut r) }
    else if name == "split-close-cycles" { why = row_split_close_cycles(mut r) }
    else if name == "mode-field" { why = row_mode_field(mut r) }
    else if name == "hint-line" { why = row_hint_line(mut r) }
    else if name == "prefix-twice" { why = row_prefix_twice(mut r) }
    else if name == "locked" { why = row_locked(mut r) }
    else if name == "pane-mode" { why = row_pane_mode(mut r) }
    else if name == "tab-mode" { why = row_tab_mode(mut r) }
    else if name == "resize-mode" { why = row_resize_mode(mut r) }
    else if name == "session-mode" { why = row_session_mode(mut r) }
    else if name == "confirm-close" { why = row_confirm_close(mut r) }
    else if name == "rename-tab" { why = row_rename_tab(mut r) }
    else if name == "command-mode" { why = row_command_mode(mut r) }
    else if name == "modes-per-client" { why = row_modes_per_client(mut r) }
    else if name == "input-in-modes" { why = row_input_in_modes(mut r) }
    else if name == "help-overlay" { why = row_help_overlay(mut r) }
    else if name == "bar-line-one" { why = row_bar_line_one(mut r) }
    else if name == "zoom-mark" { why = row_zoom_mark(mut r) }
    else if name == "activity-marks" { why = row_activity_marks(mut r) }
    else if name == "clock" { why = row_clock(mut r) }
    else if name == "clock-tick" { why = row_clock_tick(mut r) }
    else if name == "pane-cost" { why = row_pane_cost(mut r) }
    if r.started { let _s = stop_server(mut r) }
    why
}

fn all_rows() -> List[str] {
    var x = List[str]()
    for n in "mouse-tab-snapshot-sgr mouse-tab-snapshot-x10 mouse-tab-removed-sgr mouse-tab-removed-x10 mouse-tab-identity-frame mouse-sgr-off mouse-sgr-sgr mouse-sgr-legacy mouse-tabs-sgr mouse-legacy-off mouse-legacy-sgr mouse-legacy-legacy mouse-tabs-legacy split-sizes keys-reach-focused sigwinch-on-change close-hangs-up exit-closes-pane tabs resize-all-tabs zoom too-small pane-memory frame-golden damage-in-rect focus-bytes focus-prefix-bytes keys-in-split split-latency mode-field hint-line prefix-twice locked pane-mode tab-mode resize-mode session-mode confirm-close rename-tab command-mode modes-per-client input-in-modes help-overlay bar-line-one zoom-mark activity-marks clock clock-tick".split(" ") {
        (mut x).push(n)
    }
    x
}

// ---------------- helpers run inside panes ----------------

fn print_size(tag: str) -> int {
    let size = term.size(fs.stdin()) else |e| {
        print("size-{e}")
        return 1
    }
    print("{tag} {size.rows} {size.columns}")
    0
}

fn winch_helper(path: str, tag: str) -> int {
    let set = signal.resize() | signal.reload()
    signal.listen(set) else |e| {
        print("winch-listen-{e}")
        return 1
    }
    let s0 = term.size(fs.stdin()) else |e| {
        print("size-{e}")
        return 1
    }
    fs.append_text(path, "{tag} start {s0.rows} {s0.columns}\n") else |_| {}
    print("{tag} watching")
    var n = 0
    while n < 100000 {
        let m = signal.wait(set) else { return 1 }
        if m & signal.reload() != 0 { return 0 }
        if m & signal.resize() != 0 {
            let s = term.size(fs.stdin()) else { return 1 }
            fs.append_text(path, "{tag} winch {s.rows} {s.columns}\n") else |_| {}
        }
        n += 1
    }
    0
}

fn hup_helper(path: str) -> int {
    let set = signal.reload()
    signal.listen(set) else |e| {
        print("hup-listen-{e}")
        return 1
    }
    let pid = env.pid()
    fs.append_text(path, "ready {pid}\n") else |_| {}
    print("hup-waiting")
    let m = signal.wait(set) else { return 1 }
    if m & signal.reload() != 0 { fs.append_text(path, "hangup {pid}\n") else |_| {} }
    0
}

// Raw mode on its terminal, N bytes read, their hex appended; the mode put
// back.
fn read_bytes_helper(path: str, count: int) -> int {
    let was = term.mode(fs.stdin()) else |e| {
        print("mode-{e}")
        return 1
    }
    term.set_mode(fs.stdin(), term.raw_bytes(was)) else |e| {
        print("raw-{e}")
        return 1
    }
    fs.append_text(path, "ready\n") else |_| {}
    var hex = ""
    var n = 0
    var tty = fs.stdin()
    while n < count {
        let got = fs.read_chunk(mut tty, count - n) else { break }
        for b in got {
            let v = b as int
            let digits = "0123456789abcdef"
            hex = hex + " " + digits[v / 16..v / 16 + 1] + digits[v % 16..v % 16 + 1]
            n += 1
        }
    }
    term.set_mode(fs.stdin(), was) else |_| {}
    fs.append_text(path, "bytes{hex}\n") else |_| {}
    0
}

fn main() -> int {
    let args = env.args()
    if args.len == 3 && args[0] == "--mouse-probe" { return mouse_probe_helper(args[1], args[2].to_int() else 0) }
    if args.len == 3 && args[0] == "--read-bytes" { return read_bytes_helper(args[1], args[2].to_int() else 1) }
    if args.len == 2 && args[0] == "--print-size" { return print_size(args[1]) }
    if args.len == 3 && args[0] == "--winch" { return winch_helper(args[1], args[2]) }
    if args.len == 2 && args[0] == "--hup" { return hup_helper(args[1]) }
    if args.len < 1 {
        eprint("usage: pane_rows WARREN [ROW...]")
        return 2
    }
    let warren = args[0]
    var rows = List[str]()
    var i = 1
    while i < args.len {
        (mut rows).push(args[i])
        i += 1
    }
    if rows.len == 0 { rows = all_rows() }
    var failed = 0
    for name in rows {
        let t0 = now_ms()
        let why = run_row(warren, name)
        let t = now_ms() - t0
        if why.len == 0 {
            print("PASS {name} ms={t}")
        } else {
            failed += 1
            print("FAIL {name} {why}")
        }
    }
    print("PANE-ROWS rows={rows.len} failed={failed}")
    if failed > 0 { return 1 }
    0
}
