//! member: true
//! Seeded random operation sequences, every invariant held after every
//! operation, at each of the five sizes. Also constructed grids for
//! invariant 6, which random sequences rarely make.
use layout

/// The rows a property take reports, by index.
fn row_name(i: int) -> str {
    if i == 0 { return "layout-refusal-unchanged" }
    if i == 1 { return "layout-inv1-tiling" }
    if i == 2 { return "layout-inv2-structure" }
    if i == 3 { return "layout-inv3-shares" }
    if i == 4 { return "layout-inv4-split-close" }
    if i == 5 { return "layout-inv5-resize-back" }
    "layout-inv6-focus-back"
}

fn op_name(k: int) -> str {
    if k == 0 { return "split" }
    if k == 1 { return "close" }
    if k == 2 { return "focus" }
    if k == 3 { return "focus_pane" }
    if k == 4 { return "focus_next" }
    if k == 5 { return "focus_previous" }
    if k == 6 { return "resize" }
    if k == 7 { return "zoom" }
    if k == 8 { return "equalize" }
    if k == 9 { return "new_tab" }
    if k == 10 { return "close_tab" }
    if k == 11 { return "select_tab" }
    if k == 12 { return "select_tab_id" }
    if k == 13 { return "next_tab" }
    if k == 14 { return "previous_tab" }
    "rename_tab"
}

struct Rng {
    state: int,
}

fn roll(mut g: Rng, n: int) -> int {
    g.state = (g.state * 48271) % 2147483647
    g.state % n
}

/// One size's counts: per row, checks and failures (and attempts for the
/// rows that need a precondition); per operation kind, applied and refused.
struct Tally {
    checks: List[int],
    fails: List[int],
    attempts: List[int],
    applied: List[int],
    refused: List[int],
}

fn zeros(n: int) -> List[int] {
    var xs = List[int]()
    var i = 0
    while i < n {
        (mut xs).push(0)
        i += 1
    }
    xs
}

fn tally() -> Tally {
    Tally { checks: zeros(7), fails: zeros(7), attempts: zeros(7), applied: zeros(16), refused: zeros(16) }
}

/// Count one check of `row`; print the first failure of each row at a size.
fn judge(mut t: Tally, row: int, why: str, cols: int, rows: int, seq: int, step: int, x: Done) {
    t.checks[row] += 1
    if why.len == 0 { return }
    if t.fails[row] == 0 {
        print("FAIL {row_name(row)} size={cols}x{rows} sequence={seq} step={step} op={label(x)}: {why}")
    }
    t.fails[row] += 1
}

fn all_panes(l: layout.Layout) -> List[int] {
    var ps = List[int]()
    for t in l.tabs {
        for p in layout.panes(l, t.id) { (mut ps).push(p) }
    }
    ps
}

fn pick_pane(mut g: Rng, ps: List[int], fresh: int) -> int {
    if roll(mut g, 20) == 0 { return fresh + 100 }
    ps[roll(mut g, ps.len)]
}

fn pick_tab(mut g: Rng, l: layout.Layout) -> int {
    if roll(mut g, 20) == 0 { return l.next_id + 5 }
    l.tabs[roll(mut g, l.tabs.len)].id
}

fn pick_new(mut g: Rng, ps: List[int], fresh: int) -> int {
    let r = roll(mut g, 25)
    if r == 0 { return ps[roll(mut g, ps.len)] }
    if r == 1 { return 0 - roll(mut g, 3) }
    fresh
}

fn pick_name(mut g: Rng) -> str {
    let r = roll(mut g, 6)
    if r == 0 { return "" }
    if r == 1 { return "a" }
    if r == 2 { return "build" }
    if r == 3 { return "x y" }
    if r == 4 { return "q\"b\\" }
    "é"
}

fn kind_of(r: int) -> int {
    if r < 30 { return 0 }
    if r < 42 { return 1 }
    if r < 52 { return 2 }
    if r < 56 { return 3 }
    if r < 58 { return 4 }
    if r < 60 { return 5 }
    if r < 76 { return 6 }
    if r < 81 { return 7 }
    if r < 83 { return 8 }
    if r < 89 { return 9 }
    if r < 92 { return 10 }
    if r < 94 { return 11 }
    if r < 95 { return 12 }
    if r < 97 { return 13 }
    if r < 98 { return 14 }
    15
}

/// What an operation did: its kind, whether it refused, its arguments for
/// a failure line (formatted only then), and anything it answered that
/// broke its contract.
struct Done {
    kind: int,
    refused: bool,
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    why: str,
}

fn done(kind: int, refused: bool, a: int, b: int, c: int, d: int, e: int) -> Done {
    Done { kind: kind, refused: refused, a: a, b: b, c: c, d: d, e: e, why: "" }
}

fn label(x: Done) -> str {
    let r = if x.refused then " (refused)" else ""
    "{op_name(x.kind)} {x.a} {x.b} {x.c} {x.d} {x.e}{r}"
}

fn apply(mut l: layout.Layout, mut g: Rng, fresh: int, cols: int, rows: int) -> Done {
    let ps = all_panes(l)
    let k = kind_of(roll(mut g, 100))
    let pane = pick_pane(mut g, ps, fresh)
    let tab = pick_tab(mut g, l)
    let d = roll(mut g, 4)
    if k == 0 {
        let owner = layout.tab_of(l, pane)
        let t = if roll(mut g, 10) == 0 then tab else owner
        let axis = roll(mut g, 2)
        let after = roll(mut g, 2)
        let id = pick_new(mut g, ps, fresh)
        layout.split(mut l, t, pane, axis, id, after == 0, cols, rows) else |_| { return done(k, true, t, pane, axis, id, after) }
        return done(k, false, t, pane, axis, id, after)
    }
    if k == 1 {
        layout.close(mut l, pane) else |_| { return done(k, true, pane, 0, 0, 0, 0) }
        return done(k, false, pane, 0, 0, 0, 0)
    }
    if k == 2 {
        layout.focus(mut l, tab, d, cols, rows) else |_| { return done(k, true, tab, d, 0, 0, 0) }
        return done(k, false, tab, d, 0, 0, 0)
    }
    if k == 3 {
        layout.focus_pane(mut l, pane) else |_| { return done(k, true, pane, 0, 0, 0, 0) }
        return done(k, false, pane, 0, 0, 0, 0)
    }
    if k == 4 {
        layout.focus_next(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 5 {
        layout.focus_previous(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 6 {
        let cells = roll(mut g, 13) - 6
        let moved = layout.resize(mut l, pane, d, cells, cols, rows) else |_| { return done(k, true, pane, d, cells, 0, 0) }
        var x = done(k, false, pane, d, cells, moved, 0)
        if moved * cells < 0 || moved > cells && cells >= 0 || moved < cells && cells <= 0 {
            x.why = "resize by {cells} answered {moved}"
        }
        return x
    }
    if k == 7 {
        layout.zoom(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 8 {
        layout.equalize(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 9 {
        let id = pick_new(mut g, ps, fresh)
        let made = layout.new_tab(mut l, id, pick_name(mut g)) else |_| { return done(k, true, id, 0, 0, 0, 0) }
        return done(k, false, id, made, 0, 0, 0)
    }
    if k == 10 {
        layout.close_tab(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 11 {
        let n = roll(mut g, l.tabs.len + 2)
        layout.select_tab(mut l, n) else |_| { return done(k, true, n, 0, 0, 0, 0) }
        return done(k, false, n, 0, 0, 0, 0)
    }
    if k == 12 {
        layout.select_tab_id(mut l, tab) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
        return done(k, false, tab, 0, 0, 0, 0)
    }
    if k == 13 {
        layout.next_tab(mut l)
        return done(k, false, 0, 0, 0, 0, 0)
    }
    if k == 14 {
        layout.previous_tab(mut l)
        return done(k, false, 0, 0, 0, 0, 0)
    }
    layout.rename_tab(mut l, tab, pick_name(mut g)) else |_| { return done(k, true, tab, 0, 0, 0, 0) }
    done(k, false, tab, 0, 0, 0, 0)
}

/// The layout with one tab unzoomed, as a split or a resize leaves it.
fn unzoomed(l: layout.Layout, tab: int) -> layout.Layout {
    var m = copy l
    let ti = index_of(m, tab)
    if ti >= 0 { m.tabs[ti].zoomed = false }
    m
}

/// Invariant 4: split a pane and close the new one; `made` counts the
/// splits that were not refused.
fn split_close(l: layout.Layout, mut g: Rng, fresh: int, cols: int, rows: int, mut made: int) -> str {
    let ps = all_panes(l)
    let pane = ps[roll(mut g, ps.len)]
    let tab = layout.tab_of(l, pane)
    var m = copy l
    layout.split(mut m, tab, pane, roll(mut g, 2), fresh, roll(mut g, 2) == 0, cols, rows) else |_| { return "" }
    made += 1
    layout.close(mut m, fresh) else |e| { return "close of the new pane {fresh}: {e}" }
    if !same_layout(unzoomed(l, tab), m) { return "split {pane} then close {fresh} changed the layout" }
    ""
}

/// Invariant 5: resize by +n then -n; equal rects when neither was clamped.
/// `accepted` counts first resizes not refused, `made` round trips judged.
fn resize_back(l: layout.Layout, mut g: Rng, cols: int, rows: int, mut accepted: int, mut made: int) -> str {
    let ps = all_panes(l)
    let pane = ps[roll(mut g, ps.len)]
    let tab = layout.tab_of(l, pane)
    let d = roll(mut g, 4)
    let n = 1 + roll(mut g, 5)
    var m = copy l
    let there = layout.resize(mut m, pane, d, n, cols, rows) else |_| { return "" }
    accepted += 1
    if there != n { return "" }
    let back = layout.resize(mut m, pane, d, 0 - n, cols, rows) else |e| { return "resize {pane} {d} back by {n}: {e}" }
    if back != 0 - n { return "" }
    made += 1
    let a = layout.rects(unzoomed(l, tab), tab, cols, rows)
    let b = layout.rects(m, tab, cols, rows)
    var i = 0
    while i < a.len {
        let x = copy a[i]
        let y = copy b[i]
        if x.pane != y.pane || x.col != y.col || x.row != y.row || x.cols != y.cols || x.rows != y.rows {
            return "resize {pane} {d} by {n} and back moved pane {x.pane}"
        }
        i += 1
    }
    ""
}

fn check_all(mut t: Tally, before: layout.Layout, l: layout.Layout, x: Done, mut g: Rng, fresh: int,
    cols: int, rows: int, seq: int, step: int) {
    if x.refused {
        var why = ""
        if !same_layout(before, l) { why = "a refused operation changed the layout" }
        judge(mut t, 0, why, cols, rows, seq, step, x)
    }
    for tab in l.tabs {
        judge(mut t, 1, tiling(l, tab.id, cols, rows), cols, rows, seq, step, x)
    }
    judge(mut t, 2, structure(l), cols, rows, seq, step, x)
    var why = shares_kept(before, l, x.kind == 6, x.kind == 8)
    if why.len == 0 { why = reveals(l, l.active, cols, rows) }
    judge(mut t, 3, why, cols, rows, seq, step, x)
    var made = 0
    let split_why = split_close(l, mut g, fresh + 1, cols, rows, mut made)
    t.attempts[4] += 1
    if made > 0 { judge(mut t, 4, split_why, cols, rows, seq, step, x) }
    if x.why.len > 0 { judge(mut t, 5, x.why, cols, rows, seq, step, x) }
    var accepted = 0
    made = 0
    let resize_why = resize_back(l, mut g, cols, rows, mut accepted, mut made)
    t.attempts[5] += accepted
    if made > 0 || resize_why.len > 0 { judge(mut t, 5, resize_why, cols, rows, seq, step, x) }
    let rs = layout.rects(l, l.active, cols, rows)
    if rs.len > 1 && grid(rs) {
        var trips = 0
        let back_why = focus_back(l, l.active, cols, rows, mut trips)
        t.attempts[6] += 1
        judge(mut t, 6, back_why, cols, rows, seq, step, x)
    }
}

fn sequence(mut t: Tally, cols: int, rows: int, seq: int, seed: int, length: int) {
    var g = Rng { state: seed }
    var l = layout.new(1, "t") else |_| {
        judge(mut t, 2, "new refused pane 1", cols, rows, seq, 0, done(0, true, 1, 0, 0, 0, 0))
        return
    }
    var fresh = 2
    var step = 0
    while step < length {
        let before = copy l
        let x = apply(mut l, mut g, fresh, cols, rows)
        if x.kind == 0 || x.kind == 9 { fresh += 1 }
        t.applied[x.kind] += 1
        if x.refused { t.refused[x.kind] += 1 }
        check_all(mut t, before, l, x, mut g, fresh, cols, rows, seq, step)
        step += 1
    }
}

/// Grids of every shape up to 4x4 built at the size; invariants 1 and 6.
fn grids(mut t: Tally, cols: int, rows: int) {
    var across = 1
    while across <= 4 {
        var down = 1
        while down <= 4 {
            region grid_take {
                grid_one(mut t, cols, rows, across, down)
            }
            down += 1
        }
        across += 1
    }
}

fn grid_one(mut t: Tally, cols: int, rows: int, across: int, down: int) {
    var l = layout.new(1, "grid") else |_| { return }
    var next = 2
    var tops = List[int]()
    (mut tops).push(1)
    var c = 1
    while c < across {
        layout.split(mut l, 1, tops[tops.len - 1], layout.COLS, next, true, cols, rows) else |_| { return }
        (mut tops).push(next)
        next += 1
        c += 1
    }
    for top in tops {
        var last = top
        var r = 1
        while r < down {
            layout.split(mut l, 1, last, layout.ROWS, next, true, cols, rows) else |_| { return }
            last = next
            next += 1
            r += 1
        }
    }
    let x = done(0, false, across, down, 0, 0, 0)
    judge(mut t, 1, tiling(l, 1, cols, rows), cols, rows, -1, 0, x)
    let rs = layout.rects(l, 1, cols, rows)
    var why = ""
    if !grid(rs) { why = "a constructed {across}x{down} grid is not a grid" }
    var trips = 0
    if why.len == 0 { why = focus_back(l, 1, cols, rows, mut trips) }
    t.attempts[6] += 1
    judge(mut t, 6, why, cols, rows, -1, 0, x)
}

/// One line per row; with `whole`, a row never checked is a failure (a
/// chunk of a larger take prints it as unexercised for the rig to sum).
fn report(t: Tally, cols: int, rows: int, first: int, count: int, whole: bool) -> int {
    var failed = 0
    var row = 0
    while row < 7 {
        let name = row_name(row)
        let span = "size={cols}x{rows} sequences={first}..{first + count - 1}"
        if t.fails[row] > 0 {
            print("FAIL {name} {span} failures={t.fails[row]} checks={t.checks[row]}")
            failed += 1
        } else if t.checks[row] == 0 && whole {
            print("FAIL {name} {span} never-exercised attempts={t.attempts[row]}")
            failed += 1
        } else if t.checks[row] == 0 {
            print("INFO {name} {span} unexercised attempts={t.attempts[row]}")
        } else {
            print("PASS {name} {span} checks={t.checks[row]} attempts={t.attempts[row]}")
        }
        row += 1
    }
    var ops = ""
    var k = 0
    while k < 16 {
        ops = ops + " {op_name(k)}={t.applied[k]}/{t.refused[k]}"
        k += 1
    }
    print("INFO layout-ops size={cols}x{rows} applied/refused{ops}")
    failed
}

/// The five sizes, by index: 20x6, 80x24, 81x25, 320x90, 512x512.
fn size_cols(index: int) -> int {
    if index == 0 { return 20 }
    if index == 1 { return 80 }
    if index == 2 { return 81 }
    if index == 3 { return 320 }
    512
}

fn size_rows(index: int) -> int {
    if index == 0 { return 6 }
    if index == 1 { return 24 }
    if index == 2 { return 25 }
    if index == 3 { return 90 }
    512
}

/// Sequences `first` .. `first + count - 1` of 50 operations at size
/// `index` (seeded by size and number, so any range is a slice of the same
/// take), with the constructed grids when `first` is 0. `whole` says the
/// range is the whole take at that size. Answers the failing rows.
pub fn properties_at(index: int, first: int, count: int, whole: bool) -> int {
    let cols = size_cols(index)
    let rows = size_rows(index)
    var t = tally()
    var seq = first
    while seq < first + count {
        region turn {
            sequence(mut t, cols, rows, seq, 1 + index * 100003 + seq * 7919, 50)
        }
        seq += 1
    }
    if first == 0 { grids(mut t, cols, rows) }
    report(t, cols, rows, first, count, whole)
}

/// `count` sequences of 50 operations at each size; answers the number of
/// failing rows.
pub fn properties(count: int) -> int {
    var failed = 0
    var index = 0
    while index < 5 {
        failed += properties_at(index, 0, count, true)
        index += 1
    }
    print("LAYOUT-PROPERTIES sizes=5 sequences={count * 5} length=50 failed-rows={failed}")
    failed
}
