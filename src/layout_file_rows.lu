//! member: false
//! The layout file round trip (`layout-file-round-trip`, src/layout_rows/
//! files.lu). With no arguments: 2000 sequences at each of the five sizes,
//! natively. With `SIZE FIRST COUNT`: that slice, for the reference
//! interpreter. With `--sample DIR`: the first 512 files the round trip
//! writes (about a fifth from each size, in sequence order), each with
//! warren's TOML reading of it, for tests/config/layout_files.py
//! (`layout-files-tomllib`).
use std.env
use std.fs
use config
use layout_rows

fn sample(dir: str) -> int {
    fs.create_dir_all(dir) else |_| {
        print("FAIL layout-files-sample the directory {dir} was not made")
        return 1
    }
    var kept = 0
    var index = 0
    while index < 5 && kept < 512 {
        var seq = 0
        var here = 0
        while here < 103 && kept < 512 {
            let text = layout_rows.file_sample(index, seq)
            if text != "" {
                var lines = ""
                for line in config.toml_reading(config.parse_toml(text)) { lines = lines + line + "\n" }
                let base = "{dir}/{index}-{seq}"
                fs.write_text(base + ".toml", text) else |_| {
                    print("FAIL layout-files-sample {base}.toml was not written")
                    return 1
                }
                fs.write_text(base + ".reading", lines) else |_| {
                    print("FAIL layout-files-sample {base}.reading was not written")
                    return 1
                }
                kept += 1
                here += 1
            }
            seq += 1
        }
        index += 1
    }
    print("PASS layout-files-sample files={kept} dir={dir}")
    0
}

fn main() -> int {
    let args = env.args()
    if args.len == 2 && args[0] == "--sample" { return sample(args[1]) }
    if args.len == 3 {
        let index = args[0].to_int() else -1
        let first = args[1].to_int() else -1
        let count = args[2].to_int() else -1
        if index < 0 || index > 4 || first < 0 || count < 1 {
            print("FAIL layout-file-round-trip arguments size={index} first={first} count={count}")
            return 2
        }
        return layout_rows.file_round_trips(index, first, count)
    }
    if args.len != 0 {
        print("FAIL layout-file-round-trip usage: [SIZE FIRST COUNT | --sample DIR]")
        return 2
    }
    var failed = 0
    var index = 0
    while index < 5 {
        failed += layout_rows.file_round_trips(index, 0, 2000)
        index += 1
    }
    if failed > 0 { return 1 }
    0
}
