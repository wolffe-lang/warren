//! member: true
//! The key table: modes, actions, the default bindings, what one key does in
//! a mode, the hint line and the key list read from the same table, and the
//! command line's verbs.
//!
//! Pure: no I/O. The server's dispatcher calls `step` and performs the action
//! it names; the hint line and the key list are generated from `bindings`, so
//! the three cannot disagree. KEY events arrive as PROTOCOL has them: a scalar
//! with shift folded in (`H` is 72), `C-p` the scalar `p` with ctrl (4), named
//! keys by number (1 Up, 2 Down, 3 Right, 4 Left, 11 Backspace, 13 Enter,
//! 14 Escape).

/// Everything to the focused pane except the prefix.
pub const MODE_NORMAL: int = 0
/// One key of the prefix table, then back to normal.
pub const MODE_PREFIX: int = 1
/// Sticky: split, focus, close, zoom.
pub const MODE_PANE: int = 2
/// Sticky: switch, open, close and rename tabs.
pub const MODE_TAB: int = 3
/// Sticky: move borders.
pub const MODE_RESIZE: int = 4
/// Sticky: detach.
pub const MODE_SESSION: int = 5
/// Everything to the pane, the prefix included; left only with `C-g`.
pub const MODE_LOCKED: int = 6
/// A line of the key table's action names, typed on the hint line.
pub const MODE_COMMAND: int = 7
/// The active tab's new name, typed on the hint line.
pub const MODE_RENAME: int = 8
/// `y` runs the action waiting for it; any other key cancels.
pub const MODE_CONFIRM: int = 9
/// The key list over the tab area, for this client only.
pub const MODE_HELP: int = 10
/// Sticky: a window over the pane's history; left with `q`, Esc or Enter.
pub const MODE_SCROLL: int = 11
/// How many modes there are.
pub const MODES: int = 12
/// A step's next mode: the mode the client was in before confirm, help or a
/// prompt (a sticky mode, or normal). The server keeps it.
pub const MODE_BACK: int = -1

/// No action: the key is dropped.
pub const A_NONE: int = 0
/// Split the focused pane; arg is the axis (0: side by side).
pub const A_SPLIT: int = 1
/// Move focus; arg is the direction (0 left, 1 right, 2 up, 3 down).
pub const A_FOCUS: int = 2
/// Focus the next pane in tree order.
pub const A_FOCUS_NEXT: int = 3
/// Move a border of the focused pane; arg is the direction.
pub const A_RESIZE: int = 4
/// Zoom the focused pane, or unzoom.
pub const A_ZOOM: int = 5
/// Every split of the tab back to halves.
pub const A_EQUALIZE: int = 6
/// Close the focused pane.
pub const A_CLOSE: int = 7
/// A new tab with one pane.
pub const A_NEW_TAB: int = 8
/// The next tab, wrapping.
pub const A_NEXT_TAB: int = 9
/// The previous tab, wrapping.
pub const A_PREVIOUS_TAB: int = 10
/// The tab at position arg (1-based).
pub const A_SELECT_TAB: int = 11
/// Detach this client.
pub const A_DETACH: int = 12
/// Send the prefix itself to the focused pane.
pub const A_SEND_PREFIX: int = 13
/// Close the active tab and its panes.
pub const A_CLOSE_TAB: int = 14
/// Start the rename prompt, filled with the tab's name.
pub const A_RENAME_TAB: int = 15
/// Enter locked mode.
pub const A_LOCK: int = 16
/// The key goes to the focused pane.
pub const A_PASS: int = 17
/// Ask before the action named by arg (A_CLOSE or A_CLOSE_TAB).
pub const A_CONFIRM: int = 18
/// Run the action the confirm question asked about.
pub const A_YES: int = 19
/// Start the command prompt, empty.
pub const A_COMMAND: int = 20
/// Open the key list at its top.
pub const A_HELP: int = 21
/// Scroll the key list by arg lines.
pub const A_SCROLL: int = 22
/// Type the scalar arg into the prompt.
pub const A_TYPE: int = 23
/// Erase the prompt's last scalar.
pub const A_ERASE: int = 24
/// Empty the prompt.
pub const A_CLEAR: int = 25
/// Run the prompt's line.
pub const A_RUN: int = 26
/// Close immediately except that the final pane of the session asks first.
pub const A_QUICK_CLOSE: int = 27
/// Look back through the focused pane's history (scroll mode).
pub const A_VIEW_ENTER: int = 28
/// Move the window arg rows back (negative: toward the live rows).
pub const A_VIEW_ROWS: int = 29
/// Move the window arg half windows back (negative: toward the live rows).
pub const A_VIEW_PAGE: int = 30
/// The oldest retained row (arg 1) or the live rows (arg 0).
pub const A_VIEW_END: int = 31
/// The session's register into the focused pane.
pub const A_PASTE: int = 32

const SHIFT: int = 1
const ALT: int = 2
const CTRL: int = 4
const SCALAR: int = 0
const NAMED: int = 1
const UP: int = 1
const DOWN: int = 2
const RIGHT: int = 3
const LEFT: int = 4
const BACKSPACE: int = 11
const PAGE_UP: int = 7
const PAGE_DOWN: int = 8
const ENTER: int = 13
const ESC: int = 14

/// One key in one mode: its action and argument, and the mode after it.
/// `shows` is the key's text in its hint group and `hint` the group's label;
/// a binding with an empty `hint` is left off the hint line (arrows beside
/// `h j k l`, Enter beside Esc) but is in the key list.
pub struct Binding {
    mode: int,
    mods: int,
    kind: int,
    code: int,
    action: int,
    arg: int,
    next: int,
    shows: str,
    hint: str,
}

/// The key table.
pub struct Keys {
    bindings: List[Binding],
}

/// What a key does: the action, its argument, and the next mode.
pub struct Step {
    action: int,
    arg: int,
    mode: int,
}

/// A hint line: its text, and the columns (0-based, end exclusive) of each key
/// drawn in inverse, as pairs.
pub struct HintLine {
    text: str,
    keys: List[int],
}

/// A parsed command line. `count` repeats a resize; `text` is a rename's name;
/// `why` is the answer shown when the line is refused (empty for an empty line).
pub struct Command {
    ok: bool,
    action: int,
    arg: int,
    count: int,
    text: str,
    why: str,
}

fn bind(mut l: List[Binding], mode: int, mods: int, kind: int, code: int, action: int, arg: int, next: int,
    shows: str, hint: str) {
    (mut l).push(Binding { mode: mode, mods: mods, kind: kind, code: code, action: action, arg: arg, next: next,
        shows: shows, hint: hint })
}

fn letter(mut l: List[Binding], mode: int, ch: str, action: int, arg: int, next: int, hint: str) {
    let b = ch.bytes()
    bind(mut l, mode, 0, SCALAR, b[0] as int, action, arg, next, ch, hint)
}

fn hidden(mut l: List[Binding], mode: int, mods: int, kind: int, code: int, action: int, arg: int, next: int) {
    bind(mut l, mode, mods, kind, code, action, arg, next, "", "")
}

fn sticky(mut l: List[Binding], mode: int) {
    bind(mut l, mode, 0, NAMED, ESC, A_NONE, 0, MODE_NORMAL, "Esc", "back")
    hidden(mut l, mode, 0, NAMED, ENTER, A_NONE, 0, MODE_NORMAL)
    hidden(mut l, mode, CTRL, SCALAR, 32, A_NONE, 0, MODE_PREFIX)
}

fn focus_keys(mut l: List[Binding], mode: int, next: int) {
    letter(mut l, mode, "h", A_FOCUS, 0, next, "focus")
    letter(mut l, mode, "j", A_FOCUS, 3, next, "focus")
    letter(mut l, mode, "k", A_FOCUS, 2, next, "focus")
    letter(mut l, mode, "l", A_FOCUS, 1, next, "focus")
    hidden(mut l, mode, 0, NAMED, LEFT, A_FOCUS, 0, next)
    hidden(mut l, mode, 0, NAMED, DOWN, A_FOCUS, 3, next)
    hidden(mut l, mode, 0, NAMED, UP, A_FOCUS, 2, next)
    hidden(mut l, mode, 0, NAMED, RIGHT, A_FOCUS, 1, next)
}

fn digits(mut l: List[Binding], mode: int, next: int) {
    bind(mut l, mode, 0, SCALAR, 49, A_SELECT_TAB, 1, next, "1-9", "go to")
    var d = 2
    while d <= 9 {
        bind(mut l, mode, 0, SCALAR, 48 + d, A_SELECT_TAB, d, next, "", "go to")
        d += 1
    }
}

fn prompt_keys(mut l: List[Binding], mode: int) {
    bind(mut l, mode, 0, NAMED, ENTER, A_RUN, 0, MODE_BACK, "Enter", "run")
    bind(mut l, mode, 0, NAMED, ESC, A_NONE, 0, MODE_BACK, "Esc", "cancel")
    hidden(mut l, mode, 0, NAMED, BACKSPACE, A_ERASE, 0, mode)
    hidden(mut l, mode, CTRL, SCALAR, 117, A_CLEAR, 0, mode)
}

/// The default table: the prefix (Ctrl-Space) and its table, the four sticky
/// modes behind `w t r s`, locked behind `g` (left only with `C-g`), and the
/// confirm, help and prompt modes. Order is the hint line's order.
pub fn defaults() -> Keys {
    var l = List[Binding]()
    let n = MODE_NORMAL
    let p = MODE_PREFIX
    bind(mut l, n, CTRL, SCALAR, 32, A_NONE, 0, p, "C-Space", "prefix")
    bind(mut l, n, ALT, SCALAR, 92, A_SPLIT, 0, n, "M-\\ ", "split")
    bind(mut l, n, ALT, SCALAR, 124, A_SPLIT, 1, n, "M-| ", "split")
    bind(mut l, n, ALT, SCALAR, 116, A_NEW_TAB, 0, n, "M-t ", "new tab")
    hidden(mut l, n, ALT, SCALAR, 84, A_NEW_TAB, 0, n)
    bind(mut l, n, ALT, SCALAR, 119, A_QUICK_CLOSE, 0, n, "M-w ", "close")
    hidden(mut l, n, ALT, SCALAR, 87, A_QUICK_CLOSE, 0, n)


    letter(mut l, p, "?", A_HELP, 0, MODE_HELP, "keys")
    letter(mut l, p, "|", A_SPLIT, 0, n, "split")
    letter(mut l, p, "-", A_SPLIT, 1, n, "split")
    focus_keys(mut l, p, n)
    letter(mut l, p, "x", A_CONFIRM, A_CLOSE, MODE_CONFIRM, "close")
    letter(mut l, p, "c", A_NEW_TAB, 0, n, "new tab")
    letter(mut l, p, "n", A_NEXT_TAB, 0, n, "tabs")
    letter(mut l, p, "p", A_PREVIOUS_TAB, 0, n, "tabs")
    digits(mut l, p, n)
    letter(mut l, p, "z", A_ZOOM, 0, n, "zoom")
    letter(mut l, p, "H", A_RESIZE, 0, n, "resize")
    letter(mut l, p, "J", A_RESIZE, 3, n, "resize")
    letter(mut l, p, "K", A_RESIZE, 2, n, "resize")
    letter(mut l, p, "L", A_RESIZE, 1, n, "resize")
    letter(mut l, p, "o", A_FOCUS_NEXT, 0, n, "next pane")
    letter(mut l, p, "=", A_EQUALIZE, 0, n, "equalize")
    letter(mut l, p, ",", A_RENAME_TAB, 0, MODE_RENAME, "rename")
    letter(mut l, p, ":", A_COMMAND, 0, MODE_COMMAND, "command")
    letter(mut l, p, "d", A_DETACH, 0, n, "detach")
    letter(mut l, p, "w", A_NONE, 0, MODE_PANE, "PANE")
    letter(mut l, p, "t", A_NONE, 0, MODE_TAB, "TAB")
    letter(mut l, p, "r", A_NONE, 0, MODE_RESIZE, "RESIZE")
    letter(mut l, p, "s", A_NONE, 0, MODE_SESSION, "SESSION")
    letter(mut l, p, "g", A_NONE, 0, MODE_LOCKED, "LOCK")
    letter(mut l, p, "[", A_VIEW_ENTER, 0, MODE_SCROLL, "SCROLL")
    letter(mut l, p, "]", A_PASTE, 0, n, "paste")
    hidden(mut l, p, CTRL, SCALAR, 32, A_SEND_PREFIX, 0, n)

    let w = MODE_PANE
    letter(mut l, w, "|", A_SPLIT, 0, w, "split")
    letter(mut l, w, "-", A_SPLIT, 1, w, "split")
    focus_keys(mut l, w, w)
    letter(mut l, w, "x", A_CONFIRM, A_CLOSE, MODE_CONFIRM, "close")
    letter(mut l, w, "z", A_ZOOM, 0, w, "zoom")
    letter(mut l, w, "o", A_FOCUS_NEXT, 0, w, "next pane")
    letter(mut l, w, "=", A_EQUALIZE, 0, w, "equalize")
    sticky(mut l, w)

    let t = MODE_TAB
    letter(mut l, t, "h", A_PREVIOUS_TAB, 0, t, "prev/next")
    letter(mut l, t, "l", A_NEXT_TAB, 0, t, "prev/next")
    hidden(mut l, t, 0, NAMED, LEFT, A_PREVIOUS_TAB, 0, t)
    hidden(mut l, t, 0, NAMED, RIGHT, A_NEXT_TAB, 0, t)
    hidden(mut l, t, 0, SCALAR, 112, A_PREVIOUS_TAB, 0, t)
    hidden(mut l, t, 0, SCALAR, 110, A_NEXT_TAB, 0, t)
    letter(mut l, t, "c", A_NEW_TAB, 0, t, "new")
    letter(mut l, t, "x", A_CONFIRM, A_CLOSE_TAB, MODE_CONFIRM, "close")
    letter(mut l, t, "r", A_RENAME_TAB, 0, MODE_RENAME, "rename")
    digits(mut l, t, t)
    sticky(mut l, t)

    let r = MODE_RESIZE
    letter(mut l, r, "h", A_RESIZE, 0, r, "resize")
    letter(mut l, r, "j", A_RESIZE, 3, r, "resize")
    letter(mut l, r, "k", A_RESIZE, 2, r, "resize")
    letter(mut l, r, "l", A_RESIZE, 1, r, "resize")
    hidden(mut l, r, 0, SCALAR, 72, A_RESIZE, 0, r)
    hidden(mut l, r, 0, SCALAR, 74, A_RESIZE, 3, r)
    hidden(mut l, r, 0, SCALAR, 75, A_RESIZE, 2, r)
    hidden(mut l, r, 0, SCALAR, 76, A_RESIZE, 1, r)
    hidden(mut l, r, 0, NAMED, LEFT, A_RESIZE, 0, r)
    hidden(mut l, r, 0, NAMED, DOWN, A_RESIZE, 3, r)
    hidden(mut l, r, 0, NAMED, UP, A_RESIZE, 2, r)
    hidden(mut l, r, 0, NAMED, RIGHT, A_RESIZE, 1, r)
    letter(mut l, r, "=", A_EQUALIZE, 0, r, "equalize")
    sticky(mut l, r)

    let s = MODE_SESSION
    letter(mut l, s, "d", A_DETACH, 0, n, "detach")
    sticky(mut l, s)

    let v = MODE_SCROLL
    letter(mut l, v, "j", A_VIEW_ROWS, -1, v, "row")
    letter(mut l, v, "k", A_VIEW_ROWS, 1, v, "row")
    hidden(mut l, v, 0, NAMED, UP, A_VIEW_ROWS, 1, v)
    hidden(mut l, v, 0, NAMED, DOWN, A_VIEW_ROWS, -1, v)
    bind(mut l, v, 0, NAMED, PAGE_UP, A_VIEW_PAGE, 2, v, "PgUp ", "page")
    bind(mut l, v, 0, NAMED, PAGE_DOWN, A_VIEW_PAGE, -2, v, "PgDn", "page")
    hidden(mut l, v, CTRL, SCALAR, 98, A_VIEW_PAGE, 2, v)
    hidden(mut l, v, CTRL, SCALAR, 102, A_VIEW_PAGE, -2, v)
    letter(mut l, v, "u", A_VIEW_PAGE, 1, v, "half")
    letter(mut l, v, "d", A_VIEW_PAGE, -1, v, "half")
    letter(mut l, v, "g", A_VIEW_END, 1, v, "oldest/live")
    letter(mut l, v, "G", A_VIEW_END, 0, v, "oldest/live")
    letter(mut l, v, "q", A_NONE, 0, n, "quit")
    sticky(mut l, v)

    bind(mut l, MODE_LOCKED, CTRL, SCALAR, 103, A_NONE, 0, n, "C-g", "unlock")

    prompt_keys(mut l, MODE_COMMAND)
    prompt_keys(mut l, MODE_RENAME)

    let c = MODE_CONFIRM
    letter(mut l, c, "y", A_YES, 0, MODE_BACK, "yes")
    letter(mut l, c, "n", A_NONE, 0, MODE_BACK, "no")
    hidden(mut l, c, 0, NAMED, ESC, A_NONE, 0, MODE_BACK)

    let h = MODE_HELP
    letter(mut l, h, "j", A_SCROLL, 1, h, "scroll")
    letter(mut l, h, "k", A_SCROLL, -1, h, "scroll")
    hidden(mut l, h, 0, NAMED, DOWN, A_SCROLL, 1, h)
    hidden(mut l, h, 0, NAMED, UP, A_SCROLL, -1, h)
    bind(mut l, h, 0, NAMED, ESC, A_NONE, 0, MODE_BACK, "Esc", "close")
    hidden(mut l, h, 0, SCALAR, 113, A_NONE, 0, MODE_BACK)
    hidden(mut l, h, 0, SCALAR, 63, A_NONE, 0, MODE_BACK)
    Keys { bindings: l }
}

fn found(action: int, arg: int, mode: int) -> Step {
    Step { action: action, arg: arg, mode: mode }
}

/// What a KEY event (mods, kind, code) does in a mode. Shift is folded into
/// scalars, so it is ignored on them. Unbound keys: normal and locked pass
/// them to the pane; prefix mode drops them and goes back to normal; the
/// sticky modes and help drop them and stay; confirm cancels; the prompts
/// type a printable scalar and drop anything else.
pub fn step(k: Keys, mode: int, mods: int, kind: int, code: int) -> Step {
    var m = mods
    if kind == SCALAR { m = mods & (ALT | CTRL) }
    for b in k.bindings {
        if b.mode == mode && b.mods == m && b.kind == kind && b.code == code {
            return found(b.action, b.arg, b.next)
        }
    }
    if mode == MODE_NORMAL || mode == MODE_LOCKED { return found(A_PASS, 0, mode) }
    // Prefix hints include root quick actions; those advertised keys act
    // here too, after the exact prefix-table bindings have had first choice.
    if mode == MODE_PREFIX {
        for b in k.bindings {
            if b.mode == MODE_NORMAL && b.action != A_NONE && b.mods == m && b.kind == kind && b.code == code {
                return found(b.action, b.arg, b.next)
            }
        }
        return found(A_NONE, 0, MODE_NORMAL)
    }
    if mode == MODE_CONFIRM { return found(A_NONE, 0, MODE_BACK) }
    if mode == MODE_COMMAND || mode == MODE_RENAME {
        if kind == SCALAR && m == 0 && code >= 32 && code != 127 && !(code >= 128 && code < 160) {
            return found(A_TYPE, code, mode)
        }
        return found(A_NONE, 0, mode)
    }
    if mode >= 0 && mode < MODES { return found(A_NONE, 0, mode) }
    found(A_NONE, 0, MODE_NORMAL)
}

/// The mode's name, as the bar's mode field shows it.
pub fn mode_name(mode: int) -> str {
    let names = ["NORMAL", "PREFIX", "PANE", "TAB", "RESIZE", "SESSION", "LOCKED", "COMMAND", "RENAME",
        "CONFIRM", "HELP", "SCROLL"]
    if mode < 0 || mode >= MODES { return "" }
    names[mode]
}

fn scalar_text(cp: int) -> str {
    var out = List[byte]()
    if cp < 128 {
        (mut out).push(cp as byte)
    } else if cp < 2048 {
        (mut out).push((192 + cp / 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else if cp < 65536 {
        (mut out).push((224 + cp / 4096) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else {
        (mut out).push((240 + cp / 262144) as byte)
        (mut out).push((128 + cp / 4096 % 64) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    }
    str_from_utf8(out) else "?"
}

/// A key's name: `C-Space`, `C-g`, `M-x`, `h`, `Up`, `Esc`, `F5`.
pub fn key_name(mods: int, kind: int, code: int) -> str {
    var prefix = ""
    if mods & CTRL != 0 { prefix = prefix + "C-" }
    if mods & ALT != 0 { prefix = prefix + "M-" }
    if kind == SCALAR {
        if code == 32 { return prefix + "Space" }
        if code < 32 || code == 127 || code < 0 || code > 1114111 { return prefix + "?" }
        return prefix + scalar_text(code)
    }
    if mods & SHIFT != 0 { prefix = prefix + "S-" }
    let names = ["Up", "Down", "Right", "Left", "Home", "End", "PageUp", "PageDown", "Insert", "Delete",
        "Backspace", "Tab", "Enter", "Esc"]
    if code >= 1 && code <= 14 { return prefix + names[code - 1] }
    if code >= 15 && code <= 38 { return prefix + "F{code - 14}" }
    if code >= 39 && code <= 48 { return prefix + "KP{code - 39}" }
    prefix + "key{code}"
}

/// The width of hint and key-list text in columns: one a scalar (the table's
/// text is ASCII).
pub fn text_width(text: str) -> int {
    var n = 0
    for b in text.bytes() {
        if (b as int) & 192 != 128 { n += 1 }
    }
    n
}

fn in_line(mode: int, line: int) -> bool {
    if line == MODE_PREFIX { return mode == MODE_NORMAL || mode == MODE_PREFIX }
    mode == line
}

/// The hint line of a mode at a width: the mode's bindings grouped by label
/// in table order, each `keys label`, two spaces apart. Idle shows only its
/// prefix binding; prefix mode adds the prefix table. Groups that do not fit
/// are counted at the end as `+N`.
pub fn hint_line(k: Keys, mode: int, cols: int) -> HintLine {
    var labels = List[str]()
    var shows = List[str]()
    for b in k.bindings {
        if b.hint == "" || !in_line(b.mode, mode) { continue }
        if mode == MODE_NORMAL && !(b.action == A_NONE && b.next == MODE_PREFIX) { continue }
        var at = -1
        var i = 0
        while i < labels.len {
            if labels[i] == b.hint { at = i }
            i += 1
        }
        if at < 0 {
            (mut labels).push(b.hint)
            (mut shows).push(b.shows)
        } else {
            shows[at] = shows[at] + b.shows
        }
    }
    var text = ""
    var keys = List[int]()
    var width = 0
    var shown = 0
    while shown < labels.len {
        var gap = "  "
        if shown == 0 { gap = " " }
        let group = gap + shows[shown] + " " + labels[shown]
        let after = width + text_width(group)
        let left = labels.len - shown - 1
        var tail = 0
        if left > 0 { tail = text_width("  +{left}") }
        if after + tail > cols { break }
        (mut keys).push(width + text_width(gap))
        (mut keys).push(width + text_width(gap) + text_width(shows[shown]))
        text = text + group
        width = after
        shown += 1
    }
    let left = labels.len - shown
    if left > 0 {
        if shown == 0 { text = " +{left}" } else { text = text + "  +{left}" }
    }
    HintLine { text: text, keys: keys }
}

/// The hint line's text alone.
pub fn hint_text(k: Keys, mode: int, cols: int) -> str {
    hint_line(k, mode, cols).text
}

fn directions() -> List[str] {
    ["left", "right", "up", "down"]
}

fn direction_name(d: int) -> str {
    let names = directions()
    if d < 0 || d >= names.len { return "?" }
    names[d]
}

fn verb(action: int, arg: int) -> str {
    if action == A_SPLIT {
        if arg == 0 { return "split-right" }
        return "split-down"
    }
    if action == A_FOCUS { return "focus " + direction_name(arg) }
    if action == A_FOCUS_NEXT { return "focus-next" }
    if action == A_RESIZE { return "resize " + direction_name(arg) }
    if action == A_ZOOM { return "zoom" }
    if action == A_EQUALIZE { return "equalize" }
    if action == A_CLOSE { return "close-pane" }
    if action == A_QUICK_CLOSE { return "close-pane (asks on last pane)" }
    if action == A_NEW_TAB { return "new-tab" }
    if action == A_NEXT_TAB { return "next-tab" }
    if action == A_PREVIOUS_TAB { return "previous-tab" }
    if action == A_SELECT_TAB { return "select-tab {arg}" }
    if action == A_DETACH { return "detach" }
    if action == A_CLOSE_TAB { return "close-tab" }
    if action == A_RENAME_TAB { return "rename-tab" }
    if action == A_LOCK { return "lock" }
    if action == A_SEND_PREFIX { return "send the prefix" }
    if action == A_CONFIRM { return verb(arg, 0) + " (asks)" }
    if action == A_YES { return "yes" }
    if action == A_COMMAND { return "command line" }
    if action == A_HELP { return "the key list" }
    if action == A_SCROLL {
        if arg > 0 { return "scroll down" }
        return "scroll up"
    }
    if action == A_VIEW_ENTER { return "look back (scroll mode)" }
    if action == A_VIEW_ROWS {
        if arg > 0 { return "one row back" }
        return "one row forward"
    }
    if action == A_VIEW_PAGE {
        if arg == 2 { return "a window back" }
        if arg == 0 - 2 { return "a window forward" }
        if arg > 0 { return "half a window back" }
        return "half a window forward"
    }
    if action == A_VIEW_END {
        if arg == 1 { return "the oldest row" }
        return "the live rows"
    }
    if action == A_PASTE { return "paste the register" }
    if action == A_RUN { return "run" }
    if action == A_ERASE { return "erase" }
    if action == A_CLEAR { return "clear the line" }
    ""
}

fn describe(b: Binding) -> str {
    let v = verb(b.action, b.arg)
    if v != "" { return v }
    if b.next == MODE_BACK { return "back" }
    if b.next != b.mode && b.next >= 0 && b.next < MODES {
        var name = List[byte]()
        for c in mode_name(b.next).bytes() {
            var x = c as int
            if x >= 65 && x <= 90 { x += 32 }
            (mut name).push(x as byte)
        }
        return (str_from_utf8(name) else "") + " mode"
    }
    "nothing"
}

fn pad(text: str, width: int) -> str {
    var out = text
    var w = text_width(text)
    while w < width {
        out = out + " "
        w += 1
    }
    out
}

/// The key list `?` shows: one line a binding, `  MODE  KEY  what it does`.
pub fn help_lines(k: Keys) -> List[str] {
    var out = List[str]()
    for b in k.bindings {
        (mut out).push("  " + pad(mode_name(b.mode), 8) + " " + pad(key_name(b.mods, b.kind, b.code), 10) + " " +
            describe(b))
    }
    out
}

fn refused(why: str) -> Command {
    Command { ok: false, action: A_NONE, arg: 0, count: 1, text: "", why: why }
}

fn command_of(action: int, arg: int) -> Command {
    Command { ok: true, action: action, arg: arg, count: 1, text: "", why: "" }
}

fn words(line: str) -> List[str] {
    var out = List[str]()
    var cur = List[byte]()
    for b in line.bytes() {
        if b == 32 as byte || b == 9 as byte {
            if cur.len > 0 {
                (mut out).push(str_from_utf8(cur) else "")
                cur = List[byte]()
            }
        } else {
            (mut cur).push(b)
        }
    }
    if cur.len > 0 { (mut out).push(str_from_utf8(cur) else "") }
    out
}

fn direction_of(word: str) -> int {
    let names = directions()
    var i = 0
    while i < names.len {
        if names[i] == word { return i }
        i += 1
    }
    -1
}

fn number_of(word: str) -> int {
    var n = 0
    if word.len == 0 || word.len > 4 { return -1 }
    for b in word.bytes() {
        let d = (b as int) - 48
        if d < 0 || d > 9 { return -1 }
        n = n * 10 + d
    }
    n
}

/// The rest of a line after its first word, trimmed: a rename's name.
fn rest_after_verb(line: str) -> str {
    var out = List[byte]()
    var state = 0
    for b in line.bytes() {
        let space = b == 32 as byte || b == 9 as byte
        if state == 0 {
            if !space { state = 1 }
        } else if state == 1 {
            if space { state = 2 }
        } else if state == 2 {
            if !space {
                state = 3
                (mut out).push(b)
            }
        } else {
            (mut out).push(b)
        }
    }
    while out.len > 0 && (out[out.len - 1] == 32 as byte || out[out.len - 1] == 9 as byte) {
        let _gone = (mut out).pop() else { break }
    }
    str_from_utf8(out) else ""
}

/// A command line: the key table's action names and their arguments
/// (`split-right`, `focus left`, `resize up 3`, `select-tab 2`,
/// `rename-tab NAME`, `lock`, ...). Unknown verbs and bad arguments are
/// refused with the answer the hint line shows.
pub fn command(line: str) -> Command {
    let w = words(line)
    if w.len == 0 { return refused("") }
    let v = w[0]
    let plain = ["split-right", "split-down", "focus-next", "zoom", "equalize", "close-pane", "new-tab", "close-tab",
        "next-tab", "previous-tab", "detach", "lock"]
    let acts = [A_SPLIT, A_SPLIT, A_FOCUS_NEXT, A_ZOOM, A_EQUALIZE, A_CLOSE, A_NEW_TAB, A_CLOSE_TAB, A_NEXT_TAB,
        A_PREVIOUS_TAB, A_DETACH, A_LOCK]
    var i = 0
    while i < plain.len {
        if plain[i] == v {
            if w.len > 1 { return refused(v + " takes no arguments") }
            if v == "split-down" { return command_of(A_SPLIT, 1) }
            return command_of(acts[i], 0)
        }
        i += 1
    }
    if v == "focus" || v == "resize" {
        let usage = "usage: " + v + " left|right|up|down"
        if w.len < 2 { return refused(usage) }
        let d = direction_of(w[1])
        if d < 0 { return refused(usage) }
        if v == "focus" {
            if w.len > 2 { return refused(usage) }
            return command_of(A_FOCUS, d)
        }
        if w.len > 3 { return refused(usage + " [N]") }
        var c = command_of(A_RESIZE, d)
        if w.len == 3 {
            let n = number_of(w[2])
            if n < 1 { return refused(usage + " [N]") }
            c.count = n
        }
        return c
    }
    if v == "select-tab" {
        if w.len != 2 { return refused("usage: select-tab N") }
        let n = number_of(w[1])
        if n < 1 { return refused("usage: select-tab N") }
        return command_of(A_SELECT_TAB, n)
    }
    if v == "rename-tab" {
        if w.len < 2 { return refused("usage: rename-tab NAME") }
        var c = command_of(A_RENAME_TAB, 0)
        c.text = rest_after_verb(line)
        return c
    }
    refused("unknown command: " + v)
}
