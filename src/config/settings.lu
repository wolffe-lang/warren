//! member: true
//! The configuration file's settings: a strict subset of TOML read by a pure
//! parser. A file that does not parse is refused whole, by line and reason,
//! and the defaults apply.

/// What `warren.toml` sets. `ok` false names the refused `line` and `why`.
/// `restore` says whether sessions are saved and restored.
pub struct Settings { ok: bool, why: str, line: int, clipboard_programs: bool, restore: bool }

/// Every setting at its default: programs in panes cannot write the
/// clipboard, and sessions are saved and restored.
pub fn default_settings() -> Settings {
    Settings { ok: true, why: "", line: 0, clipboard_programs: false, restore: true }
}

/// Take an accepted file's settings into `to`, field by field: by scalar
/// stores alone, so that a server keeps settings read in one turn's scratch
/// region. Every setting is copied here; `why` is read only while `ok` is
/// false, so it is left as it was.
pub fn take_settings(mut to: Settings, from: Settings) {
    to.ok = true
    to.line = 0
    to.clipboard_programs = from.clipboard_programs
    to.restore = from.restore
}

fn refuse(line: int, why: str) -> Settings {
    Settings { ok: false, why: why, line: line, clipboard_programs: false, restore: true }
}

// A line without its comment (`#` to the end: values are bare words) and the
// blanks around it.
fn settings_line(raw: str) -> str {
    let at = raw.find("#") else raw.len
    raw[0..at].trim()
}

/// Parse a configuration file's text: blank lines, `#` comments, the table
/// `[clipboard]` and in it `programs = true` or `false`. Anything else, a
/// table or key given twice included, refuses the whole file by line and
/// reason, with every setting at its default.
pub fn parse_settings(text: str) -> Settings {
    var s = default_settings()
    var table = ""
    var clipboard_seen = false
    var programs_seen = false
    var n = 0
    for raw in text.lines() {
        n += 1
        let line = settings_line(raw)
        if line.len == 0 { continue }
        if line.starts_with("[") {
            if !line.ends_with("]") { return refuse(n, "a table header needs ]") }
            let name = line[1..line.len - 1].trim()
            if name != "clipboard" { return refuse(n, "unknown table [{name}]") }
            if clipboard_seen { return refuse(n, "[clipboard] appears twice") }
            clipboard_seen = true
            table = name
            continue
        }
        let eq = line.find("=") else 0 - 1
        if eq < 0 { return refuse(n, "expected key = value") }
        if table.len == 0 { return refuse(n, "a key outside a table") }
        let key = line[0..eq].trim()
        let value = line[eq + 1..line.len].trim()
        if key != "programs" { return refuse(n, "unknown key {key} in [{table}]") }
        if programs_seen { return refuse(n, "programs is set twice") }
        if value == "true" { s.clipboard_programs = true }
        else if value == "false" { s.clipboard_programs = false }
        else { return refuse(n, "programs takes true or false") }
        programs_seen = true
    }
    s
}
