//! member: true
//! The configuration file's settings: a strict subset of TOML read by a pure
//! parser. A file that does not parse is refused whole, by line and reason,
//! and the defaults apply.

/// What `warren.toml` sets. `ok` false names the refused `line` and `why`.
/// `restore` says whether sessions are saved and restored. `prefix` is the
/// prefix key: Ctrl with the scalar `prefix` (32 Space, 97 to 122 a to z).
pub struct Settings { ok: bool, why: str, line: int, clipboard_programs: bool, restore: bool, prefix: int }

/// Every setting at its default: programs in panes cannot write the
/// clipboard, sessions are saved and restored, and the prefix is C-Space.
pub fn default_settings() -> Settings {
    Settings { ok: true, why: "", line: 0, clipboard_programs: false, restore: true, prefix: 32 }
}

/// Take an accepted file's settings into `to`, field by field: by scalar
/// stores alone, so that a server keeps settings read in one turn's scratch
/// region. Every setting is copied here; `why` is read only while `ok` is
/// false, so it is left as it was.
pub fn take_settings(mut to: Settings, from: Settings) {
    to.ok = true
    to.line = 0
    to.clipboard_programs = from.clipboard_programs
    to.restore = from.restore
    to.prefix = from.prefix
}

fn refuse(line: int, why: str) -> Settings {
    Settings { ok: false, why: why, line: line, clipboard_programs: false, restore: true, prefix: 32 }
}

// A line without its comment (`#` to the end: no value holds a `#`) and the
// blanks around it.
fn settings_line(raw: str) -> str {
    let at = raw.find("#") else raw.len
    raw[0..at].trim()
}

// The prefix a key name gives: Ctrl with the scalar 32 (C-Space) or 97 to
// 122 (C-a to C-z), but not C-g, C-h, C-i, C-m or C-u; 0 - 1 when refused.
fn prefix_code(name: str) -> int {
    if name == "C-Space" { return 32 }
    let b = name.bytes()
    if b.len == 3 && b[0] == 67 as byte && b[1] == 45 as byte {
        let c = b[2] as int
        if c >= 97 && c <= 122 && c != 103 && c != 104 && c != 105 && c != 109 && c != 117 { return c }
    }
    0 - 1
}

// Why a key name is refused as the prefix.
fn prefix_why(name: str) -> str {
    if name == "C-g" { return "C-g leaves the locked mode" }
    if name == "C-h" { return "C-h is Backspace on a terminal without an extended keyboard protocol" }
    if name == "C-i" { return "C-i is Tab on a terminal without an extended keyboard protocol" }
    if name == "C-m" { return "C-m is Enter on a terminal without an extended keyboard protocol" }
    if name == "C-u" { return "C-u clears the line in the command, rename and search prompts" }
    "prefix takes C-Space or C-a to C-z, not {name}"
}

/// Parse a configuration file's text: blank lines, `#` comments, the
/// top-level key `restore = true` or `false` (before any table), the table
/// `[clipboard]` with `programs = true` or `false`, and the table `[keys]`
/// with `prefix = "C-a"`, a quoted key name (C-Space, or C-a to C-z but not
/// C-g, C-h, C-i, C-m or C-u). Anything else, a table or key given twice
/// included, refuses the whole file by line and reason, with every setting
/// at its default.
pub fn parse_settings(text: str) -> Settings {
    var s = default_settings()
    var table = ""
    var clipboard_seen = false
    var keys_seen = false
    var programs_seen = false
    var prefix_seen = false
    var restore_seen = false
    var n = 0
    for raw in text.lines() {
        n += 1
        let line = settings_line(raw)
        if line.len == 0 { continue }
        if line.starts_with("[") {
            if !line.ends_with("]") { return refuse(n, "a table header needs ]") }
            let name = line[1..line.len - 1].trim()
            if name == "clipboard" {
                if clipboard_seen { return refuse(n, "[clipboard] appears twice") }
                clipboard_seen = true
            } else if name == "keys" {
                if keys_seen { return refuse(n, "[keys] appears twice") }
                keys_seen = true
            } else {
                return refuse(n, "unknown table [{name}]")
            }
            table = name
            continue
        }
        let eq = line.find("=") else 0 - 1
        if eq < 0 { return refuse(n, "expected key = value") }
        let key = line[0..eq].trim()
        let value = line[eq + 1..line.len].trim()
        if table.len == 0 && key == "restore" {
            if restore_seen { return refuse(n, "restore is set twice") }
            if value == "true" { s.restore = true }
            else if value == "false" { s.restore = false }
            else { return refuse(n, "restore takes true or false") }
            restore_seen = true
            continue
        }
        if table.len == 0 { return refuse(n, "a key outside a table") }
        if table == "keys" {
            if key != "prefix" { return refuse(n, "unknown key {key} in [keys]") }
            if prefix_seen { return refuse(n, "prefix is set twice") }
            if value.len < 2 || !value.starts_with("\"") || !value.ends_with("\"") {
                return refuse(n, "prefix takes a quoted key name, like \"C-a\"")
            }
            let name = value[1..value.len - 1]
            let code = prefix_code(name)
            if code < 0 { return refuse(n, prefix_why(name)) }
            s.prefix = code
            prefix_seen = true
            continue
        }
        if key != "programs" { return refuse(n, "unknown key {key} in [{table}]") }
        if programs_seen { return refuse(n, "programs is set twice") }
        if value == "true" { s.clipboard_programs = true }
        else if value == "false" { s.clipboard_programs = false }
        else { return refuse(n, "programs takes true or false") }
        programs_seen = true
    }
    s
}
