//! member: false
//! The layout rows in slices, for the checked machine and the reference
//! interpreter, whose step budgets hold a few dozen sequences a run. With
//! no arguments: every golden. With `SIZE FIRST COUNT`: sequences FIRST ..
//! FIRST+COUNT-1 at size SIZE (0 for 20x6, then 80x24, 81x25, 320x90 and
//! 512x512), seeded as the native take's, with the constructed grids when
//! FIRST is 0. A rig sums the slices; tests/layout/rig/slices.py is one.
use std.env
use layout_rows

fn number(raw: List[List[byte]], i: int) -> int {
    let text = str_from_utf8(raw[i]) else { return -1 }
    text.to_int() else -1
}

fn main() -> int {
    let raw = env.args_bytes()
    if raw.len < 4 {
        if layout_rows.goldens() > 0 { return 1 }
        return 0
    }
    let index = number(raw, 1)
    let first = number(raw, 2)
    let count = number(raw, 3)
    if index < 0 || index > 4 || first < 0 || count < 1 {
        print("FAIL layout-slice-arguments size={index} first={first} count={count}")
        return 2
    }
    if layout_rows.properties_at(index, first, count, false) > 0 { return 1 }
    0
}
