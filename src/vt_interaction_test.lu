//! member: false
//! Interactions exposed by complete frozen reference fuzz streams.
use vt

fn test_cursor_toward_region() {
    var pane = vt.new(10, 8, 0)
    vt.feed(mut pane, "\u{1b}[3;5r\u{1b}[8;1H\u{1b}[99A".bytes())
    assert(pane.cursor_row == 3, "cursor-up-from-below-stops-at-region-top")
    vt.feed(mut pane, "\u{1b}[1;1H\u{1b}[99B".bytes())
    assert(pane.cursor_row == 5, "cursor-down-from-above-stops-at-region-bottom")
    vt.feed(mut pane, "\u{1b}[1;1H\u{1b}[B".bytes())
    assert(pane.cursor_row == 2)
    vt.feed(mut pane, "\u{1b}[8;1H\u{1b}[A".bytes())
    assert(pane.cursor_row == 7)
}

fn test_mouse_reset_is_one_tracking_mode() {
    let modes: List[int] = [1000, 1002, 1003]
    for active in modes {
        for reset in modes {
            var pane = vt.new(4, 2, 0)
            vt.feed(mut pane, "\u{1b}[?{active}h\u{1b}[?{reset}l".bytes())
            assert(pane.mode_values[8] == 0 && pane.mode_values[9] == 0 && pane.mode_values[10] == 0, "mouse-reset-clears-tracking-selector")
        }
    }
}

fn main() -> int { test_cursor_toward_region(); test_mouse_reset_is_one_tracking_mode(); 0 }
