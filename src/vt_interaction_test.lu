//! member: false
//! Interactions exposed by complete frozen reference fuzz streams.
use vt

fn test_cursor_toward_region() {
    var pane = vt.new(10, 8, 0)
    vt.feed(mut pane, "\u{1b}[3;5r\u{1b}[8;1H\u{1b}[99A".bytes())
    assert(pane.cursor_row == 3, "cursor-up-from-below-stops-at-region-top")
    vt.feed(mut pane, "\u{1b}[1;1H\u{1b}[99B".bytes())
    assert(pane.cursor_row == 5, "cursor-down-from-above-stops-at-region-bottom")
    vt.feed(mut pane, "\u{1b}[1;1H\u{1b}[B".bytes())
    assert(pane.cursor_row == 2)
    vt.feed(mut pane, "\u{1b}[8;1H\u{1b}[A".bytes())
    assert(pane.cursor_row == 7)
}

fn test_mouse_reset_is_one_tracking_mode() {
    let modes: List[int] = [1000, 1002, 1003]
    for active in modes {
        for reset in modes {
            var pane = vt.new(4, 2, 0)
            vt.feed(mut pane, "\u{1b}[?{active}h\u{1b}[?{reset}l".bytes())
            assert(pane.mode_values[8] == 0 && pane.mode_values[9] == 0 && pane.mode_values[10] == 0, "mouse-reset-clears-tracking-selector")
        }
    }
}

fn test_partial_erase_extends_written_extent() {
    var ech = vt.new(12, 4, 0)
    vt.feed(mut ech, "ab\u{1b}[5G\u{1b}[X".bytes())
    assert(ech.primary.extents[0] == 5, "partial-ech-marks-blank-through-endpoint")
    var left = vt.new(12, 4, 0)
    vt.feed(mut left, "\u{1b}[5G\u{1b}[1K".bytes())
    assert(left.primary.extents[0] == 5, "partial-el-left-marks-blank-through-endpoint")
}

fn test_inserted_blank_extends_written_extent() {
    var pane = vt.new(12, 4, 0)
    vt.feed(mut pane, "\u{1b}[5G\u{1b}[@".bytes())
    assert(pane.primary.extents[0] == 5, "ich-past-old-extent-marks-inserted-blank")
}

fn test_1049_reset_keeps_alternate_content() {
    var pane = vt.new(12, 4, 0)
    vt.feed(mut pane, "\u{1b}[?1049hX\u{1b}[?1049l\u{1b}[?47h".bytes())
    assert(pane.alternate.cells[0].base == 88 && pane.alternate.extents[0] == 1,
        "1049-reset-does-not-clear-shared-alternate")
}

fn test_1049_clear_cancels_active_pending_wrap() {
    var pane = vt.new(4, 2, 0)
    vt.feed(mut pane, "abcd\u{1b}[?1049h".bytes())
    assert(pane.cursor_col == 4 && !pane.pending_wrap, "1049-clear-cancels-active-pending-wrap")
    vt.feed(mut pane, "\u{1b}[?1049l".bytes())
    assert(pane.pending_wrap, "1049-restore-keeps-saved-primary-pending-wrap")
}

fn test_sparse_insert_discards_last_written_cell() {
    var pane = vt.new(12, 2, 0)
    vt.feed(mut pane, "ab\u{1b}[12GZ\u{1b}[3G\u{1b}[@".bytes())
    assert(pane.primary.extents[0] == 3, "ich-discards-last-written-cell-over-erased-gap")
    assert(pane.primary.cells[0].base == 97 && pane.primary.cells[1].base == 98 && pane.primary.cells[2].base == 32)
}

fn test_written_bits_survive_original_snapshot() {
    var pane = vt.new(12, 2, 4096)
    vt.feed(mut pane, "a\u{1b}[12GZ".bytes())
    assert(vt.resize(mut pane, 6, 4) == "" && vt.resize(mut pane, 12, 2) == "")
    var at = 0
    while at < 24 {
        assert(pane.primary.cells[at].written == (at == 0 || at == 11), "written-bit-original-snapshot")
        at += 1
    }
}

fn test_alternate_clip_recomputes_sparse_extent() {
    var pane = vt.new(12, 2, 0)
    vt.feed(mut pane, "\u{1b}[?1049ha\u{1b}[12GZ".bytes())
    assert(vt.resize(mut pane, 6, 2) == "")
    assert(pane.alternate.extents[0] == 1 && pane.alternate.cells[0].written,
        "alternate-clip-discards-distant-written-cell")
}

fn test_history_materializes_logical_spaces_written() {
    var pane = vt.new(4, 2, 4096)
    vt.feed(mut pane, "a\u{1b}[4GZ\r\nq\r\nr".bytes())
    assert(pane.history.records == 1)
    assert(vt.resize(mut pane, 2, 4) == "")
    assert(pane.primary.cells[0].base == 97 && pane.primary.cells[3].base == 90)
    assert(pane.primary.cells[1].base == 32 && pane.primary.cells[1].written &&
        pane.primary.cells[2].base == 32 && pane.primary.cells[2].written, "history-logical-spaces-are-written")
}

fn test_combining_marks_make_unwritten_cells_content() {
    var pane = vt.new(12, 2, 4096)
    vt.feed(mut pane, "\u{1b}[1;5H\u{301}".bytes())
    assert(pane.primary.cells[3].mark1 == 769)
    assert(pane.primary.cells[3].written && pane.primary.extents[0] == 4,
        "combining-unwritten-primary-is-content")
    assert(vt.resize(mut pane, 6, 4) == "")
    assert(pane.primary.cells[3].mark1 == 769 && pane.primary.cells[3].written,
        "combining-unwritten-primary-survives-resize")
    vt.feed(mut pane, "\u{1b}[?47h\u{1b}[1;5H\u{301}".bytes())
    assert(pane.alternate.cells[3].written && pane.alternate.extents[0] == 4,
        "combining-unwritten-alternate-is-content")
    var erased = vt.new(12, 2, 0)
    vt.feed(mut erased, "abcd\u{1b}[1;4H\u{1b}[2K\u{301}".bytes())
    assert(erased.primary.cells[2].written && erased.primary.extents[0] == 3,
        "combining-erased-cell-is-content")
    var first = vt.new(12, 2, 0)
    vt.feed(mut first, "\u{1b}[1;0H\u{301}".bytes())
    assert(first.primary.extents[0] == 0 && !first.primary.cells[0].written && first.primary.cells[0].mark1 == 0,
        "combining-without-left-cell-still-dropped")
}

fn test_saved_origin_row_survives_new_region() {
    var above = vt.new(12, 8, 0)
    vt.feed(mut above, "\u{1b}[?6h\u{1b}[2;3H\u{1b}7\u{1b}[5;8r\u{1b}8".bytes())
    assert(above.modes.origin && above.cursor_row == 2 && above.cursor_col == 3,
        "saved-origin-absolute-row-above-new-region")
    var below = vt.new(12, 8, 0)
    vt.feed(mut below, "\u{1b}[?6h\u{1b}[7;3H\u{1b}7\u{1b}[1;3r\u{1b}8".bytes())
    assert(below.modes.origin && below.cursor_row == 3 && below.cursor_col == 3,
        "saved-origin-row-below-new-region-clamps-at-bottom")
}

fn main() -> int {
    test_saved_origin_row_survives_new_region()
    test_combining_marks_make_unwritten_cells_content()
    test_cursor_toward_region()
    test_mouse_reset_is_one_tracking_mode()
    test_partial_erase_extends_written_extent()
    test_inserted_blank_extends_written_extent()
    test_1049_reset_keeps_alternate_content()
    test_1049_clear_cancels_active_pending_wrap()
    test_sparse_insert_discards_last_written_cell()
    test_written_bits_survive_original_snapshot()
    test_alternate_clip_recomputes_sparse_extent()
    test_history_materializes_logical_spaces_written()
    0
}
