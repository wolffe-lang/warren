//! member: true
//! Host-side finite VT feed/resource witness; no clocks enter src/vt.
use std.io

// One implementation deliberately serves the small smoke and full native take.
/// Feed exactly `bytes` through a fixed-size chunk with `history_cap` retained
/// bytes; report feed time and allocation, asserting the bounded-storage rows.
#[allow(w0314)]
pub fn measure(bytes: int, history_cap: int) -> int {
    assert(bytes > 0 && history_cap > 0, "vt-resource-arguments")
    assert(false, "vt-resource-bounded-feed")
    io.write_line("not implemented")
    0
}
