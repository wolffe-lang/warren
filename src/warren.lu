//! member: false
//! warren's host dispatcher. With no arguments: attach to the default
//! session, starting the server and the session when there are none.
//! `attach [-t NAME]` attaches to an existing session; `new [-d] [-s NAME]`
//! makes one (and attaches unless -d); every verb of the server's table
//! (`kill-server`, `list-sessions`, `list --json`, the command line's verbs
//! with `-t TARGET`) asks the server; `server` runs one in the foreground;
//! `vt-dump` works without a server; `modules` lists the modules and their
//! milestones; `--version` (alone) prints `warren` and the package version.
use std.io
use std.env
use vt
use proto
use layout
use server
use client
use cmd
use config

fn line(name: str, milestone: str, pure: bool) -> str {
    let kind = if pure { "pure" } else { "host" }
    "{name}\t{milestone}\t{kind}"
}

fn main() -> int {
    let raw = env.args_bytes()
    var args = List[str]()
    var index = 1
    while index < raw.len {
        let text = str_from_utf8(raw[index]) else { return cmd.usage() }
        (mut args).push(text)
        index += 1
    }
    if args.len == 0 { return client.attach("", true) }
    if args.len == 1 && args[0] == "--version" {
        io.write_line("warren {vt.package_version()}")
        return 0
    }
    if args[0] == "vt-dump" { return cmd.vt_dump(args) }
    if args[0] == "server" && args.len == 1 { return server.serve() }
    if args[0] == "attach" {
        if args.len == 1 { return client.attach("", false) }
        if args.len == 3 && args[1] == "-t" { return client.attach(args[2], false) }
        return cmd.usage()
    }
    if args[0] == "new" { return new_verb(args) }
    if args[0] == "modules" && args.len == 1 { return modules() }
    // Every verb of the server's table (docs/CLI.md) goes to the server,
    // which reads its arguments and answers with its exit status.
    for verb in cmd.verb_names() {
        if args[0] == verb { return client.command(args) }
    }
    for later in "split close tab rename".split(" ") {
        if args[0] == later {
            io.write_err_line("warren: {later} is not implemented in this version")
            return 2
        }
    }
    cmd.usage()
}

// `new [-d] [-s NAME] [-l LAYOUT]`, its flags in any order, each at most once.
fn new_verb(args: List[str]) -> int {
    var detached = false
    var name = ""
    var named = false
    var layout_word = ""
    var laid = false
    var existing = false
    var i = 1
    while i < args.len {
        if args[i] == "-d" && !detached {
            detached = true
        } else if args[i] == "-A" && !existing {
            existing = true
        } else if args[i] == "-s" && !named && i + 1 < args.len {
            name = args[i + 1]
            named = true
            i += 1
        } else if args[i] == "-l" && !laid && i + 1 < args.len {
            layout_word = args[i + 1]
            laid = true
            i += 1
        } else {
            return cmd.usage()
        }
        i += 1
    }
    if named && name.len == 0 {
        io.write_err_line("warren: new: a session name may not be empty")
        return 2
    }
    if laid && layout_word.len == 0 {
        io.write_err_line("warren: new: a layout name may not be empty")
        return 2
    }
    if existing && !named {
        io.write_err_line("warren: new: -A needs a session name")
        return 2
    }
    client.new_session(if existing then "" else name, detached, layout_word, false)
}

// The modules and the milestone each belongs to.
fn modules() -> int {
    let version = vt.package_version()
    io.write_line("warren {version}: modules")
    io.write_line(line("vt", vt.milestone(), vt.pure()))
    io.write_line(line("proto", proto.milestone(), proto.pure()))
    io.write_line(line("layout", layout.milestone(), layout.pure()))
    io.write_line(line("server", server.milestone(), server.pure()))
    io.write_line(line("client", client.milestone(), client.pure()))
    io.write_line(line("cmd", cmd.milestone(), cmd.pure()))
    io.write_line(line("config", config.milestone(), config.pure()))
    0
}
