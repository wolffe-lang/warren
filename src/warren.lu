//! member: false
//! warren's host dispatcher. The vt-dump diagnostic works without a server.
//! With no arguments, retain scaffold status and exit 1 so scripts cannot
//! mistake this diagnostic-stage binary for a working multiplexer.
use std.io
use std.env
use vt
use proto
use layout
use server
use client
use cmd
use config

fn line(name: str, milestone: str, pure: bool) -> str {
    let kind = if pure { "pure" } else { "host" }
    "{name}\t{milestone}\t{kind}\tnot implemented"
}

fn main() -> int {
    let raw = env.args_bytes()
    var args = List[str]()
    var index = 1
    while index < raw.len {
        let text = str_from_utf8(raw[index]) else { return cmd.usage() }
        (mut args).push(text)
        index += 1
    }
    if args.len > 0 {
        if args[0] == "vt-dump" { return cmd.vt_dump(args) }
        if args[0] == "server" && args.len == 1 { return server.serve() }
        return cmd.usage()
    }
    let version = vt.package_version()
    io.write_line("warren {version}: scaffold only")
    io.write_line(line("vt", vt.milestone(), vt.pure()))
    io.write_line(line("proto", proto.milestone(), proto.pure()))
    io.write_line(line("layout", layout.milestone(), layout.pure()))
    io.write_line(line("server", server.milestone(), server.pure()))
    io.write_line(line("client", client.milestone(), client.pure()))
    io.write_line(line("cmd", cmd.milestone(), cmd.pure()))
    io.write_line(line("config", config.milestone(), config.pure()))
    1
}
