//! member: true
//! Pure protocol inputs with test-only PASS reporting; separate from proto.
use proto
use server_model

fn payload(kind: int) -> List[byte] {
    var b = List[byte]()
    if kind == 1 {
        for c in "WRN\0".bytes() { (mut b).push(c) }
        proto.put(mut b, 1, 2)
        proto.put(mut b, 1, 2)
        proto.put(mut b, 1, 1)
        proto.put(mut b, 80, 2)
        proto.put(mut b, 24, 2)
        proto.put(mut b, 3, 1)
        proto.put(mut b, 31, 4)
        proto.put_text(mut b, "xterm")
        proto.put_text(mut b, "")
        proto.put(mut b, 1, 1)
        proto.put_text(mut b, "/")
        proto.put(mut b, 1, 2)
        proto.put_text(mut b, "A")
        proto.put_text(mut b, "B")
    } else if kind == 2 {
        proto.put(mut b, 7, 1)
        proto.put(mut b, 0, 1)
        proto.put(mut b, 0x1f600, 4)
    } else if kind == 3 {
        proto.put(mut b, 0, 1)
        proto.put(mut b, 1, 1)
        proto.put(mut b, 0, 1)
        proto.put(mut b, 4, 2)
        proto.put(mut b, 5, 2)
    } else if kind == 4 || kind == 7 || kind == 133 {
        proto.put_bytes(mut b, "abc".bytes())
    } else if kind == 5 {
        proto.put(mut b, 1, 1)
    } else if kind == 6 {
        proto.put(mut b, 80, 2)
        proto.put(mut b, 24, 2)
    } else if kind == 8 || kind == 12 || kind == 137 {
        proto.put(mut b, 7, 4)
    } else if kind == 11 {
        proto.put(mut b, 1, 4)
        proto.put(mut b, 1, 2)
        proto.put_text(mut b, "ls")
        proto.put_text(mut b, "/")
        proto.put_text(mut b, "p1")
    } else if kind == 129 {
        proto.put(mut b, 1, 2)
        proto.put(mut b, 1, 4)
        proto.put(mut b, 123, 4)
        proto.put_text(mut b, "default")
        proto.put_text(mut b, "0.1")
    } else if kind == 130 || kind == 135 {
        proto.put(mut b, 1, 2)
        proto.put_text(mut b, "done")
    } else if kind == 131 {
        return image(80, 24, false, false)
    } else if kind == 134 {
        proto.put_text(mut b, "title")
    } else if kind == 136 {
        proto.put(mut b, 1, 4)
        proto.put(mut b, 0, 1)
        proto.put_bytes(mut b, "yes".bytes())
        proto.put_bytes(mut b, List[byte]())
    }
    b
}

fn image(cols: int, rows: int, separate: bool, three: bool) -> List[byte] {
    var b = List[byte]()
    proto.put(mut b, 1, 4)
    proto.put(mut b, 0, 4)
    proto.put(mut b, cols, 2)
    proto.put(mut b, rows, 2)
    proto.put(mut b, 1, 2)
    proto.put(mut b, 1, 2)
    proto.put(mut b, 2, 1)
    proto.put(mut b, 1, 1)
    var n = rows
    if separate { n = cols * rows }
    proto.put(mut b, n, 4)
    var r = 1
    while r <= rows {
        var c = 1
        while c <= cols {
            proto.put(mut b, r, 2)
            proto.put(mut b, c, 2)
            proto.put(mut b, 0, 2)
            proto.put(mut b, 0, 4)
            proto.put(mut b, 0, 4)
            var cover = cols
            if separate { cover = 1 }
            proto.put(mut b, cover, 2)
            proto.put(mut b, 1, 2)
            proto.put(mut b, 1, 1)
            proto.put(mut b, cover, 2)
            var count = 1
            if three { count = 3 }
            proto.put(mut b, count, 1)
            proto.put(mut b, 0x10000, 4)
            if three {
                proto.put(mut b, 0x10001, 4)
                proto.put(mut b, 0x10002, 4)
            }
            c = c + cover
        }
        r = r + 1
    }
    b
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    true
}

fn golden(kind: int, hex: str) {
    let chars = hex.bytes()
    var want = List[byte]()
    var i = 0
    while i < chars.len {
        var hi = chars[i] as int
        var lo = chars[i + 1] as int
        if hi >= 97 { hi = hi - 87 } else { hi = hi - 48 }
        if lo >= 97 { lo = lo - 87 } else { lo = lo - 48 }
        (mut want).push((hi * 16 + lo) as byte)
        i = i + 2
    }
    var p = payload(kind)
    if kind == 131 { p = image(1, 1, false, false) }
    let got = proto.encode(kind, 0, p)
    assert(got.code == 0 && same(got.bytes, want))
    let d = proto.decode(want)
    assert(d.code == 0 && d.kind == kind && same(d.bytes, p))
}

fn test_all_golden_vectors() {
    golden(1, "27000000010057524e00010001000150001800031f0000000500787465726d00000101002f0100010041010042")
    golden(2, "060000000200070000f60100")
    golden(3, "07000000030000010004000500")
    golden(4, "07000000040003000000616263")
    golden(5, "01000000050001")
    golden(6, "04000000060050001800")
    golden(7, "07000000070003000000616263")
    golden(8, "04000000080007000000")
    golden(9, "000000000900")
    golden(10, "000000000a00")
    golden(11, "110000000b0001000000010002006c7301002f02007031")
    golden(12, "040000000c0007000000")
    golden(129, "1800000081000100010000007b000000070064656661756c740300302e31")
    golden(130, "08000000820001000400646f6e65")
    golden(131, "300000008300010000000000000001000100010001000201010000000100010000000000000000000000010001000101000100000100")
    golden(132, "000000008400")
    golden(133, "07000000850003000000616263")
    golden(134, "07000000860005007469746c65")
    golden(135, "08000000870001000400646f6e65")
    golden(136, "10000000880001000000000300000079657300000000")
    golden(137, "04000000890007000000")
    print("PASS proto-golden-all-21-types")
}

fn test_message_roundtrips() {
    var k = 1
    while k <= 137 {
        if (k <= 12) || (k >= 129) {
            let p = payload(k)
            assert(proto.validate(k, p) == 0)
            let e = proto.encode(k, 0, p)
            assert(e.code == 0)
            let d = proto.decode(e.bytes)
            assert(d.code == 0 && d.kind == k && d.flags == 0)
            assert(d.used == e.bytes.len && same(d.bytes, p))
            var n = 0
            while n < e.bytes.len {
                var prefix = List[byte]()
                var i = 0
                while i < n { (mut prefix).push(e.bytes[i]); i = i + 1 }
                assert(proto.decode(prefix).code == proto.SHORT)
                n = n + 1
            }
        }
        k = k + 1
    }
    print("PASS proto-roundtrip-all-types-and-truncations")
}

fn test_golden_and_refusals() {
    let e = proto.encode(12, 0, payload(12))
    var golden = List[byte]()
    for x in [4, 0, 0, 0, 12, 0, 7, 0, 0, 0] { (mut golden).push(x as byte) }
    assert(same(e.bytes, golden))
    let h = payload(1)
    var i = 0
    for x in [87, 82, 78, 0, 1, 0, 1, 0] {
        assert(h[i] == x as byte)
        i = i + 1
    }
    assert(proto.encode(0, 0, List[byte]()).code == proto.UNKNOWN)
    assert(proto.encode(12, 2, payload(12)).code == proto.RESERVED)
    assert(proto.encode(12, 1, payload(12)).code == proto.RESERVED)
    var bad = payload(2)
    bad[0] = 8 as byte
    assert(proto.validate(2, bad) == proto.MALFORMED)
    bad = payload(2)
    bad[2] = 0 as byte
    bad[3] = 0xd8 as byte
    bad[4] = 0 as byte
    bad[5] = 0 as byte
    assert(proto.validate(2, bad) == proto.MALFORMED)
    var title = List[byte]()
    for x in [2, 0, 0xc0, 0x80] { (mut title).push(x as byte) }
    assert(proto.validate(134, title) == proto.UTF8)
    var trailing = payload(12)
    (mut trailing).push(0 as byte)
    assert(proto.validate(12, trailing) == proto.MALFORMED)
    var too_big = List[byte]()
    for x in [1, 0, 16, 0, 12, 0] { (mut too_big).push(x as byte) }
    assert(proto.decode(too_big).code == proto.LIMIT)
    print("PASS proto-golden-and-named-refusals")
}

fn test_wide_and_coverage() {
    var b = image(2, 1, false, false)
    // Run covers two columns, one width-2 record repeated once.
    b[40] = 2 as byte
    b[41] = 1 as byte
    assert(proto.validate(131, b) == 0)
    b[40] = 1 as byte
    if proto.validate(131, b) != proto.MALFORMED {
        print("FAIL proto-wide-boundary incomplete coverage accepted")
        assert(false)
    }
    b = image(2, 1, false, false)
    b[22] = 2 as byte
    assert(proto.validate(131, b) == proto.MALFORMED)
    b = image(2, 1, false, false)
    b[26] = 0xff as byte
    b[27] = 0xff as byte
    assert(proto.validate(131, b) == proto.MALFORMED)
    print("PASS proto-wide-boundary-and-full-coverage")
}

fn test_fragment_and_ack_model() {
    let p = image(2, 1, false, false)
    var split = 1
    while split < p.len {
        var s = proto.assembly()
        var a = List[byte]()
        var b = List[byte]()
        var i = 0
        while i < p.len {
            if i < split { (mut a).push(p[i]) } else { (mut b).push(p[i]) }
            i = i + 1
        }
        assert(proto.append(mut s, 131, 1, a) == 0)
        assert(!s.complete)
        assert(proto.append(mut s, 131, 0, b) == 0 && s.complete)
        assert(same(s.bytes, p))
        split = split + 1
    }
    var s = proto.assembly()
    assert(proto.append(mut s, 131, 1, "x".bytes()) == 0)
    assert(proto.append(mut s, 4, 0, payload(4)) == proto.MALFORMED)
    var a = proto.ack_state()
    assert(proto.sent(mut a, 1) == 0)
    assert(proto.ack(mut a, 1) == 0)
    // An image reset changes base, not the connection sequence.
    assert(proto.sent(mut a, 2) == 0)
    assert(proto.ack(mut a, 1) == 0 && a.pending == 2)
    assert(proto.ack(mut a, 3) == proto.MALFORMED)
    assert(proto.ack(mut a, 2) == 0 && a.pending == 0)
    assert(proto.sent(mut a, 1) == proto.MALFORMED)
    print("PASS proto-fragment-all-splits-and-stale-ack-after-reset")
}

fn same_pen_image(cols: int, rows: int) -> List[byte] {
    let blank = image(cols, rows, false, false)
    var b = List[byte]()
    var i = 0
    while i < 22 { (mut b).push(blank[i]); i = i + 1 }
    var row = 0
    while row < rows {
        var j = 0
        while j < 16 { (mut b).push(blank[22 + row * 26 + j]); j = j + 1 }
        proto.put(mut b, cols, 2)
        var col = 0
        while col < cols {
            proto.put(mut b, 1, 1)
            proto.put(mut b, 1, 2)
            proto.put(mut b, 1, 1)
            proto.put(mut b, 32 + col % 95, 4)
            col = col + 1
        }
        row = row + 1
    }
    b
}

fn test_repaint_costs() {
    for dims in [80, 320] {
        var rows = 24
        if dims == 320 { rows = 90 }
        let blank = proto.encode(131, 0, image(dims, rows, false, false))
        let separate = proto.encode(131, 0, image(dims, rows, true, false))
        let same_pen = proto.encode(131, 0, same_pen_image(dims, rows))
        let worst = proto.encode(131, 0, image(dims, rows, true, true))
        assert(blank.code == 0 && blank.bytes.len == 28 + rows * 26)
        assert(separate.code == 0 && separate.bytes.len == 28 + dims * rows * 26)
        assert(same_pen.code == 0 && same_pen.bytes.len == 28 + rows * (18 + dims * 8))
        assert(worst.code == 0 && worst.bytes.len == 28 + dims * rows * 34)
        print("PASS proto-repaint {dims}x{rows} blank={blank.bytes.len} same_pen={same_pen.bytes.len} separate={separate.bytes.len} worst={worst.bytes.len} frames=1")
    }
}

fn test_partial_write_model() {
    let wire = proto.encode(131, 0, image(80, 24, false, false)).bytes
    var stall = 0
    while stall <= wire.len {
        var sent = 0
        var drained = 0
        var delivered = List[byte]()
        // A 4096-byte socket model: busy can take zero, never lose suffix.
        while drained < wire.len {
            let old_sent = sent
            var take_count = wire.len - sent
            if take_count > 4096 - (sent - drained) { take_count = 4096 - (sent - drained) }
            if drained == stall { take_count = 0 }
            sent = sent + take_count
            if sent == drained {
                // A later writable turn resumes from exactly the old offset.
                sent = old_sent + 1
            }
            (mut delivered).push(wire[drained])
            drained = drained + 1
            assert(sent >= drained && sent - drained <= 4096)
        }
        assert(same(delivered, wire))
        assert(proto.decode(delivered).code == 0)
        stall = stall + 1
    }
    // Every permitted short-write count of a tiny packet, including >length.
    let ping = proto.encode(12, 0, payload(12)).bytes
    var chunk = 1
    while chunk <= 4096 {
        var pos = 0
        var delivered = List[byte]()
        while pos < ping.len {
            var n = chunk
            if n > ping.len - pos { n = ping.len - pos }
            var i = 0
            while i < n { (mut delivered).push(ping[pos + i]); i = i + 1 }
            pos = pos + n
        }
        assert(same(delivered, ping))
        chunk = chunk + 1
    }
    print("PASS proto-partial-write-4096-and-every-stall-offset")
}

fn test_version_before_suffix() {
    var p = List[byte]()
    for x in [87, 82, 78, 0, 2, 0, 3, 0, 255] { (mut p).push(x as byte) }
    let v = proto.hello_version(p)
    assert(v.code == 0 && v.minimum == 2 && v.maximum == 3)
    let wire = proto.encode_part(1, 0, p)
    assert(wire.code == 0 && proto.decode(wire.bytes).code == 0)
    assert(proto.validate(1, p) != 0)
    print("PASS proto-version-before-versioned-suffix")
}

fn test_full_socket_queue() {
    let wire = proto.encode(131, 0, image(80, 24, true, false)).bytes
    assert(wire.len > 4096)
    var written = 0
    var read = 0
    var turns = 0
    var busy = 0
    var delivered = List[byte]()
    while read < wire.len {
        var n = 4096 - (written - read)
        if n > wire.len - written { n = wire.len - written }
        if n == 0 { busy = busy + 1 }
        written = written + n
        if turns % 3 != 0 {
            var count = written - read
            if count > 127 { count = 127 }
            var i = 0
            while i < count {
                (mut delivered).push(wire[read])
                read = read + 1
                i = i + 1
            }
        }
        assert(written >= read && written - read <= 4096)
        turns = turns + 1
    }
    assert(busy > 0 && same(delivered, wire))
    var first = proto.ack_state()
    var second = proto.ack_state()
    assert(proto.sent(mut first, 1) == 0)
    assert(proto.sent(mut second, 1) == 0 && proto.ack(mut second, 1) == 0)
    assert(proto.sent(mut second, 2) == 0 && first.pending == 1)
    print("PASS proto-full-4096-queue-and-independent-client")
}

fn test_connection_transitions() {
    var cases = 0
    // phase, classified event, next phase, action mask (SERVER's pure model).
    for row in [
        [0, 0, 4, 1], [0, 1, 4, 1], [0, 2, 3, 2],
        [0, 3, 4, 1], [0, 4, 3, 2], [0, 5, 3, 132],
        [0, 6, 1, 60], [0, 7, 2, 4], [0, 23, 3, 2],
        [1, 8, 1, 64], [1, 9, 1, 48], [1, 10, 1, 5120],
        [1, 11, 1, 32], [1, 12, 3, 144], [1, 13, 4, 17],
        [1, 14, 3, 144], [1, 15, 3, 144], [1, 17, 1, 512],
        [1, 18, 3, 144], [1, 22, 3, 144], [1, 24, 3, 144],
        [1, 25, 1, 8192], [1, 26, 4, 17],
        [2, 16, 3, 256], [2, 17, 2, 512], [2, 8, 3, 128],
        [2, 13, 4, 1], [2, 26, 4, 1],
        [3, 19, 3, 2048], [3, 20, 4, 1], [3, 21, 4, 1],
        [3, 13, 4, 1], [3, 8, 3, 8192], [4, 8, 4, 8192],
    ] {
        let phase = row[0] as int
        let before = server_model.Connection { phase: phase, member: phase == 1 }
        let next = server_model.transition(before, row[1] as int)
        assert(next.valid && next.phase == row[2] as int && next.actions == row[3] as int)
        assert(next.member == (next.phase == 1))
        assert(before.phase == phase)
        cases = cases + 1
    }
    let wrong = server_model.Connection { phase: 1, member: false }
    assert(!server_model.transition(wrong, 8).valid)
    assert(!server_model.transition(server_model.start(), 99).valid)
    print("PASS server-connection-transition-model rows={cases} invalid=2")
}

/// Full native rows, including large images and every stalled write offset.
pub fn all() -> int {
    test_version_before_suffix()
    test_connection_transitions()
    test_message_roundtrips()
    test_golden_and_refusals()
    test_wide_and_coverage()
    test_fragment_and_ack_model()
    test_repaint_costs()
    test_all_golden_vectors()
    test_partial_write_model()
    test_full_socket_queue()
    0
}

/// Compact checked/lupin rows: all message goldens, refusals, wide coverage,
/// all short fragment splits and the stale-ACK model; no large cost loops.
pub fn compact() -> int {
    test_version_before_suffix()
    test_connection_transitions()
    test_golden_and_refusals()
    test_wide_and_coverage()
    test_fragment_and_ack_model()
    test_all_golden_vectors()
    0
}
