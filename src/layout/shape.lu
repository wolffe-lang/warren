//! member: true
//! A tab's tree in an arena-free form, for the layout files: its shape, the
//! splits and leaves in preorder. `shape_of` reads a tab's; `add_tree`
//! builds a tab from one and its panes in tree order, so that
//! `shape_of(add_tree(s)) == s` (docs/LAYOUT.md, The arena-free form).

/// One node of a shape, in preorder: a leaf (`kind` LEAF, `axis` COLS,
/// `share` 0), or a split (`kind` SPLIT) along `axis` whose first child
/// takes `share` of it, followed by its first subtree's nodes and then its
/// second's.
pub struct ShapeNode {
    kind: int,
    axis: int,
    share: int,
}

/// Why `add_tree` refused: the shape is not one whole tree with a leaf for
/// each pane, or a node is out of range (`bad_shape`); a pane is below 1
/// (`bad_id`); a pane is given twice or is already a live pane
/// (`duplicate_id`); the focus is not one of the leaves (`bad_focus`).
pub error ShapeRefusal = {bad_shape, bad_id, duplicate_id, bad_focus}

fn shape_walk(t: Tab, i: int, mut out: List[ShapeNode]) {
    if t.nodes[i].kind == LEAF {
        (mut out).push(ShapeNode { kind: LEAF, axis: COLS, share: 0 })
        return
    }
    (mut out).push(ShapeNode { kind: SPLIT, axis: t.nodes[i].axis, share: t.nodes[i].share })
    shape_walk(t, t.nodes[i].first, mut out)
    shape_walk(t, t.nodes[i].second, mut out)
}

/// The tab's shape in preorder; empty for an unknown tab.
pub fn shape_of(l: Layout, tab: int) -> List[ShapeNode] {
    var out = List[ShapeNode]()
    let ti = tab_index(l, tab)
    if ti >= 0 { shape_walk(l.tabs[ti], l.tabs[ti].root, mut out) }
    out
}

/// The index just past the subtree that starts at `i`, or -1 when the
/// shape ends inside it or one of its nodes is out of range.
fn shape_end(shape: List[ShapeNode], i: int) -> int {
    if i >= shape.len { return -1 }
    if shape[i].kind == LEAF {
        if shape[i].axis != COLS || shape[i].share != 0 { return -1 }
        return i + 1
    }
    if shape[i].kind != SPLIT { return -1 }
    if shape[i].axis != COLS && shape[i].axis != ROWS { return -1 }
    if shape[i].share < 1 || shape[i].share > SHARE_ONE - 1 { return -1 }
    let first = shape_end(shape, i + 1)
    if first < 0 { return -1 }
    shape_end(shape, first)
}

/// Where `shape_build` is: the next shape node and the next pane.
struct ShapeCursor {
    node: int,
    leaf: int,
}

/// Put the subtree at the cursor into the arena under `parent`; answers its
/// slot.
fn shape_build(mut t: Tab, shape: List[ShapeNode], panes: List[int], mut at: ShapeCursor, parent: int) -> int {
    let i = at.node
    at.node += 1
    if shape[i].kind == LEAF {
        let pane = panes[at.leaf]
        at.leaf += 1
        return alloc(mut t, take Node {
            kind: LEAF,
            pane: pane,
            axis: COLS,
            first: -1,
            second: -1,
            share: 0,
            parent: parent,
        })
    }
    let s = alloc(mut t, take Node {
        kind: SPLIT,
        pane: 0,
        axis: shape[i].axis,
        first: -1,
        second: -1,
        share: shape[i].share,
        parent: parent,
    })
    let a = shape_build(mut t, shape, panes, mut at, s)
    let b = shape_build(mut t, shape, panes, mut at, s)
    t.nodes[s].first = a
    t.nodes[s].second = b
    s
}

/// A new last tab whose tree is `shape`, its leaves holding `panes` in tree
/// order. It takes the next tab id, which it answers; its focus is the
/// `focus_leaf`th leaf (from 1), first in its focus order and the rest in
/// tree order. The active tab does not change.
pub fn add_tree(
    mut l: Layout,
    shape: List[ShapeNode],
    panes: List[int],
    name: str,
    focus_leaf: int,
    zoomed: bool,
) -> int ! ShapeRefusal {
    if shape_end(shape, 0) != shape.len { return bad_shape }
    var count = 0
    var i = 0
    while i < shape.len {
        if shape[i].kind == LEAF { count += 1 }
        i += 1
    }
    if panes.len != count { return bad_shape }
    for p in panes {
        if p < 1 { return bad_id }
    }
    i = 0
    while i < panes.len {
        if locate(l, panes[i]).tab >= 0 { return duplicate_id }
        var j = 0
        while j < i {
            if panes[j] == panes[i] { return duplicate_id }
            j += 1
        }
        i += 1
    }
    if focus_leaf < 1 || focus_leaf > count { return bad_focus }
    let focus = panes[focus_leaf - 1]
    var order = List[int]()
    (mut order).push(focus)
    for p in panes {
        if p != focus { (mut order).push(p) }
    }
    var t = Tab {
        id: l.next_id,
        name: name_bytes(name),
        nodes: List[Node](),
        root: -1,
        focus: focus,
        zoomed: zoomed,
        focus_order: order,
    }
    var at = ShapeCursor { node: 0, leaf: 0 }
    t.root = shape_build(mut t, shape, panes, mut at, -1)
    let id = l.next_id
    l.next_id += 1
    (mut l.tabs).push(copy t)
    id
}

/// A layout of one tab (id 1, active) built from a shape and its panes as
/// `add_tree` builds a tab, beside `new`; the same refusals.
pub fn from_tree(
    shape: List[ShapeNode],
    panes: List[int],
    name: str,
    focus_leaf: int,
    zoomed: bool,
) -> Layout ! ShapeRefusal {
    // Nothing is built yet: every tree is refused.
    let _unused = shape.len + panes.len + name.len + focus_leaf
    let _zoomed = zoomed
    bad_shape
}
