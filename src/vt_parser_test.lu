//! member: false
//! Pure parser checks; this entry also runs under lupin.
use vt

fn expect_print(data: List[byte], expected: List[int]) {
    var p = vt.new_parser()
    var got = List[int]()
    for b in data {
        let step = vt.advance(mut p, b)
        if step.count > 0 && step.first.kind == 1 { (mut got).push(step.first.value) }
        if step.count > 1 && step.second.kind == 1 { (mut got).push(step.second.value) }
    }
    assert(got.len == expected.len, "parser-decoder-length")
    var i = 0
    while i < got.len {
        assert(got[i] == expected[i], "parser-decoder-scalar")
        i += 1
    }
}

fn expect_octets(data: List[int], expected: List[int]) {
    var octets = List[byte]()
    for n in data { (mut octets).push(n as byte) }
    expect_print(octets, expected)
}

fn test_decoder() {
    expect_print("a中😀b".bytes(), [97, 20013, 128512, 98])
    expect_octets([97, 195, 40, 98], [97, 65533, 40, 98])
    expect_octets([97, 228, 184, 40, 98], [97, 65533, 40, 98])
    expect_octets([97, 237, 160, 128, 98], [97, 65533, 98])
    expect_octets([97, 192, 175, 98], [97, 65533, 65533, 98])
    expect_octets([97, 244, 144, 128, 128, 98], [97, 65533, 65533, 65533, 65533, 98])
    expect_octets([97, 128, 255, 98], [97, 65533, 65533, 98])
    expect_octets([194, 155, 51, 49, 109, 88], [51, 49, 109, 88])
    expect_octets([155, 51, 49, 109, 88], [65533, 51, 49, 109, 88])
    expect_octets([226, 128, 128, 240, 144, 128, 128], [8192, 65536])
}

fn expect_tokens(text: str, expected: List[int]) {
    var p = vt.new_parser()
    var got = List[int]()
    for b in text.bytes() {
        let step = vt.advance(mut p, b)
        if step.count > 0 {
            (mut got).push(step.first.kind)
            (mut got).push(step.first.value)
        }
        if step.count > 1 {
            (mut got).push(step.second.kind)
            (mut got).push(step.second.value)
        }
    }
    assert(got.len == expected.len, "parser-transitions-length")
    var i = 0
    while i < got.len {
        assert(got[i] == expected[i], "parser-transitions-token")
        i += 1
    }
}

fn test_transitions() {
    expect_tokens("\u{1b}[31mX", [4, 109, 1, 88])
    expect_tokens("\u{1b}[3\r1mX", [2, 13, 4, 109, 1, 88])
    expect_tokens("\u{1b}[31\u{18}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}[31\u{1a}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}[31\u{1b}[1mX", [4, 109, 1, 88])
    expect_tokens("\u{1b}[5 zX", [4, 122, 1, 88])
    expect_tokens("\u{1b}[?9999hX", [4, 104, 1, 88])
    expect_tokens("\u{1b}jX", [3, 106, 1, 88])
    expect_tokens("\u{1b}(0X", [3, 48, 1, 88])
    expect_tokens("\u{1b}]2;abc\u{7}X", [5, 0, 1, 88])
    expect_tokens("\u{1b}]2;abc\u{1b}\\X", [5, 0, 1, 88])
    expect_tokens("\u{1b}]2;abc\nX", [])
    expect_tokens("\u{1b}Pqqq\u{7}X\u{1b}\\Y", [1, 89])
    expect_tokens("\u{1b}_app\u{1b}\\X", [1, 88])
    expect_tokens("\u{1b}^pm\u{1b}\\X", [1, 88])
    expect_tokens("\u{1b}Xsos\u{1b}\\X", [1, 88])
    expect_tokens("\u{1b}]2;lost\u{1b}[31mX", [4, 109, 1, 88])
    expect_tokens("\u{1b}[1?mX", [1, 88])
    expect_tokens("\u{1b}[1 2mX", [1, 88])
    expect_tokens("\u{1b}[1   mX", [1, 88])
}

fn feed_trace(mut p: vt.Parser, data: List[byte], seed: int) -> int {
    var fingerprint = seed
    for b in data {
        let step = vt.advance(mut p, b)
        fingerprint = (fingerprint * 31 + step.count) % 1000000007
        if step.count > 0 {
            fingerprint = (fingerprint * 31 + step.first.kind * 1114112 + step.first.value) % 1000000007
        }
        if step.count > 1 {
            fingerprint = (fingerprint * 31 + step.second.kind * 1114112 + step.second.value) % 1000000007
        }
    }
    fingerprint
}

fn feed_part(mut p: vt.Parser, data: List[byte]) -> int {
    feed_trace(mut p, data, 0)
}

fn test_metadata_and_caps() {
    var p = vt.new_parser()
    feed_part(mut p, "\u{1b}[?38:2::1:2:3;99999999999999999999 $p".bytes())
    assert(p.state == 0)
    assert(p.private_marker == 63)
    assert(p.param_count == 2)
    assert(p.subs[0] == 6)
    assert(p.params[0] == 38 && p.params[1] == 2 && p.params[2] == 0 - 1)
    assert(p.params[3] == 1 && p.params[4] == 2 && p.params[5] == 3)
    assert(p.params[6] == 65535)
    assert(p.inter_count == 2 && p.inter[0] == 32 && p.inter[1] == 36)
    feed_part(mut p, "\u{1b}[1:2:3:4:5:6:7".bytes())
    assert(p.state == 6 && p.subs[0] == 6)
    let ignored = vt.advance(mut p, 109 as byte)
    assert(ignored.count == 0 && p.state == 0)
    feed_part(mut p, "\u{1b}[".bytes())
    var i = 0
    while i < 31 { vt.advance(mut p, 59 as byte); i += 1 }
    assert(p.param_count == 32 && p.state == 4)
    let accepted = vt.advance(mut p, 109 as byte)
    assert(accepted.count == 1 && accepted.first.kind == 4)
    feed_part(mut p, "\u{1b}[".bytes())
    i = 0
    while i < 32 { vt.advance(mut p, 59 as byte); i += 1 }
    assert(p.param_count == 32 && p.state == 6)
    assert(vt.advance(mut p, 109 as byte).count == 0)
    feed_part(mut p, "\u{1b}]".bytes())
    i = 0
    while i < 4096 { vt.advance(mut p, 97 as byte); i += 1 }
    assert(p.payload_len == 4096 && !p.payload_overflow)
    assert(vt.advance(mut p, 7 as byte).first.kind == 5)
    feed_part(mut p, "\u{1b}]".bytes())
    i = 0
    while i < 4097 { vt.advance(mut p, 97 as byte); i += 1 }
    assert(p.payload_len == 4096 && p.payload_overflow)
    assert(vt.advance(mut p, 7 as byte).count == 0 && p.state == 0)
    feed_part(mut p, "\u{1b}]2;中\u{7}".bytes())
    assert(p.payload_len == 5 && p.payload[2] as int == 228)
}

fn test_chunking() {
    let data = "a中😀\u{1b}[38:2::1:2:3mX\u{1b}]2;中\u{1b}\\Y".bytes()
    var whole = vt.new_parser()
    let whole_trace = feed_part(mut whole, data)
    var split = 0
    while split <= data.len {
        var p = vt.new_parser()
        let first_trace = feed_part(mut p, data[0..split])
        let split_trace = feed_trace(mut p, data[split..data.len], first_trace)
        assert(split_trace == whole_trace, "parser-chunking-tokens")
        assert(p.state == whole.state && p.utf_left == whole.utf_left, "parser-chunking-state")
        assert(p.param_count == whole.param_count && p.payload_len == whole.payload_len)
        var k = 0
        while k < 192 { assert(p.params[k] == whole.params[k]); k += 1 }
        k = 0
        while k < p.payload_len { assert(p.payload[k] == whole.payload[k]); k += 1 }
        split += 1
    }
    // A partial scalar and a partial sequence have no end-of-feed flush.
    var p = vt.new_parser()
    assert(vt.advance(mut p, 228 as byte).count == 0 && p.utf_left == 2)
    assert(vt.advance(mut p, 184 as byte).count == 0 && p.utf_left == 1)
    assert(vt.advance(mut p, 173 as byte).first.value == 20013)
    feed_part(mut p, "\u{1b}[31".bytes())
    assert(p.state == 4)
    let final = vt.advance(mut p, 109 as byte)
    assert(final.count == 1 && final.first.kind == 4 && p.params[0] == 31)
}

fn test_measured_parser_edges() {
    expect_tokens("\u{1b}中X", [1, 88])
    expect_tokens("\u{1b}[31中mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}(中X", [1, 88])
    expect_tokens("\u{1b}[中mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}[1 中mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}[1?中mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}[ 1中mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}\u{fffd}X", [1, 88])
    expect_tokens("\u{1b}[31\u{fffd}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}]2;abc\u{18}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}]2;abc\u{1a}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}Pabc\u{18}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}Pabc\u{1a}mX", [1, 109, 1, 88])
    expect_tokens("\u{1b}\u{7f}jX", [3, 106, 1, 88])
    expect_tokens("\u{1b}[3\u{7f}1mX", [4, 109, 1, 88])
    expect_tokens("\u{1b}Pabc\u{7f}def\u{1b}\\X", [1, 88])
    // D8: DEL is dropped from titles, not changed to the reference's '?'.
    var p = vt.new_parser()
    feed_part(mut p, "\u{1b}]2;a\u{7f}b\u{7}".bytes())
    assert(p.output_count == 1 && p.first_kind == 5)
    assert(p.payload_len == 4 && p.payload[2] as int == 97 && p.payload[3] as int == 98)
}

fn main() -> int {
    test_decoder()
    test_transitions()
    test_metadata_and_caps()
    test_chunking()
    test_measured_parser_edges()
    0
}
