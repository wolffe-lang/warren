//! member: false
//! Pure parser checks; this entry also runs under lupin.
use vt.parser

fn expect_print(data: List[byte], expected: List[int]) {
    var p = parser.new()
    var got = List[int]()
    for b in data {
        let step = parser.advance(mut p, b)
        if step.count > 0 && step.first.kind == 1 { (mut got).push(step.first.value) }
        if step.count > 1 && step.second.kind == 1 { (mut got).push(step.second.value) }
    }
    assert(got == expected, "parser-decoder")
}

fn test_decoder() {
    expect_print("a中😀b".bytes(), [97, 20013, 128512, 98])
    expect_print([97, 195, 40, 98], [97, 65533, 40, 98])
    expect_print([97, 228, 184, 40, 98], [97, 65533, 40, 98])
    expect_print([97, 237, 160, 128, 98], [97, 65533, 98])
    expect_print([97, 192, 175, 98], [97, 65533, 65533, 98])
    expect_print([97, 244, 144, 128, 128, 98], [97, 65533, 65533, 65533, 65533, 98])
    expect_print([97, 128, 255, 98], [97, 65533, 65533, 98])
    expect_print([194, 155, 51, 49, 109, 88], [51, 49, 109, 88])
    expect_print([155, 51, 49, 109, 88], [65533, 51, 49, 109, 88])
    expect_print([226, 128, 128, 240, 144, 128, 128], [8192, 65536])
}

fn main() -> int {
    test_decoder()
    0
}
