//! member: true
//! The verbs `warren <verb>` sends to the server. The verbs that act on a
//! pane are the command line's (`:`) own, read by its own parser, so the
//! two can never differ; a verb may name its pane with `-t TARGET`.
use config

/// A verb that is one of the command line's actions on a pane.
pub const VERB_ACTION: int = 1
/// `kill-server`.
pub const VERB_KILL_SERVER: int = 2
/// `list-sessions` (or `ls`).
pub const VERB_LIST_SESSIONS: int = 3
/// `new-session [NAME]`.
pub const VERB_NEW_SESSION: int = 4
/// `list --json`.
pub const VERB_LIST_JSON: int = 5
/// `send-keys [-t TARGET] [-l] [--] KEY...`.
pub const VERB_SEND_KEYS: int = 6
/// `capture-pane [-t TARGET] [-p] [-e] [-J] [-S LINE] [-E LINE]`.
pub const VERB_CAPTURE: int = 7
/// A capture's line given as `-`: history's first line for `-S`, the last
/// visible row for `-E`.
pub const LINE_EDGE: int = 1125899906842624
/// A capture's line not given: the first visible row for `-S`, the last
/// visible row for `-E`.
pub const LINE_UNSET: int = 1125899906842625

/// A verb read from a COMMAND's arguments: `ok`, its kind, its target (empty
/// for none), the command line's reading for an action, a new session's
/// name and whether one was given (an empty name given is still a name, which
/// the server refuses), the directory a new pane starts in (`-c DIR`) and
/// the program it runs (`-- CMD [ARG...]`, empty for the shell); or a
/// refusal, its exit status (2 for usage) and why.
/// For `send-keys`: its words (`keys`) and whether they are all text
/// (`literal`). For `capture-pane`: whether it prints (`print`), writes
/// renditions (`escapes`) and joins wrapped rows (`join`), and its first and
/// last lines (`start`, `end`: a line number, LINE_EDGE or LINE_UNSET).
pub struct Verb { ok: bool, kind: int, target: str, command: config.Command, name: str, named: bool, dir: str, has_dir: bool,
    argv: List[str], status: int, why: str, keys: List[str], literal: bool, print: bool, escapes: bool, join: bool,
    start: int, end: int }

// The server's own verbs, besides the command line's (a function: the
// reference interpreter does not resolve a method on a module constant).
fn server_verbs() -> str {
    "kill-server list-sessions ls new-session list send-keys capture-pane"
}

fn usage_error(why: str) -> Verb {
    Verb { ok: false, kind: 0, target: "", command: config.command(""), name: "", named: false, dir: "", has_dir: false,
        argv: List[str](), status: EXIT_USAGE, why: why, keys: List[str](), literal: false, print: false, escapes: false,
        join: false, start: LINE_UNSET, end: LINE_UNSET }
}

fn verb_of(kind: int, target: str, name: str) -> Verb {
    Verb { ok: true, kind: kind, target: target, command: config.command(""), name: name, named: false, dir: "",
        has_dir: false, argv: List[str](), status: EXIT_DONE, why: "", keys: List[str](), literal: false, print: false,
        escapes: false, join: false, start: LINE_UNSET, end: LINE_UNSET }
}

fn is_server_verb(v: str) -> bool {
    for n in server_verbs().split(" ") {
        if n == v { return true }
    }
    false
}

fn is_command_verb(v: str) -> bool {
    for n in config.command_verbs() {
        if n == v { return true }
    }
    false
}

/// Read a COMMAND's arguments, the verb first: `VERB [-t TARGET] [-c DIR]
/// [ARGUMENT...] [-- CMD [ARG...]]`, `-t` and `-c` anywhere after the verb,
/// each at most once; every word after `--` is the program's. `-c` and `--`
/// go with the verbs that make a pane (`new-session` takes `-c` alone). The
/// command line's verbs are read by the command line's own parser, so a verb
/// and its `:` line are one reading; the server's verbs take no target.
pub fn parse_verb(argv: List[str]) -> Verb {
    if argv.len == 0 { return usage_error("usage: warren <verb> [-t TARGET] [ARGUMENT...]") }
    let v = argv[0]
    let server_verb = is_server_verb(v)
    if !server_verb && !is_command_verb(v) { return usage_error("unknown command: " + v) }
    if v == "send-keys" { return parse_send_keys(argv) }
    if v == "capture-pane" { return parse_capture(argv) }
    var target = ""
    var targeted = false
    var dir = ""
    var has_dir = false
    var program = List[str]()
    var dashed = false
    var rest = List[str]()
    var i = 1
    while i < argv.len {
        if argv[i] == "--" {
            if i + 1 >= argv.len { return usage_error("usage: -- needs a command") }
            var j = i + 1
            while j < argv.len {
                (mut program).push(argv[j])
                j += 1
            }
            dashed = true
            i = argv.len
        } else if argv[i] == "-t" {
            if targeted { return usage_error("usage: -t given twice") }
            if i + 1 >= argv.len { return usage_error("usage: -t needs a target") }
            target = argv[i + 1]
            targeted = true
            i += 2
        } else if argv[i] == "-c" {
            if has_dir { return usage_error("usage: -c given twice") }
            if i + 1 >= argv.len { return usage_error("usage: -c needs a directory") }
            dir = argv[i + 1]
            has_dir = true
            i += 2
        } else {
            (mut rest).push(argv[i])
            i += 1
        }
    }
    if has_dir || dashed {
        if !makes_a_pane(v) { return usage_error("usage: {v} makes no pane: -c and -- go with split-right, split-down, new-tab and new-session") }
        if dashed && v == "new-session" { return usage_error("usage: new-session takes no command") }
    }
    if server_verb {
        if targeted { return usage_error("usage: {v} takes no target") }
        if v == "kill-server" {
            if rest.len > 0 { return usage_error("usage: kill-server") }
            return verb_of(VERB_KILL_SERVER, "", "")
        }
        if v == "list-sessions" || v == "ls" {
            if rest.len > 0 { return usage_error("usage: {v}") }
            return verb_of(VERB_LIST_SESSIONS, "", "")
        }
        if v == "new-session" {
            if rest.len > 1 { return usage_error("usage: new-session [-c DIR] [NAME]") }
            let name = if rest.len == 1 then rest[0] else ""
            var n = verb_of(VERB_NEW_SESSION, "", name)
            n.named = rest.len == 1
            n.dir = dir
            n.has_dir = has_dir
            return n
        }
        if rest.len != 1 || rest[0] != "--json" { return usage_error("usage: list --json") }
        return verb_of(VERB_LIST_JSON, "", "")
    }
    // `source` reads settings for the whole server: no pane is its target.
    if v == "source" && targeted { return usage_error("usage: source takes no target") }
    var line = v
    for a in rest { line = line + " " + a }
    let c = config.command(line)
    if !c.ok { return usage_error(c.why) }
    Verb { ok: true, kind: VERB_ACTION, target: target, command: c, name: "", named: false, dir: dir, has_dir: has_dir,
        argv: program, status: EXIT_DONE, why: "", keys: List[str](), literal: false, print: false, escapes: false,
        join: false, start: LINE_UNSET, end: LINE_UNSET }
}

// send-keys's flags that tmux has and this version does not.
fn refused_send_flag(a: str) -> bool {
    for f in "-H -K -M -N -R -X -F -c".split(" ") {
        if f == a { return true }
    }
    false
}

// `send-keys [-t TARGET] [-l] [--] KEY...`: options only before the first
// key (getopt's rule, as tmux reads them), `--` ends them.
fn parse_send_keys(argv: List[str]) -> Verb {
    var target = ""
    var targeted = false
    var literal = false
    var i = 1
    var reading = true
    while reading && i < argv.len {
        let a = argv[i]
        if a == "--" {
            i += 1
            reading = false
        } else if a == "-t" {
            if targeted { return usage_error("usage: -t given twice") }
            if i + 1 >= argv.len { return usage_error("usage: -t needs a target") }
            target = argv[i + 1]
            targeted = true
            i += 2
        } else if a == "-l" {
            literal = true
            i += 1
        } else if a.len > 1 && a.starts_with("-") {
            if refused_send_flag(a) { return usage_error("usage: send-keys {a}: not in this version") }
            return usage_error("usage: send-keys: unknown flag {a}")
        } else {
            reading = false
        }
    }
    var keys = List[str]()
    while i < argv.len {
        (mut keys).push(argv[i])
        i += 1
    }
    if keys.len == 0 { return usage_error("usage: send-keys [-t TARGET] [-l] [--] KEY...") }
    var v = verb_of(VERB_SEND_KEYS, target, "")
    v.keys = keys
    v.literal = literal
    v
}

/// A capture's line number read: `-` (LINE_EDGE), or digits after an
/// optional `+` or `-`; `ok` false for anything else.
pub struct LineRead { ok: bool, n: int }

/// Read a `-S` or `-E` value.
pub fn line_of(text: str) -> LineRead {
    if text == "-" { return LineRead { ok: true, n: LINE_EDGE } }
    var sign = 1
    var digits = text
    if text.starts_with("-") || text.starts_with("+") {
        if text.starts_with("-") { sign = 0 - 1 }
        digits = text[1..text.len]
    }
    if digits.len == 0 || digits.len > 12 { return LineRead { ok: false, n: 0 } }
    var n = 0
    for b in digits.bytes() {
        let d = (b as int) - 48
        if d < 0 || d > 9 { return LineRead { ok: false, n: 0 } }
        n = n * 10 + d
    }
    LineRead { ok: true, n: sign * n }
}

// `capture-pane [-t TARGET] [-p] [-e] [-J] [-S LINE] [-E LINE]`: flags may be
// clustered (`-pJ`), a value may follow its flag in the same word (`-S-50`).
fn parse_capture(argv: List[str]) -> Verb {
    var v = verb_of(VERB_CAPTURE, "", "")
    var targeted = false
    var i = 1
    while i < argv.len {
        let a = argv[i]
        if a.len < 2 || !a.starts_with("-") { return usage_error("usage: capture-pane takes no argument: {a}") }
        var k = 1
        while k < a.len {
            let f = a[k..k + 1]
            if f == "p" {
                v.print = true
            } else if f == "e" {
                v.escapes = true
            } else if f == "J" {
                v.join = true
            } else if f == "S" || f == "E" || f == "t" {
                var value = a[k + 1..a.len]
                if value.len == 0 {
                    if i + 1 >= argv.len { return usage_error("usage: -{f} needs a value") }
                    i += 1
                    value = argv[i]
                }
                if f == "t" {
                    if targeted { return usage_error("usage: -t given twice") }
                    v.target = value
                    targeted = true
                } else {
                    let line = line_of(value)
                    if !line.ok { return usage_error("usage: -{f} {value}: not a line number") }
                    if f == "S" { v.start = line.n } else { v.end = line.n }
                }
                k = a.len
            } else if "aAbCNPqT".contains(f) {
                return usage_error("usage: capture-pane -{f}: not in this version")
            } else {
                return usage_error("usage: capture-pane: unknown flag -{f}")
            }
            k += 1
        }
        i += 1
    }
    v
}

// The verbs that make a pane, and so take `-c DIR` (and, but for
// `new-session`, `-- CMD`).
fn makes_a_pane(v: str) -> bool {
    v == "split-right" || v == "split-down" || v == "new-tab" || v == "new-session"
}

/// Every verb the server answers: its own, then the command line's.
pub fn verb_names() -> List[str] {
    var out = List[str]()
    for n in server_verbs().split(" ") { (mut out).push(n) }
    for n in config.command_verbs() { (mut out).push(n) }
    out
}
