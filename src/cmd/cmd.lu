//! member: true
//! The command client and dispatcher behind `warren <verb>`.
//!
//! The bounded vt-dump raw/replay diagnostic is implemented. Command-client
//! operations for a live server remain for W5.

/// The milestone that fills this module in.
pub fn milestone() -> str {
    "W5"
}

/// Whether the module is pure: no I/O, so it runs on every host and under
/// the reference interpreter.
pub fn pure() -> bool {
    false
}
