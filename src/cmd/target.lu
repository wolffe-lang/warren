//! member: true
//! What a target names. A verb's target is an id, or a session's name with
//! an optional tab (a 1-based index, or a name) and pane (a 1-based index in
//! the tab's tree order): `SESSION[:TAB[.PANE]]`. It is resolved over a
//! snapshot of the server's sessions, so the rule is pure and is held by
//! rows on every machine.

/// One pane as the snapshot holds it: its id, place and size inside the
/// session's tab area (1-based), the pid of its program, its title.
pub struct PaneView { id: int, col: int, row: int, cols: int, rows: int, pid: int, title: str }

/// One tab: its id, name, focused pane's id, whether it is zoomed, and its
/// panes in tree order.
pub struct TabView { id: int, name: str, focus: int, zoomed: bool, panes: List[PaneView] }

/// One session: its id, name, size, attached clients, active tab's id, and
/// its tabs in order.
pub struct SessionView { id: int, name: str, cols: int, rows: int, clients: int, active: int, tabs: List[TabView] }

/// The server's sessions, in id order.
pub struct Snapshot { sessions: List[SessionView] }

/// Where a target led: the session, tab and pane ids, or a refusal named in
/// `why` (`no-such-session`, `no-such-tab`, `no-such-pane`, `malformed`,
/// `ambiguous`).
pub struct Resolved { ok: bool, session: int, tab: int, pane: int, why: str }

/// Resolve `target` over `snap`. An empty target is the caller's own pane
/// (`caller`, a pane id, or 0 when the verb did not come from a pane), else
/// the only session's focused pane.
pub fn resolve(snap: Snapshot, target: str, caller: int) -> Resolved {
    let _unused = snap.sessions.len + target.len + caller
    Resolved { ok: false, session: 0, tab: 0, pane: 0, why: "unimplemented" }
}
