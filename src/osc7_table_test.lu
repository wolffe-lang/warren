//! member: false
//! Every row of tests/session/osc7.table, fed to a pane named
//! `warren-table-host` after it reported /tmp/osc7-base, leaves the table's
//! warren column: the stored path in hex (written as the payload is, with
//! `{hh*N}` for a run), `kept` for /tmp/osc7-base, `none` for no path. A
//! native program (the table holds a 70,000-byte payload): `PASS osc7-table
//! rows=40`, or a FAIL naming the first row that differs; exit 1 then.
use std.fs
use vt

fn hex(b: List[byte]) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    for x in b {
        let v = x as int
        (mut out).push(digits.bytes()[v / 16])
        (mut out).push(digits.bytes()[v % 16])
    }
    str_from_utf8(out) else ""
}

fn nibble(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    0 - 1
}

// A payload column's bytes: hex, `{host}` the pane's name, `{hh*N}` byte hh
// N times; an empty list with `ok` false when the column is not that.
struct Expanded { ok: bool, data: List[byte] }

fn expand(column: str) -> Expanded {
    let c = column.bytes()
    var out = List[byte]()
    var i = 0
    while i < c.len {
        if c[i] as int == 123 {
            var j = i + 1
            while j < c.len && c[j] as int != 125 { j += 1 }
            if j == c.len { return Expanded { ok: false, data: out } }
            let token = column[i + 1..j]
            if token == "host" {
                for b in "warren-table-host".bytes() { (mut out).push(b) }
            } else {
                let parts = token.split("*")
                if parts.len != 2 || parts[0].len != 2 { return Expanded { ok: false, data: out } }
                let high = nibble(parts[0].bytes()[0] as int)
                let low = nibble(parts[0].bytes()[1] as int)
                let n = parts[1].to_int() else 0 - 1
                if high < 0 || low < 0 || n < 1 { return Expanded { ok: false, data: out } }
                var k = 0
                while k < n { (mut out).push((high * 16 + low) as byte); k += 1 }
            }
            i = j + 1
        } else {
            if i + 1 >= c.len { return Expanded { ok: false, data: out } }
            let high = nibble(c[i] as int)
            let low = nibble(c[i + 1] as int)
            if high < 0 || low < 0 { return Expanded { ok: false, data: out } }
            (mut out).push((high * 16 + low) as byte)
            i += 2
        }
    }
    Expanded { ok: true, data: out }
}

// What a pane named `warren-table-host` keeps after /tmp/osc7-base and
// then `payload`, as the table's warren column writes it.
fn warren_column(payload: List[byte]) -> str {
    var pane = vt.new(20, 4, 0)
    let _named = vt.set_local_host(mut pane, "warren-table-host")
    vt.feed(mut pane, "\u{1b}]7;file:///tmp/osc7-base\u{7}".bytes())
    vt.feed(mut pane, payload)
    let path = vt.reported_dir(pane)
    if path == "/tmp/osc7-base" { return "kept" }
    if pane.cwd_length == 0 { return "none" }
    hex(pane.cwd_storage[0..pane.cwd_length])
}

fn main() -> int {
    let text = fs.read_text("tests/session/osc7.table") else {
        print("FAIL osc7-table the table did not read")
        return 1
    }
    var rows = 0
    for line in text.lines() {
        if line.len == 0 || line.starts_with("#") { continue }
        let f = line.split("\t")
        if f.len != 5 {
            print("FAIL osc7-table a line of {f.len} columns")
            return 1
        }
        let payload = expand(f[1])
        if !payload.ok {
            print("FAIL osc7-table {f[0]}: the payload column is not hex")
            return 1
        }
        let got = warren_column(payload.data)
        var want = f[3]
        if want != "kept" && want != "none" {
            let column = expand(f[3])
            if !column.ok {
                print("FAIL osc7-table {f[0]}: the warren column is not hex")
                return 1
            }
            want = hex(column.data)
        }
        if got != want {
            print("FAIL osc7-table {f[0]}: warren {got}, the table's warren column {f[3]}")
            return 1
        }
        rows += 1
    }
    if rows != 40 {
        print("FAIL osc7-table {rows} rows, not 40")
        return 1
    }
    print("PASS osc7-table rows={rows}")
    0
}
