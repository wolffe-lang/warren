//! member: true
//! The compositor for a session: one client's frame made of every shown
//! pane's grid in its rect, the borders between them with the focused
//! pane's marked, and the bar's two lines below the tab area. Composed as
//! a delta against the client's shadow over the regions that may have
//! changed (a pane's rect when its grid changed, the bar's rows, all of it
//! after a layout change), so a keystroke's image holds that pane's cells.
use proto
use vt

/// A blank cell in the default rendition.
pub fn blank_cell() -> vt.Cell {
    vt.Cell { base: 32, mark1: 0, mark2: 0, width: 1, flags: 0, foreground: 0 - 1, background: 0 - 1, written: false }
}

/// A border or bar cell: a scalar of width one with a rendition.
pub fn chrome_cell(base: int, flags: int, fg: int) -> vt.Cell {
    vt.Cell { base: base, mark1: 0, mark2: 0, width: 1, flags: flags, foreground: fg, background: 0 - 1, written: true }
}

/// The frame's cell at row-major index `i`. `bar` is the client's own
/// cells over the frame's last rows: the bar's two lines, the whole frame
/// while its key list is open, or nothing when no bar row is read. Else the
/// owner map's pane (its active screen at the rect offset) or the border
/// cell. A wide glyph on a pane's last column (which the emulator does not
/// make) would cross a border: it is sent one column wide.
fn frame_cell(panes: List[Pane], ses: Session, bar: List[vt.Cell], view: vt.View, view_slot: int, i: int) -> vt.Cell {
    let cols = ses.cols
    let area = ses.rows - BAR_LINES
    let r0 = i / cols
    let top = ses.rows - bar.len / cols
    if r0 >= top {
        let j = i - top * cols
        if j >= 0 && j < bar.len { return bar[j] }
        return blank_cell()
    }
    if r0 >= area { return blank_cell() }
    if i >= ses.owner.len { return blank_cell() }
    let o = ses.owner[i]
    if o < 0 || o >= panes.len {
        if i < ses.border.len { return ses.border[i] }
        return blank_cell()
    }
    let c0 = i % cols
    let pr = r0 - (panes[o].at_row - 1)
    let pc = c0 - (panes[o].at_col - 1)
    let pcols = panes[o].screen.cols
    if pr < 0 || pc < 0 || pc >= pcols || pr >= panes[o].screen.rows { return blank_cell() }
    // A client looking back sees its window in place of the pane's screen.
    let viewed = o == view_slot && view.cols == pcols && view.rows == panes[o].screen.rows
    // This client's selection is drawn inverse over its window.
    let marked = viewed && vt.view_marked(view, pr + 1, pc + 1)
    var cell = if viewed then view.screen.cells[pr * pcols + pc] else active_cell(panes[o].screen, pr * pcols + pc)
    if marked {
        cell.flags = if cell.flags & INVERSE != 0 then cell.flags - INVERSE else cell.flags + INVERSE
    }
    if cell.width == 2 && pc == pcols - 1 {
        return vt.Cell { base: cell.base, mark1: cell.mark1, mark2: cell.mark2, width: 1, flags: cell.flags,
            foreground: cell.foreground, background: cell.background, written: cell.written }
    }
    cell
}

// The frame's cell at column c (1-based) of `row` into `line[c]`, once a
// row: `have[c]` says it is there; `sh.reads` counts each one computed.
fn row_cell(mut line: List[vt.Cell], mut have: List[bool], mut sh: Shadow, panes: List[Pane], ses: Session,
    bar: List[vt.Cell], view: vt.View, view_slot: int, row: int, c: int) {
    if have[c] { return }
    line[c] = frame_cell(panes, ses, bar, view, view_slot, (row - 1) * ses.cols + c - 1)
    have[c] = true
    sh.reads += 1
}

// Emit the runs covering columns a..b (1-based, inclusive) of one row of
// the frame from its cells in `line`; as `emit_span` for one pane.
fn emit_line(mut body: List[byte], line: List[vt.Cell], cols: int, row: int, a: int, b: int) -> int {
    var runs = 0
    var col = a
    while col <= b {
        let lead = copy line[col]
        var records = List[byte]()
        var record_count = 0
        var covered = 0
        var c = col
        while c <= b {
            let cell = copy line[c]
            if !same_rendition(cell, lead) && c > col { break }
            let orphan = cell.width == 0
            let w = sent_width(cell, c, cols)
            var times = 1
            var next = c + w
            while next + w - 1 <= b && times < 65535 && !orphan {
                if !same_glyph(line[next], cell) || !same_rendition(line[next], lead) || sent_width(line[next], next, cols) != w {
                    break
                }
                times += 1
                next += w
            }
            put_record(mut records, cell, w, times, orphan)
            record_count += 1
            covered += w * times
            c = next
        }
        proto.put(mut body, row, 2)
        proto.put(mut body, col, 2)
        proto.put(mut body, lead.flags, 2)
        proto.put(mut body, wire_colour(lead.foreground), 4)
        proto.put(mut body, wire_colour(lead.background), 4)
        proto.put(mut body, covered, 2)
        proto.put(mut body, record_count, 2)
        for x in records { (mut body).push(x) }
        runs += 1
        col = c
    }
    runs
}

fn store_line(mut sh: Shadow, line: List[vt.Cell], cols: int, row: int, a: int, b: int) {
    var c = a
    while c <= b {
        sh.cells[(row - 1) * cols + c - 1] = line[c]
        c += 1
    }
}

// Within a pane's rect on frame row `row`, keep scanning only the columns
// its emulator changed after tick `seen`.
fn limit_row(mut scan: List[bool], pane: Pane, seen: int, row: int, cols: int) {
    if !pane.live || !pane.shown { return }
    let pr = row - pane.at_row + 1
    if pr < 1 || pr > pane.screen.rows { return }
    let (first, last) = vt.changed_span(pane.screen, pr, seen)
    let pcols = pane.screen.cols
    if first == 0 && last >= pcols - 1 { return }
    var c = pane.at_col
    while c < pane.at_col + pcols && c <= cols {
        let pc = c - pane.at_col
        if c >= 1 && (pc < first || pc > last) { scan[c] = false }
        c += 1
    }
}

/// Compose a client's next image of the session's frame into a FRAME
/// payload, updating its shadow. A full image (base 0) when `full` is set
/// or the shadow is not of this size; otherwise a delta on seq - 1 over
/// the scanned regions: every cell when `all`, else the rects in `scans`
/// (col, row, cols, rows, four ints each), and within a pane's rect only
/// the rows and columns its emulator changed since this shadow's last
/// image (the shadow keeps each pane slot's gen and tick). Each frame cell
/// is computed once. Empty when nothing changed. The cursor is the
/// caller's (`cursor`: row, col, shape, visible). Pane slot `view_slot`
/// (-1: none) shows the client's window `view` instead of its screen.
pub fn compose_frame(mut sh: Shadow, panes: List[Pane], ses: Session, bar: List[vt.Cell], view: vt.View,
    view_slot: int, seq: int, full: bool, all: bool, scans: List[int], cursor: List[int]) -> List[byte] {
    let cols = ses.cols
    let rows = ses.rows
    let whole = full || !sh.valid || sh.cols != cols || sh.rows != rows
    if whole { reshape(mut sh, cols, rows) }
    sh.reads = 0
    // A pane's damage limits its scan when this shadow's last image was
    // composed from the same pane (its gen), unless every cell is asked for.
    while sh.seen_gen.len < panes.len {
        (mut sh.seen_gen).push(0 - 1)
        (mut sh.seen_tick).push(0)
    }
    var limit = List[bool]()
    var p = 0
    while p < panes.len {
        (mut limit).push(!whole && !all && sh.seen_gen[p] == panes[p].gen)
        p += 1
    }
    var body = List[byte]()
    var runs = 0
    var changed = List[bool]()
    var scan = List[bool]()
    var have = List[bool]()
    var line = List[vt.Cell]()
    var k = 0
    while k <= cols + 1 {
        (mut changed).push(false)
        (mut scan).push(false)
        (mut have).push(false)
        (mut line).push(blank_cell())
        k += 1
    }
    var row = 1
    while row <= rows {
        var c = 1
        while c <= cols {
            have[c] = false
            c += 1
        }
        if whole {
            c = 1
            while c <= cols {
                row_cell(mut line, mut have, mut sh, panes, ses, bar, view, view_slot, row, c)
                c += 1
            }
            runs += emit_line(mut body, line, cols, row, 1, cols)
            store_line(mut sh, line, cols, row, 1, cols)
        } else {
            var any_scan = all
            c = 1
            while c <= cols {
                scan[c] = all
                c += 1
            }
            if !all {
                var q = 0
                while q + 3 < scans.len {
                    let rr = scans[q + 1]
                    if row >= rr && row < rr + scans[q + 3] {
                        var c2 = scans[q]
                        while c2 < scans[q] + scans[q + 2] && c2 <= cols {
                            if c2 >= 1 { scan[c2] = true }
                            c2 += 1
                        }
                        any_scan = true
                    }
                    q += 4
                }
            }
            if any_scan {
                p = 0
                while p < panes.len {
                    if limit[p] { limit_row(mut scan, panes[p], sh.seen_tick[p], row, cols) }
                    p += 1
                }
                var any = false
                c = 1
                while c <= cols {
                    changed[c] = false
                    if scan[c] {
                        row_cell(mut line, mut have, mut sh, panes, ses, bar, view, view_slot, row, c)
                        changed[c] = !same(line[c], sh.cells[(row - 1) * cols + c - 1])
                        if changed[c] { any = true }
                    }
                    c += 1
                }
                if any {
                    // Both halves of every wide pair a change touches, old or new.
                    var moved = true
                    while moved {
                        moved = false
                        c = 1
                        while c <= cols {
                            if changed[c] {
                                let i = (row - 1) * cols + c - 1
                                row_cell(mut line, mut have, mut sh, panes, ses, bar, view, view_slot, row, c)
                                let live = copy line[c]
                                let old = copy sh.cells[i]
                                if (live.width == 0 || old.width == 0) && c > 1 && !changed[c - 1] {
                                    changed[c - 1] = true
                                    moved = true
                                }
                                if (live.width == 2 || old.width == 2) && c < cols && !changed[c + 1] {
                                    changed[c + 1] = true
                                    moved = true
                                }
                            }
                            c += 1
                        }
                    }
                    c = 1
                    while c <= cols {
                        if changed[c] {
                            var e = c
                            while e + 1 <= cols && changed[e + 1] { e += 1 }
                            var f = c
                            while f <= e {
                                row_cell(mut line, mut have, mut sh, panes, ses, bar, view, view_slot, row, f)
                                f += 1
                            }
                            runs += emit_line(mut body, line, cols, row, c, e)
                            store_line(mut sh, line, cols, row, c, e)
                            c = e + 1
                        } else {
                            c += 1
                        }
                    }
                }
            }
        }
        row += 1
    }
    // Every pane slot as of this image: its gen and its emulator's tick.
    p = 0
    while p < panes.len {
        sh.seen_gen[p] = panes[p].gen
        sh.seen_tick[p] = vt.damage_tick(panes[p].screen)
        p += 1
    }
    let cr = clamp(cursor[0], 1, rows)
    let cc = clamp(cursor[1], 1, cols)
    let shape = clamp(cursor[2], 0, 6)
    let visible = if cursor[3] == 1 then 1 else 0
    let cursor_same = sh.valid && sh.cursor_row == cr && sh.cursor_col == cc && sh.shape == shape && sh.visible == visible
    sh.cursor_row = cr
    sh.cursor_col = cc
    sh.shape = shape
    sh.visible = visible
    sh.valid = true
    if !whole && runs == 0 && cursor_same { return List[byte]() }
    var payload = List[byte]()
    (mut payload).reserve(22 + body.len)
    proto.put(mut payload, seq, 4)
    proto.put(mut payload, if whole then 0 else seq - 1, 4)
    proto.put(mut payload, cols, 2)
    proto.put(mut payload, rows, 2)
    proto.put(mut payload, cr, 2)
    proto.put(mut payload, cc, 2)
    proto.put(mut payload, shape, 1)
    proto.put(mut payload, visible, 1)
    proto.put(mut payload, runs, 4)
    for x in body { (mut payload).push(x) }
    payload
}

// ---- the chrome: borders, the focus mark, the bar ----

const V_LINE: int = 9474
const H_LINE: int = 9472
const T_RIGHT: int = 9500
const T_LEFT: int = 9508
const T_DOWN: int = 9516
const T_UP: int = 9524
const CROSS: int = 9532
/// The focused pane's border cells are drawn in this palette colour.
pub const FOCUS_COLOUR: int = 2
/// Rendition flag: inverse.
pub const INVERSE: int = 64
/// Rendition flag: bold (the mode field).
pub const BOLD: int = 1

fn is_border(owner: List[int], cols: int, area: int, c: int, r: int) -> bool {
    if c < 1 || r < 1 || c > cols || r > area { return false }
    owner[(r - 1) * cols + c - 1] < 0
}

/// A border cell's glyph from its neighbours: a junction where a border
/// meets a perpendicular one, else the line of its own axis.
fn glyph_at(owner: List[int], cols: int, area: int, c: int, r: int, axis: int) -> int {
    let up = is_border(owner, cols, area, c, r - 1)
    let down = is_border(owner, cols, area, c, r + 1)
    let left = is_border(owner, cols, area, c - 1, r)
    let right = is_border(owner, cols, area, c + 1, r)
    let vertical = up || down
    let horizontal = left || right
    if vertical && horizontal {
        if up && down && left && right { return CROSS }
        if up && down { return if right then T_RIGHT else T_LEFT }
        if left && right { return if down then T_DOWN else T_UP }
        return if right then T_RIGHT else T_LEFT
    }
    if axis == 0 { return V_LINE }
    H_LINE
}

/// Decode a name's bytes into cells from `col` on, with a rendition; wide
/// glyphs take two cells, marks are dropped, controls drawn as `?`.
/// Returns the column after the text.
fn put_text(mut line: List[vt.Cell], col: int, cols: int, text: str, flags: int) -> int {
    var c = col
    for cp in text.code_points() {
        var base = cp
        if base < 32 || (base >= 127 && base < 160) { base = 63 }
        let w = vt.scalar_width(base)
        if w == 0 { continue }
        if c + w - 1 > cols { return c }
        if w == 2 {
            line[c - 1] = vt.Cell { base: base, mark1: 0, mark2: 0, width: 2, flags: flags, foreground: 0 - 1,
                background: 0 - 1, written: true }
            line[c] = vt.Cell { base: 32, mark1: 0, mark2: 0, width: 0, flags: flags, foreground: 0 - 1,
                background: 0 - 1, written: true }
            c += 2
        } else {
            line[c - 1] = chrome_cell(base, flags, 0 - 1)
            c += 1
        }
    }
    c
}

/// The width of a label as `put_text` draws it.
fn text_width(text: str) -> int {
    var n = 0
    for cp in text.code_points() {
        var base = cp
        if base < 32 || (base >= 127 && base < 160) { base = 63 }
        n += vt.scalar_width(base)
    }
    n
}
