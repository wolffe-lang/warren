//! member: true
//! The event loop: one wait a turn over the listener, every connection,
//! every pane's master, the listened signals and the nearest deadline.
//! A turn's scratch lives in a region that ends with the turn; long-lived
//! state is changed in place. No helper process and no thread. Slots the
//! turn cannot make in place (a session, a pane and its emulator) are made
//! between turns, and the action that asked for one is taken again on the
//! next turn, which follows at once.
use std.env
use std.fs
use std.net
use std.net.unix
use std.poll
use std.process
use std.signal
use std.time
use cmd
use config
use layout
use proto
use vt

const KEY_NONE: int = 0
const KEY_LISTENER: int = 1
const KEY_CONN: int = 2
const KEY_MASTER: int = 3

/// The whole server.
pub struct Server {
    place: Start,
    w: poll.Waiter,
    listen_key: int,
    listening: bool,
    conns: List[Conn],
    sessions: List[Session],
    panes: List[Pane],
    orphans: List[int],
    key_kind: List[int],
    key_owner: List[int],
    key_gen: List[int],
    next_id: int,
    next_pane: int,
    // The next session's and the next tab's ids: like pane ids, from one
    // counter each that never goes back.
    next_session: int,
    next_tab: int,
    // What the last action would have told a client, when it was run for
    // a command and there was no client to tell (bytes the server keeps:
    // a turn's region may not leave a str in it).
    told: List[byte],
    // The one server-wide reply buffer: a REPLY past its connection's share
    // (the event cap) is sent from here, one at a time. Its storage grows in
    // place to the largest reply sent (8 MiB and fragment headers at most)
    // and is kept. `reply_len` bytes are the current reply's, `reply_off` of
    // them already moved into `reply_conn`'s queue (generation
    // `reply_gen`); -1 when no connection holds it. A connection whose
    // reply needs the buffer while another holds it waits in
    // `reply_waiters` (with their generations), first come first served.
    reply: List[byte],
    reply_len: int,
    reply_off: int,
    reply_conn: int,
    reply_gen: int,
    reply_waiters: List[int],
    reply_waiter_gens: List[int],
    // How long a reply waits for the buffer (REPLY_WAIT_MS, or lower).
    reply_wait_ms: int,
    // While a command's action runs, the end of the last session owes the
    // stop instead of starting it, so the command's REPLY is queued first.
    hold_stop: bool,
    stop_owed: bool,
    stopping: bool,
    stop_deadline: int,
    started: int,
    idle_since: int,
    lifetime: int,
    pid: int,
    version: str,
    again: bool,
    need_slot: bool,
    need_pane: bool,
    need_view: bool,
    settings: config.Settings,
    want_cols: int,
    want_rows: int,
    rotate: int,
    trace: bool,
    turns: int,
    frames: int,
    prompt_frames: int,
    master_read: int,
    budget: int,
    uid: int,
    inherited: List[int],
    keys: config.Keys,
    help: List[str],
    clock_hour: int,
    clock_minute: int,
    clock_next: int,
    // The name this machine answers to in a pane's OSC 7 report, learnt
    // once at start (host.lu); "" when nothing named it.
    host_name: str,
}

fn now_ns() -> int {
    time.monotonic_ns()
}

fn trace(s: Server, text: str) {
    if s.trace { eprint("warren-server: {text}") }
}

fn record_key(mut s: Server, key: int, kind: int, owner: int, gen: int) {
    while s.key_kind.len <= key {
        (mut s.key_kind).push(KEY_NONE)
        (mut s.key_owner).push(0 - 1)
        (mut s.key_gen).push(0)
    }
    s.key_kind[key] = kind
    s.key_owner[key] = owner
    s.key_gen[key] = gen
}

fn forget_key(mut s: Server, key: int) {
    if key >= 0 && key < s.key_kind.len {
        poll.remove(mut s.w, key) else |_| {}
        s.key_kind[key] = KEY_NONE
        s.key_owner[key] = 0 - 1
    }
}

fn socket_of(c: Conn) -> net.Socket {
    net.Socket { fd: c.fd }
}

// ---- connections ----

fn interest(c: Conn) -> int {
    var i = 0
    if c.read_on { i = i | poll.READ }
    if queued(c) > 0 { i = i | poll.WRITE }
    if i == 0 { i = poll.READ }
    i
}

fn sync_interest(mut s: Server, index: int) {
    if !s.conns[index].live || s.conns[index].key < 0 { return }
    let want_write = queued(s.conns[index]) > 0
    if want_write != s.conns[index].write_on {
        let key = s.conns[index].key
        let i = interest(s.conns[index])
        poll.modify(mut s.w, key, i) else |_| {}
        s.conns[index].write_on = want_write
    }
}

/// Close a connection: membership leaves exactly once, the readiness
/// entry goes before the socket, the slot is kept for reuse. `why` is the
/// cause the trace names, for every close (a close that sends the peer
/// nothing included).
fn close_conn(mut s: Server, index: int, why: str) {
    if !s.conns[index].live { return }
    leave(mut s, index)
    let key = s.conns[index].key
    forget_key(mut s, key)
    var sock = net.Socket { fd: s.conns[index].fd }
    net.close(take sock) else |_| {}
    s.conns[index].live = false
    s.conns[index].phase = CLOSED
    s.conns[index].key = 0 - 1
    s.conns[index].fd = 0 - 1
    s.conns[index].pending = 0
    empty_conn(mut s.conns[index])
    trace(s, "conn {index} wrote {s.conns[index].written} bytes in {s.conns[index].writes} writes over {s.turns - s.conns[index].first_turn} turns")
    trace(s, "conn {index} closed: {why}")
    if s.reply_conn == index { release_reply(mut s) }
}

// The reply buffer is free: its bytes stay (the storage is kept), and the
// first connection still waiting for it asks again on the next turn.
fn release_reply(mut s: Server) {
    s.reply_conn = 0 - 1
    s.reply_len = 0
    s.reply_off = 0
    while s.reply_waiters.len > 0 {
        let w = s.reply_waiters[0]
        let g = s.reply_waiter_gens[0]
        drop_waiter(mut s, 0)
        if w >= 0 && w < s.conns.len && s.conns[w].live && s.conns[w].gen == g && s.conns[w].command_len > 0 {
            // Its turn: the buffer is kept for it (no reply in it yet), so a
            // COMMAND that comes meanwhile waits behind it.
            s.reply_conn = w
            s.reply_gen = g
            s.conns[w].command_ready = true
            s.again = true
            return
        }
    }
}

// Whether connection `index` waits for the reply buffer.
fn waits_for_reply(s: Server, index: int) -> bool {
    var k = 0
    while k < s.reply_waiters.len {
        if s.reply_waiters[k] == index && s.reply_waiter_gens[k] == s.conns[index].gen { return true }
        k += 1
    }
    false
}

// A reply waited for the buffer as long as it may: it leaves the queue and
// its COMMAND is refused by name (status 1).
fn refuse_waiter(mut s: Server, index: int) {
    var k = 0
    while k < s.reply_waiters.len {
        if s.reply_waiters[k] == index && s.reply_waiter_gens[k] == s.conns[index].gen { drop_waiter(mut s, k) } else { k += 1 }
    }
    let body = s.conns[index].command[0..s.conns[index].command_len]
    let id = u(body, 0, 4)
    let argv = argv_of(body)
    let verb = if argv.len > 0 then argv[0] else ""
    s.conns[index].command_len = 0
    let ok = send(mut s.conns[index], 136, reply_payload(id, cmd.EXIT_REFUSED, "",
        "warren: {verb}: waited {s.reply_wait_ms} ms for the server's reply buffer, which another reply held\n"))
    trace(s, "conn {index} gave up waiting for the reply buffer")
    s.conns[index].sent_kind = 136
    s.conns[index].sent_code = cmd.EXIT_REFUSED
    s.conns[index].phase = DRAINING
    s.conns[index].deadline = now_ns() + DRAIN_MS * 1000000
    if !ok { close_conn(mut s, index, "the REPLY to {verb} could not be queued") }
}

// Remove waiter `k` of the reply buffer, keeping the others' order.
fn drop_waiter(mut s: Server, k: int) {
    var j = k
    while j + 1 < s.reply_waiters.len {
        s.reply_waiters[j] = s.reply_waiters[j + 1]
        s.reply_waiter_gens[j] = s.reply_waiter_gens[j + 1]
        j += 1
    }
    let _w = (mut s.reply_waiters).pop() else { return }
    let _g = (mut s.reply_waiter_gens).pop() else { return }
}

// The next part of the reply buffer into its holder's queue, once that
// queue has been written out: at most one write's worth at a time, so the
// connection's own queue never holds more than that of it.
fn refill_reply(mut s: Server, index: int) {
    if s.reply_conn != index || s.conns[index].gen != s.reply_gen || s.reply_off >= s.reply_len { return }
    if queued(s.conns[index]) > 0 { return }
    let end = if s.reply_len - s.reply_off > WRITE_BUDGET then s.reply_off + WRITE_BUDGET else s.reply_len
    append_reply_part(mut s.conns[index], s.reply[s.reply_off..end])
    s.reply_off = end
}

// A phase's name in the trace.
fn phase_name(phase: int) -> str {
    if phase == ACCEPTED { return "waiting for its HELLO" }
    if phase == ATTACHED { return "attached" }
    if phase == COMMANDING { return "waiting for its COMMAND" }
    if phase == DRAINING { return "draining" }
    "closed"
}

// A terminal message's name in the trace: REFUSE, BYE or REPLY and its code.
fn sent_name(kind: int, code: int) -> str {
    if kind == 130 { return "REFUSE {code}" }
    if kind == 135 { return "BYE {code}" }
    if kind == 136 { return "REPLY" }
    "message {kind}"
}

fn leave(mut s: Server, index: int) {
    if !s.conns[index].member { return }
    let si = s.conns[index].session
    s.conns[index].member = false
    if si >= 0 && si < s.sessions.len && s.sessions[si].live {
        s.sessions[si].members = s.sessions[si].members - 1
        recompute_size(mut s, si)
    }
}

/// Queue a terminal message (REFUSE or BYE) and drain; if it cannot be
/// queued whole, close at once.
fn terminal(mut s: Server, index: int, kind: int, code: int, text: str) {
    leave(mut s, index)
    s.conns[index].pending = 0
    let ok = send(mut s.conns[index], kind, coded(code, text))
    if !ok {
        close_conn(mut s, index, "{sent_name(kind, code)} ({text}) could not be queued")
        return
    }
    s.conns[index].sent_kind = kind
    s.conns[index].sent_code = code
    s.conns[index].phase = DRAINING
    s.conns[index].deadline = now_ns() + DRAIN_MS * 1000000
    flush(mut s, index)
}

fn protocol_error(mut s: Server, index: int, why: str) {
    trace(s, "conn {index} protocol error: {why}")
    if s.conns[index].phase == ACCEPTED {
        close_conn(mut s, index, "a protocol error before its HELLO ({why})")
        return
    }
    terminal(mut s, index, 135, 6, why)
}

/// One write of at most WRITE_BUDGET bytes; busy keeps the suffix; a
/// gone peer closes. Then WRITE interest follows the queue.
fn flush(mut s: Server, index: int) {
    if !s.conns[index].live || queued(s.conns[index]) == 0 {
        if s.conns[index].live { after_write(mut s, index) }
        return
    }
    var sock = socket_of(s.conns[index])
    let chunk = next_write(s.conns[index])
    var gone = ""
    let n = net.write_some(mut sock, chunk) else |e| {
        if "{e}" != "busy" { gone = "{e}" }
        0
    }
    // Counted for the trace: every write call, and the bytes they took.
    s.conns[index].writes = s.conns[index].writes + 1
    s.conns[index].written = s.conns[index].written + n
    if gone.len > 0 {
        close_conn(mut s, index, "write failed: {gone}")
        return
    }
    wrote(mut s.conns[index], n)
    // A draining connection's two seconds count from its last write that
    // made progress: a peer that reads is never cut, one that stops is.
    if n > 0 && s.conns[index].phase == DRAINING { s.conns[index].deadline = now_ns() + DRAIN_MS * 1000000 }
    after_write(mut s, index)
}

fn after_write(mut s: Server, index: int) {
    if s.conns[index].image_end >= 0 && s.conns[index].tx_off >= s.conns[index].image_end {
        let seq = s.conns[index].image_seq
        let _sent = proto.sent(mut s.conns[index].ack, seq)
        s.conns[index].image_end = 0 - 1
    }
    refill_reply(mut s, index)
    if s.conns[index].phase == DRAINING && queued(s.conns[index]) == 0 {
        close_conn(mut s, index, "{sent_name(s.conns[index].sent_kind, s.conns[index].sent_code)} sent")
        return
    }
    if title_owed(s.conns[index]) { owed_title(mut s, index) }
    sync_interest(mut s, index)
}

// The waiting TITLE was written while a newer title came: queue the
// session's focused pane's title as it is now (it may have changed again).
fn owed_title(mut s: Server, index: int) {
    s.conns[index].title_dirty = false
    if !s.conns[index].member || s.conns[index].ending { return }
    let si = s.conns[index].session
    if si < 0 || !s.sessions[si].live { return }
    let k = focused_slot(s, si)
    if k < 0 { return }
    let title = s.panes[k].screen.title_storage[0..s.panes[k].screen.title_length]
    if !send_title(mut s.conns[index], title) { terminal(mut s, index, 135, 5, "too slow") }
}

// ---- sessions ----

fn find_session(s: Server, name: str) -> int {
    var i = 0
    while i < s.sessions.len {
        if named(s.sessions[i], name) { return i }
        i += 1
    }
    0 - 1
}

fn live_sessions(s: Server) -> int {
    var n = 0
    for x in s.sessions {
        if x.live { n += 1 }
    }
    n
}

fn live_conns(s: Server) -> int {
    var n = 0
    for c in s.conns {
        if c.live { n += 1 }
    }
    n
}

fn pending_conns(s: Server) -> int {
    var n = 0
    for c in s.conns {
        if c.live && c.phase == ACCEPTED { n += 1 }
    }
    n
}

/// The projected memory of what is held now, plus an addition: every
/// pane slot (a free one keeps its emulator), every connection slot (a live
/// one at its share or what it retains, the larger; a closed one at what it
/// retains) and the reply buffer's storage.
fn projected(s: Server, extra: int) -> int {
    var total = extra
    for p in s.panes {
        total += pane_bytes(p.screen.cols, p.screen.rows)
    }
    for c in s.conns {
        let kept = retained_bytes(c)
        if c.live {
            let share = if c.member && c.session >= 0 then attached_bytes(s.sessions[c.session].cols, s.sessions[c.session].rows) else connection_bytes()
            total += if kept > share then kept else share
        } else {
            total += kept
        }
    }
    total + s.reply.len
}

/// Whether a pane of this size fits the budget beside `extra`: a free slot
/// (which would be reused) is already counted.
fn pane_fits(s: Server, cols: int, rows: int, extra: int) -> bool {
    for p in s.panes {
        if !p.live { return projected(s, extra) <= s.budget }
    }
    projected(s, pane_bytes(cols, rows) + extra) <= s.budget
}

/// The session's size: the smallest columns and, independently, rows of
/// its attached members; unchanged when nobody is attached. A change
/// resizes every shown pane of every tab to its rect.
fn recompute_size(mut s: Server, si: int) {
    var cols = 0
    var rows = 0
    for c in s.conns {
        if c.live && c.member && c.session == si {
            if cols == 0 || c.cols < cols { cols = c.cols }
            if rows == 0 || c.rows < rows { rows = c.rows }
        }
    }
    if cols == 0 || rows == 0 { return }
    if cols == s.sessions[si].cols && rows == s.sessions[si].rows { return }
    s.sessions[si].cols = cols
    s.sessions[si].rows = rows
    layout_changed(mut s, si)
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].member && s.conns[i].session == si {
            s.conns[i].force_full = true
            mark_stale(mut s.conns[i], now_ns())
        }
        i += 1
    }
    trace(s, "session {si} size {cols}x{rows}")
}

fn mark_stale(mut c: Conn, now: int) {
    if !c.stale {
        c.stale = true
        c.stale_since = now
    }
}

/// The session's frame changed: every member has damage to compose.
fn session_changed(mut s: Server, si: int, now: int) {
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].member && s.conns[i].session == si {
            mark_stale(mut s.conns[i], now)
        }
        i += 1
    }
}

/// A session ends: members are told (after the last image where they
/// can take it), every pane's master is closed and its child left in
/// process.poll's care; the panes stay as they are until no client is
/// owed the last image, and the slots are then free for reuse.
fn end_session(mut s: Server, si: int) {
    trace(s, "session {si} ended")
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].member && s.conns[i].session == si && !s.conns[i].ending {
            if s.conns[i].image_end < 0 && s.conns[i].ack.pending == 0 {
                // The pane's last output reaches a client that can take an
                // image now, then its BYE.
                compose_now(mut s, i, now_ns())
                if s.conns[i].live { terminal(mut s, i, 135, 2, "session ended") }
            } else {
                // One still owing its ACK gets the last image after it (or
                // its BYE alone at the closing deadline).
                s.conns[i].ending = true
                s.conns[i].ending_gen = s.sessions[si].generation
                s.conns[i].deadline = now_ns() + CLOSING_MS * 1000000
            }
        }
        i += 1
    }
    var k = 0
    while k < s.panes.len {
        if s.panes[k].live && s.panes[k].session == si && s.panes[k].session_gen == s.sessions[si].generation {
            let key = s.panes[k].key
            forget_key(mut s, key)
            s.panes[k].key = 0 - 1
            close_master(mut s.panes[k])
            orphan_child(mut s, k)
        }
        k += 1
    }
    s.sessions[si].live = false
    s.sessions[si].members = 0
    if live_sessions(s) == 0 {
        // A command that ended the last session has its REPLY queued before
        // the stop, as kill-server's is.
        if s.hold_stop { s.stop_owed = true } else { begin_stop(mut s, "the last session ended") }
    }
}

// ---- panes ----

/// The slot of the live pane with this id, or -1.
fn slot_of(s: Server, id: int) -> int {
    var k = 0
    while k < s.panes.len {
        if s.panes[k].live && s.panes[k].id == id { return k }
        k += 1
    }
    0 - 1
}

/// The focused pane's id in the session's active tab, or -1.
fn focus_id(s: Server, si: int) -> int {
    var t = 0
    while t < s.sessions[si].layout.tabs.len {
        if s.sessions[si].layout.tabs[t].id == s.sessions[si].layout.active { return s.sessions[si].layout.tabs[t].focus }
        t += 1
    }
    0 - 1
}

fn focused_slot(s: Server, si: int) -> int {
    let id = focus_id(s, si)
    if id < 0 { return 0 - 1 }
    slot_of(s, id)
}

/// How many panes the session's tabs hold.
fn pane_count(s: Server, si: int) -> int {
    var n = 0
    for t in s.sessions[si].layout.tabs {
        n += t.focus_order.len
    }
    n
}

/// A child whose pane goes: it stays tracked until it is reaped.
fn orphan_child(mut s: Server, k: int) {
    if !s.panes[k].child_live { return }
    let child = s.panes[k].child
    s.panes[k].child_live = false
    s.panes[k].child = 0 - 1
    var i = 0
    while i < s.orphans.len {
        if s.orphans[i] < 0 {
            s.orphans[i] = child
            return
        }
        i += 1
    }
    (mut s.orphans).push(child)
}

/// A free pane slot whose emulator is reset to a size, or -1 after asking
/// for one to be made between turns.
fn acquire_pane(mut s: Server, cols: int, rows: int) -> int {
    var k = 0
    while k < s.panes.len {
        if !s.panes[k].live {
            fresh_screen(mut s.panes[k], cols, rows)
            return k
        }
        k += 1
    }
    s.need_pane = true
    s.want_cols = cols
    s.want_rows = rows
    0 - 1
}

/// Start a pane's program in slot k for the session, at a size: the
/// session's working directory and environment, the pane's id. "" or why
/// it did not start (the slot is then free again).
fn spawn_pane(mut s: Server, si: int, k: int, id: int, cols: int, rows: int) -> str {
    spawn_pane_in(mut s, si, k, id, cols, rows, "", List[str]())
}

/// As spawn_pane, the program started in `dir` (the session's start
/// directory when empty) and running `argv` (the configured shell when
/// empty).
fn spawn_pane_in(mut s: Server, si: int, k: int, id: int, cols: int, rows: int, dir: str, argv: List[str]) -> str {
    s.panes[k].live = true
    s.panes[k].id = id
    s.panes[k].session = si
    s.panes[k].session_gen = s.sessions[si].generation
    s.panes[k].gen = s.panes[k].gen + 1
    s.panes[k].damage = s.panes[k].damage + 1
    s.panes[k].shown = false
    s.panes[k].sync_since = 0
    let _named = vt.set_local_host(mut s.panes[k].screen, s.host_name)
    let sp = Spawn { cols: cols, rows: rows, cwd: if dir.len > 0 then dir else cwd_of(s.sessions[si]),
        names: copy s.sessions[si].env_names, values: copy s.sessions[si].env_values, pane_id: id }
    let program = if argv.len > 0 then argv else shell_argv()
    let why = start_pane(mut s.panes[k], name_of(s.sessions[si]), sp, program, s.inherited)
    if why.len > 0 {
        trace(s, "spawn failed: {why}")
        orphan_child(mut s, k)
        s.panes[k].live = false
        return why
    }
    let key = poll.add_file(mut s.w, master_file(s.panes[k]), poll.READ) else |e| {
        close_master(mut s.panes[k])
        orphan_child(mut s, k)
        s.panes[k].live = false
        return "readiness set: {e}"
    }
    record_key(mut s, key, KEY_MASTER, k, s.panes[k].gen)
    s.panes[k].key = key
    s.panes[k].last_output = now_ns()
    ""
}

/// A pane leaves its session's layout: its master is closed (its program
/// hears the hangup), its child stays tracked until reaped, its slot is
/// free at once.
fn drop_pane(mut s: Server, k: int) {
    let key = s.panes[k].key
    forget_key(mut s, key)
    s.panes[k].key = 0 - 1
    close_master(mut s.panes[k])
    orphan_child(mut s, k)
    s.panes[k].live = false
    s.panes[k].shown = false
    s.panes[k].in_off = 0
    s.panes[k].in_len = 0
    s.panes[k].damage = s.panes[k].damage + 1
}

/// Close a pane: it leaves the layout and its slot; the last pane of the
/// last tab ends the session instead.
fn close_pane(mut s: Server, si: int, k: int) {
    let id = s.panes[k].id
    var empty = false
    layout.close(mut s.sessions[si].layout, id) else |e| {
        empty = "{e}" == "session_empty"
    }
    if empty {
        end_session(mut s, si)
        return
    }
    drop_pane(mut s, k)
    layout_changed(mut s, si)
    title_to_members(mut s, si)
}

/// After any change of the layout or the session's size: every pane at
/// its rect's size, the frame's owner map to rebuild, every member to
/// rescan its frame.
fn layout_changed(mut s: Server, si: int) {
    let shown = s.sessions[si].layout.active
    clear_marks(mut s, si, shown)
    sync_sizes(mut s, si)
    s.sessions[si].layout_gen = s.sessions[si].layout_gen + 1
    session_changed(mut s, si, now_ns())
}

/// Every pane of the session whose rect (in any tab) is not empty gets
/// that rect's size: the emulator first, then the terminal (its program
/// hears the window change and redraws into the resized emulator). A
/// hidden pane keeps its size. `shown` marks the active tab's visible
/// panes.
fn sync_sizes(mut s: Server, si: int) {
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    var k = 0
    while k < s.panes.len {
        if s.panes[k].live && s.panes[k].session == si && s.panes[k].session_gen == s.sessions[si].generation {
            s.panes[k].shown = false
        }
        k += 1
    }
    if cols < 1 || area < 1 { return }
    let active = s.sessions[si].layout.active
    var t = 0
    while t < s.sessions[si].layout.tabs.len {
        let tab = s.sessions[si].layout.tabs[t].id
        let rs = layout.rects(s.sessions[si].layout, tab, cols, area)
        for r in rs {
            if r.cols > 0 && r.rows > 0 {
                let p = slot_of(s, r.pane)
                if p >= 0 {
                    s.panes[p].at_col = r.col
                    s.panes[p].at_row = r.row
                    if tab == active { s.panes[p].shown = true }
                    if s.panes[p].screen.cols != r.cols || s.panes[p].screen.rows != r.rows {
                        let _r = vt.resize(mut s.panes[p].screen, r.cols, r.rows)
                        if s.panes[p].master >= 0 { term_size(master_file(s.panes[p]), r.cols, r.rows) }
                        s.panes[p].damage = s.panes[p].damage + 1
                    }
                }
            }
        }
        t += 1
    }
}

/// The owner map (which pane slot draws each tab-area cell, -1 for a
/// border) and the border cells, rebuilt in place when the layout or the
/// size moved. Border cells beside the focused pane (within one cell of
/// its rect) are drawn in the focus colour; with exactly two panes shown
/// they share one border, and the half beside the focused pane is marked.
fn ensure_chrome(mut s: Server, si: int) {
    if s.sessions[si].chrome_gen == s.sessions[si].layout_gen { return }
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    let n = if cols > 0 && area > 0 then cols * area else 0
    while s.sessions[si].owner.len < n { (mut s.sessions[si].owner).push(0 - 1) }
    while s.sessions[si].border.len < n { (mut s.sessions[si].border).push(blank_cell()) }
    var i = 0
    while i < n {
        s.sessions[si].owner[i] = 0 - 1
        s.sessions[si].border[i] = blank_cell()
        i += 1
    }
    s.sessions[si].chrome_gen = s.sessions[si].layout_gen
    if n == 0 { return }
    let tab = s.sessions[si].layout.active
    let rs = layout.rects(s.sessions[si].layout, tab, cols, area)
    let focus = focus_id(s, si)
    var fc = 0
    var fr = 0
    var fw = 0
    var fh = 0
    var shown = 0
    var first = 0 - 1
    for r in rs {
        if r.cols > 0 && r.rows > 0 {
            shown += 1
            if first < 0 { first = r.pane }
            if r.pane == focus {
                fc = r.col
                fr = r.row
                fw = r.cols
                fh = r.rows
            }
            let k = slot_of(s, r.pane)
            var row = r.row
            while row < r.row + r.rows {
                var c = r.col
                while c < r.col + r.cols {
                    s.sessions[si].owner[(row - 1) * cols + c - 1] = k
                    c += 1
                }
                row += 1
            }
        }
    }
    let bs = layout.borders(s.sessions[si].layout, tab, cols, area)
    let halves = shown == 2 && bs.len == 1
    for b in bs {
        var j = 0
        while j < b.length {
            let c = if b.axis == layout.COLS then b.col else b.col + j
            let row = if b.axis == layout.COLS then b.row + j else b.row
            let glyph = glyph_at(s.sessions[si].owner, cols, area, c, row, b.axis)
            var lit = fw > 0 && c >= fc - 1 && c <= fc + fw && row >= fr - 1 && row <= fr + fh
            if halves {
                let half = (b.length + 1) / 2
                lit = if focus == first then j < half else j >= half
            }
            s.sessions[si].border[(row - 1) * cols + c - 1] = chrome_cell(glyph, 0, if lit then FOCUS_COLOUR else 0 - 1)
            j += 1
        }
    }
}

// ---- line one: marks and the clock ----

fn tab_exists(s: Server, si: int, tab: int) -> bool {
    for t in s.sessions[si].layout.tabs {
        if t.id == tab { return true }
    }
    false
}

/// Mark a tab (MARK_ACTIVITY, MARK_BELL); its members draw line one again
/// when the marks change. Entries are reused once clear or their tab gone.
fn mark_tab(mut s: Server, si: int, tab: int, bits: int) {
    var free = 0 - 1
    var i = 0
    while i < s.sessions[si].mark_tab.len {
        if s.sessions[si].mark_tab[i] == tab {
            let was = s.sessions[si].mark_bits[i]
            if was | bits == was { return }
            s.sessions[si].mark_bits[i] = was | bits
            s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
            session_changed(mut s, si, now_ns())
            return
        }
        if free < 0 && (s.sessions[si].mark_bits[i] == 0 || !tab_exists(s, si, s.sessions[si].mark_tab[i])) { free = i }
        i += 1
    }
    if free >= 0 {
        s.sessions[si].mark_tab[free] = tab
        s.sessions[si].mark_bits[free] = bits
    } else {
        (mut s.sessions[si].mark_tab).push(tab)
        (mut s.sessions[si].mark_bits).push(bits)
    }
    s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
    session_changed(mut s, si, now_ns())
}

/// A tab is shown: its marks clear.
fn clear_marks(mut s: Server, si: int, tab: int) {
    var i = 0
    while i < s.sessions[si].mark_tab.len {
        if s.sessions[si].mark_tab[i] == tab && s.sessions[si].mark_bits[i] != 0 {
            s.sessions[si].mark_bits[i] = 0
            s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
        }
        i += 1
    }
}

fn marks_of(s: Server, si: int, tab: int) -> int {
    var i = 0
    while i < s.sessions[si].mark_tab.len {
        if s.sessions[si].mark_tab[i] == tab { return s.sessions[si].mark_bits[i] }
        i += 1
    }
    0
}

/// The local time's hour and minute (TZ or /etc/localtime; UTC where the
/// zone cannot be read), and the next minute's boundary to read it again.
fn read_clock(mut s: Server) {
    let ms = time.unix_ms()
    let sec = ms / 1000
    s.clock_next = (ms / 60000 + 1) * 60000
    let l = time.local(sec) else |_| {
        s.clock_hour = sec % 86400 / 3600
        s.clock_minute = sec % 3600 / 60
        return
    }
    s.clock_hour = l.hour
    s.clock_minute = l.minute
}

fn two_digits(n: int) -> str {
    if n < 10 { return "0{n}" }
    "{n}"
}

/// A tab's label on the bar: ` N `, ` N:NAME `, with its marks after the
/// name: `Z` zoomed, `+` output and `!` a bell while it was not shown.
fn tab_label(t: layout.Tab, n: int, marks: int) -> str {
    let name = str_from_utf8(t.name[0..t.name.len]) else ""
    var tail = ""
    if t.zoomed { tail = tail + "Z" }
    if marks & MARK_ACTIVITY != 0 { tail = tail + "+" }
    if marks & MARK_BELL != 0 { tail = tail + "!" }
    if name.len == 0 { return " {n}{tail} " }
    " {n}:{name}{tail} "
}

fn blank_line(cols: int) -> List[vt.Cell] {
    var line = List[vt.Cell]()
    var i = 0
    while i < cols {
        (mut line).push(blank_cell())
        i += 1
    }
    line
}

/// The last scalars of a prompt that fit in `room` columns (a long line
/// scrolls left as it is typed).
fn prompt_tail(prompt: List[byte], room: int) -> str {
    let text = str_from_utf8(prompt[0..prompt.len]) else ""
    var width = text_width(text)
    if width <= room { return text }
    var off = 0
    for cp in text.code_points() {
        if width <= room { break }
        var base = cp
        if base < 32 || (base >= 127 && base < 160) { base = 63 }
        width -= vt.scalar_width(base)
        off += if cp < 128 then 1 else if cp < 2048 then 2 else if cp < 65536 then 3 else 4
    }
    str_from_utf8(prompt[off..prompt.len]) else ""
}

/// The hint line's text in a prompt mode (rename, command, search), the
/// cursor after it; "" in any other mode.
fn prompt_line(s: Server, index: int, cols: int) -> str {
    let mode = s.conns[index].mode
    var lead = ""
    if mode == config.MODE_COMMAND { lead = " :" }
    if mode == config.MODE_RENAME { lead = " rename tab: " }
    if mode == config.MODE_SEARCH { lead = if s.conns[index].search_older then " ?" else " /" }
    if lead.len == 0 { return "" }
    lead + prompt_tail(s.conns[index].prompt, cols - text_width(lead) - 1)
}

// A hint line drawn at a column of a bar line: its text, its keys inverse.
fn put_hints(mut line: List[vt.Cell], col: int, cols: int, h: config.HintLine) {
    let _t = put_text(mut line, col, cols, h.text, 0)
    var q = 0
    while q + 1 < h.keys.len {
        var x = h.keys[q]
        while x < h.keys[q + 1] {
            let at = col - 1 + x
            if at >= 0 && at < line.len { line[at] = chrome_cell(line[at].base, INVERSE, 0 - 1) }
            x += 1
        }
        q += 2
    }
}

struct TabBar { cells: List[vt.Cell], hits: List[TabHit] }

fn mode_field_at(cols: int) -> int {
    if cols >= CLOCK_MIN_COLS { return cols - MODE_FIELD - CLOCK_FIELD + 1 }
    cols - MODE_FIELD + 1
}

// Paint and hit-test the exact same label spans, in display cells, including
// clipped and wide labels. Session text and overflow markers have no hit.
fn tab_bar(s: Server, si: int) -> TabBar {
    let cols = s.sessions[si].cols
    var hits = List[TabHit]()
    var line = blank_line(cols)
    // The mode field, left of the clock from CLOCK_MIN_COLS; the tabs end
    // one column before it.
    let tab_end = mode_field_at(cols) - 2
    var col = put_text(mut line, 1, tab_end, " " + name_of(s.sessions[si]) + " ", INVERSE)
    var labels = List[str]()
    var active = 0
    var t = 0
    while t < s.sessions[si].layout.tabs.len {
        let id = s.sessions[si].layout.tabs[t].id
        (mut labels).push(tab_label(s.sessions[si].layout.tabs[t], t + 1, marks_of(s, si, id)))
        if s.sessions[si].layout.tabs[t].id == s.sessions[si].layout.active { active = t }
        t += 1
    }
    if labels.len > 0 {
        // The widest run of labels that fits and holds the active one: from
        // the active label back as far as fits, then forward.
        let room = tab_end - col + 1 - 2
        var from = active
        var to = active
        var used = text_width(labels[active])
        while from > 0 && used + text_width(labels[from - 1]) <= room {
            from -= 1
            used += text_width(labels[from])
        }
        while to + 1 < labels.len && used + text_width(labels[to + 1]) <= room {
            to += 1
            used += text_width(labels[to])
        }
        if from > 0 { col = put_text(mut line, col, tab_end, "<", 0) }
        t = from
        while t <= to {
            let first = col
            col = put_text(mut line, col, tab_end, labels[t], if t == active then INVERSE else 0)
            if col > first {
                (mut hits).push(TabHit { first: first, end: col, tab: s.sessions[si].layout.tabs[t].id })
            }
            t += 1
        }
        if to + 1 < labels.len { col = put_text(mut line, col, tab_end, ">", 0) }
    }
    TabBar { cells: line, hits: hits }
}

fn tab_at(s: Server, index: int, col: int, row: int) -> int {
    tab_hit_at(s.conns[index].tabs, col, row)
}

/// The client's cells over the frame's last rows: the bar's two lines,
/// with the key list over the tab area above them while it is open. Line
/// one: the session's name, its tabs (the active one inverse; tabs that do
/// not fit are left out on the far side of the active one, marked `<` and
/// `>`), and the client's mode in a fixed field at the right end. Line two:
/// the prompt being typed, the confirm question, the client's message while
/// it lasts, or the mode's hints with their keys inverse.
fn bar_cells(s: Server, si: int, index: int, now: int, tab_cells: List[vt.Cell]) -> List[vt.Cell] {
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    let mode = s.conns[index].mode
    var bar = List[vt.Cell]()
    if mode == config.MODE_HELP && area > 0 {
        var r = 0
        while r < area {
            var help = blank_line(cols)
            let at = s.conns[index].help_top + r
            if at < s.help.len { let _h = put_text(mut help, 1, cols, s.help[at], 0) }
            for cell in help { (mut bar).push(cell) }
            r += 1
        }
    }
    let clock = cols >= CLOCK_MIN_COLS
    let field = mode_field_at(cols)
    var line = copy tab_cells
    if field >= 1 {
        var c = field - 1
        while c < field - 1 + MODE_FIELD {
            line[c] = chrome_cell(32, INVERSE | BOLD, 0 - 1)
            c += 1
        }
        let _f = put_text(mut line, field + 1, field + MODE_FIELD - 1, config.mode_name(mode), INVERSE | BOLD)
    }
    if clock {
        let _k = put_text(mut line, cols - CLOCK_FIELD + 2, cols, two_digits(s.clock_hour) + ":" + two_digits(s.clock_minute), 0)
    }
    for cell in line { (mut bar).push(cell) }
    var two = blank_line(cols)
    let prompt = prompt_line(s, index, cols)
    if prompt.len > 0 {
        let _p = put_text(mut two, 1, cols, prompt, 0)
    } else if mode == config.MODE_CONFIRM {
        let question = if s.conns[index].confirm == config.A_CLOSE_TAB then " close this tab and its panes?" else if pane_count(s, si) == 1 then (if cols >= 48 then " close last pane and end session?" else " end session?") else " close this pane?"
        let q = put_text(mut two, 1, cols, question, 0)
        put_hints(mut two, q, cols, config.hint_line(s.keys, mode, cols - q + 1))
    } else if s.conns[index].message_until > now && s.conns[index].message.len > 0 {
        let text = str_from_utf8(s.conns[index].message[0..s.conns[index].message.len]) else ""
        let _m = put_text(mut two, 1, cols, text, 0)
    } else {
        put_hints(mut two, 1, cols, config.hint_line(s.keys, mode, cols))
    }
    for cell in two { (mut bar).push(cell) }
    bar
}

/// Show a message on one client's hint line for MESSAGE_MS.
fn tell(mut s: Server, index: int, text: str) {
    if index < 0 {
        keep_told(mut s, text)
        return
    }
    (mut s.conns[index].message).reset()
    for b in text.bytes() { (mut s.conns[index].message).push(b) }
    s.conns[index].message_until = now_ns() + MESSAGE_MS * 1000000
    s.conns[index].seen_bar = 0 - 1
    mark_stale(mut s.conns[index], now_ns())
}

/// The focused pane's title to every member (after focus or a tab moved).
fn title_to_members(mut s: Server, si: int) {
    let k = focused_slot(s, si)
    if k < 0 { return }
    let title = s.panes[k].screen.title_storage[0..s.panes[k].screen.title_length]
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].member && s.conns[i].session == si && !s.conns[i].ending {
            if !send_title(mut s.conns[i], title) { terminal(mut s, i, 135, 5, "too slow") }
        }
        i += 1
    }
}

/// Focus reports to the pane losing focus and the one taking it, when
/// they asked for them; the new focused pane's title to the members.
fn focus_moved(mut s: Server, si: int, from: int) {
    let to = focused_slot(s, si)
    if from == to { return }
    if from >= 0 && s.panes[from].live { queue_to(mut s, from, focus_bytes(s.panes[from].screen, false)) }
    if to >= 0 { queue_to(mut s, to, focus_bytes(s.panes[to].screen, true)) }
    title_to_members(mut s, si)
}

// ---- actions ----

const DONE: int = 0
const LATER: int = 1

/// Split the focused pane along an axis; the new pane goes second and
/// takes focus. LATER when its slot is made between turns.
fn act_split(mut s: Server, index: int, si: int, axis: int) -> int {
    act_split_in(mut s, index, si, axis, "", List[str]())
}

/// As act_split, the new pane's program in `dir` running `argv` (see
/// spawn_pane_in).
fn act_split_in(mut s: Server, index: int, si: int, axis: int, dir: str, argv: List[str]) -> int {
    let tab = s.sessions[si].layout.active
    let focus = focus_id(s, si)
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    if pane_count(s, si) >= MAX_PANES {
        tell(mut s, index, "split refused: {MAX_PANES} panes a session")
        return DONE
    }
    let id = s.next_pane
    var trial = copy s.sessions[si].layout
    var refusal = ""
    layout.split(mut trial, tab, focus, axis, id, true, cols, area) else |e| { refusal = "{e}" }
    if refusal.len > 0 {
        if refusal == "too_small" { tell(mut s, index, "too small to split") } else { tell(mut s, index, "split refused: {refusal}") }
        return DONE
    }
    var nc = 0
    var nr = 0
    for r in layout.rects(trial, tab, cols, area) {
        if r.pane == id {
            nc = r.cols
            nr = r.rows
        }
    }
    if nc < 1 || nr < 1 {
        tell(mut s, index, "too small to split")
        return DONE
    }
    if !pane_fits(s, nc, nr, 0) {
        tell(mut s, index, "split refused: memory budget")
        return DONE
    }
    let k = acquire_pane(mut s, nc, nr)
    if k < 0 { return LATER }
    let from = focused_slot(s, si)
    let start = if dir.len > 0 then dir else new_pane_dir(s, si, from, true)
    s.next_pane = s.next_pane + 1
    layout.split(mut s.sessions[si].layout, tab, focus, axis, id, true, cols, area) else |_| {}
    let why = spawn_pane_in(mut s, si, k, id, nc, nr, start, argv)
    if why.len > 0 {
        layout.close(mut s.sessions[si].layout, id) else |_| {}
        tell(mut s, index, "split refused: the program did not start: {why}")
        layout_changed(mut s, si)
        return DONE
    }
    layout_changed(mut s, si)
    focus_moved(mut s, si, from)
    DONE
}

/// A new tab with one pane at the whole area; it becomes active.
fn act_new_tab(mut s: Server, index: int, si: int) -> int {
    act_new_tab_in(mut s, index, si, "", List[str]())
}

/// As act_new_tab, the new pane's program in `dir` running `argv` (see
/// spawn_pane_in).
fn act_new_tab_in(mut s: Server, index: int, si: int, dir: str, argv: List[str]) -> int {
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    if pane_count(s, si) >= MAX_PANES {
        tell(mut s, index, "new tab refused: {MAX_PANES} panes a session")
        return DONE
    }
    if !pane_fits(s, cols, area, 0) {
        tell(mut s, index, "new tab refused: memory budget")
        return DONE
    }
    let k = acquire_pane(mut s, cols, area)
    if k < 0 { return LATER }
    let from = focused_slot(s, si)
    let id = s.next_pane
    s.next_pane = s.next_pane + 1
    // The layout hands out the server's next tab id, and the server takes
    // back the count it reached.
    s.sessions[si].layout.next_id = s.next_tab
    let _t = layout.new_tab(mut s.sessions[si].layout, id, "") else |_| { 0 }
    s.next_tab = s.sessions[si].layout.next_id
    let start = if dir.len > 0 then dir else new_pane_dir(s, si, from, false)
    let why = spawn_pane_in(mut s, si, k, id, cols, area, start, argv)
    if why.len > 0 {
        layout.close(mut s.sessions[si].layout, id) else |_| {}
        tell(mut s, index, "new tab refused: the program did not start: {why}")
        layout_changed(mut s, si)
        return DONE
    }
    layout_changed(mut s, si)
    focus_moved(mut s, si, from)
    DONE
}

fn opposite(direction: int) -> int {
    if direction == layout.LEFT { return layout.RIGHT }
    if direction == layout.RIGHT { return layout.LEFT }
    if direction == layout.UP { return layout.DOWN }
    layout.UP
}

/// Move a border of the focused pane one step in a direction: its own
/// border on that side, or else the one on the other side, moving the
/// same way.
fn act_resize(mut s: Server, si: int, direction: int) {
    let focus = focus_id(s, si)
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    let step = if direction == layout.LEFT || direction == layout.RIGHT then RESIZE_COLS else RESIZE_ROWS
    var none = false
    let _g = layout.resize(mut s.sessions[si].layout, focus, direction, step, cols, area) else |e| {
        none = "{e}" == "no_border"
        0
    }
    if none {
        let _h = layout.resize(mut s.sessions[si].layout, focus, opposite(direction), 0 - step, cols, area) else |_| { 0 }
    }
    layout_changed(mut s, si)
}

/// Close the active tab: its panes leave their slots (their programs hear
/// the hangup); the last tab ends the session instead.
fn close_tab(mut s: Server, si: int) {
    let tab = s.sessions[si].layout.active
    var ids = List[int]()
    for t in s.sessions[si].layout.tabs {
        if t.id == tab {
            for id in t.focus_order { (mut ids).push(id) }
        }
    }
    let from = focused_slot(s, si)
    var last = false
    layout.close_tab(mut s.sessions[si].layout, tab) else |e| { last = "{e}" == "last_tab" }
    clear_marks(mut s, si, tab)
    if last {
        end_session(mut s, si)
        return
    }
    for id in ids {
        let k = slot_of(s, id)
        if k >= 0 { drop_pane(mut s, k) }
    }
    layout_changed(mut s, si)
    focus_moved(mut s, si, from)
}

/// Do a key's action for a client. LATER when it waits for a pane slot
/// made between turns (it is taken again on the next turn).
fn do_action(mut s: Server, index: int, action: int, arg: int) -> int {
    do_action_in(mut s, index, s.conns[index].session, action, arg)
}

/// An action on session `si`'s focused pane, for client `index` (-1 for a
/// command, which has no client: what it would be told is kept in `told`).
fn do_action_in(mut s: Server, index: int, si: int, action: int, arg: int) -> int {
    if si < 0 || !s.sessions[si].live { return DONE }
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    let tab = s.sessions[si].layout.active
    let from = focused_slot(s, si)
    if action == config.A_SPLIT { return act_split(mut s, index, si, arg) }
    if action == config.A_NEW_TAB { return act_new_tab(mut s, index, si) }
    if action == config.A_DETACH {
        if index >= 0 { terminal(mut s, index, 135, 1, "detached") }
        return DONE
    }
    if action == config.A_KILL_SESSION {
        // Every pane's program hangs up and every member is told the
        // session ended; the last session's end ends the server.
        end_session(mut s, si)
        return DONE
    }
    if action == config.A_SEND_PREFIX {
        if from >= 0 { queue_to(mut s, from, key_bytes(s.panes[from].screen, 4, 0, 32)) }
        return DONE
    }
    if action == config.A_CLOSE {
        if from >= 0 { close_pane(mut s, si, from) }
        return DONE
    }
    if action == config.A_QUICK_CLOSE {
        if from < 0 || index < 0 { return DONE }
        if pane_count(s, si) == 1 {
            s.conns[index].back = config.MODE_NORMAL
            s.conns[index].confirm = config.A_CLOSE
            set_mode(mut s, index, config.MODE_CONFIRM)
        } else { close_pane(mut s, si, from) }
        return DONE
    }
    if action == config.A_CLOSE_TAB {
        close_tab(mut s, si)
        return DONE
    }
    if action == config.A_RESIZE {
        act_resize(mut s, si, arg)
        return DONE
    }
    var refused = false
    if action == config.A_FOCUS {
        layout.focus(mut s.sessions[si].layout, tab, arg, cols, area) else |_| { refused = true }
    } else if action == config.A_FOCUS_NEXT {
        layout.focus_next(mut s.sessions[si].layout, tab) else |_| { refused = true }
    } else if action == config.A_ZOOM {
        layout.zoom(mut s.sessions[si].layout, tab) else |_| { refused = true }
    } else if action == config.A_EQUALIZE {
        layout.equalize(mut s.sessions[si].layout, tab) else |_| { refused = true }
    } else if action == config.A_NEXT_TAB {
        layout.next_tab(mut s.sessions[si].layout)
    } else if action == config.A_PREVIOUS_TAB {
        layout.previous_tab(mut s.sessions[si].layout)
    } else if action == config.A_SELECT_TAB {
        layout.select_tab(mut s.sessions[si].layout, arg) else |_| { refused = true }
    } else {
        refused = true
    }
    if refused { return DONE }
    layout_changed(mut s, si)
    focus_moved(mut s, si, from)
    DONE
}

// ---- input from clients ----

/// Queue bytes for a pane's program and write what the pty takes now.
fn queue_to(mut s: Server, k: int, data: List[byte]) {
    if k < 0 || !s.panes[k].live || data.len == 0 { return }
    if !queue_input(mut s.panes[k], data) {
        trace(s, "pane {k} input queue full: dropped {data.len}")
        return
    }
    write_pane(mut s, k)
}

/// Bytes from a client for its session's focused pane.
fn to_pane(mut s: Server, index: int, data: List[byte]) {
    let si = s.conns[index].session
    if si < 0 || !s.sessions[si].live || data.len == 0 { return }
    queue_to(mut s, focused_slot(s, si), data)
}

fn write_pane(mut s: Server, k: int) {
    if s.panes[k].ended || s.panes[k].master < 0 { return }
    let off = s.panes[k].in_off
    let len = s.panes[k].in_len
    if len > off {
        var f = fs.File { fd: s.panes[k].master }
        let end = if len - off > WRITE_BUDGET then off + WRITE_BUDGET else len
        let n = fs.write_some(mut f, s.panes[k].input[off..end]) else |_| { 0 }
        s.panes[k].in_off = off + n
    }
    let want = s.panes[k].in_len > s.panes[k].in_off
    if want != s.panes[k].write_on && s.panes[k].key >= 0 {
        let i = if want then poll.READ | poll.WRITE else poll.READ
        poll.modify(mut s.w, s.panes[k].key, i) else |_| {}
        s.panes[k].write_on = want
    }
}

fn u(b: List[byte], at: int, width: int) -> int {
    var n: int = 0
    var f: int = 1
    var i = 0
    while i < width {
        n = n + (b[at + i] as int) * f
        f = f * 256
        i += 1
    }
    n
}

// A client whose session ended while it owed an ACK: the ended session's
// last image (when its panes are still those of that session), then BYE
// session-ended.
fn finish_ending(mut s: Server, index: int) {
    let si = s.conns[index].session
    s.conns[index].ending = false
    if si >= 0 && si < s.sessions.len && s.sessions[si].generation == s.conns[index].ending_gen {
        compose_now(mut s, index, now_ns())
    }
    if s.conns[index].live { terminal(mut s, index, 135, 2, "session ended") }
}

// ---- keys and modes ----

/// INPUT, PASTE and the mouse reach the pane only in normal and locked mode.
fn passing(mode: int) -> bool {
    mode == config.MODE_NORMAL || mode == config.MODE_LOCKED
}

fn sticky(mode: int) -> bool {
    mode == config.MODE_PANE || mode == config.MODE_TAB || mode == config.MODE_RESIZE || mode == config.MODE_SESSION ||
        mode == config.MODE_SCROLL
}

// Confirm, help and the prompts: left for the mode they came from.
fn passing_through(mode: int) -> bool {
    mode == config.MODE_CONFIRM || mode == config.MODE_HELP || mode == config.MODE_COMMAND || mode == config.MODE_RENAME ||
        mode == config.MODE_SEARCH
}

// The client's bar is drawn again (its mode, prompt or question changed).
fn bar_moved(mut s: Server, index: int) {
    s.conns[index].seen_bar = 0 - 1
    mark_stale(mut s.conns[index], now_ns())
}

// The client's whole frame is scanned again (its key list opened, moved or
// closed).
fn frame_moved(mut s: Server, index: int) {
    s.conns[index].seen_layout = 0 - 1
    bar_moved(mut s, index)
}

fn set_mode(mut s: Server, index: int, mode: int) {
    let was = s.conns[index].mode
    if was == mode { return }
    s.conns[index].mode = mode
    if windowed(was) && !windowed(mode) { leave_view(mut s, index) }
    if was == config.MODE_HELP || mode == config.MODE_HELP { frame_moved(mut s, index) } else { bar_moved(mut s, index) }
}

/// Do an action for a client `count` times (a command's resize); one that
/// waits for a pane slot is taken again on the next turn.
fn act(mut s: Server, index: int, action: int, arg: int, count: int) {
    if action == config.A_LOCK {
        set_mode(mut s, index, config.MODE_LOCKED)
        return
    }
    var n = 0
    while n < count && s.conns[index].live {
        if do_action(mut s, index, action, arg) == LATER {
            s.conns[index].pending = action
            s.conns[index].pending_arg = arg
            return
        }
        n += 1
    }
}

/// The active tab's new name.
fn rename_active(mut s: Server, index: int, name: str) {
    let si = s.conns[index].session
    if si < 0 || !s.sessions[si].live { return }
    let tab = s.sessions[si].layout.active
    layout.rename_tab(mut s.sessions[si].layout, tab, name) else |_| { return }
    s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
    session_changed(mut s, si, now_ns())
}

// The prompt's line, run as the mode it was typed in says: a search, a
// rename, or a command of the key table's action names.
fn run_prompt(mut s: Server, index: int, was: int) {
    if was == config.MODE_SEARCH {
        search_run(mut s, index)
        return
    }
    let text = str_from_utf8(s.conns[index].prompt[0..s.conns[index].prompt.len]) else ""
    (mut s.conns[index].prompt).reset()
    if was == config.MODE_RENAME {
        rename_active(mut s, index, text)
        return
    }
    let c = config.command(text)
    if !c.ok {
        if c.why.len > 0 { tell(mut s, index, c.why) }
        return
    }
    if c.action == config.A_RENAME_TAB {
        rename_active(mut s, index, c.text)
        return
    }
    if c.action == config.A_RENAME_SESSION {
        rename_session(mut s, index, s.conns[index].session, c.text)
        return
    }
    act(mut s, index, c.action, c.arg, c.count)
}

// Rename session `si`, or tell client `index` why not: a name the server
// does not allow, or one another live session holds.
fn rename_session(mut s: Server, index: int, si: int, name: str) {
    if si < 0 || !s.sessions[si].live { return }
    let problem = name_problem(name)
    if problem.len > 0 {
        tell(mut s, index, problem)
        return
    }
    let other = find_session(s, name)
    if other >= 0 && other != si {
        tell(mut s, index, "a session named {name} already exists")
        return
    }
    set_name(mut s.sessions[si], name)
    s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
    session_changed(mut s, si, now_ns())
}

// The prompt's bytes: the active tab's name for a rename, else empty.
fn fill_prompt(mut s: Server, index: int, rename: bool) {
    (mut s.conns[index].prompt).reset()
    let si = s.conns[index].session
    if !rename || si < 0 { return }
    let tab = s.sessions[si].layout.active
    var name = List[byte]()
    for t in s.sessions[si].layout.tabs {
        if t.id == tab {
            for b in t.name { (mut name).push(b) }
        }
    }
    for b in name {
        if s.conns[index].prompt.len < PROMPT_BYTES { (mut s.conns[index].prompt).push(b) }
    }
}

fn prompt_type(mut s: Server, index: int, cp: int) {
    var bytes = List[byte]()
    push_scalar(mut bytes, cp)
    if s.conns[index].prompt.len + bytes.len > PROMPT_BYTES { return }
    for b in bytes { (mut s.conns[index].prompt).push(b) }
    bar_moved(mut s, index)
}

fn prompt_erase(mut s: Server, index: int) {
    // Drop continuation bytes, then the scalar's lead byte.
    while s.conns[index].prompt.len > 0 {
        let b = (mut s.conns[index].prompt).pop() else { return }
        if (b as int) & 192 != 128 { break }
    }
    bar_moved(mut s, index)
}

/// A KEY from a client, through the key table in the client's mode: passed
/// to the focused pane, or an action and the next mode.
fn key_event(mut s: Server, index: int, mods: int, kind: int, code: int) {
    // A keyboard action cancels mouse capture, but its release stays consumed.
    s.conns[index].drag = layout.no_border_hit()
    let si = s.conns[index].session
    let mode = s.conns[index].mode
    let st = config.step(s.keys, mode, mods, kind, code)
    let a = st.action
    if a == config.A_PASS {
        if si >= 0 {
            let f = focused_slot(s, si)
            if f >= 0 { queue_to(mut s, f, key_bytes(s.panes[f].screen, mods, kind, code)) }
        }
        return
    }
    var next = st.mode
    if next == config.MODE_BACK { next = s.conns[index].back }
    if passing_through(next) && !passing_through(mode) {
        s.conns[index].back = if sticky(mode) then mode else config.MODE_NORMAL
    }
    if a == config.A_TYPE {
        prompt_type(mut s, index, st.arg)
        return
    }
    if a == config.A_ERASE {
        prompt_erase(mut s, index)
        return
    }
    if a == config.A_CLEAR {
        (mut s.conns[index].prompt).reset()
        bar_moved(mut s, index)
        return
    }
    if a == config.A_SCROLL {
        let area = if si >= 0 then s.sessions[si].rows - BAR_LINES else 0
        var top = s.conns[index].help_top + st.arg
        if top > s.help.len - area { top = s.help.len - area }
        if top < 0 { top = 0 }
        if top != s.conns[index].help_top {
            s.conns[index].help_top = top
            frame_moved(mut s, index)
        }
        return
    }
    set_mode(mut s, index, next)
    if a == config.A_NONE { return }
    if a == config.A_RUN {
        run_prompt(mut s, index, mode)
        return
    }
    if a == config.A_CONFIRM {
        s.conns[index].confirm = st.arg
        return
    }
    if a == config.A_YES {
        act(mut s, index, s.conns[index].confirm, 0, 1)
        return
    }
    if a == config.A_RENAME_TAB || a == config.A_COMMAND {
        fill_prompt(mut s, index, a == config.A_RENAME_TAB)
        return
    }
    if a == config.A_HELP {
        s.conns[index].help_top = 0
        return
    }
    if a == config.A_VIEW_ENTER {
        let f = if si >= 0 then focused_slot(s, si) else 0 - 1
        if f >= 0 { enter_view(mut s, index, f, false) } else { set_mode(mut s, index, config.MODE_NORMAL) }
        return
    }
    if a == config.A_VIEW_ROWS || a == config.A_VIEW_PAGE || a == config.A_VIEW_END {
        view_key(mut s, index, a, st.arg)
        return
    }
    if a == config.A_PASTE {
        paste_register(mut s, index)
        return
    }
    if a == config.A_SEARCH || a == config.A_SEARCH_AGAIN {
        search_key(mut s, index, a, st.arg)
        return
    }
    act(mut s, index, a, st.arg, 1)
}

// ---- scroll mode: one client's window over one pane's history ----

// The window's pane still holds the slot it was opened on.
fn view_live(s: Server, index: int) -> bool {
    let k = s.conns[index].view_slot
    k >= 0 && k < s.panes.len && s.panes[k].live && s.panes[k].id == s.conns[index].view_pane
}

// Scroll mode ended: the pane's live rows are drawn again.
fn leave_view(mut s: Server, index: int) {
    if s.conns[index].view_slot < 0 { return }
    s.conns[index].view_slot = 0 - 1
    s.conns[index].view_back = 0
    s.conns[index].view_retry = 0 - 1
    s.conns[index].sel_state = 0
    s.conns[index].sel_slot = 0 - 1
    s.conns[index].sel_opened = false
    vt.unmark_view(mut s.conns[index].view)
    vt.unfind_view(mut s.conns[index].view)
    frame_moved(mut s, index)
}

// Open a window on pane slot `k` at its live rows. The wheel's windows close
// again at the live rows; prefix [ keeps its window until q or Esc.
fn enter_view(mut s: Server, index: int, k: int, wheel: bool) {
    s.conns[index].view_slot = k
    s.conns[index].view_pane = s.panes[k].id
    s.conns[index].view_back = 0
    s.conns[index].view_wheel = wheel
    s.conns[index].view_id = 0 - 1
    s.conns[index].view_offset = 0
    set_mode(mut s, index, config.MODE_SCROLL)
}

// Where the window's top row's content is now: output since the last fill
// pushed it further back. Content no longer retained keeps the old count,
// which the next fill clamps.
fn view_anchor(mut s: Server, index: int) -> int {
    let back = s.conns[index].view_back
    if back <= 0 || !view_live(s, index) { return back }
    let k = s.conns[index].view_slot
    let now = vt.view_back_of(mut s.conns[index].view, s.panes[k].screen, s.conns[index].view_id, s.conns[index].view_offset)
    if now < 0 { return back }
    now
}

// Fill the window `back` rows up, anchor it on its top row, and repaint.
fn view_to(mut s: Server, index: int, back: int) {
    if !view_live(s, index) {
        set_mode(mut s, index, config.MODE_NORMAL)
        return
    }
    let k = s.conns[index].view_slot
    let shown = vt.fill_view(mut s.conns[index].view, s.panes[k].screen, back)
    if shown < 0 {
        // Too small for the pane: grown between turns, filled on the next.
        s.conns[index].view_cols = s.panes[k].screen.cols
        s.conns[index].view_rows = s.panes[k].screen.rows
        s.conns[index].view_retry = back
        s.need_view = true
        return
    }
    s.conns[index].view_back = shown
    s.conns[index].view_id = s.conns[index].view.screen.line_ids[0]
    s.conns[index].view_offset = s.conns[index].view.screen.line_offsets[0]
    // A drag whose window was filled a turn late is marked again on it; a
    // search's match is marked wherever the window shows it.
    if s.conns[index].sel_state == 2 {
        vt.mark_view(mut s.conns[index].view, s.conns[index].sel_row, s.conns[index].sel_col,
            s.conns[index].sel_to_row, s.conns[index].sel_to_col)
    } else { let _found = vt.mark_found(mut s.conns[index].view) }
    if shown == 0 && s.conns[index].view_wheel {
        set_mode(mut s, index, config.MODE_NORMAL)
        return
    }
    frame_moved(mut s, index)
}

// Move the window `rows` rows back (negative: toward the live rows) from
// where its content is now.
fn view_move(mut s: Server, index: int, rows: int) {
    var back = view_anchor(mut s, index) + rows
    if back < 0 { back = 0 }
    view_to(mut s, index, back)
}

fn view_key(mut s: Server, index: int, action: int, arg: int) {
    if !view_live(s, index) {
        set_mode(mut s, index, config.MODE_NORMAL)
        return
    }
    let rows = s.panes[s.conns[index].view_slot].screen.rows
    if action == config.A_VIEW_ROWS { view_move(mut s, index, arg) }
    else if action == config.A_VIEW_PAGE { view_move(mut s, index, arg * rows / 2) }
    else if arg == 1 { view_to(mut s, index, VIEW_OLDEST) }
    else { view_to(mut s, index, 0) }
}

// A wheel notch over a pane: to its program when it is focused and asked for
// reports; else, over a primary screen, up opens or moves this client's
// window on that pane and down moves it toward the live rows. The alternate
// screen without reports keeps the wheel inert, as tmux does.
fn wheel(mut s: Server, index: int, si: int, up: bool, mods: int, col: int, row: int) {
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    let id = layout.pane_at(s.sessions[si].layout, s.sessions[si].layout.active, cols, area, col, row)
    let hit = slot_of(s, id)
    if hit < 0 { return }
    let mode = s.conns[index].mode
    if mode == config.MODE_SCROLL && s.conns[index].view_slot == hit && view_live(s, index) {
        view_move(mut s, index, if up then WHEEL_ROWS else 0 - WHEEL_ROWS)
        return
    }
    let reports = s.panes[hit].screen.mode_values[8] == 1 || s.panes[hit].screen.mode_values[9] == 1 ||
        s.panes[hit].screen.mode_values[10] == 1
    if reports {
        if hit == focused_slot(s, si) && passing(mode) {
            let pc = col - s.panes[hit].at_col + 1
            let pr = row - s.panes[hit].at_row + 1
            queue_to(mut s, hit, mouse_bytes(s.panes[hit].screen, if up then 3 else 4, 0, mods, pc, pr))
        }
        return
    }
    if !up || s.panes[hit].screen.active_alternate { return }
    if mode != config.MODE_NORMAL && mode != config.MODE_SCROLL { return }
    enter_view(mut s, index, hit, true)
    view_move(mut s, index, WHEEL_ROWS)
}

// ---- selection: a drag copies into the session's register on release ----

// A left press that may begin a selection: in the pane this client is looking
// back at, or in the focused pane in normal mode when its program asked for no
// mouse reports (with Shift, even when it did). Alt and Ctrl are the program's.
// The press is the UI's; nothing happens until the pointer moves.
fn select_start(mut s: Server, index: int, hit: int, from: int, mods: int, col: int, row: int) -> bool {
    if mods & 6 != 0 { return false }
    let mode = s.conns[index].mode
    let viewing = mode == config.MODE_SCROLL && s.conns[index].view_slot == hit && view_live(s, index)
    if !viewing {
        if hit != from || mode != config.MODE_NORMAL { return false }
        let reports = s.panes[hit].screen.mode_values[8] == 1 || s.panes[hit].screen.mode_values[9] == 1 ||
            s.panes[hit].screen.mode_values[10] == 1
        if reports && mods & 1 == 0 { return false }
    }
    vt.unfind_view(mut s.conns[index].view)
    s.conns[index].sel_state = 1
    s.conns[index].sel_slot = hit
    s.conns[index].sel_row = row - s.panes[hit].at_row + 1
    s.conns[index].sel_col = col - s.panes[hit].at_col + 1
    s.conns[index].sel_opened = false
    s.conns[index].mouse_consumed = s.conns[index].mouse_consumed | 1
    // The window a drag needs grows between turns, before the pointer moves.
    if !vt.view_fits(s.conns[index].view, s.panes[hit].screen.cols, s.panes[hit].screen.rows) {
        s.conns[index].view_cols = s.panes[hit].screen.cols
        s.conns[index].view_rows = s.panes[hit].screen.rows
        s.need_view = true
    }
    true
}

// The selection ends: its highlight goes, and a window its drag opened closes.
fn select_end(mut s: Server, index: int) {
    let opened = s.conns[index].sel_opened
    let was = s.conns[index].sel_state
    s.conns[index].sel_state = 0
    s.conns[index].sel_slot = 0 - 1
    s.conns[index].sel_opened = false
    vt.unmark_view(mut s.conns[index].view)
    if opened && s.conns[index].mode == config.MODE_SCROLL { set_mode(mut s, index, config.MODE_NORMAL) }
    else if was == 2 { frame_moved(mut s, index) }
}

// Motion and release of a selection's gesture. The first move opens a snapshot
// window at the pane's live rows (unless the client is already looking back),
// so output cannot shift the text under the drag; the far end is clamped to
// the pane it started in. Release copies into the session's register and says
// so; a press and release on one cell copies nothing. The wheel waits.
fn select_gesture(mut s: Server, index: int, kind: int, button: int, col: int, row: int) -> bool {
    let state = s.conns[index].sel_state
    if state == 0 { return false }
    let k = s.conns[index].sel_slot
    if kind == 0 || k < 0 || k >= s.panes.len || !s.panes[k].live {
        select_end(mut s, index)
        return false
    }
    if kind == 3 || kind == 4 { return state == 2 }
    if kind != 2 && !(kind == 1 && button == 1) { return true }
    var pr = row - s.panes[k].at_row + 1
    var pc = col - s.panes[k].at_col + 1
    if pr < 1 { pr = 1 }
    if pr > s.panes[k].screen.rows { pr = s.panes[k].screen.rows }
    if pc < 1 { pc = 1 }
    if pc > s.panes[k].screen.cols { pc = s.panes[k].screen.cols }
    if kind == 2 {
        if state == 1 {
            if pr == s.conns[index].sel_row && pc == s.conns[index].sel_col { return true }
            let viewing = s.conns[index].mode == config.MODE_SCROLL && s.conns[index].view_slot == k && view_live(s, index)
            if !viewing {
                enter_view(mut s, index, k, false)
                s.conns[index].sel_opened = true
                view_to(mut s, index, 0)
            }
            s.conns[index].sel_state = 2
        }
        s.conns[index].sel_to_row = pr
        s.conns[index].sel_to_col = pc
        vt.mark_view(mut s.conns[index].view, s.conns[index].sel_row, s.conns[index].sel_col, pr, pc)
        frame_moved(mut s, index)
        return true
    }
    s.conns[index].mouse_consumed = s.conns[index].mouse_consumed & 6
    if state == 2 && s.conns[index].view.marked {
        vt.mark_view(mut s.conns[index].view, s.conns[index].sel_row, s.conns[index].sel_col, pr, pc)
        let si = s.conns[index].session
        if si >= 0 {
            let n = vt.view_marked_text(s.conns[index].view, mut s.sessions[si].register, REGISTER_BYTES)
            if n < 0 { tell(mut s, index, "selection too large: {REGISTER_BYTES} bytes at most") }
            else {
                tell(mut s, index, "copied {n} bytes")
                // Exported best effort to this client's terminal alone, when
                // it takes OSC 52 writes.
                if n > 0 && s.conns[index].features & 8 != 0 {
                    if !send(mut s.conns[index], 133, bytes_payload(s.sessions[si].register)) {
                        terminal(mut s, index, 135, 5, "too slow")
                    }
                }
            }
        }
    }
    select_end(mut s, index)
    true
}

// Prefix ]: the session's register into the focused pane, as one bracketed
// paste when its program asked for that (PASTE's own rules).
fn paste_register(mut s: Server, index: int) {
    let si = s.conns[index].session
    if si < 0 || !s.sessions[si].live || s.sessions[si].register.len == 0 { return }
    let f = focused_slot(s, si)
    if f < 0 { return }
    queue_to(mut s, f, paste_bytes(s.panes[f].screen, s.sessions[si].register))
}

// Prompts/help/confirmation own their input; the other modes keep chrome usable.
fn mouse_chrome(mode: int) -> bool {
    passing(mode) || mode == config.MODE_PREFIX || mode == config.MODE_PANE || mode == config.MODE_TAB ||
        mode == config.MODE_RESIZE || mode == config.MODE_SESSION || mode == config.MODE_SCROLL
}

// A captured border owns every motion and the matching release even outside
// its original rect. Only this gesture's own resize advances its generation.
fn border_gesture(mut s: Server, index: int, kind: int, button: int, col: int, row: int) -> bool {
    if s.conns[index].drag.node < 0 { return false }
    if kind == 0 { s.conns[index].drag = layout.no_border_hit(); return false }
    if kind != 2 && !(kind == 1 && button == 1) { return false }
    let si = s.conns[index].session
    let hit = copy s.conns[index].drag
    let valid = si >= 0 && s.sessions[si].live && s.sessions[si].layout.active == hit.tab &&
        s.sessions[si].layout_gen == s.conns[index].drag_layout && mouse_chrome(s.conns[index].mode)
    if valid && (kind == 1 || button == 1) {
        let target = if hit.axis == layout.COLS then col else row
        let moved = layout.drag_border(mut s.sessions[si].layout, hit, target, s.sessions[si].cols,
            s.sessions[si].rows - BAR_LINES) else 0
        if moved != 0 {
            layout_changed(mut s, si)
            s.conns[index].drag_layout = s.sessions[si].layout_gen
        }
    }
    if !valid || kind == 1 { s.conns[index].drag = layout.no_border_hit() }
    if kind == 1 { s.conns[index].mouse_consumed = s.conns[index].mouse_consumed & 6 }
    true
}

/// A mouse gesture consumed by the UI never sends an orphan motion/release
/// to a pane. This state belongs to the client, just like its key mode.
fn mouse_event(mut s: Server, index: int, body: List[byte]) {
    let kind = u(body, 0, 1)
    let button = u(body, 1, 1)
    let mods = u(body, 2, 1)
    let col = u(body, 3, 2)
    let row = u(body, 5, 2)
    let bit = if button == 1 then 1 else if button == 2 then 2 else 4
    if border_gesture(mut s, index, kind, button, col, row) { return }
    if select_gesture(mut s, index, kind, button, col, row) { return }
    if kind == 1 && s.conns[index].mouse_consumed & bit != 0 {
        s.conns[index].mouse_consumed = s.conns[index].mouse_consumed & (7 - bit)
        return
    }
    if kind == 2 && s.conns[index].mouse_consumed != 0 { return }
    if kind == 0 { s.conns[index].mouse_consumed = s.conns[index].mouse_consumed & (7 - bit) }
    let si = s.conns[index].session
    if si < 0 || !s.sessions[si].live { return }
    let cols = s.sessions[si].cols
    let rows = s.sessions[si].rows
    let area = rows - BAR_LINES
    if !mouse_chrome(s.conns[index].mode) || col < 1 || col > cols || row < 1 || row > rows ||
        s.conns[index].tabs.drawn.cols != cols || s.conns[index].tabs.drawn.row != area + 1 {
        if kind == 0 { s.conns[index].mouse_consumed = s.conns[index].mouse_consumed | bit }
        return
    }
    if row > area {
        if kind == 0 {
            s.conns[index].mouse_consumed = s.conns[index].mouse_consumed | bit
            if row == area + 1 {
                let tab = tab_at(s, index, col, row)
                if tab > 0 && tab != s.sessions[si].layout.active {
                    let from = focused_slot(s, si)
                    layout.select_tab_id(mut s.sessions[si].layout, tab) else |_| { return }
                    layout_changed(mut s, si)
                    focus_moved(mut s, si, from)
                }
            }
        }
        return
    }
    let tab = s.sessions[si].layout.active
    if kind == 3 || kind == 4 {
        wheel(mut s, index, si, kind == 3, mods, col, row)
        return
    }
    if kind == 0 && button == 1 && mods == 0 {
        let border = layout.border_at(s.sessions[si].layout, tab, cols, area, col, row)
        if border.node >= 0 {
            s.conns[index].drag = border
            s.conns[index].drag_layout = s.sessions[si].layout_gen
            s.conns[index].mouse_consumed = s.conns[index].mouse_consumed | 1
            return
        }
    }
    let id = layout.pane_at(s.sessions[si].layout, tab, cols, area, col, row)
    let hit = slot_of(s, id)
    let from = focused_slot(s, si)
    if kind == 0 && button == 1 && hit >= 0 && select_start(mut s, index, hit, from, mods, col, row) { return }
    if hit < 0 || hit != from {
        if kind == 0 {
            s.conns[index].mouse_consumed = s.conns[index].mouse_consumed | bit
            if hit >= 0 {
                layout.focus_pane(mut s.sessions[si].layout, id) else |_| { return }
                layout_changed(mut s, si)
                focus_moved(mut s, si, from)
            }
        }
        return
    }
    if !passing(s.conns[index].mode) { return }
    let pc = col - s.panes[hit].at_col + 1
    let pr = row - s.panes[hit].at_row + 1
    queue_to(mut s, hit, mouse_bytes(s.panes[hit].screen, kind, button, mods, pc, pr))
}

fn attached_message(mut s: Server, index: int, kind: int, body: List[byte]) {
    let si = s.conns[index].session
    // A client whose session ended takes only its ACK.
    if s.conns[index].ending && kind != 8 { return }
    if kind == 2 {
        key_event(mut s, index, u(body, 0, 1), u(body, 1, 1), u(body, 2, 4))
    } else if kind == 3 {
        mouse_event(mut s, index, body)
    } else if kind == 4 {
        if si >= 0 && passing(s.conns[index].mode) {
            let f = focused_slot(s, si)
            if f >= 0 { queue_to(mut s, f, paste_bytes(s.panes[f].screen, body[4..body.len])) }
        }
    } else if kind == 5 {
        if si >= 0 {
            let f = focused_slot(s, si)
            if f >= 0 { queue_to(mut s, f, focus_bytes(s.panes[f].screen, u(body, 0, 1) == 1)) }
        }
    } else if kind == 6 {
        s.conns[index].drag = layout.no_border_hit()
        let cols = u(body, 0, 2)
        let rows = u(body, 2, 2)
        if cols < MIN_COLS || rows < MIN_ROWS {
            terminal(mut s, index, 135, 7, "too small")
            return
        }
        s.conns[index].cols = cols
        s.conns[index].rows = rows
        s.conns[index].force_full = true
        mark_stale(mut s.conns[index], now_ns())
        if si >= 0 { recompute_size(mut s, si) }
    } else if kind == 7 {
        if passing(s.conns[index].mode) { to_pane(mut s, index, body[4..body.len]) }
    } else if kind == 8 {
        let seq = u(body, 0, 4)
        let pending = s.conns[index].ack.pending
        if proto.ack(mut s.conns[index].ack, seq) != 0 {
            protocol_error(mut s, index, "ack of an image not sent")
        } else {
            // A stale ACK succeeds as a no-op in proto, but must never
            // promote geometry belonging to the next outstanding image.
            if pending != 0 && seq == pending { let _tabs = ack_tab_hits(mut s.conns[index].tabs, seq) }
            if s.conns[index].ending && s.conns[index].image_end < 0 && s.conns[index].ack.pending == 0 {
                finish_ending(mut s, index)
            }
        }
    } else if kind == 9 {
        s.conns[index].force_full = true
        mark_stale(mut s.conns[index], now_ns())
    } else if kind == 10 {
        terminal(mut s, index, 135, 1, "detached")
    } else if kind == 12 {
        if !send(mut s.conns[index], 137, number_payload(u(body, 0, 4))) {
            terminal(mut s, index, 135, 5, "too slow")
        }
    } else {
        protocol_error(mut s, index, "wrong role")
    }
}

// A COMMAND's argument list (after its id).
fn argv_of(body: List[byte]) -> List[str] {
    var out = List[str]()
    let count = u(body, 4, 2)
    var at = 6
    var i = 0
    while i < count && at + 2 <= body.len {
        let n = u(body, at, 2)
        if at + 2 + n > body.len { return out }
        (mut out).push(str_from_utf8(body[at + 2..at + 2 + n]) else "")
        at = at + 2 + n
        i += 1
    }
    out
}

// The lowest positive number no live session is named.
fn free_number(s: Server) -> str {
    var n = 1
    while find_session(s, "{n}") >= 0 { n += 1 }
    "{n}"
}

// A COMMAND's pane field (after its arguments and its working directory):
// the pane the command came from, as `WARREN_PANE` spells it, or "".
fn pane_field_of(body: List[byte]) -> str {
    command_field(body, 1)
}

// The directory a COMMAND was sent from (its `cwd` field).
fn cwd_field_of(body: List[byte]) -> str {
    command_field(body, 0)
}

// A text field after a COMMAND's argv: 0 its cwd, 1 its pane.
fn command_field(body: List[byte], which: int) -> str {
    let count = u(body, 4, 2)
    var at = 6
    var i = 0
    while i < count + which && at + 2 <= body.len {
        at = at + 2 + u(body, at, 2)
        i += 1
    }
    if at + 2 > body.len { return "" }
    let n = u(body, at, 2)
    if at + 2 + n > body.len { return "" }
    str_from_utf8(body[at + 2..at + 2 + n]) else ""
}

/// A pane's working directory and where it was learnt.
struct PaneDir { path: str, source: str }

// A pane's working directory: the directory its program last reported by
// OSC 7 (`osc7`), else the one /proc names for its live program (`proc`,
// where the host has it), else its session's start directory (`start`). A
// reported or read path is taken only while it names a directory that
// exists; a program reports what it likes.
fn pane_dir(s: Server, k: int) -> PaneDir {
    let reported = vt.reported_dir(s.panes[k].screen)
    if reported.len > 0 && is_directory(reported) { return PaneDir { path: reported, source: "osc7" } }
    if s.panes[k].child_live && s.panes[k].pid > 0 {
        let link = fs.read_link("/proc/{s.panes[k].pid}/cwd") else List[byte]()
        let named = str_from_utf8(link) else ""
        if named.starts_with("/") && is_directory(named) { return PaneDir { path: named, source: "proc" } }
    }
    PaneDir { path: cwd_of(s.sessions[s.panes[k].session]), source: "start" }
}

/// Where a new pane's program starts when no `-c` names a directory: a split
/// in the working directory of the pane it splits (pane_dir), a new tab and
/// a new session in the session's start directory. warren's one choice of
/// it, which differs from tmux's (README).
fn new_pane_dir(s: Server, si: int, from: int, splitting: bool) -> str {
    if splitting && from >= 0 { return pane_dir(s, from).path }
    cwd_of(s.sessions[si])
}

// One session as the command client's rules see it: its tabs in order,
// each tab's panes in tree order with their rects in the tab area (a hidden
// pane's rect is zero), the pid of a pane whose program is alive.
fn session_view(s: Server, si: int) -> cmd.SessionView {
    let cols = s.sessions[si].cols
    let area = s.sessions[si].rows - BAR_LINES
    var tabs = List[cmd.TabView]()
    for t in s.sessions[si].layout.tabs {
        var panes = List[cmd.PaneView]()
        for r in layout.rects(s.sessions[si].layout, t.id, cols, area) {
            let k = slot_of(s, r.pane)
            var pid = 0 - 1
            var title = ""
            var dir = PaneDir { path: cwd_of(s.sessions[si]), source: "start" }
            if k >= 0 {
                if s.panes[k].child_live { pid = s.panes[k].pid }
                title = str_from_utf8(s.panes[k].screen.title_storage[0..s.panes[k].screen.title_length]) else ""
                dir = pane_dir(s, k)
            }
            (mut panes).push(cmd.PaneView { id: r.pane, col: r.col, row: r.row, cols: r.cols, rows: r.rows, pid: pid, title: title,
                cwd: dir.path, cwd_source: dir.source })
        }
        (mut tabs).push(cmd.TabView { id: t.id, name: str_from_utf8(t.name) else "", focus: t.focus, zoomed: t.zoomed, panes: panes })
    }
    cmd.SessionView { id: s.sessions[si].id, name: name_of(s.sessions[si]), cols: cols, rows: s.sessions[si].rows,
        clients: s.sessions[si].members, active: s.sessions[si].layout.active, tabs: tabs }
}

/// The server's live sessions, in id order, as the command client's rules
/// (targets, `list --json`) read them.
fn snapshot(s: Server) -> cmd.Snapshot {
    var sessions = List[cmd.SessionView]()
    var last = 0
    while true {
        var pick = 0 - 1
        var k = 0
        while k < s.sessions.len {
            if s.sessions[k].live && s.sessions[k].id > last && (pick < 0 || s.sessions[k].id < s.sessions[pick].id) { pick = k }
            k += 1
        }
        if pick < 0 { break }
        last = s.sessions[pick].id
        (mut sessions).push(session_view(s, pick))
    }
    cmd.Snapshot { sessions: sessions }
}

// The slot of the live session with id `id`, or -1.
fn session_with_id(s: Server, id: int) -> int {
    var i = 0
    while i < s.sessions.len {
        if s.sessions[i].live && s.sessions[i].id == id { return i }
        i += 1
    }
    0 - 1
}

// What an action run for a command would have told its client.
fn keep_told(mut s: Server, text: str) {
    (mut s.told).reset()
    for b in text.bytes() { (mut s.told).push(b) }
}

// The focused pane's id of tab `tab` in session `si`, or -1.
fn tab_focus(s: Server, si: int, tab: int) -> int {
    for t in s.sessions[si].layout.tabs {
        if t.id == tab { return t.focus }
    }
    0 - 1
}

// The actions whose point is to move the focus or the active tab. Every
// other action sent as a command leaves both where they were.
fn moves_focus(action: int) -> bool {
    action == config.A_FOCUS || action == config.A_FOCUS_NEXT || action == config.A_SELECT_TAB ||
        action == config.A_NEXT_TAB || action == config.A_PREVIOUS_TAB || action == config.A_ZOOM
}

/// A command line action sent as `warren VERB`, on pane `pane` of tab `tab`
/// in session `si`: run by the path a key takes, as if that pane had the
/// focus; then the session's focus and active tab are put back, unless
/// moving them is the action's point. DONE, with `s.told` set when the
/// action was refused, or LATER when a pane's slot is made between turns.
fn command_action(mut s: Server, si: int, tab: int, pane: int, c: config.Command, dir: str, argv: List[str]) -> int {
    (mut s.told).reset()
    let before_tab = s.sessions[si].layout.active
    let before_focus = tab_focus(s, si, tab)
    let from = focused_slot(s, si)
    var gone = false
    layout.focus_pane(mut s.sessions[si].layout, pane) else |_| { gone = true }
    if gone {
        keep_told(mut s, "no-such-pane")
        return DONE
    }
    var result = DONE
    if c.action == config.A_RENAME_TAB {
        layout.rename_tab(mut s.sessions[si].layout, tab, c.text) else |_| { keep_told(mut s, "no-such-tab") }
        s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
    } else if c.action == config.A_RENAME_SESSION {
        rename_session(mut s, 0 - 1, si, c.text)
    } else if c.action == config.A_SPLIT && (dir.len > 0 || argv.len > 0) {
        result = act_split_in(mut s, 0 - 1, si, c.arg, dir, argv)
    } else if c.action == config.A_NEW_TAB && (dir.len > 0 || argv.len > 0) {
        result = act_new_tab_in(mut s, 0 - 1, si, dir, argv)
    } else {
        var n = 0
        while n < c.count && result == DONE && s.told.len == 0 && s.sessions[si].live {
            result = do_action_in(mut s, 0 - 1, si, c.action, c.arg)
            n += 1
        }
    }
    if !s.sessions[si].live { return result }
    if !moves_focus(c.action) {
        let after = focused_slot(s, si)
        if before_focus >= 0 && slot_of(s, before_focus) >= 0 {
            layout.focus_pane(mut s.sessions[si].layout, before_focus) else |_| {}
        }
        layout.select_tab_id(mut s.sessions[si].layout, before_tab) else |_| {}
        focus_moved(mut s, si, after)
    } else if from >= 0 && focused_slot(s, si) != from {
        focus_moved(mut s, si, from)
    }
    layout_changed(mut s, si)
    result
}

// A `-c DIR` read against the directory the COMMAND came from: the
// directory, absolute.
fn command_dir(body: List[byte], dir: str) -> str {
    if dir.starts_with("/") { return dir }
    let from = cwd_field_of(body)
    let base = if from.len > 0 then from else "/"
    if base.ends_with("/") { return base + dir }
    base + "/" + dir
}

// Whether `path` names a directory (a link to one included).
fn is_directory(path: str) -> bool {
    let info = fs.stat(path) else { return false }
    info.kind == 1
}

// Every client attached to session `si` is detached (BYE detached).
fn detach_members(mut s: Server, si: int) {
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].member && s.conns[i].session == si && !s.conns[i].ending {
            terminal(mut s, i, 135, 1, "detached")
        }
        i += 1
    }
}

// Keep a COMMAND to be asked again next turn, once a slot is made (as a
// HELLO is).
fn command_later(mut s: Server, index: int, body: List[byte]) {
    var j = 0
    for b in body {
        if j < s.conns[index].command.len { s.conns[index].command[j] = b } else { (mut s.conns[index].command).push(b) }
        j += 1
    }
    s.conns[index].command_len = body.len
    s.conns[index].command_ready = true
}

fn command_message(mut s: Server, index: int, kind: int, body: List[byte]) {
    if kind == 12 {
        let _p = send(mut s.conns[index], 137, number_payload(u(body, 0, 4)))
        return
    }
    if kind != 11 {
        protocol_error(mut s, index, "wrong role")
        return
    }
    let id = u(body, 0, 4)
    let argv = argv_of(body)
    let verb = if argv.len > 0 then argv[0] else ""
    // One table: the command line's verbs and the server's own (cmd.parse_verb).
    let v = cmd.parse_verb(argv)
    var status = cmd.EXIT_USAGE
    var out = ""
    var err = "warren: {v.why}\n"
    if v.ok && v.kind == cmd.VERB_KILL_SERVER {
        status = 0
        err = ""
        s.conns[index].stop_after = true
    } else if v.ok && v.kind == cmd.VERB_LIST_SESSIONS {
        status = 0
        err = ""
        for x in s.sessions {
            if x.live { out = out + "{name_of(x)}: {x.cols}x{x.rows} ({x.members} attached)\n" }
        }
    } else if v.ok && v.kind == cmd.VERB_LIST_JSON {
        status = 0
        err = ""
        out = cmd.list_json(snapshot(s)) + "\n"
    } else if v.ok && v.kind == cmd.VERB_NEW_SESSION {
        let h = read_hello(s.conns[index].hello[0..s.conns[index].hello_len])
        let name = if v.named then v.name else free_number(s)
        let cols = if h.cols == 0 then 80 else h.cols
        let rows = if h.rows == 0 then 24 else h.rows
        status = cmd.EXIT_REFUSED
        let problem = name_problem(name)
        let start = if v.has_dir then command_dir(body, v.dir) else h.cwd
        if v.has_dir && !is_directory(start) {
            err = "warren: new-session: no such directory: {start}\n"
        } else if problem.len > 0 {
            err = "warren: new-session: {problem}\n"
        } else if find_session(s, name) >= 0 {
            err = "warren: a session named {name} already exists\n"
        } else if cols < MIN_COLS || rows < MIN_ROWS {
            err = "warren: new-session: {cols}x{rows} is smaller than {MIN_COLS}x{MIN_ROWS}\n"
        } else {
            let m = make_session(mut s, name, cols, rows, start, h.names, h.values, 0)
            if m.later {
                command_later(mut s, index, body)
                return
            }
            if m.si < 0 {
                err = "warren: new-session: {m.why}\n"
            } else {
                status = 0
                out = name + "\n"
                err = ""
            }
        }
    } else if v.ok && v.kind == cmd.VERB_CAPTURE {
        status = cmd.EXIT_REFUSED
        let from = cmd.parse_id(pane_field_of(body))
        let caller = if from.kind == cmd.ID_PANE then from.n else 0
        let r = cmd.resolve(snapshot(s), v.target, caller)
        let k = if r.ok then slot_of(s, r.pane) else 0 - 1
        if !r.ok {
            err = if v.target.len > 0 then "warren: {verb}: {r.why}: {v.target}\n" else "warren: {verb}: {r.why}\n"
        } else if k < 0 || !s.panes[k].live {
            err = "warren: {verb}: the pane is gone\n"
        } else {
            let rows = s.panes[k].screen.rows
            // -S: unset is the first live row, `-` history's first; -E: either
            // is the last live row.
            var first = v.start
            if v.start == cmd.LINE_UNSET { first = 0 } else if v.start == cmd.LINE_EDGE { first = 0 - 1099511627776 }
            var last = v.end
            if v.end == cmd.LINE_UNSET || v.end == cmd.LINE_EDGE { last = rows - 1 }
            // A printed capture fits one REPLY (its 8 MiB less the payload's
            // other fields); one kept fits the session's register.
            let cap = if v.print then proto.REPLY_MAX - 13 else REGISTER_BYTES
            var text = List[byte]()
            let n = vt.capture_text(s.panes[k].screen, first, last, v.escapes, v.join, mut text, cap)
            if n < 0 && v.print {
                err = "warren: {verb}: the capture is past the protocol's 8 MiB; narrow it with -S and -E\n"
            } else if n < 0 {
                err = "warren: {verb}: the capture is past the register's {REGISTER_BYTES} bytes; print it with -p\n"
            } else if v.print {
                out = str_from_utf8(text) else ""
                status = 0
                err = ""
            } else {
                // Without -p the capture goes to its session's register, as
                // tmux's goes to a paste buffer: the paste key types it.
                let si = s.panes[k].session
                (mut s.sessions[si].register).reset()
                for x in text { (mut s.sessions[si].register).push(x) }
                status = 0
                err = ""
            }
        }
    } else if v.ok && v.kind == cmd.VERB_SEND_KEYS {
        status = cmd.EXIT_REFUSED
        let from = cmd.parse_id(pane_field_of(body))
        let caller = if from.kind == cmd.ID_PANE then from.n else 0
        let r = cmd.resolve(snapshot(s), v.target, caller)
        let k = if r.ok then slot_of(s, r.pane) else 0 - 1
        if !r.ok {
            err = if v.target.len > 0 then "warren: {verb}: {r.why}: {v.target}\n" else "warren: {verb}: {r.why}\n"
        } else if k < 0 || !s.panes[k].live || s.panes[k].ended {
            err = "warren: {verb}: the pane's program has ended\n"
        } else {
            // Each key as a typed key reaches the pane: in the pane's own
            // mode, past the key table (no prefix, no bindings).
            var data = List[byte]()
            for e in cmd.events_of(v.keys, v.literal) {
                for b in key_bytes(s.panes[k].screen, e.mods, e.kind, e.code) { (mut data).push(b) }
            }
            let room = INPUT_QUEUE - (s.panes[k].in_len - s.panes[k].in_off)
            if data.len > room {
                err = "warren: {verb}: {data.len} bytes do not fit the pane's input queue ({room} of {INPUT_QUEUE} bytes free); nothing was sent\n"
            } else {
                queue_to(mut s, k, data)
                status = 0
                err = ""
            }
        }
    } else if v.ok {
        status = cmd.EXIT_REFUSED
        let a = v.command.action
        if a == config.A_LOCK {
            err = "warren: {verb}: acts on an attached client\n"
        } else {
            let from = cmd.parse_id(pane_field_of(body))
            let caller = if from.kind == cmd.ID_PANE then from.n else 0
            let r = cmd.resolve(snapshot(s), v.target, caller)
            if !r.ok {
                err = if v.target.len > 0 then "warren: {verb}: {r.why}: {v.target}\n" else "warren: {verb}: {r.why}\n"
            } else if a == config.A_DETACH {
                // From a shell there is no client of its own to detach: every
                // client attached to the target's session is.
                detach_members(mut s, session_with_id(s, r.session))
                status = 0
                err = ""
            } else {
                let si = session_with_id(s, r.session)
                let dir = if v.has_dir then command_dir(body, v.dir) else ""
                let start = if dir.len > 0 then dir else new_pane_dir(s, si, slot_of(s, r.pane), a == config.A_SPLIT)
                let missing = if v.argv.len > 0 then program_problem(v.argv[0], start, s.sessions[si].env_names,
                    s.sessions[si].env_values) else ""
                if dir.len > 0 && !is_directory(dir) {
                    err = "warren: {verb}: no such directory: {dir}\n"
                } else if missing.len > 0 {
                    err = "warren: {verb}: the program did not start: {missing}\n"
                } else {
                    // The id the pane a creating verb makes will take.
                    let made = s.next_pane
                    s.hold_stop = true
                    let done = command_action(mut s, si, r.tab, r.pane, v.command, dir, v.argv)
                    s.hold_stop = false
                    if done == LATER {
                        command_later(mut s, index, body)
                        return
                    }
                    if s.told.len > 0 {
                        err = "warren: {verb}: {str_from_utf8(s.told[0..s.told.len]) else ""}\n"
                    } else {
                        status = 0
                        err = ""
                        if (a == config.A_SPLIT || a == config.A_NEW_TAB) && slot_of(s, made) >= 0 {
                            out = cmd.format_id(cmd.ID_PANE, made) + "\n"
                        }
                    }
                }
            }
        }
    }
    let payload = reply_payload(id, status, out, err)
    let wire = reply_wire(payload)
    var ok = true
    if wire.len == 0 {
        status = cmd.EXIT_REFUSED
        ok = send(mut s.conns[index], 136, reply_payload(id, status, "",
            "warren: {verb}: its reply of {payload.len} bytes is past the protocol's 8 MiB\n"))
        trace(s, "conn {index} REPLY of {payload.len} bytes refused: past the protocol's cap")
    } else if fits_queue(s.conns[index], wire) {
        // A turn kept for this connection that its reply no longer needs.
        if s.reply_conn == index && s.reply_gen == s.conns[index].gen { release_reply(mut s) }
        ok = enqueue(mut s.conns[index], wire, false)
        trace(s, "conn {index} REPLY {wire.len} bytes, in its queue")
    } else if s.reply_conn >= 0 && !(s.reply_conn == index && s.reply_gen == s.conns[index].gen) {
        // Another reply holds the buffer: this one is asked again when it is
        // free (the COMMAND is kept as one waiting for a slot is), for at
        // most the reply wait, counted from its first wait.
        command_later(mut s, index, body)
        s.conns[index].command_ready = false
        (mut s.reply_waiters).push(index)
        (mut s.reply_waiter_gens).push(s.conns[index].gen)
        if s.conns[index].deadline == 0 { s.conns[index].deadline = now_ns() + s.reply_wait_ms * 1000000 }
        trace(s, "conn {index} waits for the reply buffer")
        return
    } else if wire.len > s.reply.len && projected(s, wire.len - s.reply.len) > s.budget {
        // The buffer would grow past what the memory budget has room for.
        if s.reply_conn == index && s.reply_gen == s.conns[index].gen { release_reply(mut s) }
        status = cmd.EXIT_REFUSED
        ok = send(mut s.conns[index], 136, reply_payload(id, status, "",
            "warren: {verb}: its reply of {wire.len} bytes would pass the server's memory budget\n"))
        trace(s, "conn {index} REPLY of {wire.len} bytes refused: the memory budget")
    } else {
        var j = 0
        for b in wire {
            if j < s.reply.len { s.reply[j] = b } else { (mut s.reply).push(b) }
            j += 1
        }
        s.reply_len = wire.len
        s.reply_off = 0
        s.reply_conn = index
        s.reply_gen = s.conns[index].gen
        refill_reply(mut s, index)
        trace(s, "conn {index} REPLY {wire.len} bytes, from the reply buffer")
    }
    trace(s, "memory projected {projected(s, 0)}, reply buffer {s.reply.len}")
    s.conns[index].sent_kind = 136
    s.conns[index].sent_code = status
    s.conns[index].phase = DRAINING
    s.conns[index].deadline = now_ns() + DRAIN_MS * 1000000
    if !ok { close_conn(mut s, index, "the REPLY to {verb} could not be queued") }
    if s.conns[index].stop_after || (!ok && v.kind == cmd.VERB_KILL_SERVER) { begin_stop(mut s, "kill-server") }
    if s.stop_owed {
        s.stop_owed = false
        begin_stop(mut s, "the last session ended")
    }
}
/// One complete logical message from a connection.
fn message(mut s: Server, index: int, kind: int, body: List[byte]) {
    let phase = s.conns[index].phase
    if phase == DRAINING { return }
    if phase == ACCEPTED {
        if kind != 1 {
            close_conn(mut s, index, "its first message was not a HELLO (type {kind})")
            return
        }
        let v = proto.hello_version(body)
        if v.code != 0 {
            close_conn(mut s, index, "a HELLO whose magic or versions cannot be read (code {v.code})")
            return
        }
        if v.minimum > 1 || v.maximum < 1 {
            terminal(mut s, index, 130, 1, "no common protocol version")
            return
        }
        let invalid = proto.validate(1, body)
        if invalid != 0 {
            close_conn(mut s, index, "a malformed HELLO (code {invalid})")
            return
        }
        var j = 0
        for b in body {
            if j < s.conns[index].hello.len { s.conns[index].hello[j] = b } else { (mut s.conns[index].hello).push(b) }
            j += 1
        }
        s.conns[index].hello_len = body.len
        s.conns[index].hello_ready = true
        s.conns[index].read_on = false
        if s.conns[index].key >= 0 {
            poll.modify(mut s.w, s.conns[index].key, interest(s.conns[index])) else |_| {}
        }
        return
    }
    if proto.validate(kind, body) != 0 {
        protocol_error(mut s, index, "malformed message")
        return
    }
    if kind == 1 {
        protocol_error(mut s, index, "duplicate hello")
        return
    }
    if phase == ATTACHED {
        attached_message(mut s, index, kind, body)
    } else if phase == COMMANDING {
        command_message(mut s, index, kind, body)
    }
}

/// Parse at most PARSE_BUDGET bytes of complete frames already received;
/// an action waiting for a pane slot holds the client's later input.
fn parse(mut s: Server, index: int) {
    var spent = 0
    while s.conns[index].live && spent < PARSE_BUDGET && !s.conns[index].hello_ready && !s.conns[index].command_ready &&
        s.conns[index].pending == 0 {
        if s.conns[index].phase == DRAINING {
            s.conns[index].rx_off = s.conns[index].rx_len
            return
        }
        let p = next_frame(mut s.conns[index])
        if p.code == proto.SHORT { return }
        if p.code != 0 {
            protocol_error(mut s, index, "bad frame header")
            return
        }
        spent += 6 + p.body.len
        let paste_active = s.conns[index].paste_active
        if p.kind == 4 && (p.flags == 1 || paste_active) {
            // A paste in fragments: same type only, aggregate bounded,
            // decoded once when the last fragment arrives.
            if s.conns[index].paste_len + p.body.len > 65540 {
                protocol_error(mut s, index, "paste too large")
                return
            }
            var j = s.conns[index].paste_len
            for b in p.body {
                if j < s.conns[index].paste.len { s.conns[index].paste[j] = b } else { (mut s.conns[index].paste).push(b) }
                j += 1
            }
            s.conns[index].paste_len = j
            s.conns[index].paste_active = p.flags == 1
            if p.flags == 0 {
                let whole = s.conns[index].paste[0..s.conns[index].paste_len]
                s.conns[index].paste_len = 0
                message(mut s, index, 4, whole)
            }
        } else if paste_active {
            protocol_error(mut s, index, "a message inside a fragment chain")
            return
        } else if p.flags != 0 {
            protocol_error(mut s, index, "fragment of an unfragmented type")
            return
        } else {
            message(mut s, index, p.kind, p.body)
        }
    }
    if s.conns[index].live && next_complete(s.conns[index]) { s.again = true }
}

fn next_complete(c: Conn) -> bool {
    let have = c.rx_len - c.rx_off
    if have < 6 || c.hello_ready || c.command_ready || c.pending != 0 { return false }
    let n = (c.rx[c.rx_off] as int) + (c.rx[c.rx_off + 1] as int) * 256 + (c.rx[c.rx_off + 2] as int) * 65536 + (c.rx[c.rx_off + 3] as int) * 16777216
    have >= 6 + n
}

fn read_conn(mut s: Server, index: int) {
    var sock = socket_of(s.conns[index])
    var end = ""
    let got = net.read_bytes(mut sock, READ_BUDGET) else |e| {
        if "{e}" != "timeout" { end = "{e}" }
        List[byte]()
    }
    if end.len > 0 {
        close_conn(mut s, index, "end of input ({end})")
        return
    }
    if s.conns[index].phase == DRAINING { return }
    take_bytes(mut s.conns[index], got)
    parse(mut s, index)
}

// ---- the configuration file ----

// `$XDG_CONFIG_HOME/warren/warren.toml`, or `~/.config/warren/warren.toml`.
fn settings_path() -> str {
    let xdg = env.get("XDG_CONFIG_HOME") else ""
    if xdg.len > 0 { return xdg + "/warren/warren.toml" }
    let home = env.get("HOME") else ""
    if home.len == 0 { return "" }
    home + "/.config/warren/warren.toml"
}

/// The settings warren.toml makes, read once when the server starts. No file
/// is the defaults; a file that cannot be read or parsed is refused whole.
fn load_settings() -> config.Settings {
    let path = settings_path()
    if path.len == 0 || !fs.exists(path) { return config.default_settings() }
    let text = fs.read_text(path) else |e| {
        var refused = config.default_settings()
        refused.ok = false
        refused.why = "cannot be read: {e}"
        return refused
    }
    config.parse_settings(text)
}

// ---- HELLO, after the frame that carried it ----

fn welcome_conn(mut s: Server, index: int, session: str) -> bool {
    send(mut s.conns[index], 129, welcome(s.conns[index].id, s.pid, session, s.version))
}

/// What a name may hold: compared as bytes, it may not be empty or hold
/// '/' or a control byte. Returns the problem, or "" for a good name.
pub fn name_problem(name: str) -> str {
    if name.len == 0 { return "a session name may not be empty" }
    for b in name.bytes() {
        let v = b as int
        if v == 47 { return "a session name may not hold '/'" }
        if v < 32 || v == 127 { return "a session name may not hold a control byte" }
    }
    ""
}

// What making a session came to: its slot; a refusal (REFUSE code and
// text); or, `later`, a wait for a slot made between turns.
struct Made {
    si: int,
    code: int,
    why: str,
    later: bool,
}

// Make session `name` at cols x rows, its first pane's program started in
// `cwd` with the given environment. `extra` is what the asking connection
// adds to the projected memory beside the pane.
fn make_session(mut s: Server, name: str, cols: int, rows: int, cwd: str, names: List[str], values: List[str],
    extra: int) -> Made {
    let problem = name_problem(name)
    if problem.len > 0 { return Made { si: 0 - 1, code: 6, why: problem, later: false } }
    let area = rows - BAR_LINES
    if s.stopping || live_sessions(s) >= MAX_SESSIONS || !pane_fits(s, cols, area, extra) {
        return Made { si: 0 - 1, code: 7, why: "resource limit", later: false }
    }
    var slot = 0 - 1
    var i = 0
    while i < s.sessions.len {
        if !s.sessions[i].live && slot < 0 { slot = i }
        i += 1
    }
    if slot < 0 {
        s.need_slot = true
        return Made { si: 0 - 1, code: 0, why: "", later: true }
    }
    let k = acquire_pane(mut s, cols, area)
    if k < 0 { return Made { si: 0 - 1, code: 0, why: "", later: true } }
    let id = s.next_pane
    let fresh = layout.new(id, "") else |_| { return Made { si: 0 - 1, code: 6, why: "no layout", later: false } }
    s.next_pane = s.next_pane + 1
    s.sessions[slot].generation = s.sessions[slot].generation + 1
    set_name(mut s.sessions[slot], name)
    s.sessions[slot].cols = cols
    s.sessions[slot].rows = rows
    s.sessions[slot].members = 0
    s.sessions[slot].layout.tabs = copy fresh.tabs
    s.sessions[slot].id = s.next_session
    s.next_session = s.next_session + 1
    // The first tab takes the server's next tab id, not the layout's own 1.
    s.sessions[slot].layout.tabs[0].id = s.next_tab
    s.sessions[slot].layout.active = s.next_tab
    s.sessions[slot].layout.next_id = s.next_tab + 1
    s.next_tab = s.next_tab + 1
    (mut s.sessions[slot].cwd).reset()
    for b in cwd.bytes() { (mut s.sessions[slot].cwd).push(b) }
    (mut s.sessions[slot].env_names).reset()
    (mut s.sessions[slot].env_values).reset()
    (mut s.sessions[slot].mark_tab).reset()
    (mut s.sessions[slot].mark_bits).reset()
    (mut s.sessions[slot].register).reset()
    i = 0
    while i < names.len {
        (mut s.sessions[slot].env_names).push(copy names[i])
        (mut s.sessions[slot].env_values).push(copy values[i])
        i += 1
    }
    s.sessions[slot].layout_gen = s.sessions[slot].layout_gen + 1
    s.sessions[slot].chrome_gen = 0 - 1
    s.sessions[slot].last_output = now_ns()
    let why = spawn_pane(mut s, slot, k, id, cols, area)
    if why.len > 0 {
        return Made { si: 0 - 1, code: 6, why: "the pane's program did not start: {why}", later: false }
    }
    s.sessions[slot].live = true
    sync_sizes(mut s, slot)
    trace(s, "session {slot} created: {name}")
    Made { si: slot, code: 0, why: "", later: false }
}

fn hello(mut s: Server, index: int) {
    let h = read_hello(s.conns[index].hello[0..s.conns[index].hello_len])
    if h.duplicate {
        close_conn(mut s, index, "a HELLO naming one environment variable twice")
        return
    }
    // Defence in depth beside the 0700 directory: a peer of another user
    // is closed silently before anything it sent is used.
    let peer = unix.peer_credentials(net.Socket { fd: s.conns[index].fd }) else |_| {
        unix.Credentials { pid: 0 - 1, uid: s.uid, gid: 0 - 1 }
    }
    if peer.uid != s.uid {
        close_conn(mut s, index, "a peer of uid {peer.uid}, not {s.uid}")
        return
    }
    if h.role == 2 {
        s.conns[index].hello_ready = false
        s.conns[index].read_on = true
        if !welcome_conn(mut s, index, "") {
            close_conn(mut s, index, "the WELCOME could not be queued")
            return
        }
        s.conns[index].phase = COMMANDING
        s.conns[index].deadline = 0
        flush(mut s, index)
        return
    }
    if h.options & 2 != 0 {
        s.conns[index].hello_ready = false
        terminal(mut s, index, 130, 3, "read-only attach is not in this version")
        return
    }
    let name = if h.target.len > 0 then h.target else "default"
    if h.cols < MIN_COLS || h.rows < MIN_ROWS {
        s.conns[index].hello_ready = false
        if !welcome_conn(mut s, index, name) {
            close_conn(mut s, index, "the WELCOME could not be queued")
            return
        }
        terminal(mut s, index, 135, 7, "too small")
        return
    }
    var si = find_session(s, name)
    if si < 0 {
        if h.options & 1 == 0 {
            s.conns[index].hello_ready = false
            terminal(mut s, index, 130, 2, "no session {name}")
            return
        }
        let m = make_session(mut s, name, h.cols, h.rows, h.cwd, h.names, h.values,
            attached_bytes(h.cols, h.rows) - connection_bytes())
        // A new slot (and its emulator) is made between turns; the HELLO
        // is taken again then.
        if m.later { return }
        if m.si < 0 {
            s.conns[index].hello_ready = false
            terminal(mut s, index, 130, m.code, m.why)
            return
        }
        si = m.si
    } else if projected(s, attached_bytes(s.sessions[si].cols, s.sessions[si].rows) - connection_bytes()) > s.budget {
        s.conns[index].hello_ready = false
        terminal(mut s, index, 130, 7, "resource limit")
        return
    }
    s.conns[index].hello_ready = false
    s.conns[index].read_on = true
    if !welcome_conn(mut s, index, name) {
        close_conn(mut s, index, "the WELCOME could not be queued")
        return
    }
    s.conns[index].phase = ATTACHED
    s.conns[index].deadline = 0
    s.conns[index].member = true
    s.conns[index].session = si
    s.conns[index].cols = h.cols
    s.conns[index].rows = h.rows
    s.conns[index].depth = h.depth
    s.conns[index].features = h.features
    s.conns[index].force_full = true
    s.conns[index].shadow.valid = false
    s.conns[index].seen_layout = 0 - 1
    s.conns[index].seen_bar = 0 - 1
    s.sessions[si].members = s.sessions[si].members + 1
    mark_stale(mut s.conns[index], now_ns())
    recompute_size(mut s, si)
    // A warren.toml that did not parse is named to every attaching client.
    if !s.settings.ok {
        let at = if s.settings.line > 0 then " line {s.settings.line}" else ""
        tell(mut s, index, "warren.toml{at}: {s.settings.why}")
    }
    flush(mut s, index)
}

fn shell_argv() -> List[str] {
    var argv = List[str]()
    let custom = env.get("WARREN_PANE_COMMAND") else ""
    if custom.len > 0 {
        for w in custom.split(" ") {
            if w.len > 0 { (mut argv).push(w) }
        }
    }
    argv
}

// ---- panes' masters ----

/// Whether the pane is the focused pane of its session's active tab.
fn is_focused(s: Server, k: int) -> bool {
    let si = s.panes[k].session
    if si < 0 || !s.sessions[si].live { return false }
    focus_id(s, si) == s.panes[k].id
}

/// Whether the pane is in its session's active tab.
fn in_active_tab(s: Server, k: int) -> bool {
    let si = s.panes[k].session
    if si < 0 || !s.sessions[si].live { return false }
    layout.tab_of(s.sessions[si].layout, s.panes[k].id) == s.sessions[si].layout.active
}

fn read_master(mut s: Server, k: int, now: int) {
    var f = master_file(s.panes[k])
    var end = false
    var nothing = false
    let got = fs.read_chunk(mut f, s.master_read) else |e| {
        let n = os_error()
        if "{e}" == "io" && (n == 11 || n == 35) { nothing = true } else { end = true }
        List[byte]()
    }
    let si = s.panes[k].session
    if end {
        trace(s, "pane {k} master ended")
        let key = s.panes[k].key
        forget_key(mut s, key)
        s.panes[k].key = 0 - 1
        close_master(mut s.panes[k])
        if si >= 0 && s.sessions[si].live && s.sessions[si].generation == s.panes[k].session_gen {
            close_pane(mut s, si, k)
        }
        return
    }
    if nothing || got.len == 0 {
        // Ready with nothing to read: whatever it gave is all read.
        s.panes[k].streaming = false
        return
    }
    vt.feed(mut s.panes[k].screen, got)
    s.panes[k].last_output = now
    s.panes[k].read_turn = s.turns
    s.panes[k].streaming = read_streams(got.len, s.master_read, s.panes[k].read_peak)
    if got.len > s.panes[k].read_peak { s.panes[k].read_peak = got.len }
    s.panes[k].damage = s.panes[k].damage + 1
    let answers = vt.take_answers(mut s.panes[k].screen)
    if answers.len > 0 {
        let _q = queue_input(mut s.panes[k], answers)
        write_pane(mut s, k)
    }
    let events = vt.take_events(mut s.panes[k].screen)
    let focused = is_focused(s, k)
    let active = in_active_tab(s, k)
    for ev in events {
        var i = 0
        while i < s.conns.len {
            if s.conns[i].live && s.conns[i].member && s.conns[i].session == si {
                var ok = true
                if ev.kind == 1 && focused {
                    let title = s.panes[k].screen.title_storage[0..s.panes[k].screen.title_length]
                    ok = send_title(mut s.conns[i], title)
                } else if ev.kind == 2 && active {
                    ok = send(mut s.conns[i], 132, List[byte]())
                } else if ev.kind == 4 && ev.payload.len <= 65536 && s.settings.clipboard_programs &&
                        s.conns[i].features & 8 != 0 {
                    // A program's own clipboard write, only when warren.toml allows it.
                    ok = send(mut s.conns[i], 133, bytes_payload(ev.payload))
                }
                if !ok { terminal(mut s, i, 135, 5, "too slow") }
            }
            i += 1
        }
    }
    // Output (and a bell) in a tab that is not shown marks the tab.
    if !active && si >= 0 && s.sessions[si].live && s.sessions[si].generation == s.panes[k].session_gen {
        var bits = MARK_ACTIVITY
        for ev in events {
            if ev.kind == 2 { bits = bits | MARK_BELL }
        }
        let tab = layout.tab_of(s.sessions[si].layout, s.panes[k].id)
        if tab >= 0 { mark_tab(mut s, si, tab, bits) }
    }
    if s.panes[k].screen.mode_values[15] == 1 {
        if s.panes[k].sync_since == 0 { s.panes[k].sync_since = now }
    } else {
        s.panes[k].sync_since = 0
    }
    if s.panes[k].shown && si >= 0 {
        s.sessions[si].last_output = now
        session_changed(mut s, si, now)
    }
}

fn reap(mut s: Server) {
    var n = 0
    while n < 1024 {
        let c = process.poll() else { return }
        if !c.changed { return }
        if !process.is_stopped(c.status) {
            var i = 0
            while i < s.panes.len {
                if s.panes[i].child == c.child.slot && s.panes[i].child_live {
                    s.panes[i].child_live = false
                    s.panes[i].status = c.status.value
                    trace(s, "pane {i} child ended status {c.status.value}")
                }
                i += 1
            }
            i = 0
            while i < s.orphans.len {
                if s.orphans[i] == c.child.slot {
                    s.orphans[i] = 0 - 1
                    trace(s, "a closed pane's child ended status {c.status.value}")
                }
                i += 1
            }
        }
        n += 1
    }
}

/// Panes of an ended session are free once no client is owed its last
/// image.
fn release_held(mut s: Server) {
    var k = 0
    while k < s.panes.len {
        if s.panes[k].live {
            let si = s.panes[k].session
            let gone = si < 0 || !s.sessions[si].live || s.sessions[si].generation != s.panes[k].session_gen
            if gone {
                var owed = false
                for c in s.conns {
                    if c.live && c.ending && c.session == si && c.ending_gen == s.panes[k].session_gen { owed = true }
                }
                if !owed {
                    orphan_child(mut s, k)
                    s.panes[k].live = false
                    s.panes[k].shown = false
                }
            }
        }
        k += 1
    }
}

// ---- frames ----

fn compose_for(mut s: Server, index: int, now: int) {
    let due = frame_due(s, index)
    if due < 0 || due > now { return }
    compose_now(mut s, index, now)
}

// Compose and queue the next image for a client now, whatever the pacing;
// the caller has checked that no image is outstanding.
fn compose_now(mut s: Server, index: int, now: int) {
    let seq = s.conns[index].ack.last_sent + 1
    if seq > SEQ_MAX {
        terminal(mut s, index, 135, 4, "sequence space used: reconnect")
        return
    }
    let si = s.conns[index].session
    ensure_chrome(mut s, si)
    // A window whose pane closed ends scroll mode; a resized pane's window is
    // filled again at its new size, on the same content.
    if s.conns[index].view_slot >= 0 {
        if !view_live(s, index) { set_mode(mut s, index, config.MODE_NORMAL) }
        else if s.conns[index].view_retry >= 0 {
            let retry = s.conns[index].view_retry
            s.conns[index].view_retry = 0 - 1
            view_to(mut s, index, retry)
        } else if s.conns[index].view_back > 0 || found_shown(s, index) {
            let vk = s.conns[index].view_slot
            if s.conns[index].view.cols != s.panes[vk].screen.cols || s.conns[index].view.rows != s.panes[vk].screen.rows {
                let back = view_anchor(mut s, index)
                view_to(mut s, index, back)
            }
        }
    }
    let vslot = if s.conns[index].view_back > 0 || s.conns[index].sel_state == 2 || found_shown(s, index) then s.conns[index].view_slot else 0 - 1
    let full = s.conns[index].force_full
    let gen = s.sessions[si].layout_gen
    let all = s.conns[index].seen_layout != gen
    // What else may have changed: the bar (its generation, or this
    // client's message), and the shown panes whose grids moved.
    var scans = List[int]()
    let area = s.sessions[si].rows - BAR_LINES
    let bar_scan = s.conns[index].seen_bar != s.sessions[si].bar_gen || s.conns[index].message_until != 0
    if bar_scan {
        (mut scans).push(1)
        (mut scans).push(area + 1)
        (mut scans).push(s.sessions[si].cols)
        (mut scans).push(BAR_LINES)
    }
    while s.conns[index].seen_damage.len < s.panes.len { (mut s.conns[index].seen_damage).push(0 - 1) }
    var k = 0
    while k < s.panes.len {
        if s.panes[k].live && s.panes[k].shown && s.panes[k].session == si && s.conns[index].seen_damage[k] != s.panes[k].damage {
            (mut scans).push(s.panes[k].at_col)
            (mut scans).push(s.panes[k].at_row)
            (mut scans).push(s.panes[k].screen.cols)
            (mut scans).push(s.panes[k].screen.rows)
        }
        k += 1
    }
    var cursor = List[int]()
    let f = focused_slot(s, si)
    let mode = s.conns[index].mode
    let prompt = prompt_line(s, index, s.sessions[si].cols)
    if prompt.len > 0 {
        // A prompt's cursor follows its text on the hint line.
        (mut cursor).push(s.sessions[si].rows)
        (mut cursor).push(1 + text_width(prompt))
        (mut cursor).push(0)
        (mut cursor).push(1)
    } else if mode == config.MODE_HELP {
        (mut cursor).push(1)
        (mut cursor).push(1)
        (mut cursor).push(0)
        (mut cursor).push(0)
    } else if f >= 0 && s.panes[f].shown {
        // The pane's cursor is not drawn over a window looking back.
        let (cr, cc, shape, visible) = cursor_of(s.panes[f].screen)
        (mut cursor).push(s.panes[f].at_row + cr - 1)
        (mut cursor).push(s.panes[f].at_col + cc - 1)
        (mut cursor).push(shape)
        (mut cursor).push(if f == vslot then 0 else visible)
    } else {
        (mut cursor).push(1)
        (mut cursor).push(1)
        (mut cursor).push(0)
        (mut cursor).push(0)
    }
    // The client's own cells are made only when a row of theirs is read.
    var bar = List[vt.Cell]()
    var tabbar = TabBar { cells: List[vt.Cell](), hits: List[TabHit]() }
    let whole = full || !s.conns[index].shadow.valid || s.conns[index].shadow.cols != s.sessions[si].cols ||
        s.conns[index].shadow.rows != s.sessions[si].rows
    let paint_bar = whole || all || bar_scan || mode == config.MODE_HELP
    if paint_bar {
        tabbar = tab_bar(s, si)
        bar = bar_cells(s, si, index, now, tabbar.cells)
    }
    var payload = compose_frame(mut s.conns[index].shadow, s.panes, s.sessions[si], bar, s.conns[index].view, vslot, seq,
        full, all, scans, cursor)
    if payload.len == 0 && paint_bar && !drawn_tab_hits_match(s.conns[index].tabs, tabbar.hits, s.sessions[si].cols, area + 1) {
        payload = identity_frame(s.conns[index].shadow, seq)
    }
    s.conns[index].stale = false
    s.conns[index].seen_layout = gen
    s.conns[index].seen_bar = s.sessions[si].bar_gen
    if s.conns[index].message_until != 0 && s.conns[index].message_until <= now { s.conns[index].message_until = 0 }
    var read_turn = 0 - 1
    k = 0
    while k < s.panes.len {
        if s.panes[k].live && s.panes[k].shown && s.panes[k].session == si {
            s.conns[index].seen_damage[k] = s.panes[k].damage
            if s.panes[k].read_turn > read_turn { read_turn = s.panes[k].read_turn }
        }
        k += 1
    }
    if payload.len == 0 { return }
    let wire = frame_wire(payload)
    if wire.len == 0 {
        trace(s, "compose produced an invalid image")
        protocol_error(mut s, index, "server image invalid")
        return
    }
    if paint_bar {
        stage_tab_hits(mut s.conns[index].tabs, tabbar.hits, s.sessions[si].cols, area + 1, seq)
    } else { stage_drawn_tab_hits(mut s.conns[index].tabs, seq) }
    let _q = enqueue(mut s.conns[index], wire, true)
    s.conns[index].image_seq = seq
    s.conns[index].force_full = false
    s.conns[index].last_frame = now
    // The loop counts the frames composed in the turn that read their
    // panes' output: no wait stood between the read and the frame.
    s.frames = s.frames + 1
    if read_turn == s.turns { s.prompt_frames = s.prompt_frames + 1 }
    if s.trace { trace(s, "frame conn {index} seq {seq} turn {s.turns} read-turn {read_turn}") }
    flush(mut s, index)
}

// When the next frame for a client may be composed (monotonic ns), or -1
// (pacing.lu's frame_at): one image outstanding; at most one frame per
// 8 ms; damage at once when every shown pane of the session drained its
// master, else when 8 ms old or the panes are quiet 2 ms; synchronized
// output in a shown pane held up to 150 ms.
fn frame_due(s: Server, index: int) -> int {
    if !s.conns[index].live || s.conns[index].phase != ATTACHED || s.conns[index].session < 0 || s.conns[index].ending { return 0 - 1 }
    if !s.conns[index].stale && !s.conns[index].force_full { return 0 - 1 }
    if s.conns[index].image_end >= 0 || s.conns[index].ack.pending != 0 { return 0 - 1 }
    let si = s.conns[index].session
    var sync_since = 0
    var streaming = false
    for p in s.panes {
        if p.live && p.shown && p.session == si {
            if p.sync_since > 0 && (sync_since == 0 || p.sync_since < sync_since) { sync_since = p.sync_since }
            if p.streaming { streaming = true }
        }
    }
    frame_at(s.conns[index].last_frame, s.conns[index].stale_since, s.sessions[si].last_output, sync_since, streaming,
        s.conns[index].force_full)
}

// ---- the listener ----

fn accept_some(mut s: Server, now: int) {
    var taken = 0
    while taken < ACCEPT_BATCH && s.listening {
        if live_conns(s) >= MAX_CONNECTIONS || pending_conns(s) >= MAX_PENDING { break }
        var slot = 0 - 1
        var i = 0
        while i < s.conns.len {
            if !s.conns[i].live && slot < 0 { slot = i }
            i += 1
        }
        if slot < 0 { break }
        var gone = false
        var sock = net.accept(mut s.place.listener) else |_| {
            gone = true
            net.Socket { fd: 0 - 1 }
        }
        if gone { break }
        net.set_deadline(mut sock, 1) else |_| {}
        s.next_id = s.next_id + 1
        reset_conn(mut s.conns[slot], sock.fd, s.next_id, now)
        s.conns[slot].first_turn = s.turns
        let key = poll.add_socket(mut s.w, sock, poll.READ) else |_| {
            net.close(take sock) else |_| {}
            s.conns[slot].live = false
            break
        }
        s.conns[slot].key = key
        record_key(mut s, key, KEY_CONN, slot, s.conns[slot].gen)
        trace(s, "conn {slot} accepted")
        taken += 1
        // Only one connection is known to be pending per readiness.
        break
    }
    listener_interest(mut s)
}

/// The listener is in the readiness set only while another connection
/// may be accepted; the rest wait in the kernel's backlog.
fn listener_interest(mut s: Server) {
    let room = !s.stopping && live_conns(s) < MAX_CONNECTIONS && pending_conns(s) < MAX_PENDING
    if room && !s.listening {
        let key = poll.add_listener(mut s.w, s.place.listener) else { return }
        s.listen_key = key
        record_key(mut s, key, KEY_LISTENER, 0, 0)
        s.listening = true
    } else if !room && s.listening {
        let key = s.listen_key
        forget_key(mut s, key)
        s.listen_key = 0 - 1
        s.listening = false
    }
}

// ---- stopping ----

fn begin_stop(mut s: Server, why: str) {
    if s.stopping { return }
    trace(s, "stopping: {why}")
    s.stopping = true
    s.stop_deadline = now_ns() + STOPPING_MS * 1000000
    listener_interest(mut s)
    var i = 0
    while i < s.conns.len {
        // A client owed its session's last image keeps it (its BYE follows
        // its ACK or the closing deadline, inside the stopping bound).
        if s.conns[i].live && s.conns[i].phase != DRAINING && !s.conns[i].ending {
            terminal(mut s, i, 135, 3, "server stopping")
        }
        i += 1
    }
    var k = 0
    while k < s.panes.len {
        if s.panes[k].master >= 0 {
            let key = s.panes[k].key
            forget_key(mut s, key)
            s.panes[k].key = 0 - 1
            close_master(mut s.panes[k])
        }
        k += 1
    }
    i = 0
    while i < s.sessions.len {
        s.sessions[i].live = false
        i += 1
    }
}

fn children_live(s: Server) -> bool {
    for p in s.panes {
        if p.child_live { return true }
    }
    for o in s.orphans {
        if o >= 0 { return true }
    }
    false
}

fn done(s: Server, now: int) -> bool {
    if !s.stopping { return false }
    if now >= s.stop_deadline { return true }
    live_conns(s) == 0 && !children_live(s)
}

// ---- timers ----

fn timers(mut s: Server, now: int) {
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].deadline > 0 && now >= s.conns[i].deadline {
            if s.conns[i].ending {
                trace(s, "conn {i} deadline for its last image")
                s.conns[i].ending = false
                s.conns[i].deadline = 0
                terminal(mut s, i, 135, 2, "session ended")
            } else if waits_for_reply(s, i) {
                refuse_waiter(mut s, i)
            } else {
                close_conn(mut s, i, "its deadline passed while {phase_name(s.conns[i].phase)}")
            }
        }
        // A message's time is up: its client's bar is drawn again.
        if s.conns[i].live && s.conns[i].message_until > 0 && now >= s.conns[i].message_until {
            s.conns[i].seen_bar = 0 - 1
            mark_stale(mut s.conns[i], now)
        }
        i += 1
    }
    // The minute moved: every session's line one is drawn again.
    if s.clock_next > 0 && time.unix_ms() >= s.clock_next {
        read_clock(mut s)
        var si = 0
        while si < s.sessions.len {
            if s.sessions[si].live {
                s.sessions[si].bar_gen = s.sessions[si].bar_gen + 1
                session_changed(mut s, si, now)
            }
            si += 1
        }
    }
    if s.lifetime > 0 && now - s.started >= s.lifetime { begin_stop(mut s, "lifetime bound") }
    if !s.stopping && live_sessions(s) == 0 && live_conns(s) == 0 && now - s.idle_since >= IDLE_MS * 1000000 {
        begin_stop(mut s, "no sessions and no clients")
    }
}

/// With no session and no client, the server ends after this long.
pub const IDLE_MS: int = 10000

fn next_deadline_ms(s: Server, now: int) -> int {
    if s.again { return 0 }
    var at = 0 - 1
    var i = 0
    while i < s.conns.len {
        let d = s.conns[i].deadline
        if s.conns[i].live && d > 0 && (at < 0 || d < at) { at = d }
        let m = s.conns[i].message_until
        if s.conns[i].live && m > 0 && (at < 0 || m < at) { at = m }
        let due = frame_due(s, i)
        if due >= 0 && (at < 0 || due < at) { at = due }
        i += 1
    }
    if s.stopping && (at < 0 || s.stop_deadline < at) { at = s.stop_deadline }
    // The clock's next minute, while a session is live.
    if s.clock_next > 0 && live_sessions(s) > 0 {
        let left = s.clock_next - time.unix_ms()
        let tick = now + (if left > 0 then left else 0) * 1000000
        if at < 0 || tick < at { at = tick }
    }
    if s.lifetime > 0 {
        let end = s.started + s.lifetime
        if at < 0 || end < at { at = end }
    }
    if !s.stopping && live_sessions(s) == 0 && live_conns(s) == 0 {
        let idle = s.idle_since + IDLE_MS * 1000000
        if at < 0 || idle < at { at = idle }
    }
    if s.stopping && children_live(s) {
        // Reaping is woken by child(); bound the wait anyway.
        let soon = now + 50000000
        if at < 0 || soon < at { at = soon }
    }
    if at < 0 { return 0 - 1 }
    if at <= now { return 0 }
    (at - now + 999999) / 1000000
}

// ---- the turn ----

fn turn(mut s: Server) -> bool {
    let start = now_ns()
    let deadline = next_deadline_ms(s, start)
    s.again = false
    let ev = poll.wait(mut s.w, listened(), deadline) else |e| {
        trace(s, "wait failed: {e}")
        begin_stop(mut s, "wait failed")
        return !done(s, now_ns())
    }
    let now = now_ns()
    if s.trace && (s.turns < 30 || s.turns % 50000 == 0) {
        var seen = ""
        for r in ev.ready { seen = seen + " {r.key}:{r.facts}" }
        trace(s, "turn {s.turns} deadline {deadline} meaning {ev.meaning} ready{seen}")
    }
    if ev.meaning == signal.child() { reap(mut s) }
    if ev.meaning == signal.terminate() || ev.meaning == signal.interrupt() { begin_stop(mut s, "signal") }
    // Snapshot owners and generations, so an event for a key that a
    // handler in this turn reused is not applied to its new owner.
    var kinds = List[int]()
    var owners = List[int]()
    var gens = List[int]()
    for r in ev.ready {
        let k = r.key
        if k >= 0 && k < s.key_kind.len {
            (mut kinds).push(s.key_kind[k])
            (mut owners).push(s.key_owner[k])
            (mut gens).push(s.key_gen[k])
        } else {
            (mut kinds).push(KEY_NONE)
            (mut owners).push(0 - 1)
            (mut gens).push(0)
        }
    }
    // Masters first, in rotating order; then connections; then the listener.
    var pass = 0
    while pass < 3 {
        var j = 0
        while j < ev.ready.len {
            let at = (j + s.rotate) % ev.ready.len
            let r = copy ev.ready[at]
            let kind = kinds[at]
            let owner = owners[at]
            if pass == 0 && kind == KEY_MASTER && owner >= 0 && owner < s.panes.len && s.panes[owner].live &&
                s.panes[owner].gen == gens[at] && s.panes[owner].key == r.key {
                if r.facts & poll.WRITE != 0 { write_pane(mut s, owner) }
                if r.facts & (poll.READ | poll.HANGUP | poll.ERROR) != 0 && s.panes[owner].live && s.panes[owner].key == r.key {
                    read_master(mut s, owner, now)
                }
            } else if pass == 1 && kind == KEY_CONN && owner >= 0 && s.conns[owner].live &&
                s.conns[owner].gen == gens[at] && s.conns[owner].key == r.key {
                if r.facts & poll.WRITE != 0 { flush(mut s, owner) }
                if s.conns[owner].live && r.facts & (poll.READ | poll.HANGUP | poll.ERROR) != 0 && s.conns[owner].read_on {
                    read_conn(mut s, owner)
                }
            } else if pass == 2 && kind == KEY_LISTENER && s.listening {
                accept_some(mut s, now)
            }
            j += 1
        }
        pass += 1
    }
    s.rotate = s.rotate + 1
    // Actions waiting for a slot, messages already buffered, HELLOs,
    // timers, frames, writes.
    var i = 0
    while i < s.conns.len {
        if s.conns[i].live && s.conns[i].pending != 0 && s.conns[i].phase == ATTACHED {
            let action = s.conns[i].pending
            s.conns[i].pending = 0
            if do_action(mut s, i, action, s.conns[i].pending_arg) == LATER { s.conns[i].pending = action }
        }
        if s.conns[i].live && s.conns[i].hello_ready { hello(mut s, i) }
        if s.conns[i].live && s.conns[i].command_ready {
            s.conns[i].command_ready = false
            let waiting = s.conns[i].command[0..s.conns[i].command_len]
            command_message(mut s, i, 11, waiting)
        }
        if s.conns[i].live && !s.conns[i].hello_ready && next_complete(s.conns[i]) { parse(mut s, i) }
        i += 1
    }
    timers(mut s, now)
    release_held(mut s)
    i = 0
    while i < s.conns.len {
        compose_for(mut s, i, now_ns())
        if s.conns[i].live && queued(s.conns[i]) > 0 && !s.conns[i].write_on { flush(mut s, i) }
        i += 1
    }
    i = 0
    while i < s.panes.len {
        if s.panes[i].live && s.panes[i].in_len > s.panes[i].in_off && !s.panes[i].write_on {
            write_pane(mut s, i)
        }
        i += 1
    }
    if live_sessions(s) > 0 || live_conns(s) > 0 { s.idle_since = now }
    listener_interest(mut s)
    s.turns = s.turns + 1
    !done(s, now_ns())
}

/// Run a server in the foreground until it stops. Exit codes: 0 stopped,
/// 1 a named refusal at start, 0 when another server answers already.
pub fn serve() -> int {
    let inherited = inherited_descriptors()
    let dir = runtime_dir()
    let place = start(dir)
    if place.code == 2 {
        eprint("warren server: {place.reason}")
        return 0
    }
    if place.code != 0 {
        eprint("warren server: cannot start: {place.reason}")
        return 1
    }
    signal.ignore(signal.reload()) else |_| {}
    signal.listen(listened()) else |e| {
        eprint("warren server: cannot listen for signals: {e}")
        finish(take place)
        return 1
    }
    let lifetime_ms = (env.get("WARREN_LIFETIME_MS") else "0").to_int() else 0
    // A measurement override of the per-turn master read (rows compare
    // budgets with it); READ_BUDGET is the server's rule.
    var master_read = (env.get("WARREN_MEASURE_MASTER_READ") else "0").to_int() else 0
    if master_read <= 0 || master_read > READ_BUDGET { master_read = READ_BUDGET }
    // A row's lower memory budget, so that it reaches the refusal without
    // the memory; MEMORY_BUDGET is the server's rule and is never raised.
    var budget = (env.get("WARREN_MEMORY_BUDGET") else "0").to_int() else 0
    if budget <= 0 || budget > MEMORY_BUDGET { budget = MEMORY_BUDGET }
    // A row may shorten the reply buffer's wait, never lengthen it.
    var reply_wait = (env.get("WARREN_REPLY_WAIT_MS") else "0").to_int() else 0
    if reply_wait <= 0 || reply_wait > REPLY_WAIT_MS { reply_wait = REPLY_WAIT_MS }
    var conns = List[Conn]()
    var i = 0
    while i < MAX_CONNECTIONS {
        (mut conns).push(new_conn())
        i += 1
    }
    // The key table: the defaults until the configuration file is read.
    let keys = config.defaults()
    let help = config.help_lines(keys)
    let waiter = poll.open() else |e| {
        eprint("warren server: no readiness set: {e}")
        finish(take place)
        return 1
    }
    let host = machine_name()
    var s = Server {
        place: place, w: waiter, listen_key: 0 - 1, listening: false,
        conns: conns, sessions: List[Session](), panes: List[Pane](), orphans: List[int](), key_kind: List[int](),
        key_owner: List[int](), key_gen: List[int](), next_id: 0, next_pane: 1, next_session: 1, next_tab: 1, told: List[byte](), reply: List[byte](), reply_len: 0, reply_off: 0, reply_conn: 0 - 1, reply_gen: 0,
        reply_waiters: List[int](), reply_waiter_gens: List[int](), reply_wait_ms: reply_wait, hold_stop: false, stop_owed: false, stopping: false, stop_deadline: 0,
        started: now_ns(), idle_since: now_ns(), lifetime: lifetime_ms * 1000000, pid: env.pid(),
        version: vt.package_version(), again: false, need_slot: false, need_pane: false, need_view: false, settings: load_settings(), want_cols: 0,
        want_rows: 0, rotate: 0, trace: env.has("WARREN_TRACE"), turns: 0, frames: 0, prompt_frames: 0,
        master_read: master_read,
        budget: budget, uid: env.euid() else 0 - 1, inherited: inherited, keys: keys, help: help,
        clock_hour: 0, clock_minute: 0, clock_next: 0, host_name: host,
    }
    read_clock(mut s)
    net.set_listener_deadline(mut s.place.listener, 1) else |_| {}
    listener_interest(mut s)
    trace(s, "listening at {s.place.socket}")
    trace(s, "host name '{s.host_name}'")
    var running = true
    while running {
        region scratch {
            running = turn(mut s)
        }
        if s.need_slot && s.sessions.len < MAX_SESSIONS {
            (mut s.sessions).push(idle_session())
            s.again = true
        }
        s.need_slot = false
        if s.need_pane {
            (mut s.panes).push(idle_pane(s.want_cols, s.want_rows))
            s.again = true
        }
        s.need_pane = false
        // A window's buffers grow only here, outside the turn's region: to
        // its session's tab area once attached, so a gesture's first fill in
        // a turn fits; a size asked for in the turn is grown as well.
        var v = 0
        while v < s.conns.len {
            if s.conns[v].live && s.conns[v].member && s.conns[v].session >= 0 {
                let vs = s.conns[v].session
                let area = s.sessions[vs].rows - BAR_LINES
                if area > 0 && !vt.view_fits(s.conns[v].view, s.sessions[vs].cols, area) {
                    vt.reserve_view(mut s.conns[v].view, s.sessions[vs].cols, area)
                }
            }
            if s.need_view && s.conns[v].live && s.conns[v].view_cols > 0 {
                vt.reserve_view(mut s.conns[v].view, s.conns[v].view_cols, s.conns[v].view_rows)
                s.conns[v].view_cols = 0
                s.conns[v].view_rows = 0
                mark_stale(mut s.conns[v], now_ns())
            }
            v += 1
        }
        if s.need_view { s.again = true }
        s.need_view = false
    }
    trace(s, "stopped after {s.turns} turns; {s.prompt_frames} of {s.frames} frames composed in the turn that read their output")
    var k = 0
    while k < s.conns.len {
        close_conn(mut s, k, "the server stopped")
        k += 1
    }
    poll.close(take s.w) else |_| {}
    finish(take s.place)
    0
}
