//! member: false
//! Red-first constructor and ownership rows for the screen grid.
use vt
use std.mem.budget
use std.io

fn test_rectangular() {
    let pane = vt.new(5, 3, 0)
    assert(pane.primary.cells.len == 15, "grid-rectangular")
    assert(pane.alternate.cells.len == 15, "grid-rectangular")
    assert(pane.primary.extents.len == 3 && pane.primary.wrapped.len == 3)
    assert(pane.alternate.extents.len == 3 && pane.alternate.wrapped.len == 3)
    assert(pane.cursor_row == 1 && pane.cursor_col == 1 && !pane.pending_wrap)
    assert(pane.region_top == 1 && pane.region_bottom == 3)
    var i = 0
    while i < 15 {
        assert(pane.primary.cells[i].base == 32 && pane.primary.cells[i].width == 1)
        assert(pane.primary.cells[i].mark1 == 0 && pane.primary.cells[i].mark2 == 0)
        assert(pane.primary.cells[i].flags == 0)
        assert(pane.primary.cells[i].foreground == 0 - 1 && pane.primary.cells[i].background == 0 - 1)
        i += 1
    }
    i = 0
    while i < 3 {
        assert(pane.primary.extents[i] == 0 && !pane.primary.wrapped[i])
        i += 1
    }
}

fn test_tabs_and_ownership() {
    var pane = vt.new(20, 2, 4096)
    assert(pane.tabs.len == 20 && pane.default_tabs)
    var i = 0
    while i < 20 {
        assert(pane.tabs[i] == (i > 0 && i % 8 == 0), "grid-default-tabs")
        i += 1
    }
    pane.primary.cells[0].base = 88
    pane.primary.extents[0] = 1
    assert(pane.alternate.cells[0].base == 32 && pane.alternate.extents[0] == 0, "grid-screen-ownership")
    assert(pane.pen.flags == 0 && pane.modes.autowrap && !pane.modes.origin)
    assert(pane.scrollback_cap_bytes == 4096)
}

fn test_one_row() {
    let pane = vt.new(1, 1, 0)
    assert(pane.primary.cells.len == 1 && pane.alternate.cells.len == 1)
    assert(pane.region_top == 1 && pane.region_bottom == 1, "grid-one-row-region")
    assert(pane.tabs.len == 1 && !pane.tabs[0])
}

fn test_constructor_charge() {
    region small(cap: 16777216) {
        let before = budget.charged(small)
        let pane = vt.new(80, 24, 0)
        let charge = budget.charged(small) - before
        assert(pane.primary.cells.len == 1920 && pane.alternate.cells.len == 1920)
        io.write_line("MEASURE grid-constructor cols=80 rows=24 history-cap=0 charged={charge}")
    }
    region large(cap: 67108864) {
        let before = budget.charged(large)
        let pane = vt.new(320, 90, 0)
        let charge = budget.charged(large) - before
        assert(pane.primary.cells.len == 28800 && pane.alternate.cells.len == 28800)
        io.write_line("MEASURE grid-constructor cols=320 rows=90 history-cap=0 charged={charge}")
    }
}

fn test_ascii_print_and_wrap() {
    var pane = vt.new(4, 2, 0)
    vt.feed(mut pane, "abcd".bytes())
    assert(pane.primary.cells[0].base == 97 && pane.primary.cells[3].base == 100, "grid-ascii-print")
    assert(pane.primary.extents[0] == 4 && pane.cursor_row == 1 && pane.cursor_col == 4 && pane.pending_wrap)
    vt.feed(mut pane, "X".bytes())
    assert(pane.primary.wrapped[0] && pane.primary.cells[4].base == 88)
    assert(pane.primary.extents[1] == 1 && pane.cursor_row == 2 && pane.cursor_col == 2 && !pane.pending_wrap)
    assert(pane.alternate.cells[0].base == 32)
}

fn test_ascii_controls() {
    var pane = vt.new(5, 3, 0)
    vt.feed(mut pane, "ab\rZ".bytes())
    assert(pane.primary.cells[0].base == 90 && pane.primary.cells[1].base == 98)
    assert(pane.primary.extents[0] == 2 && pane.cursor_col == 2)
    vt.feed(mut pane, "\nX".bytes())
    assert(pane.cursor_row == 2 && pane.cursor_col == 3 && pane.primary.cells[6].base == 88)
    var wrap = vt.new(5, 2, 0)
    vt.feed(mut wrap, "abcde\u{8}Z".bytes())
    assert(wrap.primary.cells[3].base == 90 && wrap.primary.cells[4].base == 101)
    assert(wrap.cursor_col == 5 && !wrap.pending_wrap)
    var tabs = vt.new(20, 2, 0)
    vt.feed(mut tabs, "\tX".bytes())
    assert(tabs.primary.cells[8].base == 88 && tabs.cursor_col == 10)
    var tabwrap = vt.new(4, 2, 0)
    vt.feed(mut tabwrap, "abcd\tZ".bytes())
    assert(tabwrap.primary.cells[4].base == 90 && tabwrap.cursor_row == 2)
}

fn test_ascii_scroll_and_one_row() {
    var pane = vt.new(4, 2, 0)
    vt.feed(mut pane, "a\r\nb\r\nc".bytes())
    assert(pane.primary.cells[0].base == 98 && pane.primary.cells[4].base == 99)
    assert(pane.primary.extents[0] == 1 && pane.primary.extents[1] == 1)
    var one = vt.new(2, 1, 0)
    vt.feed(mut one, "a\r\nb".bytes())
    assert(one.region_top == 1 && one.region_bottom == 1)
    assert(one.primary.cells[0].base == 98 && one.primary.cells[1].base == 32)
    assert(one.cursor_row == 1 && one.cursor_col == 2 && !one.pending_wrap)
}

fn test_feed_allocation() {
    region frame(cap: 1048576) {
        var pane = vt.new(4, 2, 0)
        let data = "abcd\r\n".bytes()
        let stable = budget.charged(frame)
        var i = 0
        while i < 2048 { vt.feed(mut pane, data); i += 1 }
        assert(pane.primary.cells[0].base == 97 && pane.primary.extents[0] == 4)
        assert(pane.primary.extents[1] == 0)
        assert(budget.charged(frame) == stable, "grid-feed-allocation")
    }
}

fn test_cursor_sequences() {
    var pane = vt.new(10, 6, 0)
    vt.feed(mut pane, "\u{1b}[5;5H".bytes())
    assert(pane.cursor_row == 5 && pane.cursor_col == 5, "grid-cursor-address")
    vt.feed(mut pane, "\u{1b}[99A\u{1b}[999C".bytes())
    assert(pane.cursor_row == 1 && pane.cursor_col == 10)
    vt.feed(mut pane, "\u{1b}[99B\u{1b}[999D".bytes())
    assert(pane.cursor_row == 6 && pane.cursor_col == 1)
    vt.feed(mut pane, "\u{1b}[0;0f\u{1b}[5a\u{1b}[2e".bytes())
    assert(pane.cursor_row == 3 && pane.cursor_col == 6)
    vt.feed(mut pane, "\u{1b}[2E".bytes())
    assert(pane.cursor_row == 5 && pane.cursor_col == 1)
    vt.feed(mut pane, "\u{1b}[3F\u{1b}[8G\u{1b}[4d".bytes())
    assert(pane.cursor_row == 4 && pane.cursor_col == 8)
    vt.feed(mut pane, "\u{1b}[0`".bytes())
    assert(pane.cursor_col == 1)
    var wrap = vt.new(5, 2, 0)
    vt.feed(mut wrap, "abcde\u{1b}[1;5HZ".bytes())
    assert(wrap.cursor_row == 1 && wrap.primary.cells[4].base == 90)
    vt.feed(mut wrap, "\u{1b}[5 HZ".bytes())
    assert(wrap.cursor_row == 2 && wrap.primary.cells[5].base == 90)
}

fn test_scroll_region_and_origin() {
    var pane = vt.new(10, 6, 0)
    vt.feed(mut pane, "\u{1b}[2;4r".bytes())
    assert(pane.region_top == 2 && pane.region_bottom == 4 && pane.cursor_row == 1)
    vt.feed(mut pane, "\u{1b}[3;3H\u{1b}[99A".bytes())
    assert(pane.cursor_row == 2)
    vt.feed(mut pane, "\u{1b}[99B".bytes())
    assert(pane.cursor_row == 4)
    vt.feed(mut pane, "\u{1b}[1;1H\u{1b}[99B".bytes())
    assert(pane.cursor_row == 6)
    vt.feed(mut pane, "\u{1b}[3;3r".bytes())
    assert(pane.region_top == 2 && pane.region_bottom == 4 && pane.cursor_row == 6)
    pane.modes.origin = true
    vt.feed(mut pane, "\u{1b}[2;99r\u{1b}[99;5H".bytes())
    assert(pane.region_top == 2 && pane.region_bottom == 6 && pane.cursor_row == 6 && pane.cursor_col == 5)
    vt.feed(mut pane, "\u{1b}[0d".bytes())
    assert(pane.cursor_row == 2)
}

fn test_erase_and_pen() {
    var pane = vt.new(5, 2, 0)
    vt.feed(mut pane, "abcde\r\nfghij".bytes())
    pane.pen.flags = 9
    pane.pen.foreground = 1
    pane.pen.background = 5
    assert(pane.primary.cells[0].flags == 0 && pane.primary.cells[0].background == 0 - 1)
    vt.feed(mut pane, "\u{1b}[1;3H\u{1b}[K".bytes())
    assert(pane.primary.extents[0] == 2 && pane.primary.cells[1].base == 98)
    assert(pane.primary.cells[2].base == 32 && pane.primary.cells[2].flags == 0)
    assert(pane.primary.cells[2].foreground == 0 - 1 && pane.primary.cells[2].background == 5)
    assert(pane.cursor_row == 1 && pane.cursor_col == 3 && !pane.pending_wrap)
    vt.feed(mut pane, "\u{1b}[J".bytes())
    assert(pane.primary.extents[1] == 0 && pane.primary.cells[9].background == 5)
    vt.feed(mut pane, "\u{1b}[2J".bytes())
    assert(pane.cursor_row == 1 && pane.cursor_col == 3 && pane.primary.extents[0] == 0)
    vt.feed(mut pane, "\u{1b}[1;1Habcd\u{1b}[1;2H\u{1b}[2X".bytes())
    assert(pane.primary.cells[0].base == 97 && pane.primary.cells[1].base == 32 && pane.primary.cells[3].base == 100)
    assert(pane.primary.extents[0] == 4)
    vt.feed(mut pane, "\u{1b}[1K".bytes())
    assert(pane.primary.cells[0].base == 32 && pane.primary.extents[0] == 4)
}

fn test_sgr_cells() {
    var pane = vt.new(20, 2, 0)
    vt.feed(mut pane, "A\u{1b}[1mB\u{1b}[0;2mC\u{1b}[0;3mD\u{1b}[0;4mE\u{1b}[0;5mF\u{1b}[0;7mG\u{1b}[0;8mH\u{1b}[0;9mI\u{1b}[0;31mJ\u{1b}[0;92mK\u{1b}[0;38;5;196mL\u{1b}[0;48;2;1;2;3mM\u{1b}[0m".bytes())
    assert(pane.primary.cells[1].flags == 1, "grid-sgr-bold")
    assert(pane.primary.cells[2].flags == 2 && pane.primary.cells[3].flags == 4)
    assert(pane.primary.cells[4].flags == 8 && pane.primary.cells[5].flags == 32)
    assert(pane.primary.cells[6].flags == 64 && pane.primary.cells[7].flags == 128 && pane.primary.cells[8].flags == 256)
    assert(pane.primary.cells[9].foreground == 1 && pane.primary.cells[10].foreground == 10)
    assert(pane.primary.cells[11].foreground == 196)
    assert(pane.primary.cells[12].background == 16777216 + 65536 + 512 + 3)
    assert(pane.pen.flags == 0 && pane.pen.foreground == 0 - 1)
}

fn test_sgr_colours_and_divergences() {
    var pane = vt.new(20, 2, 0)
    vt.feed(mut pane, "\u{1b}[38:5:196mX\u{1b}[38:2::1:2:3mY\u{1b}[38:2:4:5:6mZ".bytes())
    assert(pane.primary.cells[0].foreground == 196)
    assert(pane.primary.cells[1].foreground == 16777216 + 65536 + 512 + 3)
    assert(pane.primary.cells[2].foreground == 16777216 + 262144 + 1280 + 6)
    vt.feed(mut pane, "\u{1b}[0;4:3mA\u{1b}[58;2;1;2;3mB\u{1b}[53mC".bytes())
    assert(pane.primary.cells[3].flags == 8 && pane.primary.cells[3].foreground == 0 - 1)
    assert(pane.primary.cells[4].flags == 8 && pane.primary.cells[5].flags == 8)
    vt.feed(mut pane, "\u{1b}[0;38;5mD\u{1b}[38;2;1;2mE\u{1b}[38;2;999;0;0mF".bytes())
    assert(pane.primary.cells[6].foreground == 0)
    assert(pane.primary.cells[7].foreground == 16777216 + 65536 + 512)
    assert(pane.primary.cells[8].foreground == pane.primary.cells[7].foreground)
    vt.feed(mut pane, "\u{1b}[0;38;5;1;1;48;5;2mG".bytes())
    assert(pane.primary.cells[9].flags == 1 && pane.primary.cells[9].foreground == 1 && pane.primary.cells[9].background == 2)
}

fn test_sgr_resets_and_wrap() {
    var pane = vt.new(20, 2, 0)
    vt.feed(mut pane, "\u{1b}[1;2;3;4;5;7;8;9m\u{1b}[22;23;24;25;27;28;29mX\u{1b}[21mY\u{1b}[24mZ".bytes())
    assert(pane.primary.cells[0].flags == 0 && pane.primary.cells[1].flags == 16 && pane.primary.cells[2].flags == 0)
    var wrap = vt.new(5, 2, 0)
    vt.feed(mut wrap, "abcde\u{1b}[1mZ".bytes())
    assert(wrap.cursor_row == 2 && wrap.primary.cells[5].flags == 1)
    vt.feed(mut wrap, "\u{1b}[>4;2mQ".bytes())
    assert(wrap.primary.cells[6].flags == 1)
    var underline = vt.new(8, 2, 0)
    vt.feed(mut underline, "\u{1b}[4mA\u{1b}[21mB\u{1b}[4mC\u{1b}[4:0mD".bytes())
    assert(underline.primary.cells[0].flags == 8 && underline.primary.cells[1].flags == 16, "grid-underline-exclusive")
    assert(underline.primary.cells[2].flags == 8 && underline.primary.cells[3].flags == 0)
}

fn test_insert_delete_characters() {
    var pane = vt.new(10, 3, 0)
    vt.feed(mut pane, "abcdefgh\u{1b}[1;3H\u{1b}[46m\u{1b}[2@".bytes())
    assert(pane.primary.cells[2].base == 32 && pane.primary.cells[3].base == 32, "grid-ich")
    assert(pane.primary.cells[2].background == 6 && pane.primary.cells[4].base == 99)
    assert(pane.primary.extents[0] == 10 && pane.cursor_col == 3 && !pane.pending_wrap)
    vt.feed(mut pane, "\u{1b}[1;8H\u{1b}[P".bytes())
    assert(pane.primary.cells[7].base == 103 && pane.primary.cells[8].base == 104 && pane.primary.cells[9].base == 32)
    assert(pane.primary.cells[9].background == 6 && pane.primary.extents[0] == 9)
    var insert = vt.new(8, 2, 0)
    vt.feed(mut insert, "abc\u{1b}[1;1H\u{1b}[4h\u{1b}[31mXY".bytes())
    assert(insert.primary.cells[0].base == 88 && insert.primary.cells[1].base == 89 && insert.primary.cells[2].base == 97)
    assert(insert.primary.cells[0].foreground == 1 && insert.primary.cells[2].foreground == 0 - 1)
    assert(insert.primary.extents[0] == 5 && insert.cursor_col == 3)
}

fn test_insert_delete_lines() {
    var pane = vt.new(5, 4, 0)
    vt.feed(mut pane, "1\r\n2\r\n3\r\n4\u{1b}[2;4r\u{1b}[2;3H\u{1b}[44m\u{1b}[L".bytes())
    assert(pane.primary.cells[0].base == 49 && pane.primary.cells[5].base == 32)
    assert(pane.primary.cells[10].base == 50 && pane.primary.cells[15].base == 51)
    assert(pane.primary.extents[1] == 0 && pane.primary.cells[5].background == 4)
    assert(pane.cursor_row == 2 && pane.cursor_col == 1)
    vt.feed(mut pane, "\u{1b}[3;4H\u{1b}[M".bytes())
    assert(pane.primary.cells[10].base == 51 && pane.primary.cells[15].base == 32 && pane.primary.extents[3] == 0)
    assert(pane.cursor_row == 3 && pane.cursor_col == 1)
    vt.feed(mut pane, "\u{1b}[1;4H\u{1b}[L".bytes())
    assert(pane.cursor_row == 1 && pane.cursor_col == 4 && pane.primary.cells[0].base == 49)
}

fn main() -> int {
    test_rectangular()
    test_tabs_and_ownership()
    test_one_row()
    test_ascii_print_and_wrap()
    test_ascii_controls()
    test_ascii_scroll_and_one_row()
    test_cursor_sequences()
    test_scroll_region_and_origin()
    test_erase_and_pen()
    test_sgr_cells()
    test_sgr_colours_and_divergences()
    test_sgr_resets_and_wrap()
    test_insert_delete_characters()
    test_insert_delete_lines()
    test_feed_allocation()
    test_constructor_charge()
    0
}
