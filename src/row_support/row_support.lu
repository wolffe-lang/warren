//! member: true
//! Pure bar predicates shared by test entries, not the terminal client.

/// Count a fixture's default numbered tab labels, or -1 for a malformed
/// bar. Session and labels are read only from the caller's tab-area slice.
pub fn default_tab_count(line: str, session: str) -> int {
    let tokens = line.words()
    if tokens.len < 2 || tokens[0] != session { return 0 - 1 }
    var n = 1
    while n < tokens.len {
        if tokens[n] != "{n}" { return 0 - 1 }
        n += 1
    }
    n - 1
}

/// Exact cardinality, never a prefix or "at least" predicate.
pub fn default_tabs_are(line: str, session: str, count: int) -> bool {
    count > 0 && default_tab_count(line, session) == count
}
