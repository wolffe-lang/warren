//! member: false
//! Session rows: a scripted client drives a real server over its socket.
//! Each row starts its own server in its own runtime directory (under the
//! working directory), with a lifetime bound so that no server outlives
//! its row, and ends it with the kill-server command.
//!
//!   session_rows WARREN [ROW...]
//!
//! `close-causes`, `prompt-frame` and `prompt-frame-minute` read the
//! server's trace (WARREN_TRACE, its standard error kept in a file): every
//! close names its cause, and every echo is composed in the turn that read
//! it, the minute's redraw of line one included.
//!
//! Prints `PASS <row>` or `FAIL <row> <why>` per row, then
//! `SESSION-ROWS rows=N failed=M`; exits 1 when any row is red.
use std.env
use std.fs
use std.json
use std.net
use std.net.unix
use std.process
use std.signal
use std.sort
use std.str
use std.term
use std.time
use client
use proto
use server

struct Rig {
    warren: str,
    dir: str,
    server: int,
    started: bool,
}

fn now_ms() -> int {
    time.monotonic_ns() / 1000000
}

fn rig(warren: str, row: str) -> Rig {
    Rig { warren: warren, dir: "rt-" + row, server: 0 - 1, started: false }
}

fn socket(r: Rig) -> str {
    r.dir + "/default"
}

/// Start a server for the row, its environment and runtime directory set
/// before the spawn; wait until its socket answers (bounded).
fn start_server(mut r: Rig, pane_command: str) -> str {
    start_bounded(mut r, pane_command, 60000)
}

fn start_bounded(mut r: Rig, pane_command: str, lifetime_ms: int) -> str {
    start_traced(mut r, pane_command, lifetime_ms, "")
}

/// As start_bounded; with a `trace` path, the server runs with WARREN_TRACE
/// and its standard error goes to that file.
fn start_traced(mut r: Rig, pane_command: str, lifetime_ms: int, trace: str) -> str {
    fs.remove_dir_all(r.dir) else |_| {}
    env.set("WARREN_RUNTIME_DIR", r.dir) else { return "env" }
    env.set("WARREN_LIFETIME_MS", "{lifetime_ms}") else { return "env" }
    env.set("WARREN_PANE_COMMAND", pane_command) else { return "env" }
    var c = process.command(r.warren)
    process.push_arg(mut c, "server")
    if trace.len > 0 {
        env.set("WARREN_TRACE", "1") else { return "env" }
        let f = fs.create(trace) else |e| { return "trace-file-{e}" }
        process.set_stderr(mut c, f)
    }
    var failed = ""
    let ch = process.start(c) else |e| {
        failed = "server-start-{e}"
        process.Child { slot: 0 - 1 }
    }
    if trace.len > 0 { env.unset("WARREN_TRACE") else |_| {} }
    if failed.len > 0 { return failed }
    r.server = ch.slot
    r.started = true
    let until = now_ms() + 5000
    while now_ms() < until {
        var s = unix.connect(socket(r)) else |_| {
            time.sleep(time.millis(10))
            continue
        }
        net.close(take s) else |_| {}
        return ""
    }
    "server-never-answered"
}

/// Ask the server to stop and wait for it (bounded by its lifetime).
fn stop_server(mut r: Rig) -> int {
    if !r.started { return 0 - 1 }
    var p = client.dial(socket(r)) else |_| {
        var ch = process.Child { slot: r.server }
        r.started = false
        return process.wait_status(take ch) else 0 - 1
    }
    var argv = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", argv, argv))
    let _w = client.until_kind(mut p, 129, 2000)
    var b = List[byte]()
    proto.put(mut b, 1, 4)
    proto.put(mut b, 1, 2)
    proto.put_text(mut b, "kill-server")
    proto.put_text(mut b, "")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    let _r = client.until_kind(mut p, 136, 2000)
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    process.wait_status(take ch) else 0 - 1
}

fn env_names() -> List[str] {
    var n = List[str]()
    (mut n).push("PS1")
    (mut n).push("PATH")
    (mut n).push("HOME")
    n
}

fn env_values() -> List[str] {
    var v = List[str]()
    (mut v).push("$ ")
    (mut v).push(env.get("PATH") else "/bin:/usr/bin")
    (mut v).push(env.get("HOME") else "/")
    v
}

fn attach(r: Rig, cols: int, rows: int, target: str, options: int) -> client.Peer ! client.DialErrors {
    var p = client.dial(socket(r))?
    let here = env.cwd() else "/"
    let _h = client.send(p, 1, client.hello_payload(1, cols, rows, target, options, here, env_names(), env_values()))
    p
}

// ---------------- rows ----------------

fn row_echo(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 129, 3000) { return "no WELCOME" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt: " + client.screen_text(p) }
    let _i = client.input(p, "echo warren-$((6*7))\r")
    if !client.until_text(mut p, "warren-42", 5000) { return "no echo: " + client.screen_text(p) }
    if p.full_frames != 1 { return "full images {p.full_frames}, expected 1" }
    if p.last_base == 0 { return "the last image was full, expected a delta" }
    if p.image.cols != 80 || p.image.rows != 24 { return "image {p.image.cols}x{p.image.rows}" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_split_every_byte(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = client.dial(socket(r)) else |e| { return "dial-{e}" }
    let here = env.cwd() else "/"
    let hello = proto.encode(1, 0, client.hello_payload(1, 80, 24, "", 1, here, env_names(), env_values()))
    var i = 0
    while i < hello.bytes.len {
        var one = List[byte]()
        (mut one).push(hello.bytes[i])
        if !client.send_raw(p, one) { return "write {i}" }
        i = i + 1
    }
    if !client.until_text(mut p, "$", 5000) { return "no prompt after a byte-at-a-time HELLO" }
    var b = List[byte]()
    proto.put_bytes(mut b, "echo split-ok\r".bytes())
    let input = proto.encode(7, 0, b)
    i = 0
    while i < input.bytes.len {
        var one = List[byte]()
        (mut one).push(input.bytes[i])
        let _w = client.send_raw(p, one)
        i = i + 1
    }
    if !client.until_text(mut p, "split-ok", 5000) { return "no echo after a byte-at-a-time INPUT" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn closed_silently(mut p: client.Peer) -> str {
    let m = client.next(mut p, 3000)
    if m.kind != 0 { return "a message of kind {m.kind}" }
    if m.code != 1 { return "not closed (code {m.code})" }
    ""
}

fn row_bad_first(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    // A first message that is not HELLO, then a HELLO with bad magic.
    var p = client.dial(socket(r)) else |e| { return "dial-{e}" }
    var k = List[byte]()
    proto.put(mut k, 0, 1)
    proto.put(mut k, 0, 1)
    proto.put(mut k, 97, 4)
    let _s = client.send(p, 2, k)
    let a = closed_silently(mut p)
    if a.len > 0 { return "non-HELLO first: " + a }
    client.hang_up(mut p)
    var q = client.dial(socket(r)) else |e| { return "dial-{e}" }
    var bad = List[byte]()
    for b in "WRX\u{0}".bytes() { (mut bad).push(b) }
    proto.put(mut bad, 1, 2)
    proto.put(mut bad, 1, 2)
    let raw = proto.encode_part(1, 0, bad)
    let _t = client.send_raw(q, raw.bytes)
    let b2 = closed_silently(mut q)
    if b2.len > 0 { return "bad magic: " + b2 }
    client.hang_up(mut q)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn refusal(mut p: client.Peer) -> int {
    if !client.until_kind(mut p, 130, 3000) { return 0 - 1 }
    p.end_code
}

fn row_refusals(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    // No common version: REFUSE 1 in v1's encoding, before the suffix.
    var p = client.dial(socket(r)) else |e| { return "dial-{e}" }
    var v = List[byte]()
    for b in "WRN\u{0}".bytes() { (mut v).push(b) }
    proto.put(mut v, 2, 2)
    proto.put(mut v, 3, 2)
    let raw = proto.encode_part(1, 0, v)
    let _t = client.send_raw(p, raw.bytes)
    let c1 = refusal(mut p)
    if c1 != 1 { return "version refusal {c1}" }
    client.hang_up(mut p)
    var q = attach(r, 80, 24, "missing", 0) else |e| { return "dial-{e}" }
    let c2 = refusal(mut q)
    if c2 != 2 { return "no-session refusal {c2}" }
    client.hang_up(mut q)
    var ro = attach(r, 80, 24, "", 3) else |e| { return "dial-{e}" }
    let c3 = refusal(mut ro)
    if c3 != 3 { return "read-only refusal {c3}" }
    client.hang_up(mut ro)
    // No session is made under a name holding '/' or a control byte.
    for bad in "x/y|a\u{1}b".split("|") {
        var n = attach(r, 80, 24, bad, 1) else |e| { return "dial-{e}" }
        let c5 = refusal(mut n)
        if c5 != 6 { return "a session named '{bad}' was not refused as invalid ({c5})" }
        client.hang_up(mut n)
    }
    // Too small: WELCOME, then BYE 7, and no session is created.
    var small = attach(r, 19, 6, "tiny", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut small, 129, 3000) { return "too small: no WELCOME" }
    if !client.until_kind(mut small, 135, 3000) || small.end_code != 7 { return "too small: BYE {small.end_code}" }
    client.hang_up(mut small)
    var check = attach(r, 80, 24, "tiny", 0) else |e| { return "dial-{e}" }
    let c4 = refusal(mut check)
    if c4 != 2 { return "a too-small attach created a session ({c4})" }
    client.hang_up(mut check)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_hello_timeout(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = client.dial(socket(r)) else |e| { return "dial-{e}" }
    let t0 = now_ms()
    let m = client.next(mut p, 8000)
    let t = now_ms() - t0
    if m.kind != 0 || m.code != 1 { return "expected a silent close, got kind {m.kind} code {m.code}" }
    if t < 4500 || t > 7500 { return "closed after {t} ms, expected about 5000" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_future_ack(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt" }
    // A stale ACK (already acknowledged) is ignored.
    var stale = List[byte]()
    proto.put(mut stale, 1, 4)
    let _s = client.send(p, 8, stale)
    let _i = client.input(p, "echo still-here\r")
    if !client.until_text(mut p, "still-here", 5000) { return "a stale ACK was not ignored" }
    // An ACK of an image never sent is a protocol error.
    var future = List[byte]()
    proto.put(mut future, p.image.seq + 1000, 4)
    let _f = client.send(p, 8, future)
    if !client.until_kind(mut p, 135, 3000) || p.end_code != 6 { return "future ACK: BYE {p.end_code}" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_fragment_interleave(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt" }
    // A PASTE's first fragment, then a PING inside the chain.
    var part = List[byte]()
    proto.put(mut part, 5, 4)
    for b in "ab".bytes() { (mut part).push(b) }
    let first = proto.encode_part(4, 1, part)
    let _a = client.send_raw(p, first.bytes)
    var ping = List[byte]()
    proto.put(mut ping, 7, 4)
    let _b = client.send(p, 12, ping)
    if !client.until_kind(mut p, 135, 3000) || p.end_code != 6 { return "BYE {p.end_code}, expected 6" }
    client.hang_up(mut p)
    // A paste in two fragments arrives whole.
    var q = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut q, "$", 5000) { return "no prompt (second client)" }
    var head = List[byte]()
    proto.put(mut head, 18, 4)
    for b in "echo frag".bytes() { (mut head).push(b) }
    var tail = List[byte]()
    for b in "ment-ok\r\n".bytes() { (mut tail).push(b) }
    let _c = client.send_raw(q, proto.encode_part(4, 1, head).bytes)
    let _d = client.send_raw(q, proto.encode_part(4, 0, tail).bytes)
    if !client.until_text(mut q, "fragment-ok", 5000) { return "a fragmented paste did not arrive whole" }
    client.hang_up(mut q)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_two_sizes(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 100, 30, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    var b = attach(r, 80, 40, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut b, 131, 3000) { return "second client: no image" }
    if b.image.cols != 80 || b.image.rows != 30 { return "session {b.image.cols}x{b.image.rows}, expected 80x30" }
    let _w = client.until_kind(mut a, 131, 3000)
    let _x = client.until_kind(mut a, 131, 500)
    if a.image.cols != 80 || a.image.rows != 30 { return "first client {a.image.cols}x{a.image.rows}" }
    // The second leaves: the session returns to the first client's size.
    client.hang_up(mut b)
    var n = 0
    while n < 20 && (a.image.cols != 100 || a.image.rows != 30) {
        let _k = client.step(mut a, 250)
        n = n + 1
    }
    if a.image.cols != 100 || a.image.rows != 30 { return "after leaving {a.image.cols}x{a.image.rows}" }
    // The pane's program reads its size with this program's own helper
    // mode (a host's stty may not report one).
    let _i = client.input(a, "{self_path()} --print-size\r")
    if !client.until_text(mut a, "28 100", 5000) { return "the pane did not hear its size (30 rows less the two bar lines): " + client.screen_text(a) }
    client.hang_up(mut a)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_never_ack(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var lazy = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    lazy.auto_ack = false
    if !client.until_kind(mut lazy, 131, 3000) { return "no first image" }
    var busy = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut busy, "$", 5000) { return "no prompt" }
    var i = 0
    while i < 5 {
        let _i = client.input(busy, "echo round-{i}\r")
        if !client.until_text(mut busy, "round-{i}", 5000) { return "the active client stalled at round {i}" }
        i = i + 1
    }
    // The client that never ACKs holds one image only.
    var more = 0
    while client.step(mut lazy, 300) > 0 {
        if lazy.frames > 1 { more = more + 1 }
    }
    if lazy.frames != 1 { return "a never-ACK client got {lazy.frames} images" }
    client.hang_up(mut lazy)
    client.hang_up(mut busy)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_detach_reattach(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let _i = client.input(a, "echo kept-across-detach\r")
    if !client.until_text(mut a, "kept-across-detach", 5000) { return "no echo" }
    // Ctrl-Space then d: the server's own detach binding.
    let _p = client.key(a, 4, 0, 32)
    let _d = client.key(a, 0, 0, 100)
    if !client.until_kind(mut a, 135, 3000) || a.end_code != 1 { return "detach: BYE {a.end_code}" }
    client.hang_up(mut a)
    var b = attach(r, 80, 24, "work", 0) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "kept-across-detach", 5000) { return "the session did not keep its screen" }
    let _x = client.send(b, 10, List[byte]())
    if !client.until_kind(mut b, 135, 3000) || b.end_code != 1 { return "DETACH: BYE {b.end_code}" }
    client.hang_up(mut b)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_ctrl_c(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt" }
    let _i = client.input(p, "sleep 30; echo slept-$((1+1))\r")
    time.sleep(time.millis(300))
    // Ctrl-C is the byte 03 into the pty, never a signal from the server.
    let _c = client.key(p, 4, 0, 99)
    let _e = client.input(p, "echo after-$((40+2))\r")
    // Typed after the Ctrl-C, it answers long before the sleep's 30 s.
    if !client.until_text(mut p, "after-42", 5000) { return "Ctrl-C did not end the foreground command: " + client.screen_text(p) }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_session_end(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt" }
    let _i = client.input(p, "exit\r")
    if !client.until_kind(mut p, 135, 5000) || p.end_code != 2 { return "BYE {p.end_code}, expected session-ended" }
    client.hang_up(mut p)
    // The last session ended: the server stops by itself.
    var ch = process.Child { slot: r.server }
    r.started = false
    let st = process.wait_status(take ch) else 0 - 1
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_command(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "listed", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    var p = client.dial(socket(r)) else |e| { return "dial-{e}" }
    var none = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", none, none))
    if !client.until_kind(mut p, 129, 2000) { return "command: no WELCOME" }
    var b = List[byte]()
    proto.put(mut b, 9, 4)
    proto.put(mut b, 1, 2)
    proto.put_text(mut b, "list-sessions")
    proto.put_text(mut b, "")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    let m = client.next(mut p, 3000)
    if m.kind != 136 { return "no REPLY ({m.kind})" }
    let out_len = (m.body[5] as int) + (m.body[6] as int) * 256 + (m.body[7] as int) * 65536
    let out = str_from_utf8(m.body[9..9 + out_len]) else ""
    if !out.contains("listed: 80x24 (1 attached)") { return "list-sessions said {out}" }
    client.hang_up(mut p)
    // kill-server: every attached client hears server-stopping.
    let st = stop_server(mut r)
    if !client.until_kind(mut a, 135, 3000) || a.end_code != 3 { return "attached: BYE {a.end_code}" }
    client.hang_up(mut a)
    if st != 0 { return "server exit {st}" }
    ""
}

// ---- the command client's verbs: ids, targets, the shared table, list --json ----

// A command's answer: its status (0 - 1 when none came), standard output, standard error.
struct Answer { status: int, out: str, err: str }

fn le4(body: List[byte], at: int) -> int {
    (body[at] as int) + (body[at + 1] as int) * 256 + (body[at + 2] as int) * 65536 + (body[at + 3] as int) * 16777216
}

// One COMMAND on the row's server: `argv` (words), sent from pane `pane`
// ("" when it comes from no pane), as `warren <verb>` sends it.
fn ask(r: Rig, argv: str, pane: str) -> Answer {
    var words = List[str]()
    for w in argv.split(" ") {
        if w.len > 0 { (mut words).push(w) }
    }
    ask_words(r, words, pane)
}

// One COMMAND whose words are given one by one (a word may hold spaces).
fn ask_words(r: Rig, words: List[str], pane: str) -> Answer {
    var p = client.dial(socket(r)) else |e| { return Answer { status: 0 - 1, out: "", err: "dial-{e}" } }
    var none = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", none, none))
    if !client.until_kind(mut p, 129, 2000) {
        client.hang_up(mut p)
        return Answer { status: 0 - 1, out: "", err: "no WELCOME" }
    }
    var b = List[byte]()
    proto.put(mut b, 9, 4)
    proto.put(mut b, words.len, 2)
    for w in words { proto.put_text(mut b, w) }
    proto.put_text(mut b, "/")
    proto.put_text(mut b, pane)
    let _c = client.send(p, 11, b)
    let m = client.next(mut p, 3000)
    client.hang_up(mut p)
    if m.kind != 136 { return Answer { status: 0 - 1, out: "", err: "no REPLY ({m.kind})" } }
    let out_len = le4(m.body, 5)
    let err_len = le4(m.body, 9 + out_len)
    Answer { status: m.body[4] as int, out: str_from_utf8(m.body[9..9 + out_len]) else "",
        err: str_from_utf8(m.body[13 + out_len..13 + out_len + err_len]) else "" }
}

// `list --json`'s line, or a reason it is not there.
fn listed(r: Rig) -> Answer {
    let a = ask(r, "list --json", "")
    if a.status != 0 { return Answer { status: a.status, out: "", err: "list --json status {a.status}: {a.err.trim()}" } }
    a
}

// A listing with every pane's pid written as N (pids differ run to run).
fn without_pids(json: str) -> str {
    var out = ""
    var rest = json.trim()
    while rest.len > 0 {
        let at = rest.find("\"pid\":") else {
            out = out + rest
            break
        }
        out = out + rest[0..at + 6] + "N"
        var k = at + 6
        while k < rest.len && (rest.bytes()[k] as int) != 44 && (rest.bytes()[k] as int) != 125 { k += 1 }
        rest = rest[k..]
    }
    out
}

// How many panes a listing holds.
fn panes_in(json: str) -> int {
    json.split("\"id\":\"p").len - 1
}

// A split from outside, named by the session: the session's focused pane
// is split, and the focus stays where it was.
fn row_verb_split_target(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let before = listed(r)
    if before.status != 0 { return before.err }
    if panes_in(before.out) != 1 { return "panes before: {before.out}" }
    let s = ask(r, "split-right -t work", "")
    if s.status != 0 { return "split-right -t work status {s.status}: {s.err.trim()}" }
    let after = listed(r)
    if after.status != 0 { return after.err }
    if panes_in(after.out) != 2 { return "panes after: {after.out}" }
    if !after.out.contains("\"focus\":\"p1\"") { return "the focus moved: {after.out}" }
    client.hang_up(mut a)
    ""
}

// A target that names nothing is refused by name, exit status 1, and
// nothing changes.
fn row_verb_refused_target(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s = ask(r, "split-right -t nosuch", "")
    if s.status != 1 || !s.err.contains("no-such-session") { return "split-right -t nosuch: {s.status} '{s.err.trim()}'" }
    let t = ask(r, "split-right -t work:9", "")
    if t.status != 1 || !t.err.contains("no-such-tab") { return "split-right -t work:9: {t.status} '{t.err.trim()}'" }
    let after = listed(r)
    if after.status != 0 { return after.err }
    if panes_in(after.out) != 1 { return "a refused verb changed the session: {after.out}" }
    client.hang_up(mut a)
    ""
}

// A verb with no -t acts on the pane it was sent from: the server-side
// field, then the real command client typed into the pane's shell, which
// sends its WARREN_PANE.
fn row_verb_inside_pane(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s = ask(r, "split-down", "%1")
    if s.status != 0 { return "split-down from %1: {s.status} '{s.err.trim()}'" }
    let two = listed(r)
    if two.status != 0 { return two.err }
    if panes_in(two.out) != 2 { return "panes after a split from %1: {two.out}" }
    let here = env.cwd() else "."
    let _i = client.input(a, "WARREN_RUNTIME_DIR={here}/{r.dir} {r.warren} split-right; echo rc=$?\r")
    if !client.until_text(mut a, "rc=", 8000) { return "the client in the pane said nothing: " + client.screen_text(a) }
    if !client.until_text(mut a, "rc=0", 3000) { return "the client in the pane: " + client.screen_text(a) }
    let three = listed(r)
    if three.status != 0 { return three.err }
    if panes_in(three.out) != 3 { return "panes after a split from inside: {three.out}" }
    client.hang_up(mut a)
    ""
}

// list --json, schema 1, on a live server: two sessions in id order, each
// pane's place and size inside the tab area (the bar takes two lines).
fn row_list_json(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "one", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    var b = attach(r, 100, 30, "two", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "$", 5000) { return "no prompt in two" }
    let l = listed(r)
    if l.status != 0 { return l.err }
    let want = "{{\"schema\":1,\"sessions\":[{{\"id\":\"s1\",\"name\":\"one\",\"cols\":80,\"rows\":24,\"clients\":1,\"active_tab\":\"t1\",\"tabs\":[{{\"id\":\"t1\",\"name\":\"\",\"index\":1,\"focus\":\"p1\",\"zoomed\":false,\"panes\":[{{\"id\":\"p1\",\"index\":1,\"col\":1,\"row\":1,\"cols\":80,\"rows\":22,\"pid\":N,\"title\":\"\"}}]}}]}},{{\"id\":\"s2\",\"name\":\"two\",\"cols\":100,\"rows\":30,\"clients\":1,\"active_tab\":\"t2\",\"tabs\":[{{\"id\":\"t2\",\"name\":\"\",\"index\":1,\"focus\":\"p2\",\"zoomed\":false,\"panes\":[{{\"id\":\"p2\",\"index\":1,\"col\":1,\"row\":1,\"cols\":100,\"rows\":28,\"pid\":N,\"title\":\"\"}}]}}]}}]}}"
    let got = without_pids(l.out)
    if got != want { return "listing: {got}" }
    if !l.out.ends_with("\n") { return "the listing does not end its line" }
    client.hang_up(mut a)
    client.hang_up(mut b)
    ""
}

// The JSON of one title of 4,094 double quotes, each escaped.
fn quoted_title_json() -> str {
    var b = List[byte]()
    for c in "\"title\":\"".bytes() { (mut b).push(c) }
    var i = 0
    while i < 4094 {
        (mut b).push(92 as byte)
        (mut b).push(34 as byte)
        i += 1
    }
    (mut b).push(34 as byte)
    str_from_utf8(b) else ""
}

// One session `a` of 32 panes, one a tab, each running `--title-quotes`;
// "" when every pane was made, else why not.
fn quoted_session(mut r: Rig) -> str {
    traced_quoted_session(mut r, "")
}

// The same, the server's trace kept at `trace` when that is not empty.
fn traced_quoted_session(mut r: Rig, trace: str) -> str {
    let why = start_traced(mut r, self_path() + " --title-quotes", 60000, trace)
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "a", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 5000) { return "no first image" }
    // The tabs are made with no client attached, so the projection they are
    // made under is the one a later command sees.
    client.hang_up(mut a)
    var n = 1
    while n < 32 {
        let t = ask(r, "new-tab -t a", "")
        if t.status != 0 { return "new-tab {n + 1}: {t.status} '{t.err.trim()}'" }
        n += 1
    }
    ""
}

// How many panes of a listing carry the whole quoted title.
fn quoted_titles_in(json: str) -> int {
    json.split(quoted_title_json()).len - 1
}

// A listing of the quoted session once all 32 titles are in it: its
// Answer, or a refusal (status -1) naming what came back.
fn quoted_listing(r: Rig) -> Answer {
    let until = now_ms() + 5000
    while true {
        let l = ask(r, "list --json", "")
        if l.status != 0 { return Answer { status: 0 - 1, out: "", err: "list --json: status {l.status} '{l.err.trim()}'" } }
        let n = quoted_titles_in(l.out)
        if n == 32 { return l }
        if now_ms() > until { return Answer { status: 0 - 1, out: "", err: "{n} of 32 titles after 5 s" } }
        time.sleep(time.millis(100))
    }
    Answer { status: 0 - 1, out: "", err: "unreachable" }
}

// Whether python3's json reads `text` as one object with 32 panes, each
// titled 4,094 double quotes.
fn json_reads(r: Rig, text: str) -> bool {
    let path = beside(r, "listing.json")
    fs.write_text(path, text) else { return false }
    var c = process.command("python3")
    process.push_arg(mut c, "-I")
    process.push_arg(mut c, "-c")
    process.push_arg(mut c, "import json, sys; d = json.load(open(sys.argv[1])); t = [p['title'] for s in d['sessions'] for x in s['tabs'] for p in x['panes']]; sys.exit(0 if len(t) == 32 and all(v == '\"' * 4094 for v in t) else 1)")
    process.push_arg(mut c, path)
    let ch = process.start(c) else { return false }
    let st = process.wait_status(take ch) else 0 - 1
    st == 0
}

// 32 panes whose titles are 4,094 `"` each (an OSC string holds 4,096
// bytes, less `2;`): their listing is about 265,600 bytes, past the 256 KiB
// an attached client's events are held to. Its REPLY arrives whole and
// python3's json reads every title (warren#77).
fn row_list_json_over_queue(mut r: Rig) -> str {
    let why = quoted_session(mut r)
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    if l.out.len <= 262144 { return "the listing is {l.out.len} bytes, not past the event queue's 262,144" }
    if !l.out.ends_with("}}\n") { return "the listing does not end its object and line" }
    if !json_reads(r, l.out) { return "python3's json did not read 32 quoted titles from the {l.out.len} bytes" }
    ""
}

// The physical frames in `got`, from the first: the REPLY's payload once
// its last fragment is in, else empty.
fn reply_in(got: List[byte]) -> List[byte] {
    var at = 0
    var chain = List[byte]()
    while at + 6 <= got.len {
        let n = le4(got, at)
        let kind = got[at + 4] as int
        let more = got[at + 5] as int
        if at + 6 + n > got.len { break }
        if kind == 136 {
            for b in got[at + 6..at + 6 + n] { (mut chain).push(b) }
            if more == 0 { return chain }
        }
        at = at + 6 + n
    }
    List[byte]()
}

// One `list --json` read by hand: `pause_ms` before the first read, then
// `chunk` bytes every `every_ms`, or one chunk and then a stall of
// `stall_ms`. Returns the REPLY's payload, or empty when the connection
// ended first.
fn read_slowly(r: Rig, pause_ms: int, chunk: int, every_ms: int, stall_ms: int) -> List[byte] {
    var p = client.dial(socket(r)) else |_| { return List[byte]() }
    var none = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", none, none))
    var b = List[byte]()
    proto.put(mut b, 9, 4)
    proto.put(mut b, 2, 2)
    proto.put_text(mut b, "list")
    proto.put_text(mut b, "--json")
    proto.put_text(mut b, "/")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    var s = net.Socket { fd: p.fd }
    time.sleep(time.millis(pause_ms))
    var got = List[byte]()
    var reads = 0
    let until = now_ms() + 30000
    var payload = List[byte]()
    while now_ms() < until {
        let part = net.read_bytes(mut s, chunk) else |_| { break }
        if part.len == 0 { break }
        for x in part { (mut got).push(x) }
        payload = reply_in(got)
        if payload.len > 0 { break }
        reads += 1
        if stall_ms > 0 && reads == 1 { time.sleep(time.millis(stall_ms)) } else { time.sleep(time.millis(every_ms)) }
    }
    client.hang_up(mut p)
    payload
}

// A command client that reads a large REPLY slowly but steadily receives
// all of it: the two seconds a draining connection is given count from
// its last write that made progress. It waits 1.2 s, then reads 8 KiB
// every 250 ms. The control: a client that reads 8 KiB and then stalls for
// 3 s is closed before the REPLY ends, unless its socket took the whole
// REPLY at once (said in a NOTE).
fn row_reply_slow_reader(mut r: Rig) -> str {
    let why = quoted_session(mut r)
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    let slow = read_slowly(r, 1200, 8192, 250, 0)
    if slow.len == 0 { return "the slow reader's connection ended before its REPLY did" }
    let out_len = le4(slow, 5)
    if out_len != l.out.len { return "the slow reader's REPLY held {out_len} bytes of output, not {l.out.len}" }
    let stalled = read_slowly(r, 0, 8192, 0, 3000)
    if stalled.len > 0 { print("NOTE reply-slow-reader: the stalled reader's socket took the whole REPLY") }
    ""
}

// The least a draining connection's peer may read in every two seconds and
// never be closed, on this host. On Linux it is one write to a draining
// connection (the server's 8 KiB): the kernel lets the next write through
// once a whole earlier write has been read. On macOS it is 2 KiB, the send
// low-water mark of the socket's 8 KiB send space.
fn drain_floor() -> int {
    if fs.exists("/proc/self/status") { return 8192 }
    2048
}

// One `list --json` read `chunk` bytes at a time (each read taken whole),
// `every_ms` after each, for `reads` reads; then the rest at full speed for
// at most 10 s. Returns the REPLY's payload, or empty when the connection
// ended first.
fn read_paced(r: Rig, chunk: int, every_ms: int, reads: int) -> List[byte] {
    var p = send_listing(r) else |_| { return List[byte]() }
    var s = net.Socket { fd: p.fd }
    var got = List[byte]()
    var payload = List[byte]()
    var ended = false
    var n = 0
    while n < reads && !ended && payload.len == 0 {
        let want = got.len + chunk
        while got.len < want && !ended {
            let part = net.read_bytes(mut s, want - got.len) else |_| { List[byte]() }
            if part.len == 0 { ended = true }
            for x in part { (mut got).push(x) }
        }
        payload = reply_in(got)
        n += 1
        if !ended && payload.len == 0 { time.sleep(time.millis(every_ms)) }
    }
    let until = now_ms() + 10000
    while !ended && payload.len == 0 && now_ms() < until {
        let part = net.read_bytes(mut s, 65536) else |_| { List[byte]() }
        if part.len == 0 { ended = true }
        for x in part { (mut got).push(x) }
        payload = reply_in(got)
    }
    client.hang_up(mut p)
    payload
}

// How many connections the trace says the draining deadline closed.
fn deadline_closes(path: str) -> int {
    var n = 0
    for line in trace_lines(path) {
        if line.ends_with(" closed: its deadline passed while draining") { n += 1 }
    }
    n
}

// The floor holds: a command client that reads the floor (drain_floor) every
// 1.8 s, a little over the floor in every two seconds, for five reads and
// then the rest at full speed, receives its whole REPLY, and no draining
// deadline passes.
fn row_reply_reader_over(mut r: Rig) -> str {
    let path = beside(r, "trace")
    let why = traced_quoted_session(mut r, path)
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    let n = drain_floor()
    let before = deadline_closes(path)
    let got = read_paced(r, n, 1800, 5)
    if got.len == 0 { return "a reader of {n} bytes every 1.8 s was closed before its REPLY ended" }
    let out_len = le4(got, 5)
    if out_len != l.out.len { return "the paced reader's REPLY held {out_len} bytes of output, not {l.out.len}" }
    let after = deadline_closes(path)
    if after != before { return "{after - before} draining deadlines passed while the reader kept to {n} bytes every 1.8 s" }
    ""
}

// And a reader a little under it is closed: one that reads the floor every
// 2.2 s is closed by the draining deadline (the trace names it) before its
// REPLY has gone out.
fn row_reply_reader_under(mut r: Rig) -> str {
    let path = beside(r, "trace")
    let why = traced_quoted_session(mut r, path)
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    let n = drain_floor()
    let before = deadline_closes(path)
    let got = read_paced(r, n, 2200, 3)
    if got.len > 0 { return "a reader of {n} bytes every 2.2 s received its whole REPLY" }
    let after = deadline_closes(path)
    if after != before + 1 { return "{after - before} connections closed by the draining deadline, not one" }
    ""
}

// The last large REPLY's connection's [bytes, writes, turns], from its
// `wrote B bytes in W writes over T turns` trace line; empty before it.
fn last_reply_counts(path: str) -> List[int] {
    let lines = trace_lines(path)
    var out = List[int]()
    var at = 0 - 1
    var holder = ""
    var k = 0
    while k < lines.len {
        if lines[k].contains(" REPLY ") && lines[k].ends_with("from the reply buffer") {
            at = k
            holder = lines[k].split(" ")[1]
        }
        k += 1
    }
    if at < 0 { return out }
    k = at
    while k < lines.len {
        if lines[k].starts_with("conn {holder} wrote ") {
            let w = lines[k].split(" ")
            if w.len == 11 {
                (mut out).push(w[3].to_int() else 0)
                (mut out).push(w[6].to_int() else 0)
                (mut out).push(w[9].to_int() else 0)
            }
            return out
        }
        k += 1
    }
    out
}

// What a fast reader costs: the listing read at full speed, its time, and
// the server's write calls and turns for its connection, each per MiB.
fn row_reply_fast_reader(mut r: Rig) -> str {
    let path = beside(r, "trace")
    let why = traced_quoted_session(mut r, path)
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    var p = send_listing(r) else |e| { return "dial: {e}" }
    let t0 = now_ms()
    let a = answer_of(read_reply(mut p, 10000))
    let ms = now_ms() - t0
    if a.status != 0 || a.out.len != l.out.len { return "the fast reader: status {a.status}, {a.out.len} bytes of {l.out.len}" }
    let until = now_ms() + 2000
    var c = last_reply_counts(path)
    while c.len == 0 && now_ms() < until {
        time.sleep(time.millis(20))
        c = last_reply_counts(path)
    }
    if c.len != 3 || c[0] <= 0 { return "no write count in the trace for the listing's connection" }
    let mib = 1048576
    print("MEASURE reply-fast-reader bytes={c[0]} writes={c[1]} turns={c[2]} ms={ms} writes-per-mib={c[1] * mib / c[0]} turns-per-mib={c[2] * mib / c[0]}")
    ""
}

// One `list --json` sent by hand on its own connection, not yet read.
fn send_listing(r: Rig) -> client.Peer ! client.DialErrors {
    var p = client.dial(socket(r))?
    var none = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", none, none))
    var b = List[byte]()
    proto.put(mut b, 9, 4)
    proto.put(mut b, 2, 2)
    proto.put_text(mut b, "list")
    proto.put_text(mut b, "--json")
    proto.put_text(mut b, "/")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    p
}

// A REPLY's payload read whole from a connection sent by `send_listing`,
// at full speed for at most `ms`; empty when the connection ended first.
fn read_reply(mut p: client.Peer, ms: int) -> List[byte] {
    var s = net.Socket { fd: p.fd }
    var got = List[byte]()
    var payload = List[byte]()
    let until = now_ms() + ms
    while now_ms() < until {
        let part = net.read_bytes(mut s, 65536) else |_| { break }
        if part.len == 0 { break }
        for x in part { (mut got).push(x) }
        payload = reply_in(got)
        if payload.len > 0 { break }
    }
    client.hang_up(mut p)
    payload
}

// A REPLY payload's status, output and error.
fn answer_of(payload: List[byte]) -> Answer {
    if payload.len < 13 { return Answer { status: 0 - 1, out: "", err: "no REPLY" } }
    let out_len = le4(payload, 5)
    let err_len = le4(payload, 9 + out_len)
    Answer { status: payload[4] as int, out: str_from_utf8(payload[9..9 + out_len]) else "",
        err: str_from_utf8(payload[13 + out_len..13 + out_len + err_len]) else "" }
}

// The server's trace lines, `warren-server: ` taken off.
fn trace_lines(path: str) -> List[str] {
    var out = List[str]()
    let text = fs.read_text(path) else ""
    for line in text.lines() {
        if line.starts_with("warren-server: ") { (mut out).push(line[15..line.len]) }
    }
    out
}

// The figures of the trace's `memory projected P, reply buffer R` lines, in
// order: P then R for each.
fn memory_figures(path: str) -> List[int] {
    var out = List[int]()
    for line in trace_lines(path) {
        if line.starts_with("memory projected ") {
            let parts = line[17..line.len].split(", reply buffer ")
            if parts.len == 2 {
                (mut out).push(parts[0].to_int() else 0 - 1)
                (mut out).push(parts[1].to_int() else 0 - 1)
            }
        }
    }
    out
}

// The figures after the latest REPLY: [projected, reply buffer], or [-1, -1].
fn last_memory(path: str) -> List[int] {
    let all = memory_figures(path)
    var out = List[int]()
    if all.len < 2 {
        (mut out).push(0 - 1)
        (mut out).push(0 - 1)
        return out
    }
    (mut out).push(all[all.len - 2])
    (mut out).push(all[all.len - 1])
    out
}

// The memory projection around large REPLYs (warren#79 as ruled: retained
// storage bounded and counted). A large REPLY goes out from the one
// server-wide reply buffer, which stays counted once its connection has
// closed; the connection's slot is counted at its share, which does not
// grow when the slot is reused; a second large REPLY reuses the buffer
// without growing it. Figures from the trace's `memory projected` line
// after each REPLY.
fn row_reply_projection(mut r: Rig) -> str {
    let path = beside(r, "trace")
    let why = traced_quoted_session(mut r, path)
    if why.len > 0 { return why }
    let a = ask(r, "ls", "")
    if a.status != 0 { return "ls: {a.status} '{a.err.trim()}'" }
    let before = last_memory(path)
    if before[0] < 0 { return "no memory line after the first ls" }
    if before[1] != 0 { return "the reply buffer held {before[1]} bytes before any large REPLY" }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    let b = ask(r, "ls", "")
    if b.status != 0 { return "ls after: {b.status} '{b.err.trim()}'" }
    let after = last_memory(path)
    if after[1] <= l.out.len { return "the reply buffer holds {after[1]} bytes, not the listing's {l.out.len} and more" }
    if after[0] != before[0] + after[1] { return "projected {before[0]} before and {after[0]} after: {after[0] - before[0]} more, not the reply buffer's {after[1]}" }
    let again = ask(r, "list --json", "")
    if again.status != 0 { return "a second listing: {again.status} '{again.err.trim()}'" }
    let second = last_memory(path)
    if second[1] != after[1] { return "the second large REPLY grew the reply buffer from {after[1]} to {second[1]}" }
    let c = ask(r, "ls", "")
    if c.status != 0 { return "ls last: {c.status} '{c.err.trim()}'" }
    let last = last_memory(path)
    if last[0] != after[0] { return "projected {after[0]} after the first large REPLY and {last[0]} after the second: a slot grew on reuse" }
    ""
}

// A large REPLY the memory budget has no room for is refused by name
// (status 1), and the server goes on. The projection is read from a first
// server's trace; a second server is given that figure and 64 KiB more,
// less than the listing's reply buffer needs.
fn row_reply_memory_refused(mut r: Rig) -> str {
    let path = beside(r, "trace")
    let why = traced_quoted_session(mut r, path)
    if why.len > 0 { return why }
    let a = ask(r, "ls", "")
    if a.status != 0 { return "ls: {a.status} '{a.err.trim()}'" }
    let first = last_memory(path)
    if first[0] < 0 { return "no memory line after ls" }
    let st = stop_server(mut r)
    if st != 0 { return "the first server's exit {st}" }
    let budget = first[0] + 65536
    let path2 = beside(r, "trace-2")
    env.set("WARREN_MEMORY_BUDGET", "{budget}") else { return "env" }
    let why2 = traced_quoted_session(mut r, path2)
    env.set("WARREN_MEMORY_BUDGET", "0") else { return "env" }
    if why2.len > 0 { return "under a budget of {budget}: {why2}" }
    let b = ask(r, "ls", "")
    if b.status != 0 { return "ls under the budget: {b.status} '{b.err.trim()}'" }
    let second = last_memory(path2)
    // The two servers hold the same panes and slots; the images their
    // attached client was sent may differ a little, so within 32 KiB.
    let drift = if second[0] > first[0] then second[0] - first[0] else first[0] - second[0]
    if drift > 32768 { return "projected {first[0]} on the first server and {second[0]} on the second" }
    time.sleep(time.millis(1500))
    let l = ask(r, "list --json", "")
    if l.status == 0 { return "a listing of {l.out.len} bytes was sent under a budget with 64 KiB to spare" }
    if l.status != 1 || !l.err.contains("memory budget") { return "the listing: status {l.status}, '{l.err.trim()}', not refused by the memory budget" }
    let c = ask(r, "ls", "")
    if c.status != 0 { return "the server did not go on: ls {c.status}" }
    ""
}

// Two large REPLYs at once share the one reply buffer in turn: both
// arrive whole, the second only after the first's connection has closed.
// The second's wait is bounded (WARREN_REPLY_WAIT_MS lowered to 500 ms for
// the row): when the first holds the buffer longer, the second is refused
// by name.
fn row_two_large_replies(mut r: Rig) -> str {
    let path = beside(r, "trace")
    env.set("WARREN_REPLY_WAIT_MS", "500") else { return "env" }
    let why = traced_quoted_session(mut r, path)
    env.set("WARREN_REPLY_WAIT_MS", "0") else { return "env" }
    if why.len > 0 { return why }
    let l = quoted_listing(r)
    if l.status != 0 { return "the listing of 32 titled panes: {l.err}" }
    var a = send_listing(r) else |e| { return "dial a: {e}" }
    time.sleep(time.millis(50))
    var b = send_listing(r) else |e| { return "dial b: {e}" }
    time.sleep(time.millis(200))
    let pa = answer_of(read_reply(mut a, 10000))
    let pb = answer_of(read_reply(mut b, 10000))
    if pa.status != 0 || pa.out.len != l.out.len { return "the first of two: status {pa.status}, {pa.out.len} bytes of {l.out.len} '{pa.err.trim()}'" }
    if pb.status != 0 || pb.out.len != l.out.len { return "the second of two: status {pb.status}, {pb.out.len} bytes of {l.out.len} '{pb.err.trim()}'" }
    let lines = trace_lines(path)
    var waiter = ""
    var holder = ""
    var k = 0
    var waited_at = 0 - 1
    while k < lines.len {
        if lines[k].ends_with(" waits for the reply buffer") && waited_at < 0 {
            waiter = lines[k].split(" ")[1]
            waited_at = k
        }
        k += 1
    }
    if waited_at < 0 {
        print("NOTE two-large-replies: the second never waited (the first's socket took its REPLY at once)")
    } else {
        k = waited_at
        while k >= 0 && holder.len == 0 {
            if lines[k].contains(" REPLY ") && lines[k].ends_with("from the reply buffer") { holder = lines[k].split(" ")[1] }
            k -= 1
        }
        var closed_at = 0 - 1
        var second_at = 0 - 1
        k = waited_at
        while k < lines.len {
            if closed_at < 0 && lines[k].starts_with("conn {holder} closed") { closed_at = k }
            if second_at < 0 && lines[k].starts_with("conn {waiter} REPLY ") { second_at = k }
            k += 1
        }
        if holder.len == 0 || closed_at < 0 || second_at < 0 || second_at < closed_at {
            return "the second REPLY (conn {waiter}) went out at trace line {second_at}, the holder (conn {holder}) closed at {closed_at}"
        }
    }
    let waits_before = waits_in(path)
    var c = send_listing(r) else |e| { return "dial c: {e}" }
    time.sleep(time.millis(50))
    var d = send_listing(r) else |e| { return "dial d: {e}" }
    time.sleep(time.millis(1500))
    let pc = answer_of(read_reply(mut c, 10000))
    let pd = answer_of(read_reply(mut d, 10000))
    if pc.status != 0 || pc.out.len != l.out.len { return "the holder of a long wait: status {pc.status}, {pc.out.len} bytes '{pc.err.trim()}'" }
    if waits_in(path) == waits_before {
        print("NOTE two-large-replies: the long wait never happened (the first's socket took its REPLY at once)")
        return ""
    }
    if pd.status != 1 || !pd.err.contains("reply buffer") {
        return "the second waited 1.5 s past a 500 ms bound: status {pd.status}, {pd.out.len} bytes, '{pd.err.trim()}', not refused by name"
    }
    ""
}

// How many times the trace says a connection waits for the reply buffer.
fn waits_in(path: str) -> int {
    var n = 0
    for line in trace_lines(path) {
        if line.ends_with(" waits for the reply buffer") { n += 1 }
    }
    n
}

// ---- send-keys and capture-pane ----

// The repository's root, from this program's own path (target/native/...).
fn repo_root() -> str {
    let me = self_path()
    let at = me.find("/target/") else { return "." }
    me[0..at]
}

// One COMMAND as words, waiting at most `ms` for its REPLY.
fn ask_long(r: Rig, words: List[str], ms: int) -> Answer {
    var p = client.dial(socket(r)) else |e| { return Answer { status: 0 - 1, out: "", err: "dial-{e}" } }
    var none = List[str]()
    let _h = client.send(p, 1, client.hello_payload(2, 0, 0, "", 0, "", none, none))
    if !client.until_kind(mut p, 129, 2000) {
        client.hang_up(mut p)
        return Answer { status: 0 - 1, out: "", err: "no WELCOME" }
    }
    var b = List[byte]()
    proto.put(mut b, 9, 4)
    proto.put(mut b, words.len, 2)
    for w in words { proto.put_text(mut b, w) }
    proto.put_text(mut b, "/")
    proto.put_text(mut b, "")
    let _c = client.send(p, 11, b)
    let m = client.next(mut p, ms)
    client.hang_up(mut p)
    if m.kind != 136 { return Answer { status: 0 - 1, out: "", err: "no REPLY ({m.kind})" } }
    let out_len = le4(m.body, 5)
    let err_len = le4(m.body, 9 + out_len)
    Answer { status: m.body[4] as int, out: str_from_utf8(m.body[9..9 + out_len]) else "",
        err: str_from_utf8(m.body[13 + out_len..13 + out_len + err_len]) else "" }
}

// Words split at single spaces.
fn split_words(text: str) -> List[str] {
    var out = List[str]()
    for w in text.split(" ") {
        if w.len > 0 { (mut out).push(w) }
    }
    out
}

// The bytes a `--key-reader` logged so far.
fn reader_bytes(path: str) -> List[byte] {
    var out = List[byte]()
    let log = fs.read_text(path) else ""
    for line in log.lines() {
        if line.starts_with("b ") { (mut out).push((line[2..line.len].to_int() else 0) as byte) }
    }
    out
}

// Wait until a reader has logged at least `n` bytes (or `ms` passed); its bytes.
fn until_read(path: str, n: int, ms: int) -> List[byte] {
    let until = now_ms() + ms
    while now_ms() < until {
        let got = reader_bytes(path)
        if got.len >= n { return got }
        time.sleep(time.millis(5))
    }
    reader_bytes(path)
}

fn hex_of(b: List[byte]) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    for x in b {
        let v = x as int
        (mut out).push(digits.bytes()[v / 16])
        (mut out).push(digits.bytes()[v % 16])
    }
    str_from_utf8(out) else ""
}

// A pane running `--key-reader FILE MODE` in a new tab of session `a`; its
// id, or "" (and the reason in the trace of the caller).
fn reader_tab(r: Rig, file: str, mode: str) -> str {
    var w = split_words("new-tab -t a --")
    (mut w).push(self_path())
    (mut w).push("--key-reader")
    (mut w).push(file)
    (mut w).push(mode)
    let a = ask_words(r, w, "")
    if a.status != 0 { return "" }
    if !until_file(file + ".ready", 5000) { return "" }
    // The mode's sequences reach the emulator before the first key.
    time.sleep(time.millis(100))
    a.out.trim()
}

fn until_file(path: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if fs.exists(path) { return true }
        time.sleep(time.millis(10))
    }
    fs.exists(path)
}

// A session `a` at 80x26 (its panes 80x24) whose first pane runs `program`.
fn pane_session(mut r: Rig, program: str) -> str {
    let why = start_server(mut r, program)
    if why.len > 0 { return why }
    var a = attach(r, 80, 26, "a", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 5000) { return "no first image" }
    client.hang_up(mut a)
    ""
}

// Every row of tests/session/send-keys.table, sent by `warren send-keys` to
// a reader pane in the row's mode, reaches it as the table's warren column:
// names, modifiers, text and -l, in normal, cursor and keypad modes. The
// plant's row.
fn row_send_keys_bytes(mut r: Rig) -> str {
    let why = pane_session(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var panes = List[str]()
    var files = List[str]()
    for mode in split_words("normal cursor keypad") {
        let f = beside(r, "keys-" + mode)
        fs.remove(f) else |_| {}
        let id = reader_tab(r, f, mode)
        if id.len == 0 { return "no reader pane in {mode} mode" }
        (mut panes).push(id)
        (mut files).push(f)
    }
    let text = fs.read_text(repo_root() + "/tests/session/send-keys.table") else { return "no table" }
    var seen = List[int]()
    var z = 0
    while z < 3 {
        (mut seen).push(0)
        z += 1
    }
    var rows = 0
    for line in text.lines() {
        if line.len == 0 || line.starts_with("#") { continue }
        let f = line.split("\t")
        if f.len != 5 { return "a table line of {f.len} columns" }
        var k = 2
        if f[0] == "normal" { k = 0 } else if f[0] == "cursor" { k = 1 }
        var w = List[str]()
        (mut w).push("send-keys")
        (mut w).push("-t")
        (mut w).push(panes[k])
        for a in json_words(f[1]) { (mut w).push(a) }
        let s = ask_words(r, w, "")
        if s.status != 0 { return "send-keys -t {panes[k]} {f[1]}: status {s.status} '{s.err.trim()}'" }
        let want = f[3].len / 2
        let got = until_read(files[k], seen[k] + want, 2000)
        var end = seen[k] + want
        if got.len < end { end = got.len }
        let mine = hex_of(got[seen[k]..end])
        if mine != f[3] { return "{f[1]} {f[0]}: read {mine}, the table's warren column {f[3]}" }
        seen[k] = seen[k] + want
        rows += 1
    }
    // Nothing more came after the last case.
    time.sleep(time.millis(200))
    var q = 0
    while q < 3 {
        let total = reader_bytes(files[q]).len
        if total != seen[q] { return "the reader in pane {panes[q]} read {total} bytes, the table's {seen[q]}" }
        q += 1
    }
    if rows != 391 { return "{rows} table rows sent, not 391" }
    ""
}

// The JSON list of strings in a table line, as words (the table writes them
// with every non-ASCII character escaped).
fn json_words(text: str) -> List[str] {
    var out = List[str]()
    let v = json.parse(text) else { return out }
    for a in json.as_arr(v) else List[json.Value]() { (mut out).push(json.as_str(a) else "") }
    out
}

// send-keys's refusals send nothing anywhere: a target that is not there
// (status 1, named), no keys (status 2), and 80,000 bytes in two words,
// past a pane's 64 KiB input queue, in one send (status 1, named; none of
// them arrive). A COMMAND's word holds at most 65,535 bytes.
fn row_send_keys_refusals(mut r: Rig) -> str {
    let why = pane_session(mut r, "/bin/sh")
    if why.len > 0 { return why }
    let f = beside(r, "refusals")
    fs.remove(f) else |_| {}
    let id = reader_tab(r, f, "normal")
    if id.len == 0 { return "no reader pane" }
    let missing = ask_words(r, split_words("send-keys -t p99 x"), "")
    if missing.status != 1 || !missing.err.contains("p99") { return "a missing target: status {missing.status} '{missing.err.trim()}'" }
    let none = ask_words(r, split_words("send-keys -t {id}"), "")
    if none.status != 2 { return "no keys: status {none.status} '{none.err.trim()}'" }
    var big = List[byte]()
    var i = 0
    while i < 40000 {
        (mut big).push(120 as byte)
        i += 1
    }
    var w = split_words("send-keys -l -t {id}")
    (mut w).push(str_from_utf8(big) else "")
    (mut w).push(str_from_utf8(big) else "")
    let over = ask_words(r, w, "")
    if over.status != 1 || !over.err.contains("input queue") { return "80,000 bytes: status {over.status} '{over.err.trim()}'" }
    time.sleep(time.millis(300))
    let got = reader_bytes(f)
    if got.len != 0 { return "the refusals sent {got.len} bytes" }
    ""
}

// send-keys reaches the program, not the key table: the prefix (C-Space,
// NUL) and the key after it arrive as bytes, and no client's mode moves.
fn row_send_keys_skips_bindings(mut r: Rig) -> str {
    let why = pane_session(mut r, "/bin/sh")
    if why.len > 0 { return why }
    let f = beside(r, "bindings")
    fs.remove(f) else |_| {}
    let id = reader_tab(r, f, "normal")
    if id.len == 0 { return "no reader pane" }
    var a = attach(r, 80, 26, "a", 0) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 5000) { return "no image" }
    let s = ask_words(r, split_words("send-keys -t {id} C-Space |"), "")
    if s.status != 0 { return "send-keys: status {s.status} '{s.err.trim()}'" }
    let got = until_read(f, 2, 2000)
    if hex_of(got) != "007c" { return "the program read {hex_of(got)}, not 007c (the prefix and |)" }
    let l = listed(r)
    if l.status != 0 { return l.err }
    if panes_in(l.out) != 2 { return "the prefix and | split a pane: {panes_in(l.out)} panes" }
    client.hang_up(mut a)
    ""
}

// All of a send's bytes are queued or none are: a reader that does not read
// yet takes 8 KiB sends until one is refused (its 64 KiB queue full); once
// it reads, it gets every accepted send and nothing of the refused one.
fn row_send_keys_all_or_nothing(mut r: Rig) -> str {
    let why = pane_session(mut r, "/bin/sh")
    if why.len > 0 { return why }
    let f = beside(r, "queue")
    let go = beside(r, "queue-go")
    fs.remove(f) else |_| {}
    fs.remove(go) else |_| {}
    var w = split_words("new-tab -t a --")
    (mut w).push(self_path())
    (mut w).push("--key-reader")
    (mut w).push(f)
    (mut w).push("normal")
    (mut w).push(go)
    let t = ask_words(r, w, "")
    if t.status != 0 || !until_file(f + ".ready", 5000) { return "no waiting reader: {t.status} '{t.err.trim()}'" }
    let id = t.out.trim()
    var chunk = List[byte]()
    var i = 0
    while i < 8192 {
        (mut chunk).push(121 as byte)
        i += 1
    }
    let text = str_from_utf8(chunk) else ""
    var sent = 0
    var refused = false
    var n = 0
    while n < 20 && !refused {
        var s = split_words("send-keys -l -t {id}")
        (mut s).push(text)
        let a = ask_words(r, s, "")
        if a.status == 0 { sent += 8192 } else if a.status == 1 && a.err.contains("input queue") { refused = true } else {
            return "send {n + 1}: status {a.status} '{a.err.trim()}'"
        }
        n += 1
    }
    if !refused { return "20 sends of 8 KiB were all taken by a reader that did not read" }
    fs.write_text(go, "go\n") else { return "go file" }
    let _first = until_read(f, sent, 5000)
    time.sleep(time.millis(300))
    let all = reader_bytes(f)
    if all.len != sent { return "the reader got {all.len} bytes of the {sent} accepted (a refused send arrived in part, or an accepted one did not)" }
    ""
}

// A capture's output kept beside the row, checked by tests/session/capture_check.py.
fn checked(r: Rig, out: str, leaf: str, args: List[str]) -> str {
    let path = beside(r, leaf)
    fs.write_text(path, out) else { return "write {path}" }
    var c = process.command("python3")
    process.push_arg(mut c, "-I")
    process.push_arg(mut c, repo_root() + "/tests/session/capture_check.py")
    process.push_arg(mut c, args[0])
    process.push_arg(mut c, path)
    var i = 1
    while i < args.len {
        process.push_arg(mut c, args[i])
        i += 1
    }
    let report = beside(r, leaf + ".check")
    let fo = fs.create(report) else |e| { return "report-{e}" }
    process.set_stdout(mut c, fo)
    let ch = process.start(c) else |e| { return "checker-{e}" }
    let st = process.wait_status(take ch) else 0 - 1
    if st != 0 { return (fs.read_text(report) else "the checker failed").trim() }
    ""
}

// The harness's six case streams (tests/vt/cases.py), each `cat` into a pane
// of 80x24: `capture-pane -p` gives each row of the reference emulator's
// expected screen, and `-e` read as cells its renditions as well.
fn capture_against_screens(mut r: Rig, escapes: bool) -> str {
    let dir = beside(r, "cases")
    var c = process.command("python3")
    process.push_arg(mut c, "-I")
    process.push_arg(mut c, repo_root() + "/tests/vt/cases.py")
    process.push_arg(mut c, dir)
    let ch = process.start(c) else |e| { return "cases-{e}" }
    if (process.wait_status(take ch) else 0 - 1) != 0 { return "tests/vt/cases.py failed" }
    var words = "capture-pane -p -t a"
    var mode = "screen"
    if escapes {
        words = "capture-pane -p -e -t a"
        mode = "escapes"
    }
    for name in split_words("sgr wide erase edit scroll pending-wrap") {
        let done = beside(r, name + ".printed")
        fs.remove(done) else |_| {}
        let why = pane_session(mut r, self_path() + " --print-file " + dir + "/" + name + ".in " + done)
        if why.len > 0 { return "{name}: {why}" }
        if !until_file(done, 10000) { return "{name}: the case was not printed" }
        time.sleep(time.millis(200))
        let a = ask_words(r, split_words(words), "")
        if a.status != 0 { return "{name}: capture-pane: status {a.status} '{a.err.trim()}'" }
        var args = List[str]()
        (mut args).push(mode)
        (mut args).push(repo_root() + "/tests/vt/expected/" + name + ".screen")
        let bad = checked(r, a.out, "capture-" + name, args)
        if bad.len > 0 { return "{name}: {bad}" }
        let _s = stop_server(mut r)
    }
    ""
}

fn row_capture_screen(mut r: Rig) -> str {
    capture_against_screens(mut r, false)
}

fn row_capture_escapes(mut r: Rig) -> str {
    capture_against_screens(mut r, true)
}

// The measurement's own cases (tests/session/capture-cases), each printed
// into a pane of 80x24 and captured with every flag set tmux 3.4 was
// captured with: line numbers, clamps and swaps, joins, trailing blanks,
// renditions at a row's end, the alternate screen. Each capture equals
// tests/session/capture-goldens.json's warren column (the -e ones read as
// cells).
fn row_capture_cases(mut r: Rig) -> str {
    let goldens = repo_root() + "/tests/session/capture-goldens.json"
    let text = fs.read_text(goldens) else { return "no goldens" }
    let all = json.parse(text) else { return "the goldens are not JSON" }
    for name in split_words("history join sgr-end alt") {
        let done = beside(r, name + ".printed")
        fs.remove(done) else |_| {}
        let why = pane_session(mut r, self_path() + " --print-file " + repo_root() + "/tests/session/capture-cases/" + name + ".in " + done)
        if why.len > 0 { return "{name}: {why}" }
        if !until_file(done, 10000) { return "{name}: the case was not printed" }
        time.sleep(time.millis(200))
        let cases = json.get(all, name) else { return "no goldens for {name}" }
        for flags in json.keys(cases) else List[str]() {
            var w = split_words("capture-pane -t a")
            let fl = json_words(flags)
            var spans = false
            for x in fl {
                (mut w).push(x)
                if x.starts_with("-") && x.contains("e") && !x.starts_with("-S") && !x.starts_with("-E") { spans = true }
            }
            let a = ask_words(r, w, "")
            if a.status != 0 { return "{name} {flags}: status {a.status} '{a.err.trim()}'" }
            var args = List[str]()
            var how = "case"
            if spans { how = "case-spans" }
            (mut args).push(how)
            (mut args).push(goldens)
            (mut args).push(name)
            (mut args).push(flags)
            let bad = checked(r, a.out, "case-" + name, args)
            if bad.len > 0 { return "{name} {flags}: {bad}" }
        }
        let _s = stop_server(mut r)
    }
    ""
}

// capture-pane without -p puts the capture in its session's register, as
// tmux's goes to a paste buffer: the paste key then types it into a reader.
fn row_capture_register(mut r: Rig) -> str {
    let done = beside(r, "history.printed")
    fs.remove(done) else |_| {}
    let why = pane_session(mut r, self_path() + " --print-file " + repo_root() + "/tests/session/capture-cases/history.in " + done)
    if why.len > 0 { return why }
    if !until_file(done, 10000) { return "the case was not printed" }
    time.sleep(time.millis(200))
    let c = ask_words(r, split_words("capture-pane -t a -S -3 -E -1"), "")
    if c.status != 0 || c.out.len != 0 { return "capture-pane without -p: status {c.status}, printed {c.out.len} bytes, '{c.err.trim()}'" }
    let f = beside(r, "pasted")
    fs.remove(f) else |_| {}
    let id = reader_tab(r, f, "normal")
    if id.len == 0 { return "no reader pane" }
    // A tab made by a command leaves the active tab where it was: the
    // reader's tab is selected, so the paste goes to it.
    let sel = ask_words(r, split_words("select-tab -t a 2"), "")
    if sel.status != 0 { return "select-tab 2: {sel.status} '{sel.err.trim()}'" }
    var a = attach(r, 80, 26, "a", 0) else |e| { return "dial-{e}" }
    if !client.until_kind(mut a, 131, 5000) { return "no image" }
    let _prefix = client.key(a, 4, 0, 32)
    let _paste = client.key(a, 0, 0, 93)
    let got = until_read(f, 27, 3000)
    client.hang_up(mut a)
    let want = "line 075\nline 076\nline 077\n"
    if (str_from_utf8(got) else "") != want { return "the paste typed '{str_from_utf8(got) else "?"}', not the capture" }
    ""
}

// A pane whose 2 MiB history ring is full: `-p -S -` arrives whole (past
// 1 MiB, so from the reply buffer in fragments), one line a retained row and
// a live row. MEASURE: its bytes and the time the command took.
fn row_capture_full_ring(mut r: Rig) -> str {
    let path = beside(r, "ring.in")
    var b = List[byte]()
    var n = 0
    while n < 40000 {
        for c in "{n}".bytes() { (mut b).push(c) }
        var k = 0
        while k < 70 {
            (mut b).push(46 as byte)
            k += 1
        }
        (mut b).push(13 as byte)
        (mut b).push(10 as byte)
        n += 1
    }
    fs.write_bytes(path, b) else { return "write the ring's input" }
    let done = path + ".printed"
    fs.remove(done) else |_| {}
    let why = pane_session(mut r, self_path() + " --print-file " + path + " " + done)
    if why.len > 0 { return why }
    if !until_file(done, 30000) { return "the ring's input was not printed" }
    time.sleep(time.millis(300))
    let t0 = now_ms()
    let a = ask_long(r, split_words("capture-pane -p -S - -t a"), 20000)
    let ms = now_ms() - t0
    if a.status != 0 { return "capture-pane -p -S -: status {a.status} '{a.err.trim()}'" }
    print("MEASURE capture-full-ring bytes={a.out.len} ms={ms}")
    if a.out.len <= 1048576 { return "the capture is {a.out.len} bytes: the ring did not fill past 1 MiB" }
    // Every numbered line from the oldest the ring kept to the last, in
    // order, then the live screen's blank rows.
    var next = 0 - 1
    var numbered = 0
    for line in a.out.lines() {
        if line.len == 0 { continue }
        let dots = line.find(".") else { return "a line without its dots: '{line}'" }
        let k = line[0..dots].to_int() else { return "a line without its number: '{line}'" }
        if next >= 0 && k != next { return "line {k} follows line {next - 1}: the capture is not whole" }
        next = k + 1
        numbered += 1
    }
    if next != 40000 { return "the capture ends at line {next - 1}, not 39999" }
    print("MEASURE capture-full-ring lines={numbered} first={40000 - numbered}")
    ""
}

// A capture past the protocol's 8 MiB is refused by name (status 1), and the
// server goes on: a full ring whose every cell changes the whole rendition
// (nine attributes, two RGB colours) captured with -e.
fn row_capture_over_cap(mut r: Rig) -> str {
    let path = beside(r, "worst.in")
    var b = List[byte]()
    var n = 0
    while n < 220000 {
        let v = 100 + n % 50
        for c in "\u{1b}[1;2;3;4;21;5;7;8;9;38;2;{v};{255 - v};{v};48;2;{255 - v};{v};{255 - v}mx".bytes() { (mut b).push(c) }
        if n % 79 == 78 {
            (mut b).push(13 as byte)
            (mut b).push(10 as byte)
        }
        n += 1
    }
    fs.write_bytes(path, b) else { return "write the worst ring's input" }
    let done = path + ".printed"
    fs.remove(done) else |_| {}
    let why = pane_session(mut r, self_path() + " --print-file " + path + " " + done)
    if why.len > 0 { return why }
    if !until_file(done, 60000) { return "the worst ring's input was not printed" }
    time.sleep(time.millis(300))
    let a = ask_long(r, split_words("capture-pane -p -e -S - -t a"), 20000)
    if a.status != 1 || !a.err.contains("8 MiB") { return "capture-pane -p -e -S - of the worst ring: status {a.status}, {a.out.len} bytes, '{a.err.trim()}'" }
    let l = ask_words(r, split_words("ls"), "")
    if l.status != 0 { return "the server did not go on: ls {l.status}" }
    ""
}

// Ids are never handed out again: a closed pane's, an ended session's and
// its tab's.
fn row_ids_never_reused(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "a", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s1 = ask(r, "split-right -t a", "")
    let c1 = ask(r, "close-pane -t p2", "")
    let s2 = ask(r, "split-right -t a", "")
    if s1.status != 0 || c1.status != 0 || s2.status != 0 { return "split, close, split: {s1.status} {c1.status} {s2.status} {s2.err.trim()}" }
    let one = listed(r)
    if one.status != 0 { return one.err }
    if one.out.contains("\"id\":\"p2\"") || !one.out.contains("\"id\":\"p3\"") { return "pane 2 came back: {one.out}" }
    let nb = ask(r, "new-session b", "")
    if nb.status != 0 { return "new-session b: {nb.status} {nb.err.trim()}" }
    let cb = ask(r, "close-pane -t b", "")
    if cb.status != 0 { return "close-pane -t b: {cb.status} {cb.err.trim()}" }
    let nc = ask(r, "new-session c", "")
    if nc.status != 0 { return "new-session c: {nc.status} {nc.err.trim()}" }
    let two = listed(r)
    if two.status != 0 { return two.err }
    if two.out.contains("\"name\":\"b\"") { return "session b is still listed: {two.out}" }
    if !two.out.contains("\"id\":\"s3\",\"name\":\"c\"") { return "session c is not s3: {two.out}" }
    if !two.out.contains("\"active_tab\":\"t3\"") || !two.out.contains("\"id\":\"p5\"") { return "session c's tab or pane reused an id: {two.out}" }
    client.hang_up(mut a)
    ""
}

// Words split at `^`, for a COMMAND whose words hold spaces.
fn carets(text: str) -> List[str] {
    var out = List[str]()
    for w in text.split("^") { (mut out).push(w) }
    out
}

// A path beside the row's runtime directory, absolute.
fn beside(r: Rig, leaf: str) -> str {
    (env.cwd() else ".") + "/" + r.dir + "-" + leaf
}

// Wait for the server to end by itself (bounded by its lifetime): its exit
// status, or -1.
fn server_ended(mut r: Rig) -> int {
    var ch = process.Child { slot: r.server }
    r.started = false
    process.wait_status(take ch) else 0 - 1
}

// `kill-session -t b` ends b alone: its client is told the session ended and
// the listing no longer has it, while a's client goes on. Ending the last
// session ends the server, as the last pane's end does.
fn row_kill_session_ends(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "a", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt in a" }
    var b = attach(r, 80, 24, "b", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "$", 5000) { return "no prompt in b" }
    let k = ask(r, "kill-session -t b", "")
    if k.status != 0 { return "kill-session -t b: {k.status} '{k.err.trim()}'" }
    if !client.until_kind(mut b, 135, 5000) || b.end_code != 2 { return "b's client: BYE {b.end_code}, expected session-ended" }
    client.hang_up(mut b)
    let after = listed(r)
    if after.status != 0 { return after.err }
    if after.out.contains("\"name\":\"b\"") || !after.out.contains("\"name\":\"a\"") { return "after kill-session -t b: {after.out}" }
    let _i = client.input(a, "echo still-$((2+3))\r")
    if !client.until_text(mut a, "still-5", 5000) { return "a's client did not go on" }
    let last = ask(r, "kill-session -t a", "")
    if last.status != 0 { return "kill-session -t a: {last.status} '{last.err.trim()}'" }
    if !client.until_kind(mut a, 135, 5000) || a.end_code != 2 { return "a's client: BYE {a.end_code}, expected session-ended" }
    client.hang_up(mut a)
    let st = server_ended(mut r)
    if st != 0 { return "after the last session: server exit {st}" }
    ""
}

// `rename-session` renames by target and refuses a name in use, a name the
// server does not allow and a missing session, each by name and changing
// nothing.
fn row_rename_session(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let o = ask(r, "new-session other", "")
    if o.status != 0 { return "new-session other: {o.status} '{o.err.trim()}'" }
    let n = ask(r, "rename-session -t work notes", "")
    if n.status != 0 { return "rename-session -t work notes: {n.status} '{n.err.trim()}'" }
    let after = listed(r)
    if after.status != 0 { return after.err }
    if after.out.contains("\"name\":\"work\"") || !after.out.contains("\"id\":\"s1\",\"name\":\"notes\"") { return "after the rename: {after.out}" }
    let taken = ask(r, "rename-session -t notes other", "")
    if taken.status != 1 || !taken.err.contains("already exists") { return "a name in use: {taken.status} '{taken.err.trim()}'" }
    let slash = ask(r, "rename-session -t notes a/b", "")
    if slash.status != 1 || !slash.err.contains("may not hold '/'") { return "a name with '/': {slash.status} '{slash.err.trim()}'" }
    let none = ask(r, "rename-session -t nosuch x", "")
    if none.status != 1 || !none.err.contains("no-such-session") { return "a missing session: {none.status} '{none.err.trim()}'" }
    let still = listed(r)
    if still.status != 0 { return still.err }
    if still.out != after.out { return "a refused rename changed the listing: {still.out}" }
    client.hang_up(mut a)
    ""
}

// `detach -t work` from a shell detaches every client of that session; the
// session lives on. `lock` stays refused from a shell.
fn row_detach_from_shell(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    var b = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "$", 5000) { return "no prompt in the second client" }
    let d = ask(r, "detach -t work", "")
    if d.status != 0 { return "detach -t work: {d.status} '{d.err.trim()}'" }
    if !client.until_kind(mut a, 135, 5000) || a.end_code != 1 { return "the first client: BYE {a.end_code}, expected detached" }
    if !client.until_kind(mut b, 135, 5000) || b.end_code != 1 { return "the second client: BYE {b.end_code}, expected detached" }
    client.hang_up(mut a)
    client.hang_up(mut b)
    let after = listed(r)
    if after.status != 0 { return after.err }
    if !after.out.contains("\"name\":\"work\",\"cols\":80,\"rows\":24,\"clients\":0") { return "after the detach: {after.out}" }
    let l = ask(r, "lock -t work", "")
    if l.status != 1 || !l.err.contains("acts on an attached client") { return "lock from a shell: {l.status} '{l.err.trim()}'" }
    ""
}

// `-c DIR` starts a split's program (the configured one) and a new
// session's in DIR: each pane's program prints the last part of its
// working directory.
fn row_split_in_dir(mut r: Rig) -> str {
    let script = beside(r, "cwd.sh")
    fs.write_text(script, "p=$(pwd -P); printf 'CWD=%s\\n' \"$" + "{{p##*/}}\"; exec /bin/sh\n") else |e| { return "the script: {e}" }
    let place = beside(r, "place")
    let other = beside(r, "other")
    fs.create_dir_all(place) else |e| { return "mkdir: {e}" }
    fs.create_dir_all(other) else |e| { return "mkdir: {e}" }
    let why = start_server(mut r, "/bin/sh " + script)
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "CWD=", 5000) { return "the first pane printed nothing: " + client.screen_text(a) }
    let s = ask(r, "split-right -t work -c " + place, "")
    if s.status != 0 { return "split-right -c: {s.status} '{s.err.trim()}'" }
    if !client.until_text(mut a, "CWD={r.dir}-place", 5000) { return "the split's program is not in DIR: " + client.screen_text(a) }
    let n = ask(r, "new-session -c " + other + " away", "")
    if n.status != 0 || n.out != "away\n" { return "new-session -c: {n.status} '{n.out.trim()}' '{n.err.trim()}'" }
    var b = attach(r, 80, 24, "away", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut b, "CWD={r.dir}-other", 5000) { return "the new session's program is not in DIR: " + client.screen_text(b) }
    client.hang_up(mut a)
    client.hang_up(mut b)
    ""
}

// `-- CMD` runs CMD with its words as given: no shell joins and splits
// them again, so a word with a space and a word with a `$` arrive as they
// were sent.
fn row_split_runs_command(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s = ask_words(r, carets("split-right^-t^work^--^/bin/sh^-c^printf 'ARGV=%s+%s\\n' \"$0\" \"$1\"; exec sleep 30^a b^$HOME"), "")
    if s.status != 0 { return "split-right -- CMD: {s.status} '{s.err.trim()}'" }
    if !client.until_text(mut a, "ARGV=a b+$HOME", 5000) { return "the words did not arrive as sent: " + client.screen_text(a) }
    client.hang_up(mut a)
    ""
}

// Each creating verb prints the id of the pane it made, the one the
// listing then has.
fn row_split_prints_new_id(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s = ask(r, "split-right -t work", "")
    if s.status != 0 || s.out != "p2\n" { return "split-right printed '{s.out.trim()}' (status {s.status}), not p2" }
    let t = ask(r, "new-tab -t work", "")
    if t.status != 0 || t.out != "p3\n" { return "new-tab printed '{t.out.trim()}' (status {t.status}), not p3" }
    let d = ask(r, "split-down -t p1 -- /bin/sh", "")
    if d.status != 0 || d.out != "p4\n" { return "split-down printed '{d.out.trim()}' (status {d.status}), not p4" }
    let l = listed(r)
    if l.status != 0 { return l.err }
    if panes_in(l.out) != 4 || !l.out.contains("\"id\":\"p4\"") { return "the listing: {l.out}" }
    client.hang_up(mut a)
    ""
}

// A directory that is not one and a program that does not start are each
// refused by name, and the listing (panes, focus, tabs) is byte for byte
// what it was.
fn row_create_refusals(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let before = listed(r)
    if before.status != 0 { return before.err }
    let gone = beside(r, "absent")
    let d = ask(r, "split-right -t work -c " + gone, "")
    if d.status != 1 || !d.err.contains("no such directory: " + gone) { return "split-right -c ABSENT: {d.status} '{d.err.trim()}'" }
    let c = ask(r, "split-right -t work -- " + gone + "/program", "")
    if c.status != 1 || !c.err.contains("did not start") { return "split-right -- ABSENT: {c.status} '{c.err.trim()}'" }
    let t = ask(r, "new-tab -t work -- " + gone + "/program", "")
    if t.status != 1 || !t.err.contains("did not start") { return "new-tab -- ABSENT: {t.status} '{t.err.trim()}'" }
    let n = ask(r, "new-session -c " + gone + " other", "")
    if n.status != 1 || !n.err.contains("no such directory: " + gone) { return "new-session -c ABSENT: {n.status} '{n.err.trim()}'" }
    let after = listed(r)
    if after.status != 0 { return after.err }
    if after.out != before.out { return "a refusal changed the listing:\n{before.out}\n{after.out}" }
    client.hang_up(mut a)
    ""
}

// The status after "child ended status " on each line of a trace that has
// one, in order.
fn ended_statuses(text: str) -> List[str] {
    var out = List[str]()
    for line in text.lines() {
        let at = line.find("child ended status ") else 0 - 1
        if at >= 0 { (mut out).push(line[at + 19..line.len].trim()) }
    }
    out
}

// A command that exits at once ends the way a split's shell that exits
// does: the split answers with its id, the pane closes, the listing is what
// it was, and the server's trace records the same status for both.
fn row_command_exits_at_once(mut r: Rig) -> str {
    let path = beside(r, "trace")
    fs.remove(path) else |_| {}
    let why = start_traced(mut r, "/bin/sh", 60000, path)
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let before = listed(r)
    if before.status != 0 { return before.err }
    let s = ask_words(r, carets("split-right^-t^work^--^/bin/sh^-c^exit 3"), "")
    if s.status != 0 || s.out != "p2\n" { return "split-right -- sh -c 'exit 3': {s.status} '{s.out.trim()}' '{s.err.trim()}'" }
    var until = now_ms() + 5000
    var now = listed(r)
    while now.out != before.out && now_ms() < until {
        time.sleep(time.millis(50))
        now = listed(r)
    }
    if now.out != before.out { return "the command's pane did not close: {now.out}" }
    let h = ask(r, "split-right -t work", "")
    if h.status != 0 || h.out != "p3\n" { return "split-right (the shell): {h.status} '{h.out.trim()}'" }
    let f = ask(r, "focus-next -t work", "")
    if f.status != 0 { return "focus-next: {f.status} '{f.err.trim()}'" }
    let _x = client.input(a, "exit 3\r")
    until = now_ms() + 5000
    now = listed(r)
    while now.out != before.out && now_ms() < until {
        time.sleep(time.millis(50))
        now = listed(r)
    }
    if now.out != before.out { return "the shell's pane did not close: {now.out}" }
    until = now_ms() + 5000
    var ended = List[str]()
    while ended.len < 2 && now_ms() < until {
        let text = fs.read_text(path) else ""
        ended = ended_statuses(text)
        if ended.len < 2 { time.sleep(time.millis(50)) }
    }
    if ended.len < 2 { return "the trace has {ended.len} ended statuses" }
    if ended[0] != ended[1] || ended[0] == "0" { return "the command ended with status {ended[0]}, the shell with {ended[1]}" }
    print("MEASURE command-exits-at-once status={ended[0]}")
    client.hang_up(mut a)
    ""
}

// Every close names its cause in the server's trace, the ordinary ones
// too: a command's REPLY sent, a first message that is not a HELLO, a
// client gone before its WELCOME was written, a client's end of input, a
// detach's BYE sent, and the connection the stop closes.
fn row_close_causes(mut r: Rig) -> str {
    let path = (env.cwd() else ".") + "/" + r.dir + "-trace"
    fs.remove(path) else |_| {}
    let why = start_traced(mut r, "/bin/sh", 60000, path)
    if why.len > 0 { return why }
    var verb = List[str]()
    (mut verb).push("list-sessions")
    let listed = client.command_reply(verb)
    if listed.status != 0 { return "list-sessions status {listed.status}" }
    var k = List[byte]()
    proto.put(mut k, 0, 1)
    proto.put(mut k, 0, 1)
    proto.put(mut k, 97, 4)
    var a = client.dial(socket(r)) else |e| { return "dial-{e}" }
    let _k = client.send(a, 2, k)
    let silent = closed_silently(mut a)
    if silent.len > 0 { return "non-HELLO first: " + silent }
    client.hang_up(mut a)
    // A HELLO, then gone before anything is read back.
    var g = attach(r, 80, 24, "gone", 1) else |e| { return "dial-{e}" }
    client.hang_up(mut g)
    var ended = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut ended, "$", 5000) { return "no prompt" }
    client.hang_up(mut ended)
    var d = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut d, "$", 5000) { return "no prompt (second attach)" }
    let _d = client.send(d, 10, List[byte]())
    if !client.until_kind(mut d, 135, 3000) || d.end_code != 1 { return "detach: BYE {d.end_code}" }
    client.hang_up(mut d)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    let text = fs.read_text(path) else |e| { return "the trace: {e}" }
    var closes = 0
    for line in text.lines() {
        let at = line.find(" closed") else 0 - 1
        if !line.starts_with("warren-server: conn ") || at < 0 { continue }
        closes += 1
        let rest = line[at + 7..line.len]
        if !rest.starts_with(": ") || rest.trim().len < 3 { return "a close without its cause: '{line}'" }
    }
    for cause in "REPLY sent|not a HELLO|end of input|BYE 1 sent".split("|") {
        if !text.contains(cause) { return "no close names '{cause}' ({closes} closes)" }
    }
    for line in text.lines() {
        if line.contains("conn ") && line.contains("closed: ") && (line.contains("write failed") || line.contains("WELCOME")) {
            print("MEASURE close-causes gone-before-welcome {line}")
        }
    }
    ""
}

fn row_start_lock(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    // A second server for the same directory sees the first and exits 0;
    // the first keeps its socket.
    var c = process.command(r.warren)
    process.push_arg(mut c, "server")
    var second = process.start(c) else |e| { return "second start {e}" }
    let st2 = process.wait_status(take second) else 0 - 1
    if st2 != 0 { return "the second server exited {st2}" }
    var p = attach(r, 80, 24, "", 1) else |e| { return "the first server's socket is gone: {e}" }
    if !client.until_text(mut p, "$", 5000) { return "no prompt from the first server" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}


fn percentile(sorted: List[int], pct: int) -> int {
    if sorted.len == 0 { return 0 - 1 }
    var i = sorted.len * pct / 100
    if i >= sorted.len { i = sorted.len - 1 }
    sorted[i]
}

// Type count characters at the quiet session's prompt, one at a time, each
// timed from the KEY's send to the image showing it; Ctrl-U every 40.
fn keystrokes(mut q: client.Peer, count: int, gap_ms: int) -> List[int] {
    var times = List[int]()
    var typed = ""
    var n = 0
    while n < count {
        if gap_ms > 0 { time.sleep(time.millis(gap_ms)) }
        let ch = "abcdefghijklmnopqrstuvwxyz"[n % 26..n % 26 + 1]
        let t0 = time.monotonic_ns()
        let _k = client.key(q, 0, 0, 97 + n % 26)
        typed = typed + ch
        if !client.until_line(mut q, "$ " + typed, 10000) {
            eprint("keystroke {n} not shown; frames {q.frames} seq {q.image.seq} ended {q.ended} end {q.end_kind}/{q.end_code}; screen:\n" + client.screen_text(q))
            var ping = List[byte]()
            proto.put(mut ping, 5, 4)
            let _p = client.send(q, 12, ping)
            let pong = client.until_kind(mut q, 137, 3000)
            eprint("after: ping answered {pong}, frames {q.frames} seq {q.image.seq}; screen:\n" + client.screen_text(q))
            return List[int]()
        }
        (mut times).push((time.monotonic_ns() - t0) / 1000)
        if typed.len == 40 {
            let _u = client.key(q, 4, 0, 117)
            if !client.until_line(mut q, "$", 10000) {
                eprint("line not cleared after {n}; screen:\n" + client.screen_text(q))
                return List[int]()
            }
            typed = ""
        }
        n = n + 1
    }
    times
}

fn report(label: str, times: List[int]) -> int {
    var sorted = copy times
    sort.sort_ints(mut sorted)
    let worst = percentile(sorted, 100)
    print("MEASURE {label} keys={times.len} p50-us={percentile(sorted, 50)} p90-us={percentile(sorted, 90)} p99-us={percentile(sorted, 99)} max-us={worst}")
    worst
}

fn row_flood(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var q = attach(r, 80, 24, "quiet", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut q, "$", 5000) { return "no quiet prompt: " + client.screen_text(q) }
    let quiet = keystrokes(mut q, 120, 25)
    if quiet.len == 0 { return "a quiet keystroke was not shown" }
    let _b = report("keys-quiet gap-ms=25", quiet)
    var f = attach(r, 80, 24, "flood", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut f, "$", 5000) { return "no flood prompt" }
    let _i = client.input(f, "while :; do echo 0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopq; done\r")
    if !client.until_text(mut f, "0123456789abcdefghijklmnopqrstuvwxyz0123456789", 5000) { return "the flood did not start" }
    let _d = client.send(f, 10, List[byte]())
    client.hang_up(mut f)
    time.sleep(time.millis(200))
    let flooded = keystrokes(mut q, 120, 25)
    if flooded.len == 0 { return "a keystroke beside the flood was not shown" }
    let budget = env.get("WARREN_MEASURE_MASTER_READ") else "65536"
    let worst = report("keys-beside-flood master-read={budget}", flooded)
    client.hang_up(mut q)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    if worst > 2000000 { return "a keystroke beside the flood took {worst} us (bound 2 s)" }
    ""
}

fn rss_kb(pid: int) -> int {
    let text = fs.read_text("/proc/{pid}/status") else { return 0 - 1 }
    for line in text.lines() {
        if line.starts_with("VmRSS:") {
            let parts = line.words()
            if parts.len >= 2 { return parts[1].to_int() else 0 - 1 }
        }
    }
    0 - 1
}

fn row_rss_flat(mut r: Rig) -> str {
    let why = start_bounded(mut r, "/bin/sh", 600000)
    if why.len > 0 { return why }
    let pid = process.pid(process.Child { slot: r.server }) else 0 - 1
    let at_start = rss_kb(pid)
    if at_start < 0 { return "no /proc status for the server" }
    var q = attach(r, 80, 24, "quiet", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut q, "$", 5000) { return "no prompt" }
    let one_session = rss_kb(pid)
    var f = attach(r, 80, 24, "flood", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut f, "$", 5000) { return "no flood prompt" }
    let two_sessions = rss_kb(pid)
    print("MEASURE server-rss start-kb={at_start} one-session-80x24-kb={one_session} two-sessions-kb={two_sessions}")
    let _i = client.input(f, "while :; do echo 0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopq; done\r")
    let _d = client.send(f, 10, List[byte]())
    client.hang_up(mut f)
    let warm = keystrokes(mut q, 1000, 0)
    if warm.len == 0 { return "warm-up keystrokes failed" }
    let before = rss_kb(pid)
    let more = keystrokes(mut q, 10000, 0)
    if more.len == 0 { return "keystrokes failed" }
    let after = rss_kb(pid)
    print("MEASURE server-rss before-kb={before} after-kb={after} keys=10000 beside-a-flood")
    client.hang_up(mut q)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    if after - before > 1024 { return "server RSS grew {after - before} kB over 10000 keystrokes" }
    ""
}

fn row_last_output(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    let _i = client.input(p, "printf 'last-%s\\n' words; exit\r")
    if !client.until_kind(mut p, 135, 5000) || p.end_code != 2 { return "BYE {p.end_code}, expected session-ended" }
    var seen = false
    var row = 1
    while row <= p.image.rows {
        if proto.row_text(p.image, row) == "last-words" { seen = true }
        row = row + 1
    }
    if !seen { return "the pane's last output was not shown before its end: " + client.screen_text(p) }
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    let st = process.wait_status(take ch) else 0 - 1
    if st != 0 { return "server exit {st}" }
    ""
}

// A client still owing its ACK when the session ends: the pane's last
// words must reach it (after its ACK, before BYE session-ended).
fn row_last_output_after_ack(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    p.auto_ack = false
    let _h = client.input(p, "echo held-$((1+1))\r")
    if !client.until_kind(mut p, 131, 3000) { return "no image to hold" }
    let held = p.image.seq
    // While that image is unacknowledged, the program prints and ends.
    let _e = client.input(p, "echo last-$((20+22)); exit\r")
    time.sleep(time.millis(700))
    var a = List[byte]()
    proto.put(mut a, held, 4)
    let _a = client.send(p, 8, a)
    p.auto_ack = true
    var seen = false
    var n = 0
    while n < 200 {
        let k = client.step(mut p, 3000)
        if k <= 0 { n = 200 }
        if k == 131 && client.screen_text(p).contains("last-42") { seen = true }
        if k == 135 { n = 200 }
        n = n + 1
    }
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    let _st = process.wait_status(take ch) else 0 - 1
    if p.end_kind != 135 || p.end_code != 2 { return "BYE {p.end_code}, expected session-ended" }
    if !seen { return "the pane's last words never reached the client that owed its ACK: " + client.screen_text(p) }
    ""
}

fn row_late_child(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    // The master ends while its program lives on: the pane goes, and the
    // program is still reaped when it exits.
    let t0 = now_ms()
    let _i = client.input(p, "exec sh -c 'trap \"\" HUP; echo closing-$((1+1)); exec 0<&- 1>&- 2>&-; sleep 1'\r")
    if !client.until_kind(mut p, 135, 5000) || p.end_code != 2 { return "BYE {p.end_code}, expected session-ended" }
    let t1 = now_ms()
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    let st = process.wait_status(take ch) else 0 - 1
    let t2 = now_ms()
    if st != 0 { return "server exit {st}" }
    // Where the pane ends when its program closes the terminal, the server
    // waits for the program after the BYE; where the terminal stays open
    // until the program ends, the BYE itself waits. Either way the server
    // must not end before the program does (a second after the command),
    // and must reap it when it does.
    print("MEASURE late-child command-to-bye-ms={t1 - t0} bye-to-exit-ms={t2 - t1}")
    if t2 - t1 > 4500 { return "the server waited {t2 - t1} ms after the BYE: its late child was not reaped when it ended" }
    if t2 - t0 < 900 { return "the server ended {t2 - t0} ms after the command, before its pane's program (which ignores hangup) did" }
    ""
}

fn row_inherited_ignore(mut r: Rig) -> str {
    // The server starts with interrupt and quit ignored (as under a parent
    // that ignored them); its pane's program must still die of Ctrl-C.
    signal.ignore(signal.interrupt() | signal.quit()) else { return "ignore" }
    let why = start_server(mut r, "/bin/sh")
    signal.reset(signal.interrupt() | signal.quit()) else { return "reset" }
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    let _i = client.input(p, "sleep 30\r")
    time.sleep(time.millis(300))
    let _c = client.key(p, 4, 0, 99)
    let _e = client.input(p, "echo after-$((40+2))\r")
    if !client.until_text(mut p, "after-42", 5000) { return "Ctrl-C did not end the pane's command under an inherited ignore" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_pane_proc(mut r: Rig) -> str {
    let why = start_server(mut r, self_path() + " --print-proc")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 135, 5000) { return "the helper pane did not end" }
    let screen = client.screen_text(p)
    client.hang_up(mut p)
    var ch = process.Child { slot: r.server }
    r.started = false
    let _st = process.wait_status(take ch) else 0 - 1
    if screen.contains("proc=absent") { return "no /proc on this host" }
    // The helper's lines must have reached the client before any mask is
    // judged; an empty screen is named as such, never read as a mask.
    if !screen.contains("SigBlk:") || !screen.contains("unresettable=") {
        return "the helper's output never reached the client (screen: '" + screen.trim() + "')"
    }
    if !screen.contains("SigBlk:0000000000000000") { return "blocked signals inherited: " + screen }
    // Every signal the runtime can reset must be at its default; one it
    // refuses (the C library's own, glibc's 32 and 33) keeps what the server
    // inherited, and is named rather than failed.
    let ignored = mask_of(screen, "SigIgn:")
    if ignored < 0 { return "no SigIgn line: " + screen }
    var allowed = 0
    var kept = ""
    for n in numbers_of(screen, "unresettable") {
        var bit = 1
        var k = 1
        while k < n {
            bit = bit * 2
            k += 1
        }
        allowed = allowed | bit
        if ignored & bit != 0 { kept = if kept.len == 0 then "{n}" else kept + ",{n}" }
    }
    if kept.len > 0 { print("MEASURE pane-inherits-unresettable signals={kept}") }
    if ignored & (0 - 1 - allowed) != 0 { return "ignored signals inherited: " + screen }
    if !screen.contains("inherited-handles=0") { return "handles inherited: " + screen }
    ""
}

fn status_field(pid: int, name: str) -> int {
    let text = fs.read_text("/proc/{pid}/status") else { return 0 - 1 }
    for line in text.lines() {
        if line.starts_with(name) {
            let parts = line.words()
            if parts.len >= 2 { return parts[1].to_int() else 0 - 1 }
        }
    }
    0 - 1
}

fn row_threads(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    let pid = process.pid(process.Child { slot: r.server }) else 0 - 1
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    let _i = client.input(p, "echo threads\r")
    let _w = client.until_text(mut p, "threads", 3000)
    let n = status_field(pid, "Threads:")
    print("MEASURE server-threads={n} with one session and one client")
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if n < 0 { return "no /proc status for the server" }
    if n > 3 { return "the server runs {n} threads; the loop starts none of its own" }
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_max_pending(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    // MAX_PENDING (4) connections that send nothing; a fifth with a HELLO
    // waits in the backlog until one of the four goes.
    var quiet = List[client.Peer]()
    var i = 0
    while i < 4 {
        let q = client.dial(socket(r)) else |e| { return "dial-{e}" }
        (mut quiet).push(q)
        i = i + 1
    }
    time.sleep(time.millis(200))
    var fifth = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    let early = client.next(mut fifth, 700)
    if early.kind != 0 { return "the fifth connection was served beside four pending ({early.kind})" }
    client.hang_up(mut quiet[0])
    if !client.until_kind(mut fifth, 129, 3000) { return "the fifth connection was not served after one pending went" }
    client.hang_up(mut fifth)
    i = 1
    while i < 4 {
        client.hang_up(mut quiet[i])
        i = i + 1
    }
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_max_sessions(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var n = 0
    while n < 16 {
        var p = attach(r, 20, 6, "s{n}", 1) else |e| { return "dial-{e}" }
        if !client.until_kind(mut p, 129, 3000) { return "session {n}: no WELCOME ({p.end_code})" }
        let _d = client.send(p, 10, List[byte]())
        client.hang_up(mut p)
        n = n + 1
    }
    var extra = attach(r, 20, 6, "s16", 1) else |e| { return "dial-{e}" }
    let code = refusal(mut extra)
    client.hang_up(mut extra)
    let st = stop_server(mut r)
    if code != 7 { return "a 17th session: refusal {code}, expected resource-limit" }
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_max_connections(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    // MAX_CONNECTIONS (32) attached clients; a 33rd waits in the backlog
    // until one of them goes.
    var held = List[client.Peer]()
    var i = 0
    while i < 32 {
        var p = attach(r, 20, 6, "", 1) else |e| { return "dial-{e}" }
        if !client.until_kind(mut p, 129, 3000) { return "client {i}: no WELCOME ({p.end_code})" }
        (mut held).push(p)
        i = i + 1
    }
    var extra = attach(r, 20, 6, "", 1) else |e| { return "dial-{e}" }
    let early = client.next(mut extra, 700)
    if early.kind != 0 { return "a 33rd connection was served beside 32 ({early.kind})" }
    client.hang_up(mut held[0])
    if !client.until_kind(mut extra, 129, 3000) { return "the 33rd connection was not served after one went" }
    client.hang_up(mut extra)
    i = 1
    while i < 32 {
        client.hang_up(mut held[i])
        i = i + 1
    }
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_memory_budget(mut r: Rig) -> str {
    // A lowered budget (the server never raises its own) that one 80x24
    // session with one client fits, with room for one connection not yet
    // past HELLO (the start probe's, if not yet closed): a second session
    // and a second client of the first are refused resource-limit; the
    // first still works.
    let one = server.pane_bytes(80, 24) + server.attached_bytes(80, 24) + server.connection_bytes()
    env.set("WARREN_MEMORY_BUDGET", "{one}") else { return "env" }
    let why = start_server(mut r, "/bin/sh")
    env.set("WARREN_MEMORY_BUDGET", "0") else { return "env" }
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "a", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "the first session did not start ({p.end_code})" }
    var b = attach(r, 80, 24, "b", 1) else |e| { return "dial-{e}" }
    let code_b = refusal(mut b)
    client.hang_up(mut b)
    var c = attach(r, 80, 24, "a", 0) else |e| { return "dial-{e}" }
    let code_c = refusal(mut c)
    client.hang_up(mut c)
    let _i = client.input(p, "echo still-$((20+22))\r")
    let alive = client.until_text(mut p, "still-42", 5000)
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if code_b != 7 { return "a second session: refusal {code_b}, expected resource-limit" }
    if code_c != 7 { return "a second client: refusal {code_c}, expected resource-limit" }
    if !alive { return "the first session stopped answering" }
    if st != 0 { return "server exit {st}" }
    ""
}

fn row_resize_crossing(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    p.auto_ack = false
    if !client.until_kind(mut p, 131, 3000) { return "no first image" }
    let first = p.image.seq
    // A RESIZE while the old-size image is outstanding: nothing new until
    // that image is ACKed; then a full image at the new size, next seq.
    let _r = client.resize(p, 100, 30)
    let early = client.next(mut p, 600)
    if early.kind == 131 { return "an image was sent before the outstanding one was ACKed" }
    var a = List[byte]()
    proto.put(mut a, first, 4)
    let _a = client.send(p, 8, a)
    p.auto_ack = true
    if !client.until_kind(mut p, 131, 3000) { return "no image after the ACK" }
    if p.last_base != 0 { return "the image after a resize was a delta" }
    if p.image.seq != first + 1 { return "seq {p.image.seq} after {first}: numbering restarted" }
    if p.image.cols != 100 || p.image.rows != 30 { return "image {p.image.cols}x{p.image.rows}" }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// The shell line that floods titles: 200 of 4,000 bytes, then a mark.
fn title_flood() -> str {
    "i=0; t=$(printf '%04000d' 0); while [ $i -lt 200 ]; do printf '\\033]2;%s%s\\007' $i $t; i=$((i+1)); done; echo titles-$((100+100))\r"
}

// A client whose terminal takes OSC 52 writes (feature bit 8).
fn attach_clipboard(r: Rig) -> client.Peer ! client.DialErrors {
    var p = client.dial(socket(r))?
    let here = env.cwd() else "/"
    let _h = client.send(p, 1, client.hello_with(1, 80, 24, 3, 8, "xterm-256color", "", 1, here, env_names(), env_values()))
    p
}

// A client that stops reading is closed, alone, once what it has yet to
// take passes the event queue's cap: a pane makes 200 clipboard writes
// (OSC 52) of 3,996 base64 bytes each, which warren.toml lets programs
// make, to two clients whose terminals take them. An OSC string holds at
// most 4,096 bytes and a feed's writes come out as one event, so the flood
// has the title flood's shape. It is of events, not titles: a title is
// state, and a flood of titles never passes the cap.
fn row_too_slow(mut r: Rig) -> str {
    let config = beside(r, "config")
    fs.create_dir_all(config + "/warren") else |e| { return "mkdir: {e}" }
    fs.write_text(config + "/warren/warren.toml", "[clipboard]\nprograms = true\n") else |e| { return "warren.toml: {e}" }
    let was = env.get("XDG_CONFIG_HOME") else ""
    env.set("XDG_CONFIG_HOME", config) else { return "env" }
    let why = start_server(mut r, "/bin/sh")
    if was.len > 0 { env.set("XDG_CONFIG_HOME", was) else { return "env" } } else { env.unset("XDG_CONFIG_HOME") else |_| {} }
    if why.len > 0 { return why }
    var p = attach_clipboard(r) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    var w = attach_clipboard(r) else |e| { return "dial-{e}" }
    if !client.until_kind(mut w, 129, 3000) { return "watcher: no WELCOME" }
    // The first client stops reading; the pane writes the clipboard faster
    // than it could take it. Past its event queue it is closed, alone.
    let _i = client.input(w, "d=$(head -c 2997 /dev/zero | base64 | tr -d '\\n'); i=0; while [ $i -lt 200 ]; do printf '\\033]52;c;%s\\007' \"$d\"; i=$((i+1)); done; echo clips-$((100+100))\r")
    let t0 = now_ms()
    if !client.until_text(mut w, "clips-200", 90000) { return "the second client stalled: " + client.screen_text(w) }
    print("MEASURE too-slow clips-ms={now_ms() - t0} second-client-clips={w.clips}")
    // The stalled client finds its connection closed, without a BYE that
    // could not fit.
    var closed = false
    var n = 0
    while n < 2000 && !closed {
        let k = client.step(mut p, 2000)
        if k < 0 { closed = true }
        if k == 0 { n = 2000 }
        n = n + 1
    }
    if !closed { return "the stalled client was never closed" }
    client.hang_up(mut p)
    client.hang_up(mut w)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// A title is state: a client that stops reading through a flood of 200
// titles of 4,000 bytes stays attached (one TITLE waits in its queue, a
// newer one only marks it), and once it reads again it ends with the same
// last title as a client that read all along.
fn row_title_flood_survives(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var p = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_line(mut p, "$", 5000) { return "no prompt" }
    var w = attach(r, 80, 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut w, 129, 3000) { return "watcher: no WELCOME" }
    let _i = client.input(w, title_flood())
    if !client.until_text(mut w, "titles-200", 90000) { return "the reading client stalled: " + client.screen_text(w) }
    if !client.until_text(mut p, "titles-200", 30000) { return "the stalled client did not catch up: ended={p.ended} BYE {p.end_code}" }
    var n = 0
    while n < 20 {
        let _a = client.step(mut p, 100)
        let _b = client.step(mut w, 100)
        n += 1
    }
    if p.ended { return "the stalled client was detached: BYE {p.end_code}" }
    let pt = str_from_utf8(p.title[0..p.title.len]) else ""
    let wt = str_from_utf8(w.title[0..w.title.len]) else ""
    if !wt.starts_with("199") || pt != wt {
        let ph = if pt.len > 8 then pt[0..8] else pt
        let wh = if wt.len > 8 then wt[0..8] else wt
        return "the last titles differ: the stalled client's '{ph}…' ({pt.len} bytes), the reader's '{wh}…' ({wt.len} bytes)"
    }
    client.hang_up(mut p)
    client.hang_up(mut w)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    ""
}

// A focus move still brings the newly focused pane's title: a split's
// program sets its title while another pane has the focus, and focus-next
// brings that title to the attached client.
fn row_title_on_focus(mut r: Rig) -> str {
    let why = start_server(mut r, "/bin/sh")
    if why.len > 0 { return why }
    var a = attach(r, 80, 24, "work", 1) else |e| { return "dial-{e}" }
    if !client.until_text(mut a, "$", 5000) { return "no prompt" }
    let s = ask_words(r, carets("split-right^-t^work^--^/bin/sh^-c^printf '\\033]2;two\\007'; exec sleep 30"), "")
    if s.status != 0 { return "split-right: {s.status} '{s.err.trim()}'" }
    var n = 0
    while n < 5 {
        let _k = client.step(mut a, 100)
        n += 1
    }
    let before = str_from_utf8(a.title[0..a.title.len]) else ""
    if before == "two" { return "the unfocused pane's title reached the client" }
    let f = ask(r, "focus-next -t work", "")
    if f.status != 0 { return "focus-next: {f.status} '{f.err.trim()}'" }
    let until = now_ms() + 3000
    var title = before
    while title != "two" && now_ms() < until {
        let _k = client.step(mut a, 100)
        title = str_from_utf8(a.title[0..a.title.len]) else ""
    }
    if title != "two" { return "after focus-next the title is '{title}'" }
    client.hang_up(mut a)
    ""
}

// The number after `word` in a line, or -1.
fn number_in(line: str, word: str) -> int {
    let at = line.find(word) else 0 - 1
    if at < 0 { return 0 - 1 }
    let rest = line[at + word.len..line.len]
    let end = rest.find(" ") else rest.len
    rest[0..end].to_int() else 0 - 1
}

// The prompt-frame rows' client width: a column short of the clock's, so
// line one has no clock, the minute's redraw changes no cell, and no frame
// the rows did not cause stands between a key and its echo.
fn prompt_cols() -> int {
    server.CLOCK_MIN_COLS - 1
}

// The frames a trace holds so far.
fn frames_in(text: str) -> int {
    var n = 0
    for line in text.lines() {
        if line.starts_with("warren-server: frame conn ") { n += 1 }
    }
    n
}

// Each echo is composed in the turn that read it. A key's echo is a short
// read that leaves the master empty, so no timer stands between it and
// its frame. The server's trace gives each frame's turn and the turn that
// last read its panes; the summary counts the frames composed in the
// turn of their read.
fn row_prompt_frame(mut r: Rig) -> str {
    let path = (env.cwd() else ".") + "/" + r.dir + "-trace"
    fs.remove(path) else |_| {}
    let why = start_traced(mut r, "/bin/cat", 60000, path)
    if why.len > 0 { return why }
    var p = attach(r, prompt_cols(), 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no first image" }
    var quiet = 0
    while quiet < 1000 && client.step(mut p, 300) > 0 { quiet += 1 }
    let warm = fs.read_text(path) else |e| { return "the trace: {e}" }
    let before = frames_in(warm)
    var typed = ""
    var n = 0
    while n < 20 {
        time.sleep(time.millis(30))
        let _k = client.input(p, "q")
        typed = typed + "q"
        if !client.until_text(mut p, typed, 3000) { return "echo {n} not shown: " + client.screen_text(p) }
        n += 1
    }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    let text = fs.read_text(path) else |e| { return "the trace: {e}" }
    var seen = 0
    var frames = 0
    var prompt = 0
    var late = ""
    for line in text.lines() {
        if !line.starts_with("warren-server: frame conn ") { continue }
        seen += 1
        if seen <= before { continue }
        frames += 1
        let turn = number_in(line, " turn ")
        let read = number_in(line, " read-turn ")
        if turn >= 0 && turn == read { prompt += 1 } else if late.len == 0 { late = "turn {turn}, read in turn {read}" }
    }
    for line in text.lines() {
        if line.starts_with("warren-server: stopped after") { print("MEASURE prompt-frame {line[15..line.len]}") }
    }
    print("MEASURE prompt-frame echoes={n} frames={frames} in-read-turn={prompt}")
    if prompt < n { return "{prompt} of {n} echoes composed in the turn that read them; the first other frame: {late}" }
    ""
}

/// How long past the minute the minute row waits before its key: room for
/// the server's timer to have drawn line one again.
const MINUTE_MARGIN_MS: int = 1000

/// How long the minute row's client keeps its ACK after its key: long
/// enough for the server to read the echo first.
const MINUTE_HOLD_MS: int = 200

// The echo after the minute is composed in the turn that read it. At each
// minute the server draws line one again (the clock). This client takes
// what the minute sent but owes its ACK when its key's echo is read, as a
// client busy elsewhere would; a frame the minute sent then holds the
// echo's frame for that ACK. The row waits for the next minute: up to a
// minute and a second.
fn row_prompt_frame_minute(mut r: Rig) -> str {
    let path = (env.cwd() else ".") + "/" + r.dir + "-trace"
    fs.remove(path) else |_| {}
    let why = start_traced(mut r, "/bin/cat", 120000, path)
    if why.len > 0 { return why }
    var p = attach(r, prompt_cols(), 24, "", 1) else |e| { return "dial-{e}" }
    if !client.until_kind(mut p, 131, 5000) { return "no first image" }
    var quiet = 0
    while quiet < 1000 && client.step(mut p, 300) > 0 { quiet += 1 }
    p.auto_ack = false
    let now = time.unix_ms()
    let minute = (now / 60000 + 1) * 60000
    time.sleep(time.millis(minute + MINUTE_MARGIN_MS - now))
    var held = 0 - 1
    var sent = 0
    var k = client.step(mut p, 200)
    while k > 0 {
        if k == 131 {
            held = p.image.seq
            sent += 1
        }
        k = client.step(mut p, 200)
    }
    if k < 0 { return "the connection ended across the minute" }
    let mid = fs.read_text(path) else |e| { return "the trace: {e}" }
    let before = frames_in(mid)
    let _q = client.input(p, "q")
    time.sleep(time.millis(MINUTE_HOLD_MS))
    if held >= 0 {
        var a = List[byte]()
        proto.put(mut a, held, 4)
        let _a = client.send(p, 8, a)
    }
    p.auto_ack = true
    if !client.until_line(mut p, "q", 3000) { return "echo not shown: " + client.screen_text(p) }
    client.hang_up(mut p)
    let st = stop_server(mut r)
    if st != 0 { return "server exit {st}" }
    let text = fs.read_text(path) else |e| { return "the trace: {e}" }
    var seen = 0
    var turn = 0 - 1
    var read = 0 - 1
    for line in text.lines() {
        if !line.starts_with("warren-server: frame conn ") { continue }
        seen += 1
        if seen == before + 1 {
            turn = number_in(line, " turn ")
            read = number_in(line, " read-turn ")
        }
    }
    print("MEASURE prompt-frame-minute cols={prompt_cols()} minute-frames={sent} echo-turn={turn} read-turn={read}")
    if turn < 0 { return "no frame after the minute" }
    if turn != read { return "the echo after the minute was composed in turn {turn}, read in turn {read}; the minute sent {sent} frame(s)" }
    ""
}

fn run_row(warren: str, name: str) -> str {
    var r = rig(warren, name)
    var why = "no such row"
    if name == "echo" { why = row_echo(mut r) }
    else if name == "split-every-byte" { why = row_split_every_byte(mut r) }
    else if name == "bad-first-frame" { why = row_bad_first(mut r) }
    else if name == "refusals" { why = row_refusals(mut r) }
    else if name == "hello-timeout" { why = row_hello_timeout(mut r) }
    else if name == "stale-and-future-ack" { why = row_future_ack(mut r) }
    else if name == "fragment-interleave" { why = row_fragment_interleave(mut r) }
    else if name == "two-sizes" { why = row_two_sizes(mut r) }
    else if name == "never-ack-beside-active" { why = row_never_ack(mut r) }
    else if name == "detach-reattach" { why = row_detach_reattach(mut r) }
    else if name == "ctrl-c-is-a-byte" { why = row_ctrl_c(mut r) }
    else if name == "session-end" { why = row_session_end(mut r) }
    else if name == "command" { why = row_command(mut r) }
    else if name == "start-lock" { why = row_start_lock(mut r) }
    else if name == "flood-beside-quiet" { why = row_flood(mut r) }
    else if name == "rss-flat" { why = row_rss_flat(mut r) }
    else if name == "last-output" { why = row_last_output(mut r) }
    else if name == "late-child-reaped" { why = row_late_child(mut r) }
    else if name == "last-output-after-ack" { why = row_last_output_after_ack(mut r) }
    else if name == "inherited-ignore-reset" { why = row_inherited_ignore(mut r) }
    else if name == "pane-signals-and-handles" { why = row_pane_proc(mut r) }
    else if name == "threads" { why = row_threads(mut r) }
    else if name == "max-pending" { why = row_max_pending(mut r) }
    else if name == "max-sessions" { why = row_max_sessions(mut r) }
    else if name == "max-connections" { why = row_max_connections(mut r) }
    else if name == "memory-budget" { why = row_memory_budget(mut r) }
    else if name == "resize-crossing-image" { why = row_resize_crossing(mut r) }
    else if name == "too-slow" { why = row_too_slow(mut r) }
    else if name == "close-causes" { why = row_close_causes(mut r) }
    else if name == "prompt-frame" { why = row_prompt_frame(mut r) }
    else if name == "prompt-frame-minute" { why = row_prompt_frame_minute(mut r) }
    else if name == "verb-split-target" { why = row_verb_split_target(mut r) }
    else if name == "verb-refused-target" { why = row_verb_refused_target(mut r) }
    else if name == "verb-inside-pane" { why = row_verb_inside_pane(mut r) }
    else if name == "list-json" { why = row_list_json(mut r) }
    else if name == "ids-never-reused" { why = row_ids_never_reused(mut r) }
    else if name == "kill-session-ends" { why = row_kill_session_ends(mut r) }
    else if name == "rename-session" { why = row_rename_session(mut r) }
    else if name == "detach-from-shell" { why = row_detach_from_shell(mut r) }
    else if name == "split-in-dir" { why = row_split_in_dir(mut r) }
    else if name == "split-runs-command" { why = row_split_runs_command(mut r) }
    else if name == "split-prints-new-id" { why = row_split_prints_new_id(mut r) }
    else if name == "create-refusals-change-nothing" { why = row_create_refusals(mut r) }
    else if name == "command-exits-at-once" { why = row_command_exits_at_once(mut r) }
    else if name == "title-flood-survives" { why = row_title_flood_survives(mut r) }
    else if name == "title-on-focus" { why = row_title_on_focus(mut r) }
    else if name == "list-json-over-queue" { why = row_list_json_over_queue(mut r) }
    else if name == "reply-slow-reader" { why = row_reply_slow_reader(mut r) }
    else if name == "reply-reader-over" { why = row_reply_reader_over(mut r) }
    else if name == "reply-reader-under" { why = row_reply_reader_under(mut r) }
    else if name == "reply-fast-reader" { why = row_reply_fast_reader(mut r) }
    else if name == "two-large-replies" { why = row_two_large_replies(mut r) }
    else if name == "reply-projection" { why = row_reply_projection(mut r) }
    else if name == "reply-memory-refused" { why = row_reply_memory_refused(mut r) }
    else if name == "send-keys-bytes" { why = row_send_keys_bytes(mut r) }
    else if name == "send-keys-refusals" { why = row_send_keys_refusals(mut r) }
    else if name == "send-keys-skips-bindings" { why = row_send_keys_skips_bindings(mut r) }
    else if name == "send-keys-all-or-nothing" { why = row_send_keys_all_or_nothing(mut r) }
    else if name == "capture-screen" { why = row_capture_screen(mut r) }
    else if name == "capture-escapes" { why = row_capture_escapes(mut r) }
    else if name == "capture-cases" { why = row_capture_cases(mut r) }
    else if name == "capture-register" { why = row_capture_register(mut r) }
    else if name == "capture-full-ring" { why = row_capture_full_ring(mut r) }
    else if name == "capture-over-cap" { why = row_capture_over_cap(mut r) }
    if r.started { let _s = stop_server(mut r) }
    why
}

fn all_rows() -> List[str] {
    var x = List[str]()
    for n in "echo split-every-byte bad-first-frame refusals hello-timeout stale-and-future-ack fragment-interleave two-sizes never-ack-beside-active detach-reattach ctrl-c-is-a-byte inherited-ignore-reset session-end last-output late-child-reaped command start-lock max-pending max-sessions max-connections memory-budget resize-crossing-image too-slow last-output-after-ack close-causes prompt-frame prompt-frame-minute verb-split-target verb-refused-target verb-inside-pane list-json ids-never-reused kill-session-ends rename-session detach-from-shell split-in-dir split-runs-command split-prints-new-id create-refusals-change-nothing command-exits-at-once title-flood-survives title-on-focus list-json-over-queue reply-slow-reader reply-reader-over reply-reader-under reply-fast-reader two-large-replies reply-projection reply-memory-refused send-keys-bytes send-keys-refusals send-keys-skips-bindings send-keys-all-or-nothing capture-screen capture-escapes capture-cases capture-register capture-full-ring capture-over-cap".split(" ") {
        (mut x).push(n)
    }
    x
}


// The pane-side helper for the send-keys rows: its terminal raw, in MODE
// (`normal`, `cursor`: application cursor keys, `keypad`: those and the
// application keypad), it writes FILE.ready, waits for GO when one is named,
// then logs every byte it reads to FILE as `b N` until its terminal hangs up.
fn key_reader(path: str, mode: str, go: str) -> int {
    let was = term.mode(fs.stdin()) else { return 1 }
    // Raw, and no signals: Ctrl-C, Ctrl-Z and Ctrl-\ arrive as bytes.
    var raw = term.raw_bytes(was)
    raw.signals = false
    term.set_mode(fs.stdin(), raw) else { return 1 }
    var out = fs.stdout()
    if mode == "cursor" || mode == "keypad" { fs.write_chunk(mut out, "\u{1b}[?1h".bytes()) else |_| {} }
    if mode == "keypad" { fs.write_chunk(mut out, "\u{1b}=".bytes()) else |_| {} }
    fs.write_text(path + ".ready", "ready\n") else { return 1 }
    if go.len > 0 {
        while !fs.exists(go) { time.sleep(time.millis(10)) }
    }
    var tty = fs.stdin()
    while true {
        let got = fs.read_chunk(mut tty, 4096) else { break }
        if got.len == 0 { break }
        var log = List[byte]()
        for b in got {
            (mut log).push(98 as byte)
            (mut log).push(32 as byte)
            for d in "{b as int}".bytes() { (mut log).push(d) }
            (mut log).push(10 as byte)
        }
        fs.append_text(path, str_from_utf8(log) else "") else |_| {}
    }
    term.set_mode(fs.stdin(), was) else |_| {}
    0
}

// The pane-side helper for the capture rows: FILE's bytes to its terminal,
// then DONE written, then it waits for its terminal to hang up.
fn print_file(path: str, done: str) -> int {
    let b = fs.read_bytes(path) else { return 1 }
    var out = fs.stdout()
    fs.write_chunk(mut out, b) else { return 1 }
    fs.write_text(done, "printed\n") else { return 1 }
    var tty = fs.stdin()
    while true {
        let got = fs.read_chunk(mut tty, 256) else { break }
        if got.len == 0 { break }
    }
    0
}

// The pane-side helper for the reply rows: its title becomes 4,094 double
// quotes, then it waits for its terminal to hang up.
fn title_quotes() -> int {
    var b = List[byte]()
    for c in "\u{1b}]2;".bytes() { (mut b).push(c) }
    var i = 0
    while i < 4094 {
        (mut b).push(34 as byte)
        i += 1
    }
    (mut b).push(7 as byte)
    var out = fs.stdout()
    fs.write_chunk(mut out, b) else { return 1 }
    var tty = fs.stdin()
    while true {
        let got = fs.read_chunk(mut tty, 256) else { break }
        if got.len == 0 { break }
    }
    0
}

// The pane-side helper: this process's blocked and ignored signal masks
// and every descriptor above 2 that names a socket, a pseudo-terminal
// multiplexer or the server's lock (none may be inherited).
fn print_proc() -> int {
    let text = fs.read_text("/proc/self/status") else {
        print("proc=absent")
        return 0
    }
    for line in text.lines() {
        if line.starts_with("SigBlk:") || line.starts_with("SigIgn:") {
            let parts = line.words()
            if parts.len >= 2 { print("{parts[0]}{parts[1]}") }
        }
    }
    var leaked = 0
    let names = fs.read_dir("/proc/self/fd") else { return 1 }
    for n in names {
        let fd = n.to_int() else 0 - 1
        if fd > 2 {
            let target = str_from_utf8(fs.read_link("/proc/self/fd/{n}") else List[byte]()) else ""
            if target.starts_with("socket:") || target.contains("ptmx") || target.contains("start.lock") {
                print("leaked {fd} {target}")
                leaked = leaked + 1
            }
        }
    }
    print("inherited-handles={leaked}")
    // The numbers this runtime cannot reset (it refuses them by name): read
    // after the masks above, since probing changes this process's own.
    var refused = ""
    let last = signal.last() else 0
    let kill_n = signal.number(signal.kill()) else 0
    let stop_n = signal.number(signal.stop()) else 0
    var n = 1
    while n <= last {
        var no = false
        signal.reset_one(signal.host(n)) else |e| { no = "{e}" == "invalid" }
        // KILL and STOP are refused because nothing can ignore them.
        if no && n != kill_n && n != stop_n {
            refused = if refused.len == 0 then "{n}" else refused + ",{n}"
        }
        n += 1
    }
    print("unresettable={refused}")
    0
}

// The hexadecimal mask after `name` on the helper's screen, -1 if absent.
fn mask_of(screen: str, name: str) -> int {
    let at = screen.find(name) else 0 - 1
    if at < 0 { return 0 - 1 }
    var v = 0
    var i = at + name.len
    let b = screen.bytes()
    while i < b.len {
        let c = b[i] as int
        var d = 0 - 1
        if c >= 48 && c <= 57 { d = c - 48 }
        if c >= 97 && c <= 102 { d = c - 87 }
        if d < 0 { return v }
        v = v * 16 + d
        i += 1
    }
    v
}

// The comma list after `name=` on the screen, as numbers.
fn numbers_of(screen: str, name: str) -> List[int] {
    var out = List[int]()
    let at = screen.find(name + "=") else 0 - 1
    if at < 0 { return out }
    var rest = screen[at + name.len + 1..screen.len]
    let end = rest.find(" ") else rest.len
    let nl = rest.find("\n") else rest.len
    let stop = if end < nl then end else nl
    for part in rest[0..stop].split(",") {
        let v = part.trim().to_int() else 0
        if v > 0 { (mut out).push(v) }
    }
    out
}

fn self_path() -> str {
    let a0 = env.arg0()
    if a0.starts_with("/") { return a0 }
    let here = env.cwd() else "."
    here + "/" + a0
}

fn main() -> int {
    let args = env.args()
    if args.len == 1 && args[0] == "--print-proc" { return print_proc() }
    if args.len == 1 && args[0] == "--title-quotes" { return title_quotes() }
    if args.len == 3 && args[0] == "--key-reader" { return key_reader(args[1], args[2], "") }
    if args.len == 4 && args[0] == "--key-reader" { return key_reader(args[1], args[2], args[3]) }
    if args.len == 3 && args[0] == "--print-file" { return print_file(args[1], args[2]) }
    if args.len == 1 && args[0] == "--print-size" {
        let size = term.size(fs.stdin()) else |e| {
            print("size-{e}")
            return 1
        }
        print("{size.rows} {size.columns}")
        return 0
    }
    if args.len < 1 {
        eprint("usage: session_rows WARREN [ROW...]")
        return 2
    }
    let warren = args[0]
    var rows = List[str]()
    var i = 1
    while i < args.len {
        (mut rows).push(args[i])
        i = i + 1
    }
    if rows.len == 0 { rows = all_rows() }
    var failed = 0
    for name in rows {
        let t0 = now_ms()
        let why = run_row(warren, name)
        let t = now_ms() - t0
        if why.len == 0 {
            print("PASS {name} ms={t}")
        } else {
            failed = failed + 1
            print("FAIL {name} {why}")
        }
    }
    print("SESSION-ROWS rows={rows.len} failed={failed}")
    if failed > 0 { return 1 }
    let _j = str.join(",", rows)
    0
}
