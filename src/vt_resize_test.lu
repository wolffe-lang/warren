//! member: false
//! Ruled bottom anchoring, exact no-op/refusal and initial resize boundaries.
use vt
use std.mem.budget

fn test_taller_without_history() {
    var pane = vt.new(4, 1, 4096)
    vt.feed(mut pane, "c".bytes())
    assert(vt.resize(mut pane, 4, 3) == "")
    assert(pane.cols == 4 && pane.rows == 3, "resize-taller-geometry")
    assert(pane.primary.cells[0].base == 99 && pane.primary.extents[0] == 1, "resize-no-history-top-anchor")
    assert(pane.primary.extents[1] == 0 && pane.primary.extents[2] == 0)
    assert(pane.primary.cells[4].base == 32 && pane.primary.cells[8].base == 32)
    assert(pane.cursor_row == 1 && pane.cursor_col == 2 && pane.history.records == 0)
    assert(pane.region_top == 1 && pane.region_bottom == 3)
}

fn test_taller_pulls_one_history_line() {
    var pane = vt.new(4, 1, 4096)
    vt.feed(mut pane, "o\r\nc".bytes())
    assert(pane.history.records == 1)
    assert(vt.resize(mut pane, 4, 3) == "")
    assert(pane.primary.cells[0].base == 111 && pane.primary.cells[4].base == 99, "resize-one-older-line-pulled")
    assert(pane.primary.extents[0] == 1 && pane.primary.extents[1] == 1 && pane.primary.extents[2] == 0)
    assert(pane.cursor_row == 2 && pane.cursor_col == 2 && pane.history.records == 0)
}

fn test_taller_leaves_older_prefix() {
    var pane = vt.new(4, 1, 4096)
    vt.feed(mut pane, "1\r\n2\r\n3\r\n4\r\nc".bytes())
    assert(pane.history.records == 4)
    assert(vt.resize(mut pane, 4, 3) == "")
    assert(pane.primary.cells[0].base == 51 && pane.primary.cells[4].base == 52 && pane.primary.cells[8].base == 99, "resize-pulls-only-needed-history")
    assert(pane.cursor_row == 3 && pane.cursor_col == 2 && pane.history.records == 2)
    assert(pane.primary.line_ids[0] == 2 && pane.primary.line_ids[1] == 3 && pane.primary.line_ids[2] == 4)
}

fn test_same_size_and_named_refusal() {
    region frame(cap: 1048576) {
        var pane = vt.new(4, 3, 0)
        vt.feed(mut pane, "\u{1b}[2;3rabcd".bytes())
        assert(pane.pending_wrap && pane.region_top == 2)
        let original = vt.dump(pane)
        let stable = budget.charged(frame)
        assert(vt.resize(mut pane, 4, 3) == "")
        assert(budget.charged(frame) == stable, "resize-same-size-allocation")
        assert(vt.dump(pane) == original && pane.pending_wrap, "resize-r8-exact-no-op")
        assert(vt.resize(mut pane, 262145, 1) == "vt-size-area")
        assert(vt.resize(mut pane, 9223372036854775807, 9223372036854775807) == "vt-size-area")
        assert(vt.resize(mut pane, 0, 1) == "vt-size-area")
        assert(vt.dump(pane) == original && pane.rows == 3, "resize-refusal-leaves-state")
    }
}

fn main() -> int {
    test_taller_without_history()
    test_taller_pulls_one_history_line()
    test_taller_leaves_older_prefix()
    test_same_size_and_named_refusal()
    0
}
