//! member: true
//! SGR stores the form of a colour and changes only the pen, never old cells.

fn pen_flag(mut pen: Pen, bit: int, enabled: bool) {
    let set = pen.flags / bit % 2 == 1
    if enabled && !set { pen.flags += bit }
    else if !enabled && set { pen.flags -= bit }
}

fn sgr_flag(code: int) -> int {
    if code == 1 { return 1 }
    if code == 2 { return 2 }
    if code == 3 { return 4 }
    if code == 4 { return 8 }
    if code == 5 || code == 6 { return 32 }
    if code == 7 { return 64 }
    if code == 8 { return 128 }
    if code == 9 { return 256 }
    if code == 21 { return 16 }
    0
}

fn sgr_sub(p: Parser, index: int, sub: int) -> int {
    if sub >= p.subs[index] { return 0 }
    let value = p.params[index * 6 + sub]
    if value < 0 { return 0 }
    value
}

fn rgb_colour(red: int, green: int, blue: int) -> int {
    if red > 255 || green > 255 || blue > 255 { return 0 - 2 }
    16777216 + red * 65536 + green * 256 + blue
}

fn set_sgr_colour(mut pane: Vt, code: int, value: int) {
    if value == 0 - 2 { return }
    if code == 38 { pane.pen.foreground = value }
    else if code == 48 { pane.pen.background = value }
    // 58 is consumed with its arguments, but underline colour is not stored.
}

fn reset_pen(mut pane: Vt) {
    pane.pen.flags = 0
    pane.pen.foreground = 0 - 1
    pane.pen.background = 0 - 1
}

fn apply_sgr(mut pane: Vt) {
    if pane.parser.param_count == 0 { reset_pen(mut pane); return }
    var i = 0
    while i < pane.parser.param_count {
        let code = grid_param(pane.parser, i, 0, false)
        var consumed = 1
        if pane.parser.subs[i] > 1 {
            if code == 4 {
                let style = sgr_sub(pane.parser, i, 1)
                if style == 0 { pen_flag(mut pane.pen, 8, false) }
                else if style >= 1 && style <= 5 { pen_flag(mut pane.pen, 8, true) }
            } else if code == 38 || code == 48 || code == 58 {
                let form = sgr_sub(pane.parser, i, 1)
                if form == 5 {
                    let value = sgr_sub(pane.parser, i, 2)
                    if value <= 255 { set_sgr_colour(mut pane, code, value) }
                } else if form == 2 {
                    let start = if pane.parser.subs[i] == 6 { 3 } else { 2 }
                    let colour = rgb_colour(sgr_sub(pane.parser, i, start),
                        sgr_sub(pane.parser, i, start + 1), sgr_sub(pane.parser, i, start + 2))
                    set_sgr_colour(mut pane, code, colour)
                }
            }
        } else if code == 0 {
            reset_pen(mut pane)
        } else if code == 38 || code == 48 || code == 58 {
            let form = grid_param(pane.parser, i + 1, 0, false)
            if form == 5 {
                consumed = 3
                let value = grid_param(pane.parser, i + 2, 0, false)
                if value <= 255 { set_sgr_colour(mut pane, code, value) }
            } else if form == 2 {
                consumed = 5
                let colour = rgb_colour(grid_param(pane.parser, i + 2, 0, false),
                    grid_param(pane.parser, i + 3, 0, false), grid_param(pane.parser, i + 4, 0, false))
                set_sgr_colour(mut pane, code, colour)
            } else if i + 1 < pane.parser.param_count { consumed = 2 }
        } else if code >= 30 && code <= 37 {
            pane.pen.foreground = code - 30
        } else if code >= 40 && code <= 47 {
            pane.pen.background = code - 40
        } else if code >= 90 && code <= 97 {
            pane.pen.foreground = code - 90 + 8
        } else if code >= 100 && code <= 107 {
            pane.pen.background = code - 100 + 8
        } else if code == 39 {
            pane.pen.foreground = 0 - 1
        } else if code == 49 {
            pane.pen.background = 0 - 1
        } else if code == 22 {
            pen_flag(mut pane.pen, 1, false)
            pen_flag(mut pane.pen, 2, false)
        } else if code == 23 {
            pen_flag(mut pane.pen, 4, false)
        } else if code == 24 {
            pen_flag(mut pane.pen, 8, false)
            pen_flag(mut pane.pen, 16, false)
        } else if code == 25 {
            pen_flag(mut pane.pen, 32, false)
        } else if code == 27 {
            pen_flag(mut pane.pen, 64, false)
        } else if code == 28 {
            pen_flag(mut pane.pen, 128, false)
        } else if code == 29 {
            pen_flag(mut pane.pen, 256, false)
        } else {
            let bit = sgr_flag(code)
            if bit > 0 { pen_flag(mut pane.pen, bit, true) }
        }
        i += consumed
    }
}
