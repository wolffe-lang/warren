//! member: true
//! Cell and row editing with wide-character boundary repair.

fn blank_repaired_cell(mut screen: Screen, at: int, background: int, preserve_written: bool) {
    if preserve_written { blank_cell_preserving_written(mut screen, at, background) }
    else { blank_cell(mut screen, at, background) }
}

fn repair_row_pairs_policy(mut screen: Screen, cols: int, row: int, background: int, preserve_written: bool) {
    var col = 0
    let start = (row - 1) * cols
    while col < cols {
        if screen.cells[start + col].width == 2 {
            if col + 1 >= cols { blank_repaired_cell(mut screen, start + col, background, preserve_written) }
            else if screen.cells[start + col + 1].width != 0 { blank_repaired_cell(mut screen, start + col, background, preserve_written) }
        } else if screen.cells[start + col].width == 0 {
            if col == 0 { blank_repaired_cell(mut screen, start + col, background, preserve_written) }
            else if screen.cells[start + col - 1].width != 2 { blank_repaired_cell(mut screen, start + col, background, preserve_written) }
        }
        col += 1
    }
}

fn repair_row_pairs(mut screen: Screen, cols: int, row: int, background: int) {
    repair_row_pairs_policy(mut screen, cols, row, background, true)
}

fn recalculate_written_extent(mut screen: Screen, cols: int, row: int) {
    var end = cols
    let start = (row - 1) * cols
    while end > 0 && !screen.cells[start + end - 1].written { end -= 1 }
    screen.extents[row - 1] = end
}

fn shift_characters(mut screen: Screen, cols: int, row: int, col: int,
        amount: int, background: int, insert: bool) {
    let n = grid_clamp(amount, 1, cols - col + 1)
    if insert {
        var to = cols
        while to >= col + n {
            copy_cell(mut screen, (row - 1) * cols + to - 1, (row - 1) * cols + to - n - 1)
            to -= 1
        }
        var at = col
        while at < col + n {
            let cell_at = (row - 1) * cols + at - 1
            blank_cell(mut screen, cell_at, background)
            screen.cells[cell_at].written = true
            at += 1
        }
    } else {
        var to = col
        while to <= cols - n {
            copy_cell(mut screen, (row - 1) * cols + to - 1, (row - 1) * cols + to + n - 1)
            to += 1
        }
        var at = cols - n + 1
        while at <= cols { blank_cell(mut screen, (row - 1) * cols + at - 1, background); at += 1 }
    }
    repair_row_pairs_policy(mut screen, cols, row, background, insert)
    recalculate_written_extent(mut screen, cols, row)
}

fn copy_row(mut screen: Screen, cols: int, to: int, from: int) {
    var col = 0
    while col < cols { copy_cell(mut screen, (to - 1) * cols + col, (from - 1) * cols + col); col += 1 }
    screen.extents[to - 1] = screen.extents[from - 1]
    screen.wrapped[to - 1] = screen.wrapped[from - 1]
    screen.line_ids[to - 1] = screen.line_ids[from - 1]
    screen.line_offsets[to - 1] = screen.line_offsets[from - 1]
    screen.overflow_ids[to - 1] = screen.overflow_ids[from - 1]
}

fn blank_row(mut screen: Screen, cols: int, row: int, background: int) {
    var col = 0
    while col < cols { blank_cell(mut screen, (row - 1) * cols + col, background); col += 1 }
    screen.extents[row - 1] = 0
    screen.wrapped[row - 1] = false
    fresh_row_line(mut screen, row)
}

fn shift_lines(mut screen: Screen, cols: int, row: int, bottom: int,
        amount: int, background: int, insert: bool) {
    let n = grid_clamp(amount, 1, bottom - row + 1)
    if insert {
        var to = bottom
        while to >= row + n { copy_row(mut screen, cols, to, to - n); to -= 1 }
        var at = row
        while at < row + n { blank_row(mut screen, cols, at, background); at += 1 }
    } else {
        var to = row
        while to <= bottom - n { copy_row(mut screen, cols, to, to + n); to += 1 }
        var at = bottom - n + 1
        while at <= bottom { blank_row(mut screen, cols, at, background); at += 1 }
    }
}

fn dispatch_editing(mut pane: Vt, final: int) {
    if pane.parser.param_count > 1 { return }
    let amount = grid_param(pane.parser, 0, 1, true)
    if final == 64 || final == 80 {
        pane.pending_wrap = false
        if pane.active_alternate {
            shift_characters(mut pane.alternate, pane.cols, pane.cursor_row, pane.cursor_col, amount, pane.pen.background, final == 64)
        } else {
            shift_characters(mut pane.primary, pane.cols, pane.cursor_row, pane.cursor_col, amount, pane.pen.background, final == 64)
        }
    } else {
        if pane.cursor_row < pane.region_top || pane.cursor_row > pane.region_bottom { return }
        pane.pending_wrap = false
        pane.cursor_col = 1
        if pane.active_alternate {
            shift_lines(mut pane.alternate, pane.cols, pane.cursor_row, pane.region_bottom, amount, pane.pen.background, final == 76)
        } else {
            shift_lines(mut pane.primary, pane.cols, pane.cursor_row, pane.region_bottom, amount, pane.pen.background, final == 76)
        }
    }
    if !pane.active_alternate { repair_primary_lineage(mut pane) }
}
