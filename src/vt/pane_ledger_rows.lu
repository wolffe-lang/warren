//! member: false
//! Interpreter-only pane ledger; default 8MiB history is native-only. A
//! pane at any cap charges what the same pane with no history does (measured
//! first, so the equality holds whatever its screens and buffers cost).
use std.mem.budget
use std.io

fn main() -> int {
    var none = 0
    region empty(cap: 33554432) {
        let before = budget.charged(empty)
        let _pane = new(80, 24, 0)
        none = budget.charged(empty) - before
        io.write_line("MEASURE pane-interpreter cols=80 rows=24 history-cap=0 retained={none}")
    }
    region frame(cap: 33554432) {
        let before = budget.charged(frame)
        let pane = new(80, 24, 4096)
        let retained = budget.charged(frame) - before
        io.write_line("MEASURE pane-interpreter cols=80 rows=24 history-cap=4096 retained={retained}")
        assert(retained == none, "pane-interpreter-small-history-budget")
    }
    0
}
