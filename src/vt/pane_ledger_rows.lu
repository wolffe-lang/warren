//! member: false
//! Interpreter-only pane ledger; default 8MiB history is native-only.
use std.mem.budget
use std.io

fn main() -> int {
    region frame(cap: 33554432) {
        let before = budget.charged(frame)
        let pane = new(80, 24, 4096)
        let retained = budget.charged(frame) - before
        assert(pane.history.bytes.len == 4096 && retained == 781904, "pane-interpreter-small-history-budget")
        io.write_line("MEASURE pane-interpreter cols=80 rows=24 history-cap=4096 retained={retained}")
    }
    0
}
