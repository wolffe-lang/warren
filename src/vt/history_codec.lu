//! member: true
//! Two-pass screen-line RLE and a reusable, allocation-free scalar reader.

/// Reusable scalar reader state. A successful step exposes one scalar and
/// its run kind/rendition without allocating another result record.
pub struct HistoryReader {
    at: int, remaining: int, run_left: int, value: int,
    kind: int, flags: int, foreground: int, background: int,
}

fn new_history_reader() -> HistoryReader {
    HistoryReader { at: 0, remaining: 0, run_left: 0, value: 0,
        kind: 0, flags: 0, foreground: 0 - 1, background: 0 - 1 }
}

fn history_colour(value: int) -> int {
    if value == 0 - 1 { return 0 }
    if value >= 0 && value <= 255 { return value + 1 }
    assert(value >= 16777216 && value <= 33554431, "history-colour-form")
    33554432 + value - 16777216
}

fn history_decoded_colour(value: int) -> int {
    if value == 0 { return 0 - 1 }
    if value <= 256 { return value - 1 }
    assert(value >= 33554432 && value <= 50331647, "history-colour-form")
    16777216 + value - 33554432
}

fn history_scalar_bytes(cp: int) -> int {
    assert(cp >= 0 && cp <= 1114111 && (cp < 55296 || cp > 57343), "history-scalar")
    if cp < 128 { return 1 }
    if cp < 2048 { return 2 }
    if cp < 65536 { return 3 }
    4
}

fn history_encoded_byte(mut history: History, at: int, position: int, value: int) {
    history.bytes[(at + position) % history.bytes.len] = value as byte
}

fn history_encoded_scalar(mut history: History, at: int, position: int, cp: int) -> int {
    let size = history_scalar_bytes(cp)
    if size == 1 { history_encoded_byte(mut history, at, position, cp) }
    else if size == 2 {
        history_encoded_byte(mut history, at, position, 192 + cp / 64)
        history_encoded_byte(mut history, at, position + 1, 128 + cp % 64)
    } else if size == 3 {
        history_encoded_byte(mut history, at, position, 224 + cp / 4096)
        history_encoded_byte(mut history, at, position + 1, 128 + cp / 64 % 64)
        history_encoded_byte(mut history, at, position + 2, 128 + cp % 64)
    } else {
        history_encoded_byte(mut history, at, position, 240 + cp / 262144)
        history_encoded_byte(mut history, at, position + 1, 128 + cp / 4096 % 64)
        history_encoded_byte(mut history, at, position + 2, 128 + cp / 64 % 64)
        history_encoded_byte(mut history, at, position + 3, 128 + cp % 64)
    }
    position + size
}

fn history_paint_end(screen: Screen, cols: int, row: int) -> int {
    var end = cols
    while end > screen.extents[row - 1] {
        if screen.cells[(row - 1) * cols + end - 1].background != 0 - 1 { return end }
        end -= 1
    }
    end
}

fn history_walk_line(mut history: History, screen: Screen, cols: int,
        first_row: int, last_row: int, record_at: int) -> int {
    var position = 24
    var run_at = 0 - 1
    var last_flags = 0 - 1
    var last_foreground = 0 - 2
    var last_background = 0 - 2
    var last_kind = 0 - 1
    var row = first_row
    while row <= last_row {
        let end = history_paint_end(screen, cols, row)
        var col = 1
        while col <= end {
            let cell_at = (row - 1) * cols + col - 1
            if screen.cells[cell_at].width != 0 {
                let kind = if col > screen.extents[row - 1] { 1 } else { 0 }
                let flags = if kind == 1 { 0 } else { screen.cells[cell_at].flags }
                let foreground = if kind == 1 { 0 - 1 } else { screen.cells[cell_at].foreground }
                let background = screen.cells[cell_at].background
                if kind != last_kind || flags != last_flags || foreground != last_foreground || background != last_background {
                    if record_at >= 0 && run_at >= 0 {
                        history_put_word(mut history, record_at, run_at, 4, position - run_at - 12)
                    }
                    run_at = position
                    if record_at >= 0 {
                        assert(flags >= 0 && flags <= 511)
                        history_put_word(mut history, record_at, run_at, 4, 0)
                        history_put_word(mut history, record_at, run_at + 4, 4, history_colour(foreground) + (flags % 64) * 67108864)
                        history_put_word(mut history, record_at, run_at + 8, 4, history_colour(background) + (flags / 64) * 67108864 + kind * 536870912)
                    }
                    position += 12
                    last_kind = kind
                    last_flags = flags
                    last_foreground = foreground
                    last_background = background
                }
                let cp = if kind == 1 { 32 } else { screen.cells[cell_at].base }
                if record_at >= 0 { position = history_encoded_scalar(mut history, record_at, position, cp) }
                else { position += history_scalar_bytes(cp) }
                if kind == 0 {
                    let mark1 = screen.cells[cell_at].mark1
                    let mark2 = screen.cells[cell_at].mark2
                    if mark1 != 0 {
                        if record_at >= 0 { position = history_encoded_scalar(mut history, record_at, position, mark1) }
                        else { position += history_scalar_bytes(mark1) }
                    }
                    if mark2 != 0 {
                        if record_at >= 0 { position = history_encoded_scalar(mut history, record_at, position, mark2) }
                        else { position += history_scalar_bytes(mark2) }
                    }
                }
            }
            col += 1
        }
        row += 1
    }
    if record_at >= 0 && run_at >= 0 {
        history_put_word(mut history, record_at, run_at, 4, position - run_at - 12)
    }
    position - 24
}

fn history_encode_line(mut history: History, screen: Screen, cols: int,
        first_row: int, last_row: int, id: int, start_cell: int) -> bool {
    assert(cols >= 1 && first_row >= 1 && last_row >= first_row && screen.extents.len >= last_row)
    assert(cols <= screen.cells.len / last_row)
    let body_length = history_walk_line(mut history, screen, cols, first_row, last_row, 0 - 1)
    let at = history_reserve(mut history, id, start_cell, body_length)
    if at < 0 { return false }
    let written = history_walk_line(mut history, screen, cols, first_row, last_row, at)
    assert(written == body_length, "history-encoded-byte-count")
    true
}

fn history_reader_start(mut reader: HistoryReader, history: History, at: int) {
    let length = history_get_word(history, at, 0, 4)
    assert(length >= 24 && length <= history.used)
    reader.at = (at + 24) % history.bytes.len
    reader.remaining = length - 24
    reader.run_left = 0
    reader.value = 0
}

fn history_reader_byte(mut reader: HistoryReader, history: History) -> int {
    assert(reader.remaining > 0 && reader.run_left > 0, "history-run-byte-count")
    let value = history.bytes[reader.at] as int
    reader.at = (reader.at + 1) % history.bytes.len
    reader.remaining -= 1
    reader.run_left -= 1
    value
}

fn history_reader_next(mut reader: HistoryReader, history: History) -> bool {
    if reader.remaining == 0 { assert(reader.run_left == 0); return false }
    if reader.run_left == 0 {
        assert(reader.remaining >= 12, "history-run-header")
        let run_at = reader.at
        let length = history_get_word(history, run_at, 0, 4)
        let foreground = history_get_word(history, run_at, 4, 4)
        let background = history_get_word(history, run_at, 8, 4)
        reader.at = (reader.at + 12) % history.bytes.len
        reader.remaining -= 12
        assert(length > 0 && length <= reader.remaining, "history-run-byte-count")
        reader.run_left = length
        reader.kind = background / 536870912
        assert(reader.kind <= 1, "history-run-kind")
        reader.flags = foreground / 67108864 + (background / 67108864 % 8) * 64
        reader.foreground = history_decoded_colour(foreground % 67108864)
        reader.background = history_decoded_colour(background % 67108864)
    }
    let head = history_reader_byte(mut reader, history)
    if head < 128 { reader.value = head; return true }
    assert(head >= 194 && head <= 244, "history-utf8-lead")
    var remaining = if head < 224 { 1 } else if head < 240 { 2 } else { 3 }
    var cp = head - (if head < 224 { 192 } else if head < 240 { 224 } else { 240 })
    while remaining > 0 {
        let next = history_reader_byte(mut reader, history)
        assert(next >= 128 && next <= 191, "history-utf8-continuation")
        cp = cp * 64 + next - 128
        remaining -= 1
    }
    assert(history_scalar_bytes(cp) >= 2)
    reader.value = cp
    true
}
