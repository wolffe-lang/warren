//! member: true
//! Screen-line run encoding seam.

/// Reusable scalar reader state. A successful step exposes one scalar and
/// its run kind/rendition without allocating another result record.
pub struct HistoryReader {
    at: int, remaining: int, run_left: int, value: int,
    kind: int, flags: int, foreground: int, background: int,
}

fn new_history_reader() -> HistoryReader {
    HistoryReader { at: 0, remaining: 0, run_left: 0, value: 0,
        kind: 0, flags: 0, foreground: 0 - 1, background: 0 - 1 }
}

fn history_encode_line(mut history: History, screen: Screen, cols: int,
        first_row: int, last_row: int, id: int, start_cell: int) -> bool {
    assert(cols >= 1 && first_row >= 1 && last_row >= first_row && screen.extents.len >= last_row)
    history_reserve(mut history, id, start_cell, 0) >= 0
}

fn history_reader_start(mut reader: HistoryReader, history: History, at: int) {
    assert(history.records >= 0)
    reader.at = at
    reader.remaining = 0
}

fn history_reader_next(mut reader: HistoryReader, history: History) -> bool {
    assert(history.records >= 0)
    reader.value = 0
    false
}
