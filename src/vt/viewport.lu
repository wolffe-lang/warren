//! member: true
//! A read-only window over retained primary history and the live screen.

/// One client's window over one pane. `screen` holds `rows` rows of `cols`
/// cells, row-major with stride `cols`, each row carrying its logical line id
/// and offset. The window's top row is `back` rows above the live screen's
/// first row; 0 is the live screen. `scratch`, `flow` and `reader` are reused
/// working storage. Buffers grow to the largest pane filled and are kept.
/// The last search's match is logical line `found_id` (-1: none) from cell
/// `found_from` to `found_to`; `find` is that search's working state.
pub struct View {
    cols: int, rows: int, back: int,
    screen: Screen, scratch: Screen,
    flow: ReflowState, reader: HistoryReader,
    marked: bool, mark_r0: int, mark_c0: int, mark_r1: int, mark_c1: int,
    found_id: int, found_from: int, found_to: int, find: FindState,
}

/// An empty window: one cell until `reserve_view` grows it.
pub fn new_view() -> View {
    View { cols: 0, rows: 0, back: 0, screen: new_screen(1, 1), scratch: new_screen(1, 1),
        flow: new_reflow_state(), reader: new_history_reader(),
        marked: false, mark_r0: 0, mark_c0: 0, mark_r1: 0, mark_c1: 0,
        found_id: 0 - 1, found_from: 0, found_to: 0, find: new_find_state() }
}

/// Whether the window's buffers hold a pane of this size.
pub fn view_fits(view: View, cols: int, rows: int) -> bool {
    view.screen.cells.len >= cols * rows && view.screen.extents.len >= rows &&
        view.scratch.cells.len >= cols * rows && view.scratch.extents.len >= rows
}

/// Grow the window's buffers to hold a pane of this size; smaller sizes keep
/// them. The only allocation a window makes, so a caller with a per-turn
/// region calls it outside that region; fills and lookups never allocate.
pub fn reserve_view(mut view: View, cols: int, rows: int) {
    if view_fits(view, cols, rows) { return }
    view.screen = new_screen(cols, rows)
    view.scratch = new_screen(cols, rows)
}

// The first record of the logical line whose last record is `at`. A line's
// fragments are consecutive records with one id.
fn view_line_start(history: History, at: int) -> int {
    let id = history_get_word(history, at, 8, 8)
    var start = at
    var more = true
    while more {
        let previous = history_previous(history, start)
        if previous < 0 || history_get_word(history, previous, 8, 8) != id { more = false }
        else { start = previous }
    }
    start
}

// Lay the line's records start..last at `cols`, emitting its rows first..last
// (1-based within the line) into the scratch rows 1.. when `emit`. Returns the
// line's row count. The scratch holds at least one window of rows.
fn view_lay_line(mut view: View, history: History, start: int, last: int, cols: int,
        first_row: int, last_row: int, emit: bool) -> int {
    reflow_start(mut view.flow)
    var at = start
    var more = true
    while more {
        reflow_record(mut view.flow, history, at, mut view.reader, mut view.scratch, cols, first_row, last_row, emit)
        if at == last { more = false }
        else { at = (at + history_get_word(history, at, 0, 4)) % history.cap }
    }
    view.flow.row
}

// Fill window rows 1..rows that history covers for a window `back` rows up.
// Walks back from the newest line only as far as the window reaches. Returns
// how many history rows lie at or below the window's top, at most `back`.
fn view_history_rows(mut view: View, history: History, cols: int, rows: int, back: int) -> int {
    if history.records == 0 || history.cap == 0 { return 0 }
    var below = 0
    var at = history_newest_at(history)
    while at >= 0 && below < back {
        let start = view_line_start(history, at)
        let n = view_lay_line(mut view, history, start, at, cols, 1, 1, false)
        // Row i of this line (1-based) is `below + n - i + 1` rows above the
        // live screen; window row r (0-based) is `back - r` rows above it.
        var high = below + n
        if high > back { high = back }
        var low = below + 1
        if low < back - rows + 1 { low = back - rows + 1 }
        if low <= high {
            let first = below + n - high + 1
            let last = below + n - low + 1
            var row = 1
            while row <= last - first + 1 { blank_row(mut view.scratch, cols, row, 0 - 1); row += 1 }
            let _laid = view_lay_line(mut view, history, start, at, cols, first, last, true)
            let to = back - high + 1
            row = 0
            while row <= last - first {
                copy_screen_row(mut view.screen, view.scratch, cols, to + row, row + 1)
                row += 1
            }
        }
        below += n
        at = history_previous(history, start)
    }
    if below > back { back } else { below }
}

/// Fill the window whose top row is `back` rows above the live screen's first
/// row, at the pane's current size, and return the back shown: clamped to the
/// rows history retains, and 0 on the alternate screen, which has none. History
/// holds only what is above the screen's first row, so no row appears twice.
/// -1, and nothing filled, when the buffers do not hold the pane's size.
pub fn fill_view(mut view: View, pane: Vt, back: int) -> int {
    let cols = pane.cols
    let rows = pane.rows
    if !view_fits(view, cols, rows) { return 0 - 1 }
    view.cols = cols
    view.rows = rows
    var shown = if back < 0 || pane.active_alternate { 0 } else { back }
    if shown > 0 {
        let found = view_history_rows(mut view, pane.history, cols, rows, shown)
        if found < shown {
            shown = found
            if shown > 0 { let _again = view_history_rows(mut view, pane.history, cols, rows, shown) }
        }
    }
    var row = shown + 1
    while row <= rows {
        if pane.active_alternate { copy_screen_row(mut view.screen, pane.alternate, cols, row, row - shown) }
        else { copy_screen_row(mut view.screen, pane.primary, cols, row, row - shown) }
        row += 1
    }
    // A line that goes on from history into the live rows wraps between them.
    if shown > 0 && shown < rows && view.screen.line_ids[shown] == view.screen.line_ids[shown - 1] {
        view.screen.wrapped[shown - 1] = true
    }
    view.back = shown
    shown
}

/// How many rows above the live screen's first row the row holding logical
/// line `id` at cell `offset` now is, or -1 when history no longer holds it
/// (or the buffers do not hold the pane's size).
pub fn view_back_of(mut view: View, pane: Vt, id: int, offset: int) -> int {
    if id < 0 || pane.history.records == 0 || pane.history.cap == 0 { return 0 - 1 }
    let cols = pane.cols
    if !view_fits(view, cols, pane.rows) { return 0 - 1 }
    var below = 0
    var at = history_newest_at(pane.history)
    while at >= 0 {
        let start = view_line_start(pane.history, at)
        if history_get_word(pane.history, start, 8, 8) == id {
            view.flow.cursor.id = id
            view.flow.cursor.offset = offset
            let n = view_lay_line(mut view, pane.history, start, at, cols, 1, 1, false)
            let found = view.flow.cursor.found
            let row = view.flow.cursor.row
            view.flow.cursor.id = 0 - 1
            if !found { return 0 - 1 }
            return below + n - row + 1
        }
        below += view_lay_line(mut view, pane.history, start, at, cols, 1, 1, false)
        at = history_previous(pane.history, start)
    }
    0 - 1
}

/// Mark the window's cells from row r0, column c0 to row r1, column c1
/// (1-based, either way round, clamped to the window) as a selection.
pub fn mark_view(mut view: View, r0: int, c0: int, r1: int, c1: int) {
    var a_row = grid_clamp(r0, 1, view.rows)
    var a_col = grid_clamp(c0, 1, view.cols)
    var b_row = grid_clamp(r1, 1, view.rows)
    var b_col = grid_clamp(c1, 1, view.cols)
    if b_row < a_row || (b_row == a_row && b_col < a_col) {
        let row = a_row
        let col = a_col
        a_row = b_row
        a_col = b_col
        b_row = row
        b_col = col
    }
    view.mark_r0 = a_row
    view.mark_c0 = a_col
    view.mark_r1 = b_row
    view.mark_c1 = b_col
    view.marked = view.rows > 0 && view.cols > 0
}

/// Clear the window's selection.
pub fn unmark_view(mut view: View) {
    view.marked = false
}

/// Whether the window's cell at row, col (1-based) is selected.
pub fn view_marked(view: View, row: int, col: int) -> bool {
    if !view.marked || row < view.mark_r0 || row > view.mark_r1 { return false }
    if row == view.mark_r0 && col < view.mark_c0 { return false }
    if row == view.mark_r1 && col > view.mark_c1 { return false }
    true
}

fn marked_scalar(mut out: List[byte], cp: int, emit: bool) -> int {
    let n = if cp < 128 { 1 } else if cp < 2048 { 2 } else if cp < 65536 { 3 } else { 4 }
    if !emit { return n }
    if n == 1 { (mut out).push(cp as byte) }
    else if n == 2 {
        (mut out).push((192 + cp / 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else if n == 3 {
        (mut out).push((224 + cp / 4096) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else {
        (mut out).push((240 + cp / 262144) as byte)
        (mut out).push((128 + cp / 4096 % 64) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    }
    n
}

fn marked_blank(view: View, at: int) -> bool {
    view.screen.cells[at].width != 0 && view.screen.cells[at].base == 32 &&
        view.screen.cells[at].mark1 == 0 && view.screen.cells[at].mark2 == 0
}

// The selected text's length, written to `out` too when `emit`.
fn marked_pass(view: View, mut out: List[byte], emit: bool) -> int {
    let cols = view.cols
    var bytes = 0
    var row = view.mark_r0
    while row <= view.mark_r1 {
        var first = if row == view.mark_r0 { view.mark_c0 } else { 1 }
        let last = if row == view.mark_r1 { view.mark_c1 } else { cols }
        let base = (row - 1) * cols
        // A part starting on a wide glyph's right half takes the glyph whole.
        if first > 1 && view.screen.cells[base + first - 1].width == 0 { first -= 1 }
        let joined = row < view.mark_r1 && view.screen.wrapped[row - 1]
        var end = last
        if !joined {
            while end >= first && marked_blank(view, base + end - 1) { end -= 1 }
        }
        var col = first
        while col <= end {
            let at = base + col - 1
            if view.screen.cells[at].width != 0 {
                let cp = if view.screen.cells[at].base == 0 { 32 } else { view.screen.cells[at].base }
                bytes += marked_scalar(mut out, cp, emit)
                if view.screen.cells[at].mark1 != 0 { bytes += marked_scalar(mut out, view.screen.cells[at].mark1, emit) }
                if view.screen.cells[at].mark2 != 0 { bytes += marked_scalar(mut out, view.screen.cells[at].mark2, emit) }
            }
            col += 1
        }
        if row < view.mark_r1 && !joined { bytes += marked_scalar(mut out, 10, emit) }
        row += 1
    }
    bytes
}

/// Empty `out` and write the selected text into it, at most `cap` bytes:
/// rows join at a soft wrap and otherwise end with a newline, a row part's
/// trailing blanks are dropped, a wide glyph is taken once (a part starting on
/// its right half takes it whole) and combining marks follow their base.
/// Returns the bytes written, or -1 with `out` untouched when nothing is
/// selected or the text would not fit. Pushes into `out` are its only writes.
pub fn view_marked_text(view: View, mut out: List[byte], cap: int) -> int {
    if !view.marked { return 0 - 1 }
    let need = marked_pass(view, mut out, false)
    if need > cap { return 0 - 1 }
    (mut out).reset()
    marked_pass(view, mut out, true)
}
