//! member: true
//! Pane and screen storage. A screen is flat to make rectangular bounds
//! and in-place cell mutation explicit; both screens own their arrays.

/// A cell's scalar payload. Width is 1, 2, or 0 for a wide continuation;
/// mark fields are zero when absent. Rendition colours are -1 for default,
/// 0..255 for a palette entry, or 16777216 + packed RGB for true colour.
pub struct Cell {
    base: int, mark1: int, mark2: int, width: int,
    flags: int, foreground: int, background: int,
}

/// One rectangular screen, stored flat; row metadata is indexed from zero.
pub struct Screen {
    cells: List[Cell],
    extents: List[int],
    wrapped: List[bool],
}

/// The current rendition, distinct from every cell already on the screen.
pub struct Pen { flags: int, foreground: int, background: int }

/// One screen's DECSC/DECRC cache. Coordinates are physical and 1-based;
/// charset selectors and the shift are restored with pen, origin and wrap.
pub struct SavedCursor {
    valid: bool, row: int, col: int, flags: int, foreground: int, background: int,
    origin: bool, pending_wrap: bool, g0: int, g1: int, shifted: bool,
}

/// Screen-affecting modes needed by the initial grid operations.
pub struct Modes {
    autowrap: bool, origin: bool, insert: bool, newline: bool,
    cursor_visible: bool,
}

/// One pane's pure terminal state. Cursor and region coordinates are 1-based;
/// tab and row arrays are 0-based. History storage is not implemented yet.
pub struct Vt {
    cols: int, rows: int,
    primary: Screen, alternate: Screen, active_alternate: bool,
    cursor_row: int, cursor_col: int, cursor_shape: int, pending_wrap: bool,
    region_top: int, region_bottom: int,
    tabs: List[bool], default_tabs: bool,
    pen: Pen, modes: Modes, parser: Parser,
    title_storage: List[byte], title_length: int,
    mode_values: List[int], events: EventState,
    scrollback_cap_bytes: int,
    answer_storage: List[byte], answer_length: int,
    saved_primary: SavedCursor, saved_alternate: SavedCursor,
    g0: int, g1: int, shifted: bool,
}

fn new_screen(cols: int, rows: int) -> Screen {
    var cells = List[Cell]()
    (mut cells).reserve(cols * rows)
    var i = 0
    while i < cols * rows {
        (mut cells).push(Cell { base: 32, mark1: 0, mark2: 0, width: 1,
            flags: 0, foreground: 0 - 1, background: 0 - 1 })
        i += 1
    }
    var extents = List[int]()
    var wrapped = List[bool]()
    (mut extents).reserve(rows)
    (mut wrapped).reserve(rows)
    i = 0
    while i < rows { (mut extents).push(0); (mut wrapped).push(false); i += 1 }
    Screen { cells: cells, extents: extents, wrapped: wrapped }
}

fn default_tabs(cols: int) -> List[bool] {
    var tabs = List[bool]()
    (mut tabs).reserve(cols)
    var i = 0
    while i < cols { (mut tabs).push(i > 0 && i % 8 == 0); i += 1 }
    tabs
}

/// Construct a pane with positive dimensions and a nonnegative history cap.
/// Invalid constructor arguments are caller contract violations and assert.
pub fn new(cols: int, rows: int, scrollback_cap_bytes: int) -> Vt {
    assert(cols >= 1 && rows >= 1 && scrollback_cap_bytes >= 0)
    Vt {
        cols: cols, rows: rows, primary: new_screen(cols, rows), alternate: new_screen(cols, rows),
        active_alternate: false, cursor_row: 1, cursor_col: 1, cursor_shape: 2, pending_wrap: false,
        region_top: 1, region_bottom: rows,
        tabs: default_tabs(cols), default_tabs: true,
        pen: Pen { flags: 0, foreground: 0 - 1, background: 0 - 1 },
        modes: Modes { autowrap: true, origin: false, insert: false,
            newline: false, cursor_visible: true },
        parser: new_parser(), title_storage: new_byte_buffer(), title_length: 0,
        mode_values: new_mode_values(), events: new_events(),
        scrollback_cap_bytes: scrollback_cap_bytes,
        answer_storage: new_byte_buffer(), answer_length: 0,
        saved_primary: new_saved_cursor(), saved_alternate: new_saved_cursor(),
        g0: 0, g1: 0, shifted: false,
    }
}
