//! member: true
//! Incremental screen dispatch, width-aware printing and C0 operations.

fn blank_cell(mut screen: Screen, at: int, background: int) {
    screen.cells[at].base = 32
    screen.cells[at].mark1 = 0
    screen.cells[at].mark2 = 0
    screen.cells[at].width = 1
    screen.cells[at].flags = 0
    screen.cells[at].foreground = 0 - 1
    screen.cells[at].background = background
    screen.cells[at].written = false
}

fn blank_cell_preserving_written(mut screen: Screen, at: int, background: int) {
    let written = screen.cells[at].written
    blank_cell(mut screen, at, background)
    screen.cells[at].written = written
}

fn copy_cell(mut screen: Screen, to: int, from: int) {
    // Cell is scalar-only: an independent value copy, with no region allocation.
    screen.cells[to] = screen.cells[from]
}

fn scroll_up_one(mut screen: Screen, cols: int, top: int, bottom: int, background: int) {
    shift_lines(mut screen, cols, top, bottom, 1, background, false)
}

fn clear_combine_anchor(mut pane: Vt) {
    pane.combine_row = 0
    pane.combine_col = 1
}

fn index_line(mut pane: Vt) {
    clear_combine_anchor(mut pane)
    pane.pending_wrap = false
    if pane.cursor_row == pane.region_bottom {
        if pane.active_alternate {
            scroll_up_one(mut pane.alternate, pane.cols, pane.region_top, pane.region_bottom, pane.pen.background)
        } else {
            scroll_primary_up(mut pane, pane.region_top, pane.region_bottom, 1)
        }
    } else if pane.cursor_row < pane.rows {
        pane.cursor_row += 1
    }
}

fn break_pair(mut screen: Screen, cols: int, row: int, col: int, background: int) {
    let at = (row - 1) * cols + col - 1
    if screen.cells[at].width == 2 && col < cols { blank_cell_preserving_written(mut screen, at + 1, background) }
    else if screen.cells[at].width == 0 && col > 1 { blank_cell_preserving_written(mut screen, at - 1, background) }
}

fn break_print_pair(mut screen: Screen, cols: int, row: int, col: int, background: int) {
    let at = (row - 1) * cols + col - 1
    if screen.cells[at].width == 2 && col < cols {
        // The right-edge tail is discarded; an interior tail stays a written blank.
        if col + 1 == cols {
            blank_cell(mut screen, at + 1, background)
            if screen.extents[row - 1] == col + 1 { recalculate_written_extent(mut screen, cols, row) }
        } else { blank_cell_preserving_written(mut screen, at + 1, background) }
    } else if screen.cells[at].width == 0 && col > 1 {
        if col == cols {
            // Only the right-edge overwrite retains the old lead's rendition.
            screen.cells[at - 1].base = 32
            screen.cells[at - 1].mark1 = 0
            screen.cells[at - 1].mark2 = 0
            screen.cells[at - 1].width = 1
        } else { blank_cell_preserving_written(mut screen, at - 1, background) }
    }
}

fn write_narrow(mut screen: Screen, cols: int, row: int, col: int, cp: int,
        flags: int, foreground: int, background: int) {
    break_print_pair(mut screen, cols, row, col, background)
    let at = (row - 1) * cols + col - 1
    screen.cells[at].base = cp
    screen.cells[at].mark1 = 0
    screen.cells[at].mark2 = 0
    screen.cells[at].width = 1
    screen.cells[at].flags = flags
    screen.cells[at].foreground = foreground
    screen.cells[at].background = background
    screen.cells[at].written = true
    if screen.extents[row - 1] < col { screen.extents[row - 1] = col }
}

fn combine_cell(mut screen: Screen, cols: int, row: int, col: int, cp: int) -> int {
    if cp == 8205 { return 0 - 1 }
    var at = (row - 1) * cols + col - 1
    if screen.cells[at].width == 0 { at -= 1 }
    if screen.cells[at].mark1 == 0 { screen.cells[at].mark1 = cp }
    else if screen.cells[at].mark2 == 0 { screen.cells[at].mark2 = cp }
    screen.cells[at].written = true
    let end_col = at % cols + screen.cells[at].width
    if screen.extents[row - 1] < end_col { screen.extents[row - 1] = end_col }
    at
}

fn write_glyph(mut screen: Screen, cols: int, row: int, col: int, cp: int,
        width: int, flags: int, foreground: int, background: int) {
    if width == 2 {
        // Repair the right boundary before writing the lead: writing the tail
        // afterwards must not treat our newly written lead as an old pair.
        break_print_pair(mut screen, cols, row, col + 1, background)
    }
    write_narrow(mut screen, cols, row, col, cp, flags, foreground, background)
    if width == 2 {
        let at = (row - 1) * cols + col - 1
        blank_cell(mut screen, at + 1, background)
        screen.cells[at].width = 2
        screen.cells[at + 1].width = 0
        screen.cells[at + 1].flags = flags
        screen.cells[at + 1].foreground = foreground
        screen.cells[at + 1].written = true
        if screen.extents[row - 1] < col + 1 { screen.extents[row - 1] = col + 1 }
    }
}

fn wrap_line(mut pane: Vt) {
    if pane.active_alternate {
        pane.alternate.wrapped[pane.cursor_row - 1] = true
        index_line(mut pane)
    } else {
        repair_primary_lineage(mut pane)
        advance_primary_coordinate(mut pane, pane.cursor_row)
        let id = pane.line_coordinate.id
        let offset = pane.line_coordinate.offset
        pane.primary.wrapped[pane.cursor_row - 1] = true
        index_line(mut pane)
        assign_row_line(mut pane.primary, pane.cursor_row, id, offset)
        repair_primary_lineage(mut pane)
    }
    pane.cursor_col = 1
}

fn print_scalar(mut pane: Vt, cp: int) {
    // Interlinear annotation controls have width zero but are not cell marks.
    if cp >= 0xFFF9 && cp <= 0xFFFB { return }
    var width = scalar_width(cp)
    if width == 0 {
        let alt = pane.active_alternate
        let row = if pane.combine_row > 0 { pane.combine_row } else { pane.cursor_row }
        let col = if pane.combine_row > 0 { pane.combine_col } else { pane.cursor_col }
        let at = if alt {
            combine_cell(mut pane.alternate, pane.cols, row, col, cp)
        } else {
            combine_cell(mut pane.primary, pane.cols, row, col, cp)
        }
        if at >= 0 {
            pane.last_printed = if alt { pane.alternate.cells[at].base } else { pane.primary.cells[at].base }
            pane.last_mark1 = if alt { pane.alternate.cells[at].mark1 } else { pane.primary.cells[at].mark1 }
            pane.last_mark2 = if alt { pane.alternate.cells[at].mark2 } else { pane.primary.cells[at].mark2 }
        }
        return
    }
    if pane.pending_wrap && pane.modes.autowrap { wrap_line(mut pane) }
    if pane.cols == 1 { width = 1 }
    if width == 2 && pane.cursor_col == pane.cols {
        if !pane.modes.autowrap { return }
        wrap_line(mut pane)
    }
    let written_row = pane.cursor_row
    let prior_extent = pane.primary.extents[written_row - 1]
    if pane.modes.insert {
        if pane.active_alternate {
            shift_characters(mut pane.alternate, pane.cols, pane.cursor_row, pane.cursor_col, width, pane.pen.background, true)
        } else {
            shift_characters(mut pane.primary, pane.cols, pane.cursor_row, pane.cursor_col, width, pane.pen.background, true)
        }
    }
    if pane.active_alternate {
        write_glyph(mut pane.alternate, pane.cols, pane.cursor_row, pane.cursor_col, cp,
            width, pane.pen.flags, pane.pen.foreground, pane.pen.background)
    } else {
        write_glyph(mut pane.primary, pane.cols, pane.cursor_row, pane.cursor_col, cp,
            width, pane.pen.flags, pane.pen.foreground, pane.pen.background)
    }
    if !pane.active_alternate && pane.primary.wrapped[written_row - 1] &&
            (pane.cols == 1 || pane.primary.extents[written_row - 1] != prior_extent) {
        repair_primary_lineage(mut pane)
    }
    pane.combine_row = pane.cursor_row
    pane.combine_col = pane.cursor_col
    pane.last_printed = cp
    pane.last_mark1 = 0
    pane.last_mark2 = 0
    if pane.cursor_col + width > pane.cols {
        pane.cursor_col = pane.cols
        pane.pending_wrap = true
    } else { pane.cursor_col += width }
}

fn execute_c0(mut pane: Vt, cp: int) {
    if cp == 7 { register_bell(mut pane) }
    else if cp == 8 {
        clear_combine_anchor(mut pane)
        pane.pending_wrap = false
        if pane.cursor_col > 1 { pane.cursor_col -= 1 }
    } else if cp == 9 { tab_forward(mut pane, 1, false)
    } else if cp == 10 || cp == 11 || cp == 12 {
        clear_line_wrap(mut pane)
        index_line(mut pane)
        if pane.modes.newline { pane.cursor_col = 1 }
    } else if cp == 14 { pane.shifted = true }
    else if cp == 15 { pane.shifted = false }
    else if cp == 13 {
        clear_combine_anchor(mut pane)
        pane.cursor_col = 1
        pane.pending_wrap = false
    }
}

fn dispatch_grid_token(mut pane: Vt, kind: int, value: int) {
    if kind == 1 {
        let cp = mapped_graphic(pane, value)
        print_scalar(mut pane, cp)
    }
    else if kind == 2 { execute_c0(mut pane, value) }
    else if kind == 3 { dispatch_escape(mut pane, value) }
    else if kind == 4 { dispatch_csi(mut pane, value) }
    else if kind == 5 { dispatch_osc(mut pane) }
}

/// Consume bytes with incremental parsing, width-aware screen operations,
/// bounded final-state events and query answers. Primary upward scrolling
/// retains whole encoded history fragments only for a region starting at
/// row one; alternate scrolling never enters that history. Feeding mutates
/// preallocated storage, not an input-sized event or answer log.
pub fn feed(mut pane: Vt, data: List[byte]) {
    if data.len > 0 { pane.resize_state.active = false }
    for b in data {
        advance_in_place(mut pane.parser, b)
        if pane.parser.output_count > 0 {
            dispatch_grid_token(mut pane, pane.parser.first_kind, pane.parser.first_value)
        }
        if pane.parser.output_count > 1 {
            dispatch_grid_token(mut pane, pane.parser.second_kind, pane.parser.second_value)
        }
    }
}
