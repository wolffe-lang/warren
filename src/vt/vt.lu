//! member: true
//! The emulator: escape-sequence parser, cell grid and scrollback.
//!
//! The pane value, grid and scrollback remain stubs. `parser.lu` implements
//! the incremental decoder and sequence parser independently of the grid.

/// The milestone that fills this module in.
pub fn milestone() -> str {
    "W1"
}

/// Whether the module is pure: no I/O, so it runs on every host and under
/// the reference interpreter.
pub fn pure() -> bool {
    true
}
