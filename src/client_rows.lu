//! member: false
//! Client rows: a real `warren` client in a pseudo-terminal this program
//! owns, its output read back through warren's own emulator. Every way a
//! client ends gives the terminal back: the mode read from the terminal
//! after it ends equals the mode before it started, and the bytes that
//! leave what it turned on were written. Rows: detach and reattach, the
//! session ending, the server stopping, too small, a refusal, a server
//! that closes or sends an image that does not apply (a fake server here),
//! terminate and hangup signals, suspend and continue, and KILL (which
//! runs nothing and is reported, not promised). Lifecycle rows: a session
//! made by `new` (detached, a duplicate refused, attached), a second
//! client at a smaller size, the server outliving the client that started
//! it, and a verb the server does not know.
//!
//! After every row nothing it started may still run (Linux reads /proc; a
//! process whose environment names the row's runtime directory is red).
//!
//!   client_rows WARREN [ROW...]
use std.env
use std.fs
use std.net
use std.net.unix
use std.poll
use std.process
use std.signal
use std.term
use std.time
use client
use proto
use server
use vt

struct Run {
    warren: str,
    dir: str,
    files: str,
    master: fs.File,
    slave: fs.File,
    pid: int,
    slot: int,
    out: List[byte],
    screen: vt.Vt,
    before: int,
    status: int,
    ended: bool,
}

fn now_ms() -> int {
    time.monotonic_ns() / 1000000
}

fn row_dir(name: str) -> str {
    let here = env.cwd() else "."
    here + "/rt-" + name
}

// A pty at cols x rows, a known cooked mode on it, the client started
// on it as its controlling terminal with `args`.
fn launch(warren: str, name: str, args: List[str], cols: int, rows: int) -> Run ! {io, invalid} {
    launch_as(warren, name, "", args, cols, rows)
}

// As launch, for one of several clients of the same server at once: `tag`
// keeps each client's pid, status and trace files apart.
fn launch_as(warren: str, name: str, tag: str, args: List[str], cols: int, rows: int) -> Run ! {io, invalid} {
    let dir = row_dir(name)
    let files = if tag.len > 0 then dir + "-" + tag else dir
    if server.socket_path_problem(server.socket_path(dir)).len > 0 { return invalid }
    let pty = term.open_pty() else { return io }
    let tty_name = term.pty_name(pty.master) else { return io }
    term.set_size(pty.slave, term.Size { rows: rows, columns: cols }, 0, 0) else { return io }
    let before = term.pack(term.mode(pty.slave) else { return io })
    // The pane runs /bin/sh with a home of the row's own: never the
    // user's shell or its configuration.
    fs.create_dir_mode(dir + "-home", 448) else |_| {}
    env.set("WARREN_RUNTIME_DIR", dir) else { return io }
    env.set("WARREN_LIFETIME_MS", "60000") else { return io }
    env.set("WARREN_PANE_COMMAND", "/bin/sh") else { return io }
    env.set("SHELL", "/bin/sh") else { return io }
    env.set("HOME", dir + "-home") else { return io }
    env.set("ENV", "") else { return io }
    // The prompt the rows wait for, whoever runs them (root's is `#`).
    env.set("PS1", "$ ") else { return io }
    env.set("WARREN_CLIENT_TRACE", files + "-trace") else { return io }
    fs.remove(files + "-trace") else |_| {}
    env.set("TERM", "xterm-256color") else { return io }
    env.set("COLORTERM", "truecolor") else { return io }
    let pid_file = files + "-pid"
    let status_file = files + "-status"
    let done_file = files + "-done"
    fs.remove(pid_file) else |_| {}
    fs.remove(status_file) else |_| {}
    fs.remove(done_file) else |_| {}
    // As under a shell: a session leader with the terminal starts the
    // client as a foreground job of its own group (so a stop signal stops
    // it), writes its pid, and ends with its status (128 + N for signal N).
    let a = process.fork() else { return io }
    if process.is_child(a) {
        // The leader holds only the terminal's slave side: a copy of the
        // master here would keep the terminal alive after the row closes it.
        fs.close(take copy pty.master) else |_| {}
        process.lead_session() else { process.exit(126) }
        var tty = term.open_controlling(tty_name) else |_| {
            process.exit(126)
            return io
        }
        var c = process.command(warren)
        for x in args { process.push_arg(mut c, x) }
        process.set_stdin(mut c, tty)
        process.set_stdout(mut c, tty)
        process.set_stderr(mut c, tty)
        // As a shell does for a job: its stop and continue signals at their
        // defaults, whatever this program inherited.
        // The leader outlives a hangup of its terminal to report the client's
        // end; the client gets the hangup at its default.
        signal.ignore(signal.reload()) else |_| {}
        let b = process.start_foreground(c, 0, tty, signal.suspend() | signal.continued() | signal.reload()) else |_| {
            process.exit(127)
            return io
        }
        let bpid = process.pid(process.Child { slot: b.slot }) else 0
        fs.write_text(pid_file, "{bpid}") else |_| {}
        // The client must end within the row's bound: past it the leader
        // ends it (its own child, by the pid it started) and reports so.
        let bpid2 = process.pid(process.Child { slot: b.slot }) else 0
        var st = 0 - 1
        var ended = false
        var waited_ms = 0
        while !ended && waited_ms < 60000 {
            let c = process.poll() else |_| {
                process.exit(125)
                return io
            }
            if c.changed && c.child.slot == b.slot && !process.is_stopped(c.status) {
                ended = true
                st = c.status.value
            } else if !c.changed {
                time.sleep(time.millis(20))
                waited_ms += 20
            }
        }
        if !ended {
            fs.write_text(files + "-bound", "the client outlived the row's 60 s bound") else |_| {}
            if bpid2 > 0 { signal.send(bpid2, signal.kill()) else |_| {} }
            st = 0 - 9
        }
        let code = if st >= 0 then st else 128 - st
        // Stay the terminal's session leader until the row has read the
        // terminal's mode: on macOS the terminal is taken away from every
        // holder when its session leader exits.
        fs.write_text(status_file, "{code}") else |_| {}
        var waited = 0
        while !fs.exists(done_file) && waited < 10000 {
            time.sleep(time.millis(10))
            waited += 10
        }
        process.exit(code)
    }
    var pid = 0
    let t0 = now_ms()
    while pid == 0 && now_ms() - t0 < 3000 {
        let text = fs.read_text(pid_file) else ""
        pid = text.trim().to_int() else 0
        if pid == 0 { time.sleep(time.millis(10)) }
    }
    Run { warren: warren, dir: dir, files: files, master: pty.master, slave: pty.slave, pid: pid, slot: a.child.slot,
        out: List[byte](), screen: vt.new(cols, rows, 0), before: before, status: 0, ended: false }
}

// Read what the client wrote, for up to ms; reap it if it ended.
fn pump(mut r: Run, ms: int) {
    let until = now_ms() + ms
    while true {
        var w = poll.open() else { return }
        let k = poll.add_file(mut w, r.master, poll.READ) else { return }
        let left = until - now_ms()
        let ev = poll.wait(mut w, 0, if left < 0 then 0 else (if left > 50 then 50 else left)) else { return }
        poll.remove(mut w, k) else |_| {}
        poll.close(take w) else |_| {}
        if ev.ready.len > 0 {
            let got = fs.read_chunk(mut r.master, 65536) else List[byte]()
            for b in got { (mut r.out).push(b) }
            vt.feed(mut r.screen, got)
        }
        if !r.ended {
            let st = fs.read_text(r.files + "-status") else ""
            if st.len > 0 {
                r.ended = true
                r.status = st.trim().to_int() else 0 - 1
            }
        }
        if false {
            var seen = false
            let c = process.poll() else |_| {
                seen = true
                return
            }
            if !seen && c.changed && c.child.slot == r.slot && !process.is_stopped(c.status) {
                r.ended = true
                r.status = c.status.value
            }
        }
        if now_ms() >= until { return }
    }
}

fn screen_text(v: vt.Vt) -> str {
    var t = List[byte]()
    let cells = if v.active_alternate then v.alternate.cells else v.primary.cells
    var i = 0
    while i < cells.len {
        if i > 0 && i % v.cols == 0 { (mut t).push(10 as byte) }
        let c = copy cells[i]
        if c.width != 0 { client.utf8(mut t, if c.base == 0 then 32 else c.base) }
        i += 1
    }
    str_from_utf8(t) else ""
}

fn until_screen(mut r: Run, text: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if screen_text(r.screen).contains(text) { return true }
        pump(mut r, 50)
    }
    screen_text(r.screen).contains(text)
}

fn until_end(mut r: Run, ms: int) -> bool {
    let until = now_ms() + ms
    while !r.ended && now_ms() < until { pump(mut r, 50) }
    r.ended
}

fn type_text(mut r: Run, text: str) {
    fs.write_chunk(mut r.master, text.bytes()) else |_| {}
}

fn output_text(r: Run) -> str {
    str_from_utf8(r.out) else ""
}

// The mode after equals the mode before, and the bytes that leave what
// the client turned on came after the last time it turned them on.
fn restored(r: Run) -> str {
    let after = term.pack(term.mode(r.slave) else { return "the mode cannot be read" })
    if after != r.before { return "the mode was {after}, not {r.before} as before" }
    let t = output_text(r)
    let enter = t.rfind("\u{1b}[?1049h") else 0 - 1
    let leave = t.rfind("\u{1b}[?1049l") else 0 - 1
    let paste_off = t.rfind("\u{1b}[?2004l") else 0 - 1
    let mouse_off = t.rfind("\u{1b}[?1000l") else 0 - 1
    if enter < 0 { return "the client never took the terminal" }
    if leave < enter || paste_off < enter || mouse_off < enter { return "the leave bytes were not all sent" }
    ""
}

fn words(text: str) -> List[str] {
    var x = List[str]()
    for w in text.split(" ") {
        if w.len > 0 { (mut x).push(w) }
    }
    x
}

fn stop_server() {
    let _s = client.command(words("kill-server"))
}

// Let the session leader go (the row has read what it needed) and reap it.
fn release(r: Run) {
    fs.write_text(r.files + "-done", "1") else |_| {}
    let t0 = now_ms()
    while now_ms() - t0 < 5000 {
        let c = process.poll() else { return }
        if c.changed && c.child.slot == r.slot { return }
        if !c.changed { time.sleep(time.millis(10)) }
    }
}

fn close_quiet(r: Run) {
    release(r)
    fs.close(take copy r.master) else |_| {}
    fs.close(take copy r.slave) else |_| {}
}

fn close_run(r: Run) {
    stop_server()
    close_quiet(r)
}

fn ends_with(mut r: Run, code: int, line: str) -> str {
    if !until_end(mut r, 10000) { return "the client did not end" }
    pump(mut r, 100)
    if r.status != code { return "the client ended {r.status}, not {code}: " + output_text(r) }
    if line.len > 0 && !output_text(r).contains(line) { return "no '{line}' after the end" }
    restored(r)
}

// ---------------- rows ----------------

fn row_detach_reattach(warren: str) -> str {
    var r = launch(warren, "detach", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt: " + screen_text(r.screen) }
    type_text(mut r, "echo hi-$((40+2))\r")
    if !until_screen(mut r, "hi-42", 5000) { return "the echo was not drawn" }
    let rss = fs.read_text("/proc/{r.pid}/status") else ""
    for line in rss.lines() {
        if line.starts_with("VmRSS") || line.starts_with("VmHWM") {
            print("MEASURE client 80x24 " + line.replace("\t", " "))
        }
    }
    type_text(mut r, "\u{0}d")
    let why = ends_with(mut r, 0, "[detached")
    if why.len > 0 {
        close_run(r)
        return "detach: " + why
    }
    close_quiet(r)
    var a = launch(warren, "detach", words("attach"), 80, 24) else |e| { return "relaunch: {e}" }
    if !until_screen(mut a, "hi-42", 10000) { return "the session's screen was not kept: " + screen_text(a.screen) }
    type_text(mut a, "exit\r")
    let why2 = ends_with(mut a, 0, "ended]")
    close_run(a)
    if why2.len > 0 { return "session end: " + why2 }
    ""
}

fn row_server_stopping(warren: str) -> str {
    var r = launch(warren, "stopping", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    stop_server()
    let why = ends_with(mut r, 0, "[the server stopped]")
    close_run(r)
    why
}

fn row_too_small(warren: str) -> str {
    var r = launch(warren, "small", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    term.set_size(r.slave, term.Size { rows: 4, columns: 10 }, 0, 0) else { return "resize" }
    let why = ends_with(mut r, 1, "too small")
    close_run(r)
    why
}

fn row_refused(warren: str) -> str {
    var s = launch(warren, "refused", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut s, "$", 10000) { return "no prompt" }
    var r = launch(warren, "refused", words("attach -t missing"), 80, 24) else |e| { return "launch: {e}" }
    let why = ends_with(mut r, 1, "refused")
    close_quiet(r)
    close_run(s)
    why
}

// A fake server: it listens where the client looks, takes the HELLO and
// then either closes (`bad` false) or sends an image no applier takes (a
// delta with nothing before it).
fn fake(warren: str, name: str, bad: bool) -> str {
    let dir = row_dir(name)
    fs.remove_dir_all(dir) else |_| {}
    fs.create_dir_mode(dir, 448) else { return "dir" }
    var l = unix.listen(dir + "/default") else |e| { return "listen: {e}" }
    var r = launch(warren, name, words("attach"), 80, 24) else |e| { return "launch: {e}" }
    var s = net.accept(mut l) else |e| { return "accept: {e}" }
    pump(mut r, 300)
    let _h = net.read_bytes(mut s, 65536) else List[byte]()
    if bad {
        var f = List[byte]()
        proto.put(mut f, 2, 4)
        proto.put(mut f, 1, 4)
        proto.put(mut f, 80, 2)
        proto.put(mut f, 24, 2)
        proto.put(mut f, 1, 2)
        proto.put(mut f, 1, 2)
        proto.put(mut f, 0, 1)
        proto.put(mut f, 1, 1)
        proto.put(mut f, 0, 4)
        let e = proto.encode(131, 0, f)
        net.write_bytes(mut s, e.bytes) else |_| {}
    }
    pump(mut r, 300)
    net.close(take s) else |_| {}
    net.close_listener(take l) else |_| {}
    let why = ends_with(mut r, 1, if bad then "does not apply" else "closed the connection")
    close_quiet(r)
    why
}

fn by_signal(warren: str, name: str, meaning: int) -> str {
    var r = launch(warren, name, List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    signal.send(r.pid, meaning) else |e| { return "signal: {e}" }
    let why = ends_with(mut r, 1, "ended by a signal")
    close_run(r)
    why
}

fn row_suspend_continue(warren: str) -> str {
    var r = launch(warren, "suspend", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    signal.send(r.pid, signal.suspend()) else |e| { return "signal: {e}" }
    pump(mut r, 500)
    let stopped = term.pack(term.mode(r.slave) else { return "mode" })
    var state = proc_state(r.pid)
    let status_text = fs.read_text("/proc/{r.pid}/status") else ""
    for line in status_text.lines() {
        if line.starts_with("SigBlk") || line.starts_with("SigIgn") || line.starts_with("SigCgt") || line.starts_with("SigPnd") || line.starts_with("ShdPnd") {
            state = state + " " + line.replace("\t", "")
        }
    }
    signal.send(r.pid, signal.continued()) else |e| { return "signal: {e}" }
    pump(mut r, 500)
    let resumed = term.pack(term.mode(r.slave) else { return "mode" })
    type_text(mut r, "echo back-$((50+5))\r")
    let drawn = until_screen(mut r, "back-55", 5000)
    type_text(mut r, "\u{0}d")
    let why = ends_with(mut r, 0, "[detached")
    close_run(r)
    if stopped != r.before { return "while suspended (state {state}) the mode was {stopped}, not the terminal's own {r.before}" }
    if resumed == r.before { return "after continue the terminal was not taken again" }
    if !drawn { return "nothing was drawn after continue" }
    why
}

// The process's state letter from /proc (Linux), "?" elsewhere.
fn proc_state(pid: int) -> str {
    let text = fs.read_text("/proc/{pid}/stat") else { return "?" }
    let close = text.rfind(")") else 0 - 1
    if close < 0 || close + 3 > text.len { return "?" }
    text[close + 2..close + 3]
}

// Processes this program started that are still running: any whose
// environment names a runtime directory under this program's working
// directory (Linux, from /proc; elsewhere it cannot be read and is named).
fn leftovers() -> str {
    let names = fs.read_dir("/proc") else { return "" }
    let here = env.cwd() else "."
    let marker = "WARREN_RUNTIME_DIR=" + here + "/rt-"
    let me = env.pid()
    var found = ""
    for n in names {
        let pid = n.to_int() else 0
        if pid <= 0 || pid == me { continue }
        let raw = fs.read_bytes("/proc/{pid}/environ") else { continue }
        let text = str_from_utf8(raw) else ""
        if text.contains(marker) {
            let cmd = fs.read_text("/proc/{pid}/cmdline") else ""
            found = found + " {pid}:" + cmd.replace("\u{0}", " ").trim()
        }
    }
    found
}

fn after_row() -> str {
    let t0 = now_ms()
    var left = leftovers()
    while left.len > 0 && now_ms() - t0 < 5000 {
        time.sleep(time.millis(50))
        left = leftovers()
    }
    if left.len > 0 { return "left running after the row:" + left }
    ""
}

fn row_kill_reported(warren: str) -> str {
    var r = launch(warren, "kill", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    signal.send(r.pid, signal.kill()) else |e| { return "signal: {e}" }
    if !until_end(mut r, 10000) { return "the client did not end" }
    let after = term.pack(term.mode(r.slave) else { return "mode" })
    print("MEASURE kill status={r.status} mode-restored={after == r.before} (KILL runs nothing; not promised)")
    term.set_mode(r.slave, term.unpack(r.before)) else |_| {}
    close_run(r)
    if r.status != 137 { return "KILL did not end the client by its signal ({r.status})" }
    ""
}

// The terminal goes away under an attached client (its master closed):
// the client must end on its own, without the terminal, and not linger.
fn row_terminal_gone(warren: str) -> str {
    var r = launch(warren, "gone", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) { return "no prompt" }
    fs.close(take copy r.master) else |_| {}
    let t0 = now_ms()
    var status = ""
    while status.len == 0 && now_ms() - t0 < 10000 {
        status = fs.read_text(r.files + "-status") else ""
        if status.len == 0 { time.sleep(time.millis(20)) }
    }
    let trace = fs.read_text(r.files + "-trace") else ""
    let bound = fs.read_text(r.files + "-bound") else ""
    release(r)
    fs.close(take copy r.slave) else |_| {}
    stop_server()
    if status.len == 0 { return "the client did not end within 10 s of its terminal going away; trace: " + trace.replace("\n", " | ") }
    if bound.len > 0 { return bound }
    print("MEASURE terminal-gone ended-ms={now_ms() - t0} status={status.trim()}")
    ""
}

// ---------------- lifecycle rows ----------------

fn self_path() -> str {
    let a0 = env.arg0()
    if a0.starts_with("/") { return a0 }
    let here = env.cwd() else "."
    here + "/" + a0
}

// Pump two clients until both screens show `text`.
fn until_both(mut a: Run, mut b: Run, text: str, ms: int) -> bool {
    let until = now_ms() + ms
    while now_ms() < until {
        if screen_text(a.screen).contains(text) && screen_text(b.screen).contains(text) { return true }
        pump(mut a, 25)
        pump(mut b, 25)
    }
    screen_text(a.screen).contains(text) && screen_text(b.screen).contains(text)
}

// A command that takes no terminal: it ends with `code`, prints `text`,
// and leaves the terminal's mode as it was.
fn ends_plain(mut r: Run, code: int, text: str) -> str {
    if !until_end(mut r, 10000) { return "the command did not end" }
    pump(mut r, 100)
    if r.status != code { return "it ended {r.status}, not {code}: " + output_text(r).trim() }
    if text.len > 0 && !output_text(r).contains(text) { return "no '{text}' in '" + output_text(r).trim() + "'" }
    let after = term.pack(term.mode(r.slave) else { return "the mode cannot be read" })
    if after != r.before { return "the mode was {after}, not {r.before} as before" }
    ""
}

fn reply_out(argv: str) -> str {
    let r = client.command_reply(words(argv))
    str_from_utf8(r.out) else ""
}

// `new`: a detached session (named, then numbered), a duplicate refused,
// a session made and attached at once, and attach to the detached one.
fn row_new_session(warren: str) -> str {
    var d = launch_as(warren, "new", "d", words("new -d -s work"), 80, 24) else |e| { return "launch: {e}" }
    let why = ends_plain(mut d, 0, "work")
    close_quiet(d)
    if why.len > 0 {
        stop_server()
        return "new -d -s work: " + why
    }
    var again = launch_as(warren, "new", "d", words("new -d -s work"), 80, 24) else |e| { return "launch: {e}" }
    let why2 = ends_plain(mut again, 1, "already exists")
    close_quiet(again)
    if why2.len > 0 {
        stop_server()
        return "a second work: " + why2
    }
    var n = launch_as(warren, "new", "d", words("new -d"), 80, 24) else |e| { return "launch: {e}" }
    let why3 = ends_plain(mut n, 0, "")
    let printed = output_text(n).trim()
    close_quiet(n)
    if why3.len > 0 || printed != "1" {
        stop_server()
        return "new -d with no name: " + (if why3.len > 0 then why3 else "printed '{printed}', not 1")
    }
    // Timed apart from the rows' terminal: `new -d` with no terminal (80x24),
    // from its start to its exit, against the running server.
    let null = fs.open_mode("/dev/null", 2) else {
        stop_server()
        return "/dev/null"
    }
    var c = process.command(warren)
    for x in words("new -d -s timed") { process.push_arg(mut c, x) }
    process.set_stdin(mut c, null)
    process.set_stdout(mut c, null)
    process.set_stderr(mut c, null)
    let t1 = time.monotonic_ns()
    let ch = process.start(c) else |e| {
        stop_server()
        return "start: {e}"
    }
    let st = process.wait_status(take ch) else 0 - 1
    let us = (time.monotonic_ns() - t1) / 1000
    fs.close(take null) else |_| {}
    if st != 0 {
        stop_server()
        return "new -d -s timed with no terminal ended {st}"
    }
    print("MEASURE new-detached start-to-exit-us={us} (a running server, no terminal)")
    let list = reply_out("list-sessions")
    if !list.contains("work: 80x24 (0 attached)") || !list.contains("1: 80x24 (0 attached)") ||
        !list.contains("timed: 80x24 (0 attached)") {
        stop_server()
        return "list-sessions: " + list.replace("\n", " | ")
    }
    var o = launch_as(warren, "new", "o", words("new -s other"), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut o, "$", 10000) {
        close_run(o)
        return "new -s other drew no prompt: " + screen_text(o.screen).trim()
    }
    type_text(mut o, "\u{0}d")
    let why4 = ends_with(mut o, 0, "[detached from other]")
    close_quiet(o)
    if why4.len > 0 {
        stop_server()
        return "new -s other: " + why4
    }
    var w = launch_as(warren, "new", "w", words("attach -t work"), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut w, "$", 10000) {
        close_run(w)
        return "attach -t work drew no prompt"
    }
    type_text(mut w, "exit\r")
    let why5 = ends_with(mut w, 0, "[work ended]")
    close_run(w)
    if why5.len > 0 { return "attach -t work: " + why5 }
    ""
}

// Two terminal clients of one session: the pane is sized to the smaller,
// both draw what is typed, either may go without closing the pane or the
// other, and with nobody attached the session keeps its last size.
fn row_second_client(warren: str) -> str {
    let me = self_path()
    var a = launch_as(warren, "second", "a", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut a, "$", 10000) {
        close_run(a)
        return "no prompt in the first client"
    }
    var b = launch_as(warren, "second", "b", words("attach"), 60, 20) else |e| {
        close_run(a)
        return "launch: {e}"
    }
    if !until_screen(mut b, "$", 10000) {
        close_quiet(b)
        close_run(a)
        return "no prompt in the second client"
    }
    let t0 = now_ms()
    type_text(mut a, "{me} --print-size s1\r")
    let both = until_both(mut a, mut b, "s1 20 60", 5000)
    let took = now_ms() - t0
    if !both {
        close_quiet(b)
        close_run(a)
        return "with a 60x20 client beside an 80x24 one the pane did not read 20 60 in both: " +
            screen_text(a.screen).trim().replace("\n", " | ")
    }
    print("MEASURE second-client typed-to-both-ms={took}")
    // The second detaches: the pane returns to the first client's size.
    type_text(mut b, "\u{0}d")
    let why = ends_with(mut b, 0, "[detached")
    close_quiet(b)
    if why.len > 0 {
        close_run(a)
        return "the second client's detach: " + why
    }
    type_text(mut a, "{me} --print-size s2\r")
    if !until_screen(mut a, "s2 24 80", 5000) {
        close_run(a)
        return "after the second detached the pane did not read 24 80"
    }
    // A third client's terminal goes away: the first and the pane go on.
    var c = launch_as(warren, "second", "c", words("attach"), 60, 20) else |e| {
        close_run(a)
        return "launch: {e}"
    }
    if !until_screen(mut c, "$", 10000) {
        close_quiet(c)
        close_run(a)
        return "no prompt in the third client"
    }
    fs.close(take copy c.master) else |_| {}
    let tc = now_ms()
    var status = ""
    while status.len == 0 && now_ms() - tc < 10000 {
        status = fs.read_text(c.files + "-status") else ""
        if status.len == 0 { pump(mut a, 20) }
    }
    release(c)
    fs.close(take copy c.slave) else |_| {}
    if status.len == 0 {
        close_run(a)
        return "the third client did not end when its terminal went away"
    }
    type_text(mut a, "{me} --print-size s3\r")
    if !until_screen(mut a, "s3 24 80", 5000) {
        close_run(a)
        return "after a client's terminal went away the first did not go on: " +
            screen_text(a.screen).trim().replace("\n", " | ")
    }
    type_text(mut a, "\u{0}d")
    let why2 = ends_with(mut a, 0, "[detached")
    close_quiet(a)
    if why2.len > 0 {
        stop_server()
        return "the first client's detach: " + why2
    }
    let list = reply_out("list-sessions")
    stop_server()
    if !list.contains("default: 80x24 (0 attached)") { return "with nobody attached: " + list.replace("\n", " | ") }
    ""
}

// The client that started the server goes (its terminal closed under
// it): the server and the session stay, and a new client finds the screen.
fn row_server_outlives_client(warren: str) -> str {
    let t0 = now_ms()
    var a = launch(warren, "outlive", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut a, "$", 10000) {
        close_run(a)
        return "no prompt"
    }
    print("MEASURE cold-start prompt-ms={now_ms() - t0} (no server: launch to the first prompt drawn)")
    type_text(mut a, "echo kept-$((6*7))\r")
    if !until_screen(mut a, "kept-42", 5000) {
        close_run(a)
        return "the echo was not drawn"
    }
    fs.close(take copy a.master) else |_| {}
    let tc = now_ms()
    var status = ""
    while status.len == 0 && now_ms() - tc < 10000 {
        status = fs.read_text(a.files + "-status") else ""
        if status.len == 0 { time.sleep(time.millis(20)) }
    }
    release(a)
    fs.close(take copy a.slave) else |_| {}
    if status.len == 0 {
        stop_server()
        return "the client did not end when its terminal went away"
    }
    let list = reply_out("list-sessions")
    if !list.contains("default: 80x24 (0 attached)") {
        stop_server()
        return "the server or the session did not outlive the client that started it: '" + list.trim() + "'"
    }
    var b = launch(warren, "outlive", words("attach"), 80, 24) else |e| {
        stop_server()
        return "relaunch: {e}"
    }
    if !until_screen(mut b, "kept-42", 10000) {
        close_run(b)
        return "a new client did not find the screen: " + screen_text(b.screen).trim().replace("\n", " | ")
    }
    type_text(mut b, "exit\r")
    let why = ends_with(mut b, 0, "ended]")
    close_run(b)
    why
}

// A verb this server does not know (a newer client's) is refused by name
// with the usage status, and the server goes on.
fn row_unknown_verb(warren: str) -> str {
    var r = launch(warren, "verb", List[str](), 80, 24) else |e| { return "launch: {e}" }
    if !until_screen(mut r, "$", 10000) {
        close_run(r)
        return "no prompt"
    }
    let reply = client.command_reply(words("split-window -h"))
    let err = str_from_utf8(reply.err) else ""
    type_text(mut r, "echo still-$((3+4))\r")
    let alive = until_screen(mut r, "still-7", 5000)
    close_run(r)
    if reply.status != 2 { return "an unknown verb got status {reply.status}, not 2 (usage): " + err.trim() }
    if !err.contains("split-window: not implemented") { return "an unknown verb was not refused by name: '" + err.trim() + "'" }
    if !alive { return "the session did not go on after the refusal" }
    ""
}

fn run_row(warren: str, name: str) -> str {
    if name == "detach-reattach" { return row_detach_reattach(warren) }
    if name == "server-stopping" { return row_server_stopping(warren) }
    if name == "too-small" { return row_too_small(warren) }
    if name == "refused" { return row_refused(warren) }
    if name == "server-eof" { return fake(warren, "eof", false) }
    if name == "image-refused" { return fake(warren, "image", true) }
    if name == "terminate" { return by_signal(warren, "term", signal.terminate()) }
    if name == "hangup" { return by_signal(warren, "hup", signal.reload()) }
    if name == "suspend-continue" { return row_suspend_continue(warren) }
    if name == "kill-reported" { return row_kill_reported(warren) }
    if name == "terminal-gone" { return row_terminal_gone(warren) }
    if name == "new-session" { return row_new_session(warren) }
    if name == "second-client" { return row_second_client(warren) }
    if name == "server-outlives-client" { return row_server_outlives_client(warren) }
    if name == "unknown-verb" { return row_unknown_verb(warren) }
    "no such row"
}

fn main() -> int {
    let args = env.args()
    // The pane-side helper: the size of the terminal it runs in, tagged.
    if args.len == 2 && args[0] == "--print-size" {
        let size = term.size(fs.stdin()) else |e| {
            print("size-{e}")
            return 1
        }
        print("{args[1]} {size.rows} {size.columns}")
        return 0
    }
    if args.len < 1 {
        eprint("usage: client_rows WARREN [ROW...]")
        return 2
    }
    var rows = List[str]()
    var i = 1
    while i < args.len {
        (mut rows).push(args[i])
        i += 1
    }
    if rows.len == 0 {
        rows = words("detach-reattach server-stopping too-small refused server-eof image-refused terminate hangup suspend-continue kill-reported terminal-gone new-session second-client server-outlives-client unknown-verb")
    }
    if !fs.exists("/proc") { print("NOTE leftovers unchecked here: no /proc to read") }
    // Every row's socket lives in a short directory under this one; a
    // working directory too deep for the host's socket paths is refused
    // by name here, not left to a hang or `io` in a row.
    let long = server.socket_path_problem(server.socket_path(row_dir("stopping")))
    if long.len > 0 {
        print("FAIL client-rows the working directory is too deep: the {long}")
        print("CLIENT-ROWS rows={rows.len} failed={rows.len}")
        return 1
    }
    var failed = 0
    for name in rows {
        let t0 = now_ms()
        var why = run_row(args[0], name)
        // Nothing a row started may outlive it.
        let left = after_row()
        if left.len > 0 { why = if why.len > 0 then why + "; " + left else left }
        if why.len == 0 {
            print("PASS {name} ms={now_ms() - t0}")
        } else {
            failed += 1
            print("FAIL {name} {why}")
        }
    }
    print("CLIENT-ROWS rows={rows.len} failed={failed}")
    if failed > 0 { return 1 }
    0
}
