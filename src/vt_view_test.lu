//! member: false
//! A client's window over a pane's retained history and live screen.
use vt
use std.mem.budget

// ASCII rows only: any other scalar reads as `?`; trailing blanks dropped.
fn text_of(view: vt.View, row: int) -> str {
    var out = List[byte]()
    var col = 0
    while col < view.cols {
        let base = view.screen.cells[(row - 1) * view.cols + col].base
        if view.screen.cells[(row - 1) * view.cols + col].width != 0 {
            (mut out).push((if base >= 32 && base < 127 then base else 63) as byte)
        }
        col += 1
    }
    var end = out.len
    while end > 0 && out[end - 1] == 32 as byte { end -= 1 }
    str_from_utf8(out[0..end]) else ""
}

fn lines(view: vt.View) -> str {
    var out = ""
    var row = 1
    while row <= view.rows {
        if row > 1 { out = out + "|" }
        out = out + text_of(view, row)
        row += 1
    }
    out
}

// A window whose buffers hold the pane's size.
fn view_for(pane: vt.Vt) -> vt.View {
    var view = vt.new_view()
    vt.reserve_view(mut view, pane.cols, pane.rows)
    view
}

fn numbered(count: int) -> List[byte] {
    var text = ""
    var i = 1
    while i <= count {
        if i > 1 { text = text + "\r\n" }
        text = text + "a{i}"
        i += 1
    }
    text.bytes()
}

fn test_history_above_live() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 0) == 0 && lines(view) == "a7|a8|a9", "back 0 is the live screen")
    assert(vt.fill_view(mut view, pane, 2) == 2, "two rows back")
    assert(lines(view) == "a5|a6|a7", "history rows above live rows: " + lines(view))
    assert(view.back == 2, "the window records its back")
    assert(vt.fill_view(mut view, pane, 6) == 6 && lines(view) == "a1|a2|a3", "the oldest window: " + lines(view))
    assert(vt.fill_view(mut view, pane, 40) == 6 && lines(view) == "a1|a2|a3", "back is clamped to the retained rows")
    assert(vt.fill_view(mut view, pane, 1) == 1 && lines(view) == "a6|a7|a8", "one row back")
    assert(vt.fill_view(mut view, pane, 0 - 3) == 0 && lines(view) == "a7|a8|a9", "a negative back is the live screen")
}

fn test_fills_need_reserved_buffers() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = vt.new_view()
    assert(!vt.view_fits(view, 6, 3), "a new window holds one cell")
    assert(vt.fill_view(mut view, pane, 2) == 0 - 1 && view.cols == 0, "a fill never grows the buffers")
    assert(vt.view_back_of(mut view, pane, 0, 0) == 0 - 1, "nor does a lookup")
    vt.reserve_view(mut view, 6, 3)
    assert(vt.view_fits(view, 6, 3) && vt.view_fits(view, 3, 3) && !vt.view_fits(view, 6, 4), "reserved for the pane's size")
    assert(vt.fill_view(mut view, pane, 2) == 2 && lines(view) == "a5|a6|a7", "a reserved window fills")
}

fn test_soft_wrap_relaid_at_the_current_width() {
    var pane = vt.new(4, 2, 4096)
    vt.feed(mut pane, "abcdefghij\r\nx".bytes())
    var view = view_for(pane)
    // The long line's first two rows are history; its third row and x are live.
    assert(vt.fill_view(mut view, pane, 2) == 2 && lines(view) == "abcd|efgh", "wrapped history rows: " + lines(view))
    assert(view.screen.wrapped[0], "a soft wrap is marked")
    assert(vt.fill_view(mut view, pane, 1) == 1 && lines(view) == "efgh|ij", "history then live: " + lines(view))
    assert(view.screen.wrapped[0] && !view.screen.wrapped[1], "the line wraps from history into the live rows")
    vt.feed(mut pane, "\r\ny\r\nz".bytes())
    assert(vt.resize(mut pane, 3, 2) == "")
    let total = vt.fill_view(mut view, pane, 99)
    assert(lines(view) == "abc|def", "history re-laid at three columns: " + lines(view))
    assert(vt.fill_view(mut view, pane, total - 2) == total - 2 && lines(view) == "ghi|j", "the line's last rows: " + lines(view))
}

fn test_wide_and_combining_glyphs() {
    var pane = vt.new(6, 1, 4096)
    vt.feed(mut pane, "\u{3042}\u{3044}x\r\ne\u{301}y\r\nz".bytes())
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 2) == 2, "two history rows")
    assert(view.screen.cells[0].base == 12354 && view.screen.cells[0].width == 2 && view.screen.cells[1].width == 0 &&
        view.screen.cells[2].base == 12356 && view.screen.cells[4].base == 120, "wide glyphs kept")
    assert(vt.fill_view(mut view, pane, 1) == 1, "one history row")
    assert(view.screen.cells[0].base == 101 && view.screen.cells[0].mark1 == 769 && view.screen.cells[1].base == 121, "combining mark kept")
}

fn test_renditions_kept() {
    var pane = vt.new(6, 1, 4096)
    vt.feed(mut pane, "\u{1b}[1;31mr\u{1b}[0m\r\nq".bytes())
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 1) == 1, "one history row")
    assert(view.screen.cells[0].base == 114 && view.screen.cells[0].flags % 2 == 1 && view.screen.cells[0].foreground == 1, "bold red kept")
}

fn test_alternate_screen_has_no_history() {
    var pane = vt.new(6, 2, 4096)
    vt.feed(mut pane, numbered(5))
    vt.feed(mut pane, "\u{1b}[?1049h\u{1b}[Halt".bytes())
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 3) == 0, "no history behind the alternate screen")
    assert(text_of(view, 1) == "alt", "the window is the alternate screen")
}

fn test_eviction_clamps_to_the_oldest_retained_row() {
    var pane = vt.new(6, 2, 256)
    vt.feed(mut pane, numbered(60))
    var view = view_for(pane)
    let total = vt.fill_view(mut view, pane, 1000)
    assert(total > 0 && total < 58, "a small cap keeps a suffix: {total}")
    let oldest = text_of(view, 1)
    assert(oldest == "a{59 - total}", "the oldest retained row is shown first: " + oldest)
}

fn test_anchor_follows_content() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 2) == 2 && lines(view) == "a5|a6|a7", "window before output")
    let id = view.screen.line_ids[0]
    let offset = view.screen.line_offsets[0]
    vt.feed(mut pane, "\r\na10\r\na11\r\na12".bytes())
    let back = vt.view_back_of(mut view, pane, id, offset)
    assert(back == 5, "three new rows push the anchor three rows further back: {back}")
    assert(vt.fill_view(mut view, pane, back) == 5 && lines(view) == "a5|a6|a7", "the same content again: " + lines(view))
    assert(vt.view_back_of(mut view, pane, id + 1000, 0) == 0 - 1, "an unknown line is not retained")
}

fn test_repeated_fills_have_no_retained_growth() {
    var pane = vt.new(10, 4, 4096)
    vt.feed(mut pane, numbered(80))
    region frame(cap: 1048576) {
        var view = view_for(pane)
        let _first = vt.fill_view(mut view, pane, 4)
        let stable = budget.charged(frame)
        var i = 0
        while i < 32 {
            let _f = vt.fill_view(mut view, pane, i * 3)
            let _b = vt.view_back_of(mut view, pane, view.screen.line_ids[0], view.screen.line_offsets[0])
            i += 1
        }
        let growth = budget.charged(frame) - stable
        print("MEASURE view-fills fills=32 retained-growth={growth}")
        assert(growth == 0, "window fills reuse their buffers")
    }
}

fn text(out: List[byte]) -> str { str_from_utf8(out[0..out.len]) else "?" }

fn test_marked_text_in_reading_order() {
    var pane = vt.new(6, 4, 4096)
    vt.feed(mut pane, "ab  \r\ncdefghij\r\nk".bytes())
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 0) == 0 && lines(view) == "ab|cdefgh|ij|k", "the window: " + lines(view))
    var out = List[byte]()
    vt.mark_view(mut view, 1, 1, 3, 2)
    assert(vt.view_marked_text(view, mut out, 100) == 11 && text(out) == "ab\ncdefghij", "rows join at a soft wrap: " + text(out))
    vt.mark_view(mut view, 3, 2, 1, 1)
    assert(vt.view_marked_text(view, mut out, 100) == 11 && text(out) == "ab\ncdefghij", "either way round")
    vt.mark_view(mut view, 2, 3, 2, 4)
    assert(vt.view_marked_text(view, mut out, 100) == 2 && text(out) == "ef", "part of a row")
    assert(vt.view_marked(view, 2, 3) && vt.view_marked(view, 2, 4), "marked cells")
    assert(!vt.view_marked(view, 2, 5) && !vt.view_marked(view, 1, 3) && !vt.view_marked(view, 3, 3), "unmarked cells")
    vt.mark_view(mut view, 1, 1, 1, 6)
    assert(vt.view_marked_text(view, mut out, 100) == 2 && text(out) == "ab", "a row's trailing blanks are dropped")
    vt.mark_view(mut view, 0, 0 - 4, 9, 99)
    assert(vt.view_marked_text(view, mut out, 100) == 13 && text(out) == "ab\ncdefghij\nk", "clamped to the window: " + text(out))
    vt.unmark_view(mut view)
    assert(!vt.view_marked(view, 2, 3), "unmarked")
    assert(vt.view_marked_text(view, mut out, 100) == 0 - 1 && text(out) == "ab\ncdefghij\nk", "nothing marked leaves out alone")
}

fn test_marked_wide_and_combining() {
    var pane = vt.new(6, 2, 4096)
    vt.feed(mut pane, "\u{3042}\u{3044}x\r\ne\u{301}y".bytes())
    var view = view_for(pane)
    let _f = vt.fill_view(mut view, pane, 0)
    var out = List[byte]()
    vt.mark_view(mut view, 1, 2, 1, 3)
    assert(vt.view_marked_text(view, mut out, 100) == 6 && text(out) == "\u{3042}\u{3044}", "a part starting on a wide glyph's right half takes it whole: " + text(out))
    vt.mark_view(mut view, 2, 1, 2, 1)
    assert(vt.view_marked_text(view, mut out, 100) == 3 && text(out) == "e\u{301}", "a combining mark follows its base")
}

fn test_marked_text_over_the_cap_is_refused_whole() {
    var pane = vt.new(6, 2, 4096)
    vt.feed(mut pane, "abcdef\r\ngh".bytes())
    var view = view_for(pane)
    let _f = vt.fill_view(mut view, pane, 0)
    var out = "zz".bytes()
    vt.mark_view(mut view, 1, 1, 2, 2)
    assert(vt.view_marked_text(view, mut out, 8) == 0 - 1 && text(out) == "zz", "nine bytes do not fit in eight")
    assert(vt.view_marked_text(view, mut out, 9) == 9 && text(out) == "abcdef\ngh", "nine fit in nine")
}

fn test_marked_history_rows() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    let _f = vt.fill_view(mut view, pane, 2)
    var out = List[byte]()
    vt.mark_view(mut view, 1, 1, 3, 2)
    assert(vt.view_marked_text(view, mut out, 100) == 8 && text(out) == "a5\na6\na7", "history and live rows: " + text(out))
}

// Find, place the window and mark the match: "back:r0,c0-r1,c1:text", or
// "none" when nothing is found and "gone" when it cannot be placed.
fn find_shown(mut view: vt.View, pane: vt.Vt, needle: str, older: bool, back: int) -> str {
    if !vt.view_find(mut view, pane, needle.bytes(), older, back) { return "none" }
    let to = vt.view_found_back(mut view, pane, back)
    if to < 0 { return "gone" }
    let shown = vt.fill_view(mut view, pane, to)
    if !vt.mark_found(mut view) { return "{shown}:unmarked" }
    var out = List[byte]()
    let _n = vt.view_marked_text(view, mut out, 4096)
    "{shown}:{view.mark_r0},{view.mark_c0}-{view.mark_r1},{view.mark_c1}:" + text(out)
}

fn test_find_from_the_window_edges() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    var got = find_shown(mut view, pane, "a", true, 0)
    assert(got == "0:3,1-3,1:a", "older from the live rows' bottom counts the bottom row: " + got)
    vt.unfind_view(mut view)
    got = find_shown(mut view, pane, "a5", true, 0)
    assert(got == "3:2,1-2,2:a5", "a match out of the window is placed in its middle: " + got)
    vt.unfind_view(mut view)
    let _f = vt.fill_view(mut view, pane, 6)
    got = find_shown(mut view, pane, "a", false, 6)
    assert(got == "6:1,1-1,1:a", "newer from the oldest window's top counts the top row: " + got)
    vt.unfind_view(mut view)
    got = find_shown(mut view, pane, "a8", false, 6)
    assert(got == "0:2,1-2,2:a8", "placing stops at the live rows: " + got)
    vt.unfind_view(mut view)
    got = find_shown(mut view, pane, "a1", true, 0)
    assert(got == "6:1,1-1,2:a1", "placing stops at the oldest row: " + got)
}

fn test_find_again_goes_strictly_past_the_match() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    var got = find_shown(mut view, pane, "a", true, 0)
    assert(got == "0:3,1-3,1:a", "the first match: " + got)
    got = find_shown(mut view, pane, "a", true, 0)
    assert(got == "0:2,1-2,1:a", "again: the row above: " + got)
    got = find_shown(mut view, pane, "a", true, 0)
    assert(got == "0:1,1-1,1:a", "again: the top row: " + got)
    got = find_shown(mut view, pane, "a", true, 0)
    assert(got == "2:2,1-2,1:a", "again: into history: " + got)
    got = find_shown(mut view, pane, "a", false, 2)
    assert(got == "2:3,1-3,1:a", "the other way: the row below: " + got)
    assert(view.found_from == 0 && view.found_to == 0, "one cell")
    vt.unfind_view(mut view)
    assert(find_shown(mut view, pane, "zz", true, 0) == "none", "no match")
    var top = find_shown(mut view, pane, "a", false, 0)
    assert(top == "0:1,1-1,1:a", "newer from the live rows' top counts the top row: " + top)
}

fn test_find_no_match_keeps_the_last() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    assert(find_shown(mut view, pane, "a8", true, 0) == "0:2,1-2,2:a8", "a8")
    let id = view.found_id
    assert(!vt.view_find(mut view, pane, "a8".bytes(), false, 0), "nothing newer than the only a8")
    assert(view.found_id == id && view.found_from == 0 && view.found_to == 1, "the last match is kept")
}

fn test_find_across_a_soft_wrap() {
    var pane = vt.new(4, 2, 4096)
    vt.feed(mut pane, "abcdefghij\r\nx".bytes())
    var view = view_for(pane)
    var got = find_shown(mut view, pane, "ghij", true, 0)
    assert(got == "1:1,3-2,2:ghij", "a match from history across the wrap into the live rows: " + got)
    let _whole = vt.fill_view(mut view, pane, 0)
    assert(vt.mark_found(mut view) && vt.view_marked(view, 1, 1) && vt.view_marked(view, 1, 2) && !vt.view_marked(view, 1, 3),
        "partly shown: the rows the window holds")
    let _above = vt.fill_view(mut view, pane, 2)
    assert(vt.mark_found(mut view) && view.mark_r0 == 2 && view.mark_c0 == 3 && view.mark_r1 == 2 && view.mark_c1 == 4,
        "partly shown: up to the window's last cell")
    vt.unfind_view(mut view)
    let _live = vt.fill_view(mut view, pane, 0)
    assert(find_shown(mut view, pane, "cd", false, 0) == "none", "a match starting above the top row is not newer")
}

fn test_find_wide_and_combining() {
    var pane = vt.new(6, 2, 4096)
    vt.feed(mut pane, "\u{3042}\u{3044}x\r\ne\u{301}y".bytes())
    var view = view_for(pane)
    var got = find_shown(mut view, pane, "\u{3044}x", true, 0)
    assert(got == "0:1,3-1,5:\u{3044}x", "a wide glyph is two cells: " + got)
    vt.unfind_view(mut view)
    got = find_shown(mut view, pane, "e\u{301}y", true, 0)
    assert(got == "0:2,1-2,2:e\u{301}y", "a combining mark is matched after its base: " + got)
    vt.unfind_view(mut view)
    assert(find_shown(mut view, pane, "ey", true, 0) == "none", "a mark between two scalars keeps them apart")
}

fn test_find_after_eviction() {
    var pane = vt.new(6, 3, 120)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    assert(vt.fill_view(mut view, pane, 99) == 3 && lines(view) == "a4|a5|a6", "three rows retained: " + lines(view))
    assert(find_shown(mut view, pane, "a5", true, 0) == "3:2,1-2,2:a5", "a5 in history")
    vt.feed(mut pane, "\r\na10\r\na11".bytes())
    assert(!vt.view_find(mut view, pane, "a".bytes(), true, 0), "nothing is older than a match no longer retained")
    var got = find_shown(mut view, pane, "a", false, 0)
    assert(got == "3:1,1-1,1:a", "newer than it: the oldest retained match: " + got)
}

fn test_find_the_alternate_screen() {
    var pane = vt.new(6, 2, 4096)
    vt.feed(mut pane, numbered(5))
    vt.feed(mut pane, "\u{1b}[?1049h\u{1b}[Halt".bytes())
    var view = view_for(pane)
    assert(!vt.view_find(mut view, pane, "a".bytes(), true, 0), "the alternate screen has no history to search")
    assert(vt.view_found_back(mut view, pane, 0) == 0 - 1, "nor a match to place")
}

fn test_find_marks_only_a_shown_match() {
    var pane = vt.new(6, 3, 4096)
    vt.feed(mut pane, numbered(9))
    var view = view_for(pane)
    assert(find_shown(mut view, pane, "a5", true, 0) == "3:2,1-2,2:a5", "a5")
    let _live = vt.fill_view(mut view, pane, 0)
    assert(!vt.mark_found(mut view) && !view.marked, "a window without the match marks nothing")
    vt.unfind_view(mut view)
    assert(!vt.mark_found(mut view), "no match, no marks")
}

fn test_needles_that_fit() {
    assert(!vt.needle_fits("".bytes()), "an empty needle")
    assert(vt.needle_fits("x".repeat(vt.FIND_SCALARS).bytes()), "the longest needle")
    assert(!vt.needle_fits("x".repeat(vt.FIND_SCALARS + 1).bytes()), "one scalar too many")
    assert(vt.needle_fits("\u{3042}".repeat(vt.FIND_SCALARS).bytes()), "counted in scalars, not bytes")
    assert(!vt.needle_fits("\u{301}".bytes()), "a needle with no width")
}

fn main() -> int {
    test_history_above_live()
    test_fills_need_reserved_buffers()
    test_soft_wrap_relaid_at_the_current_width()
    test_wide_and_combining_glyphs()
    test_renditions_kept()
    test_alternate_screen_has_no_history()
    test_eviction_clamps_to_the_oldest_retained_row()
    test_anchor_follows_content()
    test_repeated_fills_have_no_retained_growth()
    test_marked_text_in_reading_order()
    test_marked_wide_and_combining()
    test_marked_text_over_the_cap_is_refused_whole()
    test_marked_history_rows()
    test_find_from_the_window_edges()
    test_find_again_goes_strictly_past_the_match()
    test_find_no_match_keeps_the_last()
    test_find_across_a_soft_wrap()
    test_find_wide_and_combining()
    test_find_after_eviction()
    test_find_the_alternate_screen()
    test_find_marks_only_a_shown_match()
    test_needles_that_fit()
    print("PASS vt-view")
    0
}
