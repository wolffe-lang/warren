//! member: false
//! Bounded throughput and allocation witness; run as a finite test, not a soak.
use vt
use std.mem.budget
use std.io

fn main() -> int {
    region measured {
    let before = budget.charged(measured)
    var p = vt.new()
    let retained = budget.charged(measured) - before
    let pattern = "a\u{1b}[31m中\u{1b}]2;t\u{7}".bytes()
    let baseline = budget.charged(measured)
    var prints = 0
    var rounds = 0
    while rounds < 4096 {
        for b in pattern {
            vt.advance_in_place(mut p, b)
            if p.output_count > 0 && p.first_kind == 1 { prints += 1 }
        }
        rounds += 1
    }
    let grown = budget.charged(measured) - baseline
    io.write_line("MEASURE parser-throughput bytes={pattern.len * rounds} prints={prints} retained-charged={retained} advance-charged={grown}")
    assert(prints == 8192, "parser-benchmark-tokens")
    assert(grown == 0, "parser-advance-allocation")
    io.write_line("PASS parser-throughput")
    }
    0
}
