#!/usr/bin/env bash
# Build the oracle image from its pins, hold it to them, and run the Linux gate inside.
#   WARREN_ENGINE   docker (default) or podman
#   WARREN_CPUS     CPUs for the build and the gate, as taskset takes them (default 0)
#   WARREN_MEMORY   the container's memory limit (default 6g)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
engine=${WARREN_ENGINE:-docker}
cpus=${WARREN_CPUS:-0}
memory=${WARREN_MEMORY:-6g}
key=$(python3 -I - "$root" <<'PY'
import hashlib, pathlib, sys
r = pathlib.Path(sys.argv[1]); h = hashlib.sha256()
h.update((r / 'ci/oracle.Containerfile').read_bytes())
print(h.hexdigest()[:20])
PY
)
image="wr00-oracle:$key"
mkdir -p "$root/target/oracle" "$root/target/gate"
oracle_image() {
  "$engine" build --memory "$memory" --build-arg "BUILD_CPUS=$cpus" -f "$root/ci/oracle.Containerfile" -t "$image" "$root" || return 1
  "$engine" image inspect "$image" --format '{{.Id}}' | tee "$root/target/oracle/image-id.txt"
  for file in oracle-packages.txt oracle-binaries.txt; do
    "$engine" run --rm --memory "$memory" "$image" cat "/opt/$file" > "$root/target/oracle/$file" || return 1
  done
  diff -u "$root/ci/packages.txt" "$root/target/oracle/oracle-packages.txt" || { echo 'FAIL oracle-image: the package list is not the pin'; return 1; }
  diff -u "$root/ci/oracle-binaries.lock" "$root/target/oracle/oracle-binaries.txt" || { echo 'FAIL oracle-image: a binary is not the pin'; return 1; }
  echo 'PASS oracle-binary-and-package-pins'
}
# The same START/END shape as tools/gate, so one record reads both.
start=$SECONDS rc=0
echo 'START oracle-image'
oracle_image > "$root/target/gate/oracle-image.log" 2>&1 || rc=$?
if [ "$rc" -eq 0 ]; then sed 's/^/  /' "$root/target/gate/oracle-image.log"; else awk '/^FAIL / {print; next} {print "  " $0}' "$root/target/gate/oracle-image.log"; fi
echo "END oracle-image exit=$rc secs=$((SECONDS-start))"
[ "$rc" -eq 0 ] || exit "$rc"
if [ "${WARREN_PREPARE_ONLY:-0}" = 1 ]; then exit 0; fi
if [ "$#" -eq 0 ]; then set -- bash tools/gate linux; fi
"$engine" run --rm --init --memory "$memory" --pids-limit 4096 \
  -e WARREN_ARCHIVES -v "$root:$root" -w "$root" "$image" taskset -c "$cpus" "$@"
