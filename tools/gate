  step "vt-$entry-native" "$root/target/native/vt-$entry"
done
for entry in copy_rows pane_ledger_rows capacity_rows history_rows history_codec_rows line_coordinate_rows history_deque_rows history_prefix_rows reflow_rows resize_properties_rows history_ledger_rows; do
  step "vt-$entry-lupin" "$LUPIN" run "src/vt/$entry.lu"
done
# The one-pane server: the dependency rows (each tier), composed images
# applied by the client's applier against the emulator, and the session
# rows, where a scripted client drives a real server over its socket.
session_rows() {
  local rows=(echo split-every-byte bad-first-frame refusals hello-timeout stale-and-future-ack
    fragment-interleave two-sizes never-ack-beside-active detach-reattach ctrl-c-is-a-byte
    inherited-ignore-reset session-end last-output late-child-reaped command start-lock max-pending
    max-sessions flood-beside-quiet)
  if [ "$mode" = linux ]; then rows+=(pane-signals-and-handles threads rss-flat); fi
  rm -rf target/rows && mkdir -p target/rows && cd target/rows
  "$root/target/native/session-rows" "$root/target/native/warren" "${rows[@]}"
}
step deps-rows python3 -I tests/deps/run.py --wolf "$WOLF" --lupin "$LUPIN" --std "$WOLF_STD"
step compose-build "$WOLF" build --deny-warnings src/compose_rows.lu -o "$root/target/native/compose-rows"
step compose-native "$root/target/native/compose-rows"
step session-build "$WOLF" build --deny-warnings src/session_rows.lu -o "$root/target/native/session-rows"
step session-rows session_rows
[ "$mode" = linux ] || exit 0
# The oracle rows. No step here skips: without the pinned binaries it is red.
oracle_identity() {
  [ "$(xterm -version)" = 'XTerm(390)' ] || { echo "FAIL oracle-identity: $(xterm -version 2>&1)"; return 1; }
  [ "$(tmux -V)" = 'tmux 3.4' ] || { echo "FAIL oracle-identity: $(tmux -V 2>&1)"; return 1; }
  diff -u ci/oracle-binaries.lock /opt/oracle-binaries.txt || { echo 'FAIL oracle-identity: not the pinned image'; return 1; }
  echo 'PASS oracle-identity xterm=390 tmux=3.4'
}
export LC_ALL=C.UTF-8
