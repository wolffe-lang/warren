# Use the recorder's --base and --plant mode on a plant branch whose one hunk
# reserves nothing for the history ring, so it grows by doubling as records
# reach its end and N panes' rings go red by name against what they hold.
floor 15
rig ring-step.sh sha256=7f07e951bf31af9147fd27b6486d0bc71133375011b0bb31dcfa991257df04cd
step ring-resident-panes tools=bash,python3 script=ring-step.sh -- plant
