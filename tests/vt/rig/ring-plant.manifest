# Use the recorder's --base and --plant mode on a plant branch whose one hunk
# makes a new pane's history ring cost more than the history it holds (a
# second copy kept alive, or the ring made whole when the pane is made), so a
# new pane's resident cost goes red by name.
floor 15
rig ring-step.sh sha256=7f07e951bf31af9147fd27b6486d0bc71133375011b0bb31dcfa991257df04cd
step ring-resident-new tools=bash,python3 script=ring-step.sh -- plant
