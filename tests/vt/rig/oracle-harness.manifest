# A take for a change to the oracle harness: run inside the preflighted pinned
# image, from a clean committed checkout. The unit gate, then every step that
# launches the pinned reference terminal.
floor 35
rig oracle-harness-step.sh sha256=77e28671e662dc36dcf42e7d6d68750f3f22349b3b5eead62ab611891b513860
step oracle-harness-unit tools=python3 script=oracle-harness-step.sh -- unit
step oracle-harness-reference tools=python3,cc script=oracle-harness-step.sh -- oracle
