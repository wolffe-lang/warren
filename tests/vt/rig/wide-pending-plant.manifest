# Use the recorder's --base and --plant mode on a plant branch whose one hunk
# drops a wide scalar that should replace the wide glyph just written.
floor 15
rig wide-pending-step.sh sha256=f776a817af465829ce8fb1dc61eb961413cfe00da67fd16bc4bf09f3506b3807
step wide-pending-plant-build tools=python3 script=wide-pending-step.sh -- build
step wide-pending-off-wide-pending-wide needs=wide-pending-plant-build tools=python3,xterm,Xvfb script=wide-pending-step.sh -- plant
