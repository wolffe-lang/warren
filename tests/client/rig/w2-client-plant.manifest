floor 15
rig w2-client-plant-step.sh sha256=4962cf3e9170005b66254557233d7d8ec1ca1eefc05e2ec8b31b669afaafaab9
step w2-client-plant-build tools=python3,cc script=w2-client-plant-step.sh -- build
