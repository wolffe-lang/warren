# Use the recorder's --base and --plant mode on a plant branch whose one hunk
# drops the blank a console policy draws for a wide glyph's continuation.
floor 15
rig w2-client-plant-step.sh sha256=94bbb86f2d92bd607799b33d668e24fcd68edb96cb3e3ac8d20e5b99d431869a
step w2-client-plant-build tools=python3,cc script=w2-client-plant-step.sh -- build
step console-policy needs=w2-client-plant-build tools=python3 script=w2-client-plant-step.sh -- rows
